# Isolated local/staging MOCK profile. Never point REDIS_URL/object store at production.
# Copy to a private env file and supply isolated endpoints. No OpenAI key is needed.
NODE_ENV=test
OPENAI_MOCK=1
ASYNC_ANALYSIS=1
STATE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379
OBJECT_STORE=http
OBJECT_STORE_BASE_URL=http://127.0.0.1:8081
OBJECT_STORE_TOKEN=replace-with-isolated-store-token
ALLOW_DEV_AUTH=1
WEEKFIT_DEV_TOKEN=replace-with-isolated-dev-token
GLOBAL_AI_SLOTS=100
TARGET_BURST_SLOTS=100
WORKER_LOCAL_CONCURRENCY=25
WORKER_CLAIM_WAIT_MS=1000
INLINE_FAST_PATH=0
LONG_POLL_MAX_MS=25000
MAX_CONCURRENT_UPLOADS=64
MAX_ASYNC_QUEUE=200
MAX_QUEUE_WAIT_MS=2000
FOOD_PHOTO_MOCK_DELAY_MS=20000
# Synthetic shared reservations for mock only; not account limits.
PROVIDER_MAX_RPM=600
PROVIDER_MAX_TPM=2400000
PROVIDER_TOKENS_PER_CALL=4000
