# Copy to .env and fill in. Never commit .env or put keys in the iOS app.
OPENAI_API_KEY=sk-...
FOOD_PHOTO_MODEL=gpt-6-astra
FOOD_PHOTO_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_TIMEOUT_MS=90000
PORT=8080
DAILY_SCAN_LIMIT=20
GLOBAL_DAILY_SCAN_LIMIT=200
MAX_CONCURRENT_SCANS=4

# Production Render: ALLOW_DEV_AUTH=0 and set FIREBASE_PROJECT_ID to the iOS
# GoogleService-Info.plist PROJECT_ID (weekfitai).
FIREBASE_PROJECT_ID=weekfitai
ALLOW_DEV_AUTH=0
NODE_ENV=production

# Evening Coach summary (separate cheaper model; does not change food-photo settings).
COACH_SUMMARY_MODEL=gpt-4.1-mini
COACH_SUMMARY_TIMEOUT_MS=15000
# REQUIRED for /v1/coach/day-summary: absolute path on persistent storage.
# Empty disables the endpoint with 503; photo recognition continues to work.
# Example on Render disk: /var/data/coach-summary
COACH_SUMMARY_STORE_DIR=
# One OpenAI start per UID per local day after 20:00. Production refuses to boot if this is 0.
# COACH_SUMMARY_ONCE_PER_DAY=1
# Leave unset or 0 until resume is intentional. 1 allows new Coach generations. Food photos ignore this.
# COACH_AI_ENABLED=0
# Production file ledger: set 1 and keep the Render service at one instance. Unset disables new Coach generations.
# COACH_SUMMARY_SINGLE_INSTANCE=1
# COACH_SUMMARY_MIN_INTERVAL_HOURS=20
# COACH_SUMMARY_MAX_STARTS_PER_UTC_DAY=100
# COACH_SUMMARY_MAX_STARTS_PER_MINUTE=10
# COACH_SUMMARY_MAX_CONCURRENT=2
# COACH_SUMMARY_MAX_BODY_BYTES=131072
# UTF-8 size of the instruction text plus the day snapshot. Not a token count and not
# the whole model request (response schema and API framing are extra).
# COACH_SUMMARY_MAX_INPUT_TEXT_BYTES=80000
# Output budget only. It does not promise a finished JSON object.
# COACH_SUMMARY_MAX_OUTPUT_TOKENS=8192
# COACH_SUMMARY_CIRCUIT_FAILURES=3
# COACH_SUMMARY_CIRCUIT_OPEN_MINUTES=30

# Single-node Render (weekfit-food-photo, 1 instance + persistent disk):
# ASYNC_ANALYSIS=1
# ALLOW_SINGLE_NODE_ASYNC=1
# STATE_BACKEND=file
# OBJECT_STORE=local
# DATA_DIR=/var/data
# GLOBAL_AI_SLOTS=16
# TARGET_BURST_SLOTS=100
# LONG_POLL_MAX_MS=25000
# INLINE_FAST_PATH=1
# Do not set GLOBAL_AI_SLOTS=100 until OpenAI concurrency/RPM are confirmed.

# Local Mac only (never on Render):
# ALLOW_DEV_AUTH=1
# WEEKFIT_DEV_TOKEN=weekfit-dev-local-token
# NODE_ENV=development
# COACH_SUMMARY_STORE_DIR=/tmp/weekfit-coach-summary
