OPENAI_API_KEY=
FOOD_PHOTO_MODEL=gpt-6-astra
FOOD_PHOTO_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_TIMEOUT_MS=90000
PORT=8080
DAILY_SCAN_LIMIT=20
GLOBAL_DAILY_SCAN_LIMIT=200
MAX_CONCURRENT_SCANS=4
# Production: use Firebase Auth ID tokens (anonymous or signed-in).
FIREBASE_PROJECT_ID=
# Local testing ONLY. Never ship this token in a release iOS build.
ALLOW_DEV_AUTH=0
WEEKFIT_DEV_TOKEN=
# Evening Coach: one AI attempt per authenticated UID/local day, after 20:00.
COACH_SUMMARY_MODEL=gpt-4.1-mini
# REQUIRED: use a persistent disk mount in production, never /tmp or an ephemeral directory.
# Empty disables summary generation (503); photo recognition continues working.
COACH_SUMMARY_STORE_DIR=
