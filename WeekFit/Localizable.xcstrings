    "coach.scenario.performanceDuring.racket.hard.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Anstrengung wiederholbar und bewahren Sie die höchste Intensität für wichtige Punkte auf, nicht für jeden Ballwechsel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the effort repeatable and save the highest intensity for key points, not every rally."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga el esfuerzo repetible y guarde la máxima intensidad para puntos clave, no cada rally."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez l’effort reproductible et réservez la plus haute intensité aux points clés, pas à chaque échange."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni lo sforzo ripetibile e conserva l'intensità massima per i momenti chiave, non per ogni scambio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "努力を繰り返し可能に保ち、すべてのラリーではなく、重要なポイントに最高の強度を保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노력은 반복 가능하게 유지하고, 가장 강한 힘은 모든 랠리에 쓰지 말고 중요한 지점에만 아끼세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj wysiłek powtarzalny i zachowaj najwyższą intensywność na kluczowe momenty, nie na każdą wymianę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите усилие повторяемым и оставляйте максимальную интенсивность для ключевых очков, а не для каждого розыгрыша."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保训练动作可重复，并将最大强度应用于关键节点，而非每次对抗中均使用。"
          }
        }
      }
    },
