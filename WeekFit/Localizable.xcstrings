    "support.faq.item19.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit nutzt Zutaten, Portionen und Mahlkombinationen, um Kalorien, Protein, Kohlenhydrate und Fette zu schätzen. Werte können variieren; Ziel ist ein klares Gesamtbild von Ernährung, Energiebalance und Zusammensetzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit uses ingredients, portions, and meal combinations to estimate calories, protein, carbs, and fats for your meals. While values can vary depending on how meals are built, the goal is to help you clearly understand your overall nutrition, energy balance, and meal composition throughout the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa ingredientes, porciones y combinaciones para estimar calorías, proteína, carbohidratos y grasas. Los valores pueden variar; el objetivo es entender bien nutrición y equilibrio energético."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit utilise ingrédients, portions et combinaisons de repas pour estimer calories, protéines, glucides et lipides. Les valeurs peuvent varier, l'objectif est une compréhension claire de la nutrition et de l'équilibre énergétique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa ingredienti, porzioni e combinazioni per stimare calorie, proteine, carboidrati e grassi. I valori possono variare; l’obiettivo è capire nutrizione, bilancio energetico e composizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは材料、分量、食事の組み合わせでカロリー、タンパク質、炭水化物、脂質を推定します。値は変動することがありますが、全体の栄養、エネルギーバランス、構成を理解するのが目的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 재료, 분량, 식사 조합으로 칼로리, 단백질, 탄수화물, 지방을 추정합니다. 값은 달라질 수 있으며, 전체 영양, 에너지 균형, 구성을 이해하는 것이 목표입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit używa składników, porcji i kombinacji posiłków, by szacować kalorie, białko, węglowodany i tłuszcze. Wartości mogą się różnić — chodzi o jasne zrozumienie odżywiania i bilansu energetycznego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit использует ингредиенты, порции и состав блюд для оценки калорий, белков, углеводов и жиров. Значения могут отличаться в зависимости от продуктов и порций, поэтому это ориентир, а не лабораторная точность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 利用食材、分量及菜肴成分来估算热量、蛋白质、碳水化合物及脂肪含量。这些数值可能因食材及分量而异，因此该数据仅供参考，而非实验室级精确值。"
          }
        }
      }
    },
