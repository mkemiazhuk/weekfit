    "support.guides.item07.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach schaut, was gerade passiert, und schlägt vor, was als Nächstes helfen könnte — vor dem Training, während Aktivität, nach Workouts, Sauna oder bei hoher Erholungsbelastung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach looks at what is happening now and suggests what may help next — before training, during activity, after workouts, after sauna, or when recovery looks pressured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenador mira lo que ocurre ahora y sugiere qué puede ayudar después: antes del entrenamiento, durante actividad, tras entrenamientos, sauna o cuando la recuperación parece presionada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach regarde ce qui se passe maintenant et suggère ce qui peut aider ensuite — avant l'entraînement, pendant l'activité, après entraînements, sauna ou quand la récupération semble sous pression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach osserva cosa accade ora e suggerisce cosa può aiutare — prima dell’allenamento, durante l’attività, dopo workout, sauna o quando il recupero è sotto pressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーチは今起きていることを見て、次に役立つことを提案します — トレーニング前、活動中、ワークアウト後、サウナ後、回復が逼迫しているときなど。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코치는 지금 일어나는 일을 보고 다음에 도움이 될 것을 제안합니다 — 훈련 전, 활동 중, 운동·사우나 후, 회복이 부담될 때 등."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trener patrzy, co dzieje się teraz, i sugeruje, co może pomóc dalej — przed treningiem, w trakcie aktywności, po treningu, saunie lub gdy regeneracja wygląda na obciążoną."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренер смотрит на то, что происходит сейчас, и предлагает следующий полезный шаг — до тренировки, во время активности, после тренировки, после сауны или когда восстановление под давлением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练会观察当前状况，并在训练前、运动期间、训练后、桑拿后或恢复期面临压力时，提出可能有效的后续建议。"
          }
        }
      }
    },
    "support.guides.item07.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach als nächsten Schritt nutzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Coach as your next step"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Entrenador como su siguiente paso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Coach comme prochaine étape"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Coach come prossimo passo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーチを次の一手として使う"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코치를 다음 단계로 활용"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj Trener jako następnego kroku"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте Тренера как следующий шаг"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把教练当作下一步"
          }
        }
      }
    },
    "support.guides.item08.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan ist zum Organisieren Ihres Tages oder Ihrer Woche im Voraus. Fügen Sie Workouts, Mahlzeiten, Hydration, Erholung, Schlaf und Routinen hinzu, bevor sie passieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan is for organizing your day or week ahead. Add workouts, meals, hydration, recovery, sleep, and routines before they happen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan sirve para organizar su día o semana con antelación. Añada entrenamientos, comidas, hidratación, recuperación, sueño y rutinas antes de que ocurran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan sert à organiser votre journée ou semaine à l'avance. Ajoutez entraînements, repas, hydratation, récupération, sommeil et routines avant qu'ils n'arrivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piano serve a organizzare giorno o settimana in anticipo. Aggiungi allenamenti, pasti, idratazione, recupero, sonno e routine prima che accadano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランは日や週を事前に整理するためのものです。ワークアウト、食事、水分、回復、睡眠、ルーティンを事前に追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획은 하루·주를 미리 정리합니다. 운동, 식사, 수분, 회복, 수면, 루틴을 미리 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan służy do organizacji dnia lub tygodnia z wyprzedzeniem. Dodawaj treningi, posiłki, nawodnienie, regenerację, sen i rutyny zanim nastąpią."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "План нужен, чтобы заранее организовать день или неделю. Добавляйте тренировки, приемы пищи, воду, восстановление, сон и рутины до того, как они произойдут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计划旨在帮助您规划未来一天或一周的生活安排。在相关事项发生之前，提前制定锻炼、饮食、水分补充、恢复、睡眠及日常习惯等具体方案。"
          }
        }
      }
    },
    "support.guides.item08.title" : {
