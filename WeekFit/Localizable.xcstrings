    "termsPrivacy.weekfitUsesTheHealthActivityNutritionRecoveryAndPlanner" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit nutzt Gesundheits-, Aktivitäts-, Ernährungs-, Erholungs- und Planner-Daten, die Sie erlauben oder eingeben, um die App nützlicher zu machen. Apple Health-Berechtigungen können jederzeit in Apple Health oder iOS-Einstellungen geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit uses the health, activity, nutrition, recovery, and planner data you allow or enter to make the app more useful. You can change Apple Health permissions anytime in Apple Health or iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa los datos de salud, actividad, nutrición, recuperación y planificador que permite o introduce para hacer la app más útil. Puede cambiar los permisos de Apple Health en Apple Health o Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit utilise les données de santé, activité, nutrition, récupération et planificateur que vous autorisez ou saisissez pour rendre l'app plus utile. Vous pouvez modifier les autorisations Apple Health à tout moment dans Apple Health ou Réglages iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa dati salute, attività, nutrizione, recupero e planner che consenti o inserisci per rendere l’app più utile. Puoi cambiare i permessi Apple Health in Salute o Impostazioni iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは、許可または入力した健康、アクティビティ、栄養、回復、Plannerデータを使いアプリをより有用にします。Apple Healthの権限はApple HealthまたはiOS設定でいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 허용하거나 입력한 건강, 활동, 영양, 회복, Planner 데이터로 앱을 더 유용하게 합니다. Apple Health 권한은 Apple Health 또는 iOS 설정에서 언제든 변경할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit wykorzystuje dane zdrowia, aktywności, odżywiania, regeneracji i planera, które zezwalasz lub wprowadzasz, aby aplikacja była bardziej użyteczna. Uprawnienia Apple Health można zmienić w Apple Health lub Ustawieniach iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit использует разрешенные или введенные вами данные здоровья, активности, питания, восстановления и планирования, чтобы приложение было полезнее. Разрешения Apple Health можно изменить в Apple Health или настройках iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 利用系统授予或您手动提供的健康、活动、饮食、恢复及日程规划数据，不断优化应用功能。您可随时在 Apple Health 应用或 iOS 设置中修改 Apple Health 的授权权限。"
          }
        }
      }
    },
