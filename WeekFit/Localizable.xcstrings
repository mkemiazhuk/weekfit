    "coach.eveningRecap.forEvening.fallback" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie den Abend ruhig und machen Sie ein wenig Platz zum Entspannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
