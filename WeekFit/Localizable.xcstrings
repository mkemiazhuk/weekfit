    "support.guides.item05.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ernährung zeigt Ihren Ernährungsfortschritt des Tages. Es nutzt protokollierte oder abgeschlossene Mahlzeiten und gibt einen Überblick über Kalorien, Protein, Kohlenhydrate und Fette."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrition shows your food progress for the day. It uses meals you log or complete and gives a high-level view of calories, protein, carbs, and fats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrición muestra su progreso de comida del día. Usa comidas registradas o completadas y ofrece una vista general de calorías, proteína, carbohidratos y grasas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrition montre vos progrès alimentaires du jour. Elle utilise les repas enregistrés ou complétés et donne une vue d'ensemble calories, protéines, glucides et lipides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrizione mostra il progresso alimentare del giorno usando pasti registrati o completati, con panoramica di calorie, proteine, carboidrati e grassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "栄養はその日の食事の進捗を示します。記録または完了した食事を使い、カロリー、タンパク質、炭水化物、脂質の概要を提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영양은 하루 식사 진행을 보여줍니다. 기록·완료한 식사로 칼로리, 단백질, 탄수화물, 지방 개요를 제공합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odżywianie pokazuje postęp żywieniowy dnia. Korzysta z zalogowanych lub ukończonych posiłków i daje ogólny obraz kalorii, białka, węglowodanów i tłuszczów."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Питание показывает прогресс питания за день. Оно использует записанные или выполненные приемы пищи и дает общий взгляд на калории, белки, углеводы и жиры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "营养追踪功能可显示您当日饮食进展，它基于您记录或填写的餐食信息，为您提供卡路里、蛋白质、碳水化合物及脂肪的概览。"
          }
        }
      }
    },
    "support.guides.item05.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
