    "coach.priority.noUrgentMoveIsNeededKeepFuel.4529" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist kein dringender Umzug erforderlich. Halten Sie Treibstoff, Flüssigkeiten und Energie stabil, damit Sie später nicht reagieren müssen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No urgent move is needed. Keep fuel, fluids, and energy steady so you are not reacting later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hace falta movimiento urgente. Mantenga combustible, líquidos y energía estables para no reaccionar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun mouvement urgent n'est nécessaire. Gardez carburant, fluides et énergie stables pour ne pas réagir plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è necessario muoversi urgentemente. Mantenga stabili carburante, liquidi ed energia in modo da non dover reagire più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "急いで動く必要はありません。燃料、液体、エネルギーを安定させて、後で反応することがないようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "급한 조치는 필요하지 않습니다. 나중에 반응하지 않도록 연료, 액체, 에너지를 일정하게 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie trzeba pilnego ruchu. Trzymaj paliwo, płyny i energię stabilnie, by nie reagować późno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срочный шаг не нужен. Держите питание, воду и энергию ровно, чтобы потом не реагировать в спешке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需采取紧急措施。保持燃油、液体及能量稳定，以避免日后出现不良反应。"
          }
        }
      }
