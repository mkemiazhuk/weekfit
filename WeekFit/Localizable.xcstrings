    "coach.priority.addingLoadWhenRecoveryIsLimitedCan.5107": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding load when recovery is limited can make tomorrow harder than it needs to be."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если добавить нагрузку при ограниченном восстановлении, завтра может стать тяжелее, чем нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在恢复能力有限的情况下增加负载，可能会让未来的工作比实际需要更加艰难。"
          }
        }
      }
    },
    "coach.priority.addingLoadWouldCompeteWithTheRecovery.1548": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding load would compete with the recovery you are trying to build."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительная нагрузка будет конкурировать с восстановлением, которое вы пытаетесь собрать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加负载会与您正在构建的恢复机制产生竞争。"
          }
        }
      }
    },
    "coach.priority.adjustTrainingReadiness.642": {
