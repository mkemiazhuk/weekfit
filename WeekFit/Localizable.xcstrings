    "onboarding.v12.understanding.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach adjusts training and nutrition when your recovery changes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренер подстраивает тренировки и питание, когда меняется восстановление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您的恢复情况发生变化时，教练会相应调整训练方案与营养方案。"
          }
        }
      }
    },
    "onboarding.v12.understanding.body.fatLoss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When recovery drops, Coach protects the cut — training moves, meals tighten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда восстановление падает, Тренер защищает дефицит — тренировка сдвигается, еда уплотняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当恢复能力下降时，教练会弥补这一缺口——训练安排将调整，饮食安排也将紧凑化。"
          }
        }
      }
    },
    "onboarding.v12.understanding.body.maintenance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When recovery drops, Coach rewrites today — training moves, meals adapt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда восстановление падает, Тренер переписывает день — тренировка сдвигается, еда меняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当恢复进度下降时，教练会重新规划当日安排——训练时间调整，饮食方案变更。"
          }
        }
      }
    },
    "onboarding.v12.understanding.body.muscleGain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When recovery drops, Coach protects the gain — strength waits, fuel stays."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда восстановление падает, Тренер защищает набор — сила ждёт, топливо остаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当恢复力下降时，教练仍坚守阵型——力量犹存，能量未竭。"
          }
        }
      }
    },
    "onboarding.v12.understanding.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body changes. So does your plan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тело меняется. План — тоже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身体在变化，计划也在变化。"
          }
        }
      }
    },
