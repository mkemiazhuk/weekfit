    "support.faq.item09.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivität kann über 100 % steigen, wenn Bewegung, Workouts, Trainingsminuten oder tägliche Aktivität Ihr aktuelles Aktivitätsziel überschreiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activity can go above 100% when your movement, workouts, exercise minutes, or daily activity go beyond your current activity goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actividad puede superar el 100 por ciento cuando movimiento, entrenamientos, minutos de ejercicio o actividad diaria superan su objetivo actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'activité peut dépasser 100 pour cent lorsque mouvement, entraînements, minutes d'exercice ou activité quotidienne dépassent votre objectif d'activité actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attività può superare il 100% quando movimento, allenamenti, minuti di esercizio o attività giornaliera superano l’obiettivo attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動、ワークアウト、運動時間、日々のアクティビティが現在のアクティビティ目標を超えると、アクティビティは100%を超えることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동, 운동, 운동 시간, 일일 활동이 현재 활동 목표를 넘으면 활동가 100%를 초과할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywność może przekroczyć 100 procent, gdy ruch, treningi, minuty ćwiczeń lub dzienna aktywność przekraczają obecny cel aktywności."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активность может превышать 100%, когда движение, тренировки, минуты упражнений или дневная активность превышают текущую цель активности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您的身体活动量、训练时长、运动分钟数或日常活动量超过当前活动目标时，活动率可超过 100%。"
          }
        }
      }
    },
