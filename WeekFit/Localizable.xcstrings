    "coach.copy.sleepWasShorterThanNeededAndRecovery.77" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf war kürzer als nötig und Erholungssignale brauchen Unterstützung. Halten Sie die Intensität niedriger und entspannen Sie sich früher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep was shorter than needed and recovery signals need support. Keep intensity lower and wind down earlier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño fue más corto de lo necesario y las señales de recuperación necesitan apoyo. Mantenga intensidad más baja y baje el ritmo antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil était plus court que nécessaire et les signaux de récupération ont besoin de soutien. Gardez l'intensité plus basse et détendez-vous plus tôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno era più breve del necessario e i segnali di recupero hanno bisogno di supporto. Tenere l'intensità inferiore e il vento giù prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は必要なより短く、回復信号はサポートを必要としていました。 強度を低下させ、風を下がらせて下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠은 필요로 하고 회복 신호 필요 지원 보다는 더 짧습니다. 더 낮은 강도와 바람을 유지."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen był krótszy niż potrzeba, a sygnały regeneracji wymagają wsparcia. Utrzymać niższą intensywność i wcześniej zejść w spokój."
