    "coach.humanDecision.addingMoreFoodRightBeforeTheStart.3316" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurz vor Start mehr Essen oder Flüssigkeit vergessen, wenn Training wirklich als Nächstes kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
