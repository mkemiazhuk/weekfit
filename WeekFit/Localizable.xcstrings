    "termsPrivacy.legal.appleHealthPermissions.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit greift nur auf Apple Health-Kategorien zu, die Sie ausdrücklich über Apple Health-Berechtigungen erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit only accesses Apple Health categories that you explicitly allow through Apple Health permissions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit solo accede a las categorías de Apple Health que usted autoriza explícitamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit n'accède qu'aux catégories Apple Health que vous autorisez explicitement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit accede solo alle categorie Apple Health che consenti esplicitamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitがアクセスするApple Healthカテゴリは、Apple Healthの権限で明示的に許可したもののみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 Apple Health 권한으로 명시적으로 허용한 Apple Health 카테고리만 접근합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit uzyskuje dostęp tylko do kategorii Apple Health, które wyraźnie zostaną zezwolone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit получает доступ только к тем категориям Apple Health, которые вы явно разрешили в настройках Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 仅可访问您在 Apple Health 设置中明确授权的 Apple Health 分类。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthPermissions.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Apple Health-Berechtigungen jederzeit in der Apple Health-App oder in den iOS-Einstellungen prüfen, ändern oder widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can review, modify, or revoke Apple Health permissions at any time in the Apple Health app or iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede revisar, modificar o revocar los permisos de Apple Health en cualquier momento en la app Salud o Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez consulter, modifier ou révoquer les autorisations Apple Health à tout moment dans l'app Santé ou Réglages iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi rivedere, modificare o revocare i permessi Apple Health in qualsiasi momento nell’app Salute o in Impostazioni iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Healthの権限は、Apple HealthアプリまたはiOS設定でいつでも確認、変更、取り消しできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health 권한은 Apple Health 앱 또는 iOS 설정에서 언제든 검토·변경·해제할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprawnienia Apple Health można w każdej chwili przejrzeć, zmienić lub cofnąć w app Zdrowie lub Ustawieniach iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете просмотреть, изменить или отозвать разрешения Apple Health в любое время в приложении Apple Health или настройках iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可随时在 Apple Health 应用中或 iOS 设置中查看、修改或撤销 Apple Health 的授权。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthPermissions.p3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Berechtigungen entfernt werden, kann WeekFit möglicherweise keine Metriken mehr aktualisieren, abgeschlossene Workouts synchronisieren, Coach-Vorschläge personalisieren oder bestimmte Einblicke anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If permissions are removed, WeekFit may no longer be able to update related metrics, sync completed workouts, personalize Coach suggestions, or show certain insights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se quitan permisos, WeekFit puede dejar de actualizar métricas relacionadas, sincronizar entrenamientos completados, personalizar sugerencias de Coach o mostrar ciertos análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les autorisations sont retirées, WeekFit peut ne plus mettre à jour les métriques associées, synchroniser les entraînements terminés, personnaliser les suggestions Coach ou afficher certaines analyses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se i permessi vengono rimossi, WeekFit potrebbe non aggiornare metriche, sincronizzare allenamenti completati, personalizzare suggerimenti Coach o mostrare certi insight."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限を削除すると、WeekFitは関連指標の更新、完了ワークアウトの同期、Coach提案のパーソナライズ、一部インサイトの表示ができなくなる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한을 제거하면 WeekFit이 관련 지표 업데이트, 완료 운동 동기화, Coach 제안 개인화, 일부 인사이트 표시를 못 할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po cofnięciu uprawnień WeekFit może nie aktualizować powiązanych metryk, synchronizować ukończonych treningów, personalizować sugestii Coach ani pokazywać niektórych analiz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если разрешения удалены, WeekFit может больше не обновлять связанные метрики, синхронизировать завершенные тренировки, персонализировать советы Тренера или показывать отдельные инсайты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若权限被撤销，WeekFit 可能将无法再更新相关指标、同步已完成训练记录、个性化教练建议或显示特定洞察信息。"
          }
        }
      }
    },
