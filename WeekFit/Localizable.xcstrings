    "onboarding.v4.way.reactive.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehen Sie, wo Sie stehen. Verfolgen Sie Fortschritt und erfassen Sie, was im Laufe des Tages passiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See where you are right now. Track progress and capture what happens through the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vea dónde está ahora. Siga el progreso y registre lo que ocurre durante el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez où vous en êtes maintenant. Suivez les progrès et capturez ce qui se passe dans la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi dove sei. Monitora i progressi e registra ciò che accade durante la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の位置を確認。進捗を追い、一日の出来事を記録。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 상태를 확인하세요. 진행을 추적하고 하루 동안 일어난 일을 기록하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz, gdzie jesteś teraz. Śledź postęp i zapisuj to, co dzieje się w ciągu dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видеть, где вы сейчас. Отслеживать прогресс и фиксировать всё, что происходит в течение дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看您当前所处位置；追踪进度，并记录全天发生的所有事项。"
          }
        }
      }
    },
