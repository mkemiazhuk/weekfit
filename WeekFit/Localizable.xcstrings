    "onboarding.v10.ahead.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workouts und Mahlzeiten einmal speichern. Wiederverwenden, wenn Heute Sie zum Handeln auffordert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save workouts and meals once. Reuse them when Today asks you to act."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde entrenamientos y comidas una vez. Reutilícelos cuando Hoy le pida actuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez entraînements et repas une fois. Réutilisez-les quand Aujourd’hui vous demande d'agir."
