          }
        }
      }
    },
    "coach.priority.valueIsNotTheProblemTheCeiling.3010" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Das ist nicht das Problem, sondern die Obergrenze. Schlechter Schlaf macht die Intensität heute teuer, also fangen Sie leichter an und seien Sie bereit, dies in eine einfachere Arbeit zu verwandeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not the problem; the ceiling is. Poor sleep makes intensity expensive today, so start easier and be willing to turn this into easier work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es el problema; lo limitante es el techo. Dormir mal encarece la intensidad hoy: empiece más suave y esté dispuesto a convertir esto en trabajo más ligero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas le problème ; c’est le plafond. Un mauvais sommeil rend l’intensité coûteuse aujourd’hui : commencez plus facilement et acceptez d’alléger ce travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è il problema; il soffitto è. Il sonno povero rende l'intensità costoso oggi, quindi iniziare più facile e essere disposti a trasformare questo in lavoro più facile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 問題ではありません。天井はあります。 貧しい眠りは、今日の強度が高まります, ので、簡単に開始し、より簡単な作業にこれを有効にして喜んで."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 문제는 아닙니다; 천장은 입니다. Poor 수면은 오늘날의 강도를 높일 수 있으므로 쉽게 시작하고 쉽게 작업 할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie jest problemem — limitem jest co innego. Słaby sen podnosi koszt intensywności dziś: zacznij łagodniej i bądź gotów zamienić to na lżejszą pracę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — не проблема; проблема в потолке. Плохой сон делает интенсивность дорогой сегодня, поэтому начните легче и будьте готовы превратить это в более легкую работу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@不是问题；天花板是。如今，睡眠不足会使强度变得昂贵，因此，从轻松开始，并愿意将其转化为更轻松的工作。"
          }
        }
      }
    },
