        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目的在于进行有益的练习，而非证明该计划无需调整即可执行。"
          }
        }
      }
    },
    "coach.humanDecision.theHardWorkIsAlreadyDoneSauna.2109": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hard work is already done. Sauna can be relaxing, but after hard training it can also add stress."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная работа уже сделана. Сауна может расслабить, но после тяжелой тренировки она тоже добавляет стресс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要工作已经完成。桑拿虽能让人放松，但在高强度训练后，它反而会增加压力。"
          }
        }
      }
    },
    "coach.humanDecision.theHeatBlockIsAlreadyDoneLet.446": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The heat block is already done. Let it support recovery instead of adding more stress afterwards."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепловой блок уже завершен. Пусть он поможет восстановиться, а не добавит стресс после."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热疗模块已完工。愿它能助力康复，而非在康复后增加负担。"
