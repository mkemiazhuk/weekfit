    "coach.rationale.saveQuality.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist heute %2$@. Verwenden Sie dieses %3$@, um locker zu bleiben, nicht um vor dem Laden Ermüdung hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is %2$@ today. Use this %3$@ to stay loose, not to add fatigue before loading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es %2$@ hoy. Use este %3$@ para mantenerse suelto, no para añadir fatiga antes de cargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est %2$@ aujourd’hui. Utilisez ce %3$@ pour rester souple, pas pour ajouter de la fatigue avant la charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è %2$@ oggi. Usa questo %3$@ per restare sciolto, non per aggiungere fatica prima del carico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は今日 %2$@ です。この %3$@ を使って、荷重前に疲労を増やすのではなく、体をほぐしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@는 오늘 %2$@입니다. 이 %3$@를 사용할 때는, 로딩 전에 피로를 더하지 않고 긴장을 풀기 위해 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ to dziś %2$@. Wykorzystaj ten %3$@, by pozostać luźnym, a nie dokładać zmęczenia przed obciążeniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — это %2$@ сегодня. Используйте эту %3$@, чтобы оставаться разогретым, а не добавлять усталость перед нагрузкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@就是今天的%2$@。使用这款%3$@保持松动，在装载前不会增加疲劳。"
          }
        }
      }
    },
