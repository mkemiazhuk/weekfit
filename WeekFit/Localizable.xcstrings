      }
    },
    "challenge.recovery7.task.7.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick something small enough to repeat next week."
          }
        },
        "ru": {
