    "coach.aRelaxedWalkCanHelpTheBodyTransitionInto" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein entspannter Spaziergang kann dem Körper helfen, sich für die Nacht zu erholen. Halten Sie den Abend von hier aus ruhig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relaxed walk can help the body transition into recovery for the night. Keep the evening calm from here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una caminata relajada puede ayudar al cuerpo a pasar a recuperación nocturna. Mantenga la tarde tranquila desde aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une marche détendue peut aider le corps à passer en récupération pour la nuit. Gardez la soirée calme à partir de maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una passeggiata rilassata può aiutare la transizione corporea in recupero per la notte. Tenere la serata calma da qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リラックスした散歩は、夜の回復に身体の移行を助けることができます。 夕方から落ち着き続ける。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편안한 산책은 신체의 전환을 밤에 회복 할 수 있습니다. 저녁을 진정으로 여기."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spokojny spacer może pomóc ciału wejść w regenerację na noc. Od teraz utrzymać spokojny wieczór."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спокойная прогулка поможет телу перейти к ночному отдыху. Дальше держите вечер тихим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悠闲地散步有助于身体为夜间休息做好准备。从此以后，请保持夜晚的宁静。"
          }
        }
      }
    },
    "coach.aRelaxedWalkIsAGreatWayToWake" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein entspannter Spaziergang ist eine großartige Möglichkeit, den Körper zu wecken, ohne Stress hinzuzufügen. Nehmen Sie diese Dynamik in den Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relaxed walk is a great way to wake the body without adding stress. Take that momentum into the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una caminata relajada es una buena forma de despertar el cuerpo sin añadir estrés. Lleve ese impulso al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une marche détendue est un bon moyen de réveiller le corps sans ajouter de stress. Emportez cet élan dans la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una passeggiata rilassata è un ottimo modo per svegliare il corpo senza aggiungere stress. Prendi quel momento nella giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リラックスした散歩は、ストレスをかけずに体を目覚めるための素晴らしい方法です。 その瞬間を一日に。"
          }
        },
        "ko" : {
