        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적당한 강도가 적당합니다. HRV이 개선된다면 내일을 위해 최대한의 노력을 아끼십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umiarkowana intensywność jest w porządku. Maksymalne wysiłki zostaw na jutro, jeśli HRV się poprawi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умеренная интенсивность уместна. Максимальные нагрузки лучше оставить на завтра, если ВСР улучшится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天适合中等强度。若 HRV 改善，把极限努力留到明天。"
          }
        }
      }
    },
