    "coach.copy.energyIntakeIsAlreadyHighAndActivity.70" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Energieaufnahme ist bereits hoch und die Aktivitätsbelastung ist erhöht. Halten Sie das Abendlicht, vermeiden Sie mehr Nahrung und priorisieren Sie die Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energy intake is already high and activity strain is elevated. Keep the evening light, avoid more food, and prioritize recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ingesta ya es alta y la carga de actividad también. Mantenga la tarde ligera, evite más comida y priorice la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'apport énergétique est déjà élevé et la charge d'activité aussi. Gardez la soirée légère, évitez plus de nourriture et priorisez la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assunzione di energia è già elevata e la tensione di attività è elevata. Tenere la luce serale, evitare più cibo, e priorità di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギー摂取量が高まり、活動負担が高まります。 夕方の光を保ち、より多くの食糧を避け、回復を優先します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에너지 섭취는 이미 높고 활동 변형이 높다. 저녁 빛을 유지하고 더 많은 음식을 피하고, 회복을 우선 순위."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobór energii jest już wysoki, a obciążenie aktywnością też. Utrzymać lekki wieczór, unikać więcej jedzenia i priorytet regeneracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энергии уже много, а нагрузка повышена. Держите вечер легким, не добавляйте еду без голода и дайте себе восстановиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量摄入已处于较高水平，且体力活动负荷也显著增加。请保持晚间光照，避免过量进食，并优先进行恢复。"
          }
        }
      }
    },
