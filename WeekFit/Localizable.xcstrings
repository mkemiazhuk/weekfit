      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Beginn %@ Halten Sie den Tag auf die Arbeit gerichtet, nicht auf die Uhr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ starts %@. Keep the day pointed at the work, not the clock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ empieza %@ . Enfoque el día en el trabajo, no en el reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ commence %@ . Orientez la journée vers le travail, pas vers l’horloge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ inizio %@ . Tenere il giorno indicato al lavoro, non l'orologio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ スタート %@ 。時計ではなく、時計ではなく、仕事で指摘した日を保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 시작하기 %@ . 일, 시계가 아닌 일에 점유하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zaczyna się %@ . Skieruj dzień na pracę, nie na zegar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ начнется %@. Держите день направленным на работу, а не на часы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@启动%@。将白天指向工作，而不是时钟。"
          }
        }
      }
    },
