    "coach.scenario.enduranceBefore.long.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sitzung wird sich besser anfühlen, wenn Sie allmählich aufbauen und die Anstrengung nachhaltig halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This session will feel better if you build gradually and keep the effort sustainable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión irá mejor si construye gradualmente y mantiene un esfuerzo sostenible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette séance ira mieux si vous progressez graduellement et gardez un effort soutenable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sessione risulterà più piacevole se costruisci gradualmente e mantieni l'impegno sostenibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションは、徐々に進めて努力を持続可能に保てば、より快適に感じられるでしょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션은 점진적으로 진행하고 노력을 지속 가능하게 유지하면 더 좋게 느껴질 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sesja będzie lepsza, jeśli budujesz stopniowo i utrzymujesz wysiłek możliwy do utrzymania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировка пройдет лучше, если входить постепенно и держать усилие устойчивым."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果循序渐进地训练，并保持稳定的发力强度，训练效果会更好。"
          }
        }
      }
    },
