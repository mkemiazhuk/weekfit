    "support.faq.item30.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending bedeutet, die geplante Aktivitätszeit ist vorbei, aber die Aktivität wurde noch nicht abgeschlossen oder synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending means the planned activity time already passed, but the activity was not completed or synced yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendiente significa que la hora planificada pasó, pero la actividad no se completó ni sincronizó aún."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente signifie que l'heure planifiée est passée, mais l'activité n'a pas encore été complétée ou synchronisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending significa che l’orario pianificato è passato, ma l’attività non è stata completata o sincronizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendingは、予定のアクティビティ時刻を過ぎたが、まだ完了または同期されていないことを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending은 예정 활동 시간이 지났지만 아직 완료되거나 동기화되지 않았음을 의미합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekujące oznacza, że planowana godzina minęła, ale aktywność nie została jeszcze ukończona ani zsynchronizowana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидает означает, что время запланированной активности уже прошло, но она еще не выполнена и не синхронизирована."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“待处理”表示计划的活动时间已过，但活动尚未完成或同步。"
          }
        }
      }
    },
