          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño es lo bastante consistente para apoyar la recuperación en lugar de explicar problemas actuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
