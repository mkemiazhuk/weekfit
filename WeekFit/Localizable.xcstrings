    "support.faq.item26.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgeschlossene Apple Health-Workouts können automatisch in Plan importiert werden. WeekFit nutzt sie, um Ihren Tag genauer zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completed Apple Health workouts can be imported into Plan automatically. WeekFit uses them to help keep your day accurate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los entrenamientos completados de Apple Health pueden importarse automáticamente a Plan. WeekFit los usa para mantener el día preciso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entraînements Apple Health terminés peuvent être importés automatiquement dans Plan. WeekFit les utilise pour garder la journée exacte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli allenamenti Apple Health completati possono essere importati automaticamente in Piano. WeekFit li usa per mantenere accurata la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了したApple Healthのワークアウトはプランに自動インポートできます。WeekFitはそれらで一日を正確に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료된 Apple Health 운동은 계획에 자동으로 가져올 수 있습니다. WeekFit은 이를 통해 하루를 정확히 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukończone treningi Apple Health mogą być automatycznie importowane do Plan. WeekFit używa ich, by dzień był dokładny."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершенные тренировки из Apple Health могут автоматически импортироваться в План. WeekFit использует их, чтобы день оставался точным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已完成的 Apple Health 健身记录可自动导入到计划中。WeekFit 用这些记录帮助保持当天数据准确。"
          }
        }
      }
    },
