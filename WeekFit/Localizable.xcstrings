    "support.guides.item02.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist Ihr Live-Dashboard. Starten Sie dort, um aktuelle Aktivität, Ernährung, Erholung, Hydration, Schlaf und Coach-Status zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today is your live dashboard. Start there to see your current activity, nutrition, recovery, hydration, sleep, and coaching status."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy es su panel en vivo. Empiece ahí para ver actividad, nutrición, recuperación, hidratación, sueño y estado de Entrenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui est votre tableau de bord en direct. Commencez-y pour voir activité, nutrition, récupération, hydratation, sommeil et statut du Coach."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi è la dashboard live. Parti da lì per vedere attività, nutrizione, recupero, idratazione, sonno e stato Coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はライブダッシュボードです。現在のアクティビティ、栄養、回復、水分、睡眠、コーチの状態を確認する起点に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 실시간 대시보드입니다. 현재 활동, 영양, 회복, 수분, 수면, 코치 상태를 보는 출발점입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś to Twój dashboard na żywo. Zacznij tam, by zobaczyć aktywność, odżywianie, regenerację, nawodnienie, sen i status Trener."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня — ваш живой дашборд. Начните с него, чтобы увидеть текущую активность, питание, восстановление, воду, сон и статус Тренера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天——您的实时仪表板。从这里开始，即可查看当前活动状态、营养摄入、恢复情况、水分状况、睡眠情况及教练状态。"
          }
        }
      }
    },
