    "challenge.recovery7.task.2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dehnen, atmen oder sich leicht bewegen - bleiben Sie in dem, was sich heute gut anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stretch, breathe, or move lightly—stay within what feels good today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estire, respire o muévase suavemente; quédese en lo que hoy le resulte bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étirez-vous, respirez ou bougez légèrement — restez dans ce qui vous convient aujourd'hui."
