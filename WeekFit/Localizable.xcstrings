    "coach.rationale.protectNext.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist der nächste bedeutungsvolle Abschnitt. Halte dieses %2$@ einfach, damit du frisch ankommst, anstatt zusätzliche Müdigkeit mit Ihnen zu tragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is the next meaningful block. Keep this %2$@ easy so you arrive fresh instead of carrying extra fatigue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es el siguiente bloque significativo. Mantenga este %2$@ suave para llegar fresco en lugar de cargar más fatiga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est le prochain bloc significatif. Gardez ce %2$@ facile pour arriver frais plutôt qu’avec de la fatigue en plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è il prossimo blocco significativo. Mantieni questo %2$@ facile in modo da arrivare fresco invece di portare stanchezza extra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は次の意味のあるブロックです。この %2$@ を簡単にして、余分な疲れを持ち越さずにさっぱりと到達できるようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 다음 중요한 구간입니다. 이 %2$@을(를) 쉽게 유지하여 추가 피로를 안고 가지 않고 상쾌하게 도착하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ to następny istotny blok. Utrzymuj ten %2$@ na łatwym poziomie, by przyjść świeżo, a nie z dodatkowym zmęczeniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — следующий важный блок. Держите эту %2$@ легкой, чтобы прийти свежим, а не с лишней усталостью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@是下一个有意义的区块。保持这款%2$@轻松，让您到达新鲜，而不是带来额外的疲劳。"
          }
        }
      }
    },
    "coach.rationale.protectNext.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schütze, was als Nächstes kommt"
          }
        },
        "en" : {
