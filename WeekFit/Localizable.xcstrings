          "stringUnit": {
            "state": "translated",
            "value": "No food logged yet. If you train before your first meal, keep intensity controlled and hydrate steadily."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Еда еще не внесена. Если тренируетесь до первого приема пищи, держите интенсивность ниже и пейте спокойно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未记录进食情况。若您在首次进食前进行训练，请保持训练强度适中，并持续补充水分。"
          }
        }
      }
    },
    "coach.copy.noFoodLoggedYetLogYourFirst.219": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No food logged yet. Log your first meal so Coach can balance the rest of your day."
          }
        },
        "ru": {
          "stringUnit": {
