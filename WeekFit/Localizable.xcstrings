        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez ou faites sauter rapidement le brocoli jusqu'à vert vif et croquant-tendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapore o saltare rapidamente i broccoli fino a verde brillante e tenero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蒸気またはすぐに明るい緑と入札額までブロッコリーをsauté。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스팀 또는 빠른 sauté 밝은 녹색과 부드러운 충돌까지 broccoli."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotuj na parze lub szybko smaż brokuły do jasnozielonego, chrupko-miękkiego stanu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приготовьте брокколи на пару или быстро обжарьте до ярко-зелёного цвета и лёгкого хруста."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将西兰花焯水，或快速翻炒至呈现鲜绿色并略带脆感。"
          }
        }
      }
    },
    "meals.starter.chickenRice.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platten Sie den Reis, fügen Sie Huhn und Brokkoli hinzu und beenden Sie dann mit einem Nieselregen Olivenöl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plate the rice, add chicken and broccoli, then finish with a drizzle of olive oil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque el arroz, añada pollo y brócoli y termine con un chorrito de aceite de oliva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposez le riz, ajoutez poulet et brocoli, puis finissez avec un filet d'huile d'olive."
