    "coach.controlYourBreathingSlowDownBetweenRalliesAndAvoid" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollieren Sie Ihre Atmung, verlangsamen Sie zwischen den Rallyes und vermeiden Sie es, jeden Punkt vollständig zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control your breathing, slow down between rallies and avoid making every point all-out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle la respiración, baje el ritmo entre peloteos y evite jugar cada punto a tope."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôlez votre respiration, ralentissez entre les échanges et évitez de jouer chaque point à fond."
