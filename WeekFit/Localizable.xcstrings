    "coach.humanDecision.keepTheSessionEasyAndAvoidExtra.1569" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Sitzung einfach und vermeide zusätzlichen Stress."
          }
        },
