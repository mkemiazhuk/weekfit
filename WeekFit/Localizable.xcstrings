    "coach.section.heatWhy.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wärme kann die Durchblutung, die Muskelentspannung und den Übergang in den Erholungsmodus fördern. Die anschließende Flüssigkeitszufuhr sorgt dafür, dass die Einheit zur Unterstützung der Erholung wird und nicht zu zusätzlichem Stress."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heat can help circulation, muscle relaxation and the transition into recovery mode. Hydration afterwards is what turns the session into recovery support rather than extra stress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calor puede ayudar a la circulación, relajar músculos y la transición al modo recuperación. La hidratación después convierte la sesión en apoyo de recuperación, no en estrés extra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaleur peut aider la circulation, la détente musculaire et la transition vers le mode récupération. L’hydratation ensuite transforme la séance en soutien à la récupération plutôt qu’en stress supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il calore può aiutare la circolazione, il rilassamento muscolare e la transizione verso la modalità di recupero. L'idratazione successiva è ciò che trasforma la sessione in supporto al recupero piuttosto che in stress aggiuntivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱は血行、筋肉のリラックス、回復モードへの移行を助けることができます。その後の水分補給が、セッションを追加のストレスではなく回復サポートに変えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열은 혈액순환, 근육 이완, 회복 모드 전환에 도움을 줄 수 있습니다. 이후 수분 보충은 운동 세션을 추가적인 스트레스가 아닌 회복 지원으로 바꿔줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciepło może wspierać krążenie, rozluźnienie mięśni i przejście w tryb regeneracji. Nawodnienie potem zamienia sesję w wsparcie regeneracji, a nie dodatkowy stres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тепло может помочь кровообращению, расслаблению мышц и переходу в восстановление. Вода после него превращает тренировку в поддержку, а не в дополнительный стресс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热量摄入有助于促进血液循环、放松肌肉，并助力身体进入恢复状态。随后补充水分，则可将锻炼过程转化为恢复支持，而非增加额外压力。"
          }
        }
      }
    },
