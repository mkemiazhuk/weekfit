          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la séance facile et évitez le stress supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga la sessione facile e evita stress extra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションを簡単に保ち、余計なストレスを避けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션을 쉽게 진행하고 추가적인 스트레스를 피하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
