    "coach.proposal.guidance.morningFuelGentleRecovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung ist weich - beginnen Sie mit einem einfachen Protein-Vorwärtsfrühstück und halten Sie die Portionen sanft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
