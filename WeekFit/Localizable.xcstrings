    "insights.vm.learnings.sleepImproved.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf hat sich in letzter Zeit verbessert, was der Erholung mehr Raum geben kann, um stark zu bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep has improved recently, which may give recovery more room to stay strong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño ha mejorado recientemente, lo que puede dar más margen a la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil s'est amélioré récemment, ce qui peut laisser plus de marge à la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno è migliorato di recente, che può dare il recupero più spazio per rimanere forte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眠りは最近改善され、回復に強い滞在するより多くの部屋を与えるかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면은 최근에 개선되어 더 많은 방을 회복 할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen poprawił się ostatnio, co może dać regeneracji więcej zapasu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон недавно улучшился — это может дать восстановлению больше запаса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠质量近期有所改善——这或可为身体恢复提供更多储备。"
          }
        }
      }
    },
