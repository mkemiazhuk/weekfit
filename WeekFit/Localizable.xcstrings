    "coach.rationale.protectMainEffort.messageFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is the key workload today. Keep this %2$@ relaxed so you preserve legs and fueling for the main effort."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — главная нагрузка сегодня. Держите %2$@ спокойно, чтобы сохранить силы и качество движения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@是当今的关键工作负载。让这款%2$@保持放松，这样您就可以保留双腿，为主要工作加油。"
          }
        }
      }
    },
    "coach.rationale.protectMainEffort.title": {
