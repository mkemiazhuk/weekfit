    "termsPrivacy.legal.warranty.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit wird „wie besehen“ und „wie verfügbar“ bereitgestellt, ohne Garantie für unterbrechungsfreien, fehlerfreien, vollständig genauen oder für jede Situation geeigneten Betrieb."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit is provided as is and as available, without guarantees that the app will always be uninterrupted, error-free, fully accurate, or suitable for every individual situation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit se ofrece tal cual y según disponibilidad, sin garantías de acceso ininterrumpido, ausencia de errores, plena exactitud o idoneidad para cada situación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit est fourni en l'état et selon disponibilité, sans garantie d'accès ininterrompu, d'absence d'erreurs, de précision totale ou d'adéquation à chaque situation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit è fornito “così com’è” e “come disponibile”, senza garanzie di funzionamento ininterrotto, privo di errori, sempre accurato o adatto a ogni situazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは「現状有姿」「利用可能な範囲」で提供され、常に中断なく、エラーなく、完全に正確で、すべての状況に適しているとは保証されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 ‘있는 그대로’ ‘이용 가능한 범위’로 제공되며, 항상 중단 없이, 오류 없이, 완전히 정확하거나 모든 상황에 적합함을 보장하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit jest dostarczany „tak jak jest” i „w miarę dostępności”, bez gwarancji ciągłości, braku błędów, pełnej dokładności ani dopasowania do każdej sytuacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit предоставляется как есть и по мере доступности, без гарантий, что приложение всегда будет работать без перебоев, ошибок, с полной точностью или подходить для каждой индивидуальной ситуации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 按现有状态及可获取范围提供，且不保证该应用程序始终能够无故障、无错误地运行，亦不保证其具备完全精度或适用于每种个性化场景。"
          }
        }
      }
    },
    "termsPrivacy.legal.warranty.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheits-, Aktivitäts-, Schlaf-, Ernährungs-, Hydrations- und Erholungsdaten können je nach Gerät, Berechtigungen, Drittanbietern und Apple Health-Verfügbarkeit verzögert, unvollständig, geschätzt oder nicht verfügbar sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health, activity, sleep, nutrition, hydration, and recovery data may be delayed, incomplete, estimated, or unavailable depending on your device, permissions, third-party sources, and Apple Health data availability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de salud, actividad, sueño, nutrición, hidratación y recuperación pueden retrasarse, estar incompletos, ser estimaciones o no estar disponibles según dispositivo, permisos, fuentes externas y Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de santé, activité, sommeil, nutrition, hydratation et récupération peuvent être retardées, incomplètes, estimées ou indisponibles selon l'appareil, les autorisations, les sources tierces et Apple Health."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati salute, attività, sonno, nutrizione, idratazione e recupero possono essere ritardati, incompleti, stimati o non disponibili a seconda di dispositivo, permessi, terze parti e Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康、アクティビティ、睡眠、栄養、水分、回復データは、デバイス、権限、第三者、Apple Healthの可用性により遅延、不完全、推定、利用不可になる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강, 활동, 수면, 영양, 수분, 회복 데이터는 기기, 권한, 제3자, Apple Health 가용성에 따라 지연·불완전·추정·미제공일 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane zdrowia, aktywności, snu, odżywiania, nawodnienia i regeneracji mogą być opóźnione, niekompletne, szacunkowe lub niedostępne — zależnie od urządzenia, uprawnień, źródeł i Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные здоровья, активности, сна, питания, гидратации и восстановления могут задерживаться, быть неполными, оценочными или недоступными в зависимости от устройства, разрешений, сторонних источников и доступности данных Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康、活动、睡眠、营养、水分补充及恢复相关数据可能因所用设备、权限设置、第三方数据源以及 Apple Health 数据可用性而存在延迟、不完整、采用估算值或无法获取的情况。"
          }
        }
      }
    },
