    "onboarding.v12.understanding.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach passt Training und Ernährung an, wenn sich Ihre Erholung ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach adjusts training and nutrition when your recovery changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach ajusta entrenamiento y nutrición cuando cambia su recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach ajuste entraînement et nutrition quand votre récupération change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach adatta allenamento e nutrizione quando cambia il recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復が変わるとCoachがトレーニングと栄養を調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복이 바뀌면 Coach가 훈련과 영양을 조정합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach dostosowuje trening i odżywianie, gdy zmienia się regeneracja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренер подстраивает тренировки и питание, когда меняется восстановление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您的恢复情况发生变化时，教练会相应调整训练方案与营养方案。"
          }
        }
      }
    },
    "onboarding.v12.understanding.body.fatLoss" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Erholung sinkt, schützt Coach das Defizit — Training verschiebt sich, Mahlzeiten straffen sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When recovery drops, Coach protects the cut — training moves, meals tighten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando baja la recuperación, Coach protege el déficit — el entrenamiento se mueve, las comidas se ajustan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la récupération baisse, Coach protège le déficit — l'entraînement bouge, les repas se resserrent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il recupero cala, Coach protegge il deficit — l’allenamento si sposta, i pasti si stringono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復が下がるとCoachは減量を守り—トレーニングは動き、食事は引き締まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복이 떨어지면 Coach가 감량을 지킵니다 — 훈련은 이동하고 식사는 타이트해집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy regeneracja spada, Coach chroni redukcję — trening się przesuwa, posiłki się zacieśniają."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда восстановление падает, Тренер защищает дефицит — тренировка сдвигается, еда уплотняется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当恢复能力下降时，教练会弥补这一缺口——训练安排将调整，饮食安排也将紧凑化。"
          }
        }
      }
    },
    "onboarding.v12.understanding.body.maintenance" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Erholung sinkt, schreibt Coach den Tag neu — Training verschiebt sich, Mahlzeiten passen sich an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When recovery drops, Coach rewrites today — training moves, meals adapt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando baja la recuperación, Coach reescribe hoy — el entrenamiento se mueve, las comidas se adaptan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la récupération baisse, Coach réécrit aujourd'hui — l'entraînement bouge, les repas s'adaptent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il recupero cala, Coach riscrive oggi — l’allenamento si sposta, i pasti si adattano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復が下がるとCoachは今日を書き換え—トレーニングは動き、食事は適応。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복이 떨어지면 Coach가 오늘을 다시 씁니다 — 훈련은 이동하고 식사는 적응합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy regeneracja spada, Coach przepisuje dziś — trening się przesuwa, posiłki się dostosowują."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда восстановление падает, Тренер переписывает день — тренировка сдвигается, еда меняется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当恢复进度下降时，教练会重新规划当日安排——训练时间调整，饮食方案变更。"
          }
        }
      }
    },
    "onboarding.v12.understanding.body.muscleGain" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Erholung sinkt, schützt Coach den Aufbau — Kraft wartet, Energie bleibt."
          }
        },
        "en" : {
