          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側にほうれん草とキノアの上にサーモンをサーブ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "옆의 척추뼈와 함께 퀴노아에 연어를 세웁니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaj łososia na komosie ze szpinakiem z boku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подавайте лосось на киноа со шпинатом сбоку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将三文鱼从侧面铺在藜麦菠菜上。"
          }
        }
      }
    },
    "meals.starter.salmonRoll.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie ein Blatt Nori auf eine Bambusmatte und verteilen Sie eine gleichmäßige Schicht gewürzten Reis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay a sheet of nori on a bamboo mat and spread an even layer of seasoned rice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque una hoja de nori en esterilla de bambú y extienda una capa uniforme de arroz sazonado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez une feuille de nori sur un tapis de bambou et étalez une couche uniforme de riz assaisonné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posare un foglio di nori su un tappeto di bambù e diffondere uno strato pari di riso condito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "竹のマットの上にノリのシートを敷き、さらには調味料の米の層を広げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대나무 매트에 대한 nori의 시트와 계절 쌀의 층을 확산."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połóż arkusz nori na macie bambusowej i rozprowadź równą warstwę ryżu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положите лист нори на коврик и равномерно распределите приправленный рис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一张海苔铺在竹垫上，然后均匀地铺上一层调味米。"
          }
        }
      }
    },
    "meals.starter.salmonRoll.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Streifen von Lachs und Avocado entlang der Mittellinie hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
