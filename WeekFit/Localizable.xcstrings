      }
    },
    "privacy.settings.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T1 hält Gesundheits- und Wellnessdaten unter Ihrer Kontrolle. Verwalten Sie Apple Health Berechtigungen in Apple Health oder iOS-Einstellungen und entfernen Sie App-Daten von Ihrem Gerät, wann immer Sie es benötigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit keeps health and wellness data under your control. Manage Apple Health permissions in Apple Health or iOS Settings, and remove app data from your device whenever you need."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit mantiene los datos de salud y bienestar bajo su control. Gestione los permisos de Apple Health en Apple Health o Ajustes de iOS, y elimine los datos de la app de su dispositivo cuando lo necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit laisse les données de santé et de bien-être sous votre contrôle. Gérez les autorisations Apple Health dans Apple Health ou Réglages iOS, et supprimez les données de l'app de votre appareil quand vous le souhaitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit mantiene i dati di salute e benessere sotto il vostro controllo. Gestisci le autorizzazioni Apple Health in Impostazioni Apple Health o iOS e rimuovi i dati dell'app dal tuo dispositivo ogni volta che hai bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit は、健康とウェルネスのデータを管理下に置きます。 Apple Health または iOS 設定で Apple Health 権限を管理し、必要に応じていつでもデバイスからアプリ データを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit는 건강 및 웰빙 데이터를 귀하가 관리할 수 있도록 유지합니다. Apple Health 또는 iOS 설정에서 Apple Health 권한을 관리하고 필요할 때마다 기기에서 앱 데이터를 제거하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit pozostawia dane zdrowia i wellness pod Państwa kontrolą. Zarządzaj uprawnieniami Apple Health w Apple Health lub Ustawieniach iOS i usuwaj dane aplikacji z urządzenia, gdy zajdzie potrzeba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit оставляет данные о здоровье и самочувствии под вашим контролем. Разрешениями Apple Health можно управлять в Apple Health или настройках iOS, а данные приложения можно удалить с устройства, когда это нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 让您自主掌控您的健康与身体状况相关数据。您可通过 Apple Health 或 iOS 设置管理相关权限，并在需要时从设备中删除该应用程序的数据。"
          }
        }
      }
    },
