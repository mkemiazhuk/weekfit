        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su cuerpo muestra signos de carga acumulada. Priorice recuperación, hidratación y calidad del sueño hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre corps montre des signes de charge accumulée. Priorisez récupération, hydratation et qualité du sommeil aujourd'hui."
