    "coach.priority.goodExecutionIsCoachingTooKeepThe.3597" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gute Ausführung ist auch Coaching: Halten Sie die Sitzung nützlich, ohne sie in zusätzlichen Stress zu verwandeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good execution is coaching too: keep the session useful without turning it into extra stress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buena ejecución también es coaching: mantenga la sesión útil sin convertirla en estrés extra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bonne exécution, c'est aussi du coaching : gardez la séance utile sans en faire un stress supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una buona esecuzione è anche coaching: mantieni la sessione utile senza trasformarla in stress extra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "良い実行はコーチングでもあります：セッションを有用なままに保ち、余計なストレスに変えないようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋은 실행도 코칭입니다: 세션을 유용하게 유지하되 추가적인 스트레스가 되지 않도록 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobra realizacja to też coaching: utrzymaj sesję użyteczną, nie zamieniając jej w dodatkowy stres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хорошее выполнение — тоже работа тренера: держите тренировку полезной, без лишнего стресса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "良好的执行同样属于教练技巧：在确保课程有效性的同时，避免将其变成额外的压力源。"
          }
        }
      }
    },
    "coach.priority.goodPreparationStartsBeforeTheOfficialPrep.4506" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gute Vorbereitung beginnt vor dem offiziellen Vorbereitungszeitraum: Vermeide es, Energie zu verbrauchen, die Sie später benötigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good preparation starts before the official prep window: avoid spending energy you want available later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buena preparación empieza antes de la ventana oficial: evite gastar energía que quiere disponible después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bonne préparation commence avant la fenêtre officielle : évitez de dépenser l'énergie que vous voulez disponible plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una buona preparazione inizia prima della finestra ufficiale di preparazione: evita di spendere energia che vuoi avere disponibile più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "良い準備は公式の準備期間の前から始まります：後で使いたいエネルギーを使わないようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋은 준비는 공식 준비 기간 전에 시작됩니다: 나중에 사용하고 싶은 에너지를 낭비하지 마세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobre przygotowanie zaczyna się przed oficjalnym oknem: unikaj wydawania energii, którą chcesz mieć później."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хорошая подготовка начинается до официального окна: не тратьте энергию, которая понадобится позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充分的准备应从正式准备期之前就开始：避免消耗那些你希望留待之后使用的精力。"
          }
        }
      }
    },
    "coach.priority.goodReadinessIsUsefulButTheBest.3558" : {
