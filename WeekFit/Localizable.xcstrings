    "meals.starter.japaneseBreakfast.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwärmen Sie den gekochten braunen Reis bis zum Dämpfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm the cooked brown rice until steaming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caliente el arroz integral cocido hasta que humee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réchauffez le riz complet cuit jusqu'à ce qu'il fume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaldare il riso integrale cotto fino al vapore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蒸すまで玄米を温める。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수증기까지 요리 한 갈색 쌀을 데웁니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgrzej ugotowany brązowy ryż, aż zacznie parować."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подогрейте варёный коричневый рис до горячего пара."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将煮至呈褐色的米饭加热至冒热蒸汽。"
          }
        }
      }
    },
    "meals.starter.japaneseBreakfast.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnell den Spinat welken und die Eier weich kochen (pochiert oder leicht gebraten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quickly wilt the spinach and soft-cook the eggs (poached or lightly fried)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marchite el espinaca rápido y cocine los huevos suave (poché o fritos ligeros)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flétrissez rapidement les épinards et cuisez les œufs en douceur (pochés ou légèrement frits)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulire rapidamente gli spinaci e cotto morbido le uova (poached o leggermente fritto)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほうれん草をすばやく拭き、卵を柔らかく調理します(ポーチまたは軽く揚げ)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신속하게 회전과 부드러운 코크 계란 (조각 또는 가볍게 튀긴)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybko zwiędź szpinak i delikatnie ugotuj jajka (w koszulce lub na miękko)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстро припустите шпинат и приготовьте яйца всмятку или лёгкой глазуньей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将菠菜快速焯水，并将鸡蛋软熟（水煮或浅煎）。"
          }
        }
      }
    },
    "meals.starter.japaneseBreakfast.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordne Reis, Eier und Spinat in einer Schüssel an; Träne Nori über der Oberseite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrange rice, eggs, and spinach in a bowl; tear nori over the top."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque arroz, huevos y espinaca en un bol; desmenuce nori encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposez riz, œufs et épinards dans un bol ; émiettez le nori dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disporre riso, uova e spinaci in una ciotola; strappare nori sopra la parte superiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "米、卵、ほうれん草をボウルに並べ替え、ノリを上に引き裂く。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그릇에 볶음밥, 계란, 그리고 시금치; 정상에 눈물 nori."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ułóż ryż, jajka i szpinak w misce; posyp rozdrobnionym nori."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выложите в миску рис, яйца и шпинат; сверху порвите нори."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将米饭、鸡蛋和菠菜放入碗中；将海苔撕成碎片铺在顶部。"
          }
        }
      }
    },
    "meals.starter.japaneseBreakfast.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden Sie mit einem Nieselregen Sojasauce und servieren Sie warm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish with a drizzle of soy sauce and serve warm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine con un chorrito de salsa de soja y sirva tibio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez avec un filet de sauce soja et servez tiède."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finire con un goccio di salsa di soia e servire caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "醤油の小さじで仕上げ、温かみのある味わい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간장의 덩굴과 따뜻한 봉사."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrop soją sos i podaj ciepłe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбрызните соевым соусом и подавайте тёплым."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后淋上少许酱油，趁热上桌。"
          }
        }
      }
    },
    "meals.starter.japaneseBreakfast.title" : {
      "extractionState" : "manual",
      "localizations" : {
