    "coach.priority.veryLowSleepDuringAnEveningRecovery.4908": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very low sleep during an evening recovery block should steer the day toward recovery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень короткий сон во время вечернего восстановительного блока должен вести день к восстановлению."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在傍晚恢复期期间若出现极短睡眠，则次日有望恢复。"
          }
        }
      }
    },
    "coach.priority.whenReadinessIsLimitedAddingTrainingUsually.3088": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When readiness is limited, adding training usually costs more than it gives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда готовность ограничена, дополнительная тренировка обычно стоит больше, чем дает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当准备程度有限时，额外训练带来的收益通常往往不及其成本。"
          }
        }
      }
    },
    "coach.priority.yourFitnessDidNotDisappearOvernightThe.4563": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fitness did not disappear overnight. The bottleneck is sleep, so I would stop chasing extra work and make tonight the intervention."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма не исчезла за ночь. Узкое место — сон, поэтому я бы перестал догонять работу и сделал сегодняшний вечер главным вмешательством."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这种状态并未在一夜之间消失。而最狭窄的环节便是睡眠，因此我本可以不再紧赶进度，将今晚视为关键的干预时机。"
          }
        }
      }
    },
    "coach.priority.yourStateIsNeutral.3168": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your state is neutral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние нейтральное."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态为中性。"
          }
        }
      }
    },
    "coach.priority.youVeAlreadyAccumulatedEnoughLoadToday.4890": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already accumulated enough load today. Use stretching and breathing to transition into recovery mode, support sleep quality%@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня нагрузки уже достаточно. Используйте растяжку и дыхание, чтобы перейти к восстановлению и поддержать качество сна%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如今您的训练负荷已相当大。请运用拉伸与呼吸法，进入恢复阶段，以保障睡眠质量%@。"
          }
        }
      }
    },
