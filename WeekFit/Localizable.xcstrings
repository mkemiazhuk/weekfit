    "coach.eveningRecap.feeling.reaction.tired.quiet" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein weicher Abend klingt richtig. Ruhe ohne Druck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A soft evening sounds right. Rest without pressure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarde suave encaja. Descansa sin presión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un soir doux semble indiqué. Reposez-vous sans pression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una serata morbida suona bene. Riposare senza pressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソフトな夕暮れが右に聞こえます。 圧力なしで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 저녁 소리. 압력 없이 나머지."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łagodny wieczór brzmi dobrze. Odpoczywaj bez presji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спокойный вечер — хороший выбор. Отдыхайте без давления."
