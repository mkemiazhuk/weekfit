            "value" : "Skipping the recovery step makes today's work more expensive tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltarse el paso de recuperación hace el trabajo de hoy más caro mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorer l'étape de récupération rend le travail d'aujourd'hui plus coûteux demain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltare la fase di recupero rende il lavoro di oggi più costoso domani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復のステップを省くと、今日の作業は明日もっと高くつく。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복 단계를 건너뛰면 오늘의 작업이 내일 더 비싸집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pominięcie kroku regeneracji sprawia, że dzisiejsza praca jutro kosztuje więcej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если пропустить восстановление, сегодняшняя работа завтра обойдется дороже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若忽视修复工作，今日的劳作明日将付出更高代价。"
          }
        }
      }
    },
