    "today.aiCoach.walkHighExpenditureFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktueller Zustand: Sehr hoher Energieverbrauch heute (%lld kcal). Halten Sie diesen Walk strikt niedrig intensiv. Steigern Sie NICHT die Herzfrequenz; fokussieren Sie auf aktive Entspannung."
