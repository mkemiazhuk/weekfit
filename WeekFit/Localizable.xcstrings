          "stringUnit" : {
            "state" : "translated",
            "value" : "Season with salt and black pepper, then serve right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sazone con sal y pimienta negra y sirva al momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assaisonnez de sel et poivre noir, puis servez tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condite con sale e pepe nero, poi servite subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "塩と黒胡椒の季節は、すぐに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소금과 검은 후추와 계절, 그 다음 바로 봉사."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopraw solą i pieprzem i podaj od razu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посолите, поперчите и сразу подавайте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加盐和胡椒，随即上桌。"
          }
        }
      }
    },
    "meals.starter.eggsOatmeal.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen Sie den Haferflocken mit Wasser oder Milch über mittlerer Hitze bis cremig, etwa 4-5 Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook the oatmeal with water or milk over medium heat until creamy, about 4–5 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine la avena con agua o leche a fuego medio hasta cremosa, unos 4–5 min."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez l'avoine avec eau ou lait à feu moyen jusqu'à crémeux, environ 4–5 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuocere l'avena con acqua o latte a fuoco medio fino a creme, circa 4-5 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4〜5分程度、クリームまで、水や牛乳でオートミールを調理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크림까지 중간 열에 물 또는 우유를 쿡, 약 4 ~ 5 분."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotuj owsiankę na wodzie lub mleku na średnim ogniu do kremowości, ok. 4–5 min."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сварите овсянку на воде или молоке на среднем огне до кремовой текстуры, 4–5 минут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将燕麦片与水或牛奶一同置于中火上烹煮，直至质地呈奶油状，约需 4–5 分钟。"
          }
        }
      }
    },
    "meals.starter.eggsOatmeal.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer Antihaftpfanne die Eier mit einer Prise Salz weich krabbeln oder schonend braten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a non-stick pan, soft-scramble or gently fry the eggs with a pinch of salt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sartén antiadherente, revuelva o fría suavemente los huevos con una pizca de sal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans une poêle antiadhésive, brouillez ou faites frire doucement les œufs avec une pincée de sel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In una padella antiaderente, friggere delicatamente le uova con un pizzico di sale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノンスティックパン、ソフトスクランブル、または塩のピンチで卵を炒める。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비 스틱 팬, 부드러운 스크램블 또는 부드럽게 소금의 꼬치와 달걀을 튀긴다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na patelni z powłoką delikatnie usmaż lub wymieszaj jajka ze szczyptą soli."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На антипригарной сковороде мягко взболтайте или аккуратно пожарьте яйца с щепоткой соли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在不粘锅中，加入少许盐，将鸡蛋轻柔地炒散或简单煎熟。"
          }
        }
      }
    },
    "meals.starter.eggsOatmeal.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löffel den Haferflocken in eine Schüssel und lege die Eier oben, während beide warm sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoon the oatmeal into a bowl and place the eggs on top while both are warm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponga la avena en un bol y coloque los huevos encima mientras estén calientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez l'avoine dans un bol et posez les œufs dessus tant que tout est chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoon l'avena in una ciotola e mettere le uova in cima mentre entrambi sono caldi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボウルにオートミールをスプーンし、卵を上に配置し、両方が暖かい間。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그릇에 오트밀을 숟가락하고 두 개가 따뜻해지는 동안 위에 달걀을 배치합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełóż owsiankę do miski i połóż jajka na wierzchu, póki ciepłe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выложите овсянку в миску и сверху положите яйца, пока всё ещё тёплое."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将燕麦放入碗中，趁燕麦尚温热时，将鸡蛋放在上面。"
          }
        }
      }
    },
    "meals.starter.eggsOatmeal.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden Sie mit Blaubeeren und servieren Sie sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish with blueberries and serve immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine con arándanos y sirva al momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez avec des myrtilles et servez immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finire con mirtilli e servire immediatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブルーベリーで仕上げ、すぐに機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "블루베리와 함께 마무리 즉시 봉사."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokończ borówkami i podaj od razu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте чернику и сразу подавайте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后加入蓝莓，立即上桌。"
          }
        }
      }
    },
    "meals.starter.englishBreakfast.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toast das Brot und halten Sie es warm, während Sie den Rest kochen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toast the bread and keep it warm while you cook the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tueste el pan y manténgalo caliente mientras cocina el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites griller le pain et gardez-le au chaud pendant le reste de la préparation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tostare il pane e tenerlo caldo mentre si cucina il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パンをトーストし、残りを調理しながら温かく保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빵을 토스트하고 휴식을 요리하면서 따뜻하게 유지하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opiecz chleb i utrzymuj ciepły podczas reszty przygotowań."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поджарьте хлеб и держите тёплым, пока готовите остальное."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将面包烤好并保持温热，同时准备其他食材。"
          }
        }
      }
    },
    "meals.starter.englishBreakfast.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauté die Pilze und Tomaten in einer leicht geölten Pfanne bis zur Ausschreibung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauté the mushrooms and tomatoes in a lightly oiled pan until tender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltee champiñones y tomates en sartén con poco aceite hasta tiernos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites sauter champignons et tomates dans une poêle légèrement huilée jusqu'à tendreté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versare i funghi e i pomodori in una padella leggermente oliata fino a tenera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "きのことトマトを軽く油を塗ったパンで柔らかくなる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauté 버섯과 토마토는 부드러운 때까지 가볍게 기름진 냄비에."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaż grzyby i pomidory na lekko natłuszczonej patelni do miękkości."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обжарьте грибы и помидоры на слегка смазанной сковороде до мягкости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将蘑菇与番茄放入略刷油的煎锅中，煎至变软。"
          }
        }
      }
    },
    "meals.starter.englishBreakfast.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwärmen Sie den Schinken und braten oder klettern Sie die Eier nach Ihren Wünschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm the ham and fry or scramble the eggs to your liking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caliente el jamón y fría o revuelva los huevos a su gusto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réchauffez le jambon et faites frire ou brouillez les œufs à votre goût."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaldare il prosciutto e friggere o strapazzare le uova a vostro piacimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハムを温め、炒め、卵をあなたの好みにスクランブルします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "햄과 튀김을 따뜻하게하거나 계란을 긁어."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgrzej szynkę i usmaż lub wymieszaj jajka według uznania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подогрейте ветчину и пожарьте или взболтайте яйца по вкусу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将火腿加热，并根据口味将鸡蛋煎熟或翻炒。"
          }
        }
      }
    },
    "meals.starter.englishBreakfast.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie die Eier, Schinken, Pilze, Tomaten und Toast zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plate the eggs, ham, mushrooms, tomatoes, and toast together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque huevos, jamón, champiñones, tomates y tostada juntos."
          }
        },
        "fr" : {
