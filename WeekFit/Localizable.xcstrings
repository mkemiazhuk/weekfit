    "support.guides.item19.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit funktioniert ohne Apple Watch, aber Workouts, Schlaf, Aktivität, Erholung, HRV und Ruheherzfrequenz sind meist besser, wenn Apple Watch oder ein Tracker Daten in Apple Health schreibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit works without Apple Watch, but workouts, sleep, activity, recovery, HRV, and resting heart rate are usually better when Apple Watch or another tracker writes data to Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit funciona sin Apple Watch, pero entrenamientos, sueño, actividad, recuperación, HRV y frecuencia en reposo suelen ser mejores cuando Apple Watch u otro rastreador escribe en Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit fonctionne sans Apple Watch, mais entraînements, sommeil, activité, récupération, HRV et fréquence au repos sont en général meilleurs quand Apple Watch ou un autre tracker écrit dans Apple Health."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit funziona senza Apple Watch, ma allenamenti, sonno, attività, recupero, HRV e frequenza a riposo sono di solito migliori con Apple Watch o tracker in Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchなしでも使えますが、ワークアウト、睡眠、アクティビティ、回復、HRV、安静時心拍は、Apple WatchなどがApple Healthに書き込むと通常より良くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch 없이도 되지만, 운동·수면·활동·회복·HRV·안정 심박은 Apple Watch 등이 Apple Health에 기록할 때 보통 더 좋습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit działa bez Apple Watch, ale treningi, sen, aktywność, regeneracja, HRV i tętno spoczynkowe są zwykle lepsze, gdy Apple Watch lub inny tracker zapisuje dane w Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit работает без Apple Watch, но тренировки, сон, активность, восстановление, HRV и пульс в покое обычно лучше, когда Apple Watch или другой трекер записывает данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 无需 Apple Watch 即可运行，但若由 Apple Watch 或其他运动监测设备记录数据，其训练效果、睡眠状况、活动量、恢复情况、HRV 及静息心率等指标通常会更佳。"
          }
        }
      }
    },
    "support.guides.item19.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch nutzen, wenn vorhanden"
          }
        },
        "en" : {
