    "onboarding.intro.plan.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Workouts, Erholung, Mahlzeiten und Gewohnheiten hinzu, damit die Empfehlung auf den Tag vorbereitet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add workouts, recovery, meals, and habits so guidance can prepare for the day ahead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada entrenamientos, recuperación, comidas y hábitos para que la orientación prepare el día siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez entraînements, récupération, repas et habitudes pour que les conseils préparent la journée à venir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi allenamenti, recupero, pasti e abitudini così la guida può prepararsi alla giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウト、回復、食事、習慣を追加し、ガイダンスが一日に備えられるように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동, 회복, 식사, 습관을 추가해 안내가 하루를 준비할 수 있게 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj treningi, regenerację, posiłki i nawyki, aby wskazówki mogły przygotować nadchodzący dzień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте тренировки, восстановление, питание и привычки — чтобы подсказки готовились к дню заранее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加训练计划、恢复方案、膳食安排及生活习惯，以便指导人员为接下来的日子做好充分准备。"
          }
        }
      }
    },
