    "coach.treatThisAsRecoverySupportNotAChallengeKeep" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Erholungsunterstützung sehen, nicht als Herausforderung. Angenehm bleiben und stoppen, bevor es stressig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treat this as recovery support, not a challenge. Keep it comfortable and stop before it feels stressful."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trátelo como apoyo de recuperación, no como reto. Mantenga la comodidad y pare antes de que resulte estresante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considérez cela comme un soutien récupération, pas un défi. Restez confortable et arrêtez avant que cela devienne stressant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo tratti come supporto al recupero, non sfida. Resti comodo e si fermi prima dello stress."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復サポートとして扱い、挑戦ではありません。快適に、ストレスになる前に止めて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복 지원으로 보고 도전으로 보지 마세요. 편안히, 부담 전에 멈추세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traktuj to jako wsparcie regeneracji, nie wyzwanie. Trzymaj komfort i zatrzymaj się, zanim stanie się stresujące."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспринимайте это как поддержку восстановления, а не вызов. Держите комфортно и остановитесь до стресса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将此视为对恢复过程的支持，而非一种挑战。保持舒适状态，并在感到压力前及时停止。"
          }
        }
      }
    },
