    "coach.rationale.arriveSettledHeat.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wird Hitzestress hinzufügen. Halten Sie dieses %2$@ einfach, damit Sie hydratisiert, ruhig und nicht bereits belastet starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will add heat stress. Keep this %2$@ easy so you start hydrated, calm, and not already taxed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ añadirá estrés por calor. Mantenga este %2$@ suave para empezar hidratado, calmado y sin fatiga previa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ajoutera un stress thermique. Gardez ce %2$@ facile pour arriver hydraté, calme et sans fatigue préalable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ aggiungerà stress da calore. Mantieni questo %2$@ facile così inizi idratato, calmo e non già provato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は熱ストレスを加えます。この%2$@は簡単にして、最初から水分を十分に取り、落ち着いていて、すでに負担を受けていない状態にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@는 열 스트레스를 추가할 것입니다. 이 %2$@을 쉽게 유지하여, 수분이 충분하고, 차분하며, 이미 지치지 않은 상태로 시작하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ doda stres cieplny. Utrzymuj ten %2$@ na łatwym poziomie, by zacząć nawodniony, spokojny i bez wcześniejszego zmęczenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ добавит тепловой стресс. Держите эту %2$@ легкой, чтобы начать гидратированным, спокойным и без лишней нагрузки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@会增加热应力。保持这款%2$@轻松，这样您就可以开始补充水分、保持冷静，而且不会过税。"
          }
        }
      }
    },
    "coach.rationale.arriveSettledHeat.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ankommen, sich auf die Hitze einstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrive settled for heat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
