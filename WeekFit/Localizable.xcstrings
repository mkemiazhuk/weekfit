            "state" : "translated",
            "value" : "今晚不宜进行无意义的消耗性活动。好好休息——明天的应对之策将更为重要。"
          }
        }
      }
    },
    "onboarding.v12.ready.subtitle.fatLoss" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist nicht der Tag für mehr Intensität. Es ist der Tag, gut zu erholen, damit morgen zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today isn't the day to push harder. It's the day to recover well so tomorrow counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no es el día de exigir más. Es el día de recuperarse bien para que mañana cuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd'hui n'est pas le jour de pousser plus fort. C'est le jour de bien récupérer pour que demain compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi non è il giorno per spingere di più. È il giorno per recuperare bene così domani conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はさらに押す日ではありません。よく回復して明日を活かす日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 더 밀어붙일 날이 아닙니다. 잘 회복해 내일을 살리는 날입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś nie dzień na mocniejsze pchanie. To dzień dobrej regeneracji, by jutro się liczyło."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня не день для перегруза. Восстановитесь — завтра будет важнее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天不是过度劳累的日子。好好休息——明天会更好。"
          }
        }
      }
    },
    "onboarding.v12.ready.subtitle.maintenance" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist nicht der Tag zum Erzwingen. Erholen Sie sich gut, damit morgen zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today isn't the day to force it. Recover well so tomorrow counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no es el día de forzar. Recupérese bien para que mañana cuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
