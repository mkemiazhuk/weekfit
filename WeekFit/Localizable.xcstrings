    "onboarding.v4.way.proactive.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen Sie die Woche, bevor sie beginnt, und erstellen Sie Mahlzeiten, die zu Ihren Zielen passen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan your week before it happens, and build meals that fit your goals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifique la semana antes de que llegue y cree comidas acordes a sus objetivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez la semaine avant qu'elle n'arrive et composez des repas adaptés à vos objectifs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica la settimana prima che inizi e crea pasti adatti ai tuoi obiettivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週が始まる前に計画し、目標に合う食事を作りましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주가 시작되기 전에 계획하고 목표에 맞는 식사를 만드세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanuj tydzień z wyprzedzeniem i buduj posiłki dopasowane do celów."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планируйте неделю заранее и собирайте блюда под свои цели."
