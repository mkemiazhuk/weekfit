        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 분석: 물 %@ 리터만 기록, %lld회 운동 완료. 저강도도 혈관 탈수를 키웁니다. 저녁까지 기다리지 말고 — 지금 350밀리리터 기록."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza dnia: zalogowano tylko %@ L wody przy %lld treningach. Lekki wolumen zwiększa odwodnienie naczyniowe. Nie czekaj do wieczora — zaloguj teraz 350 ml."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За день записано только %@ л воды при %lld тренировках. Стоит выпить 350 мл прямо сейчас, а не ждать вечера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日分析：只记录了 %@ 升水，却完成了 %lld 次训练。低强度也会加重缺水——现在就记 350 毫升。"
          }
        }
      }
    },
