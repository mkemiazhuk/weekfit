    "onboarding.intro.meals.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teller fotografieren für Kalorien und Zutaten in Gramm, Mahlzeiten aus der Bibliothek oder Getränke loggen — Nutrition bleibt mit Coach synchron."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snap a plate for calories and ingredients in grams, build meals from the library, or log drinks — nutrition stays in sync with Coach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografía un plato para calorías e ingredientes en gramos, usa la biblioteca o registra bebidas — la nutrición sigue a Coach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo d’une assiette pour calories et ingrédients en grammes, repas de la bibliothèque, ou boissons — la nutrition reste alignée avec Coach."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta un piatto per calorie e ingredienti in grammi, usa la libreria o registra bevande — la nutrizione resta allineata con Coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皿を撮ってカロリーとグラム単位の材料を、ライブラリの食事や飲み物も記録 — 栄養はCoachと同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접시를 찍어 칼로리와 그램 단위 재료를, 라이브러리 식사나 음료도 기록 — 영양은 Coach와 맞춰집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób zdjęcie talerza — kalorie i składniki w gramach; albo biblioteka i napoje. Nutrition zostaje zsynchronizowane z Coach."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сфотографируйте тарелку — калории и ингредиенты в граммах; или библиотека и напитки. Nutrition остаётся в синхроне с Coach."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍一盘菜得到热量与克数食材，也可用菜谱库或记录饮品——营养与 Coach 保持同步。"
          }
        }
      }
    },
