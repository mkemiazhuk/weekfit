    "support.guides.item09.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Workouts hinzu, die Sie wirklich machen wollen, und lassen Sie Raum für Erholung, Mahlzeiten, Wasser und Schlaf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the workouts you actually want to do, then leave space for recovery, meals, water, and sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada los entrenamientos que realmente quiere hacer y deje espacio para recuperación, comidas, agua y sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les entraînements que vous voulez vraiment faire, puis laissez de la place à la récupération, aux repas, à l'eau et au sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi gli allenamenti che vuoi davvero fare, lasciando spazio a recupero, pasti, acqua e sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当にやりたいワークアウトを追加し、回復、食事、水、睡眠の余地を残してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 하고 싶은 운동을 추가하고 회복, 식사, 물, 수면 여유를 두세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj treningi, które naprawdę chcesz wykonać, a potem zostaw miejsce na regenerację, posiłki, wodę i sen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте тренировки, которые действительно хотите сделать, и оставьте место для восстановления, питания, воды и сна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列出你真正想进行的训练项目，并为恢复期、饮食、饮水及睡眠留出适当时间。"
          }
        }
      }
    },
