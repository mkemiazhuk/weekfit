    "support.guides.item13.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie Plan, wenn etwas vor Ihnen liegt. Nutzen Sie Protokollieren, wenn es bereits passiert ist. Beides hilft Coach, Ihren Tag besser zu verstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Plan when something is ahead of you. Use logging when something already happened. Both help Coach understand your day better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Plan cuando algo está por delante. Registre cuando ya ocurrió. Ambos ayudan a Entrenador a entender mejor su día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Plan quand quelque chose est devant vous. Utilisez l'enregistrement quand c'est déjà passé. Les deux aident Coach à mieux comprendre votre journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Piano per ciò che è davanti. Usa il logging per ciò che è già accaduto. Entrambi aiutano Coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これからならプラン、すでに起きたなら記録。どちらもコーチが一日を理解するのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞일은 계획, 이미 일어난 일은 기록. 둘 다 코치 이해에 도움이 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj Plan, gdy coś jest przed Tobą. Loguj, gdy już się stało. Oba pomagają Trener lepiej zrozumieć dzień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте План, когда событие впереди. Используйте логирование, когда оно уже произошло. Оба варианта помогают Тренеру лучше понимать день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当某项事件即将发生时，请使用计划；当该事件已经发生时，请使用日志记录。这两种方式都能帮助教练更清晰地把握当日的情况。"
          }
        }
      }
    },
    "support.guides.item13.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorher planen, danach protokollieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan before, log after"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifique antes, registre después"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifier avant, enregistrer après"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica prima, registra dopo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前に計画、後に記録"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 계획, 나중에 기록"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planuj wcześniej, loguj później"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планируйте до, логируйте после"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事前规划，事后记录"
          }
        }
      }
    },
    "support.guides.item14.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie eigene Mahlzeiten, kombinieren Sie Zutaten und planen Sie Ernährung über den Tag. WeekFit verbindet Mahlzeiten mit Training, Erholung, Hydration und Energiebedarf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build your own meals, combine ingredients, and plan nutrition throughout the day. WeekFit helps connect meals with training, recovery, hydration, and energy needs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cree comidas, combine ingredientes y planifique la nutrición a lo largo del día. WeekFit conecta comidas con entrenamiento, recuperación, hidratación y necesidades energéticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez vos repas, combinez des ingrédients et planifiez la nutrition dans la journée. WeekFit relie les repas à l'entraînement, la récupération, l'hydratation et les besoins énergétiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea pasti, combina ingredienti e pianifica nutrizione durante la giornata. WeekFit collega pasti ad allenamento, recupero, idratazione ed energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の食事を作り、材料を組み合わせ、一日の栄養を計画。WeekFitは食事をトレーニング、回復、水分、エネルギー必要と結びつけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 식사를 만들고 재료를 조합해 하루 영양을 계획하세요. WeekFit은 식사를 훈련, 회복, 수분, 에너지 필요와 연결합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twórz posiłki, łącz składniki i planuj odżywianie w ciągu dnia. WeekFit łączy posiłki z treningiem, regeneracją, nawodnieniem i zapotrzebowaniem energetycznym."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собирайте собственные блюда, комбинируйте ингредиенты и планируйте питание в течение дня. WeekFit помогает связать еду с тренировками, восстановлением, водой и энергией."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随心搭配餐食、组合食材，并规划全天营养摄入。WeekFit 将餐食与训练、恢复、水分补充及能量需求有机结合。"
          }
        }
      }
    },
    "support.guides.item14.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahlzeiten aus Zutaten erstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create meals from ingredients"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cree comidas a partir de ingredientes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez des repas à partir d'ingrédients"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea pasti dagli ingredienti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "材料から食事を作成"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재료로 식사 만들기"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twórz posiłki ze składników"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте блюда из ингредиентов"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用食材烹饪餐食"
          }
        }
      }
    },
    "support.guides.item15.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahlzeiten gibt einen Überblick über Kalorien, Protein, Kohlenhydrate und Fette basierend auf Zutaten und Portionen — ohne kompliziertes Tracking."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meals gives you a high-level view of calories, protein, carbs, and fats based on ingredients and portions. It helps you understand meal balance without making food tracking too complicated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comidas ofrece una vista general de calorías, proteína, carbohidratos y grasas según ingredientes y porciones. Ayuda a entender el equilibrio sin complicar el seguimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repas donne une vue d'ensemble des calories, protéines, glucides et graisses selon ingrédients et portions. Cela aide à comprendre l'équilibre sans compliquer le suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasti offre una panoramica di calorie, proteine, carboidrati e grassi da ingredienti e porzioni, senza tracking troppo complicato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事は材料と分量に基づくカロリー、タンパク質、炭水化物、脂質の概要を — 複雑な記録なしで — 提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사는 재료·분량 기반 칼로리, 단백질, 탄수화물, 지방 개요를 — 복잡한 기록 없이 — 제공합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiłki daje ogólny obraz kalorii, białka, węglowodanów i tłuszczów na podstawie składników i porcji. Pomaga zrozumieć równowagę bez komplikowania śledzenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блюда дает общий взгляд на калории, белки, углеводы и жиры по ингредиентам и порциям. Это помогает понимать баланс блюда без слишком сложного трекинга еды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“膳食分析”功能可根据食材与分量，为您提供热量、蛋白质、碳水化合物及脂肪的概览，助您轻松掌握膳食均衡性，而无需将饮食记录变得过于繁琐。"
          }
        }
      }
    },
    "support.guides.item15.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahlzeiten für grobe Ernährungsübersicht nutzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Meals for rough nutrition awareness"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Comidas para una conciencia nutricional aproximada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Repas pour une prise de conscience nutritionnelle approximative"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Pasti per consapevolezza nutrizionale approssimativa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事でおおよその栄養把握"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사로 대략적 영양 인식"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj Posiłki do przybliżonej świadomości odżywiania"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте Блюда для общего понимания питания"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用这些菜肴来全面了解营养知识"
          }
        }
      }
    },
    "support.guides.item16.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie Mahlzeiten und Snacks für Ihren Tag. Vor dem Training eher leichte Energie, danach für Erholung und Energiebalance."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use meals and snacks to support your day. Before training, you may want lighter fuel. After training, meals can help recovery and energy balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use comidas y tentempiés para apoyar su día. Antes del entrenamiento puede convenir combustible ligero. Después, las comidas pueden ayudar a recuperación y equilibrio energético."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez repas et collations pour soutenir votre journée. Avant l'entraînement, un apport léger peut convenir. Après, les repas peuvent aider la récupération et l'équilibre énergétique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa pasti e spuntini per la giornata. Prima dell’allenamento energia più leggera; dopo per recupero ed equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事とスナックで一日を支えましょう。トレーニング前は軽め、後は回復とエネルギーバランスに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사와 간식으로 하루를 지원하세요. 훈련 전엔 가벼운 에너지, 후엔 회복과 에너지 균형."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj posiłków i przekąsek, by wspierać dzień. Przed treningiem może pasować lżejsze paliwo. Po treningu posiłki mogą pomóc w regeneracji i bilansie energetycznym."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте блюда и перекусы, чтобы поддержать день. Перед тренировкой может подойти легкое топливо. После тренировки еда помогает восстановлению и энергетическому балансу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用正餐与加餐来维持全天精力。训练前可摄入轻量能量食物；训练后则通过进食促进身体恢复并调节能量平衡。"
          }
        }
      }
    },
    "support.guides.item16.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ernährung rund um Workouts planen"
          }
        },
        "en" : {
