    "coach.scenario.recoveryDuring.breathing.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Atem langsam und natürlich. Das Ziel ist es, herunterzuschalten, nicht zu performen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the breath slow and natural. The goal is to downshift, not to perform."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga la respiración lenta y natural. El objetivo es bajar el ritmo, no rendir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la respiration lente et naturelle. L’objectif est de ralentir, pas de performer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni il respiro lento e naturale. L'obiettivo è ridurre il ritmo, non esibirsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸はゆっくりと自然に保ってください。目標はギアを落とすことであり、パフォーマンスを発揮することではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨을 느리고 자연스럽게 유지하세요. 목표는 수행하는 것이 아니라 기어를 낮추는 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj wolny, naturalny oddech. Celem jest zwolnienie, a nie występ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дышите медленно и естественно. Цель — снизить темп, а не выполнить упражнение на результат."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持呼吸缓慢且自然。目标是实现降档，而非刻意表演。"
          }
        }
      }
    },
