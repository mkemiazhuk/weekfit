          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge d'entraînement presse la récupération"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico di allenamento sta premendo il recupero"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訓練負荷は回復を押します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훈련 짐은 회복을 누르고 있습니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie treningowe naciska regenerację"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировочная нагрузка давит на восстановление"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练负荷会阻碍身体恢复。"
          }
        }
      }
    },
    "insights.vm.learnings.nutritionUnclear.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ernährung hat zu wenige protokollierte Tage, um Erholungsänderungen zu erklären. Es sollte den Kontext unterstützen, bis die Protokollierung stabiler ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrition has too few logged days to explain recovery changes. It should stay supporting context until logging is steadier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nutrición tiene demasiados pocos días registrados para explicar cambios de recuperación. Debe seguir como contexto de apoyo hasta que el registro sea más estable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nutrition a trop peu de jours enregistrés pour expliquer les changements de récupération. Elle doit rester un contexte de soutien tant que le journal n'est pas plus régulier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrition ha troppi pochi giorni registrati per spiegare i cambiamenti di recupero. Dovrebbe continuare a sostenere il contesto fino a quando la registrazione è più stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "栄養は回復変更を説明するために記録された日があまりありません。 ロギングが着手するまでは、コンテキストをサポートし続ける必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영양은 복구 변경 사항을 설명하기 위해 며칠이 걸렸습니다. 로깅이 steadier 될 때까지 context를 지원해야합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odżywianie ma za mało zalogowanych dni, by wyjaśnić zmiany regeneracji. Powinno pozostać kontekstem wsparcia, dopóki logowanie nie będzie stałsze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком мало записанных дней питания, чтобы объяснить изменения восстановления. Пока записи не станут стабильнее, это лишь контекст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "营养记录天数过少，尚不足以解释恢复情况的变化；在记录数据趋于稳定之前，营养分析仍应仅作为背景支持。"
          }
        }
      }
    },
    "insights.vm.learnings.nutritionUnclear.title" : {
