    "support.faq.item12.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE (Gesamtenergiebedarf) kombiniert Grundstoffwechsel mit Bewegung, Workouts und täglicher Aktivität zur Schätzung Ihres Tagesbedarfs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE (Total Daily Energy Expenditure) combines your base metabolism with movement, workouts, and daily activity to estimate your daily energy needs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE (gasto energético total) combina metabolismo basal, movimiento, entrenamientos y actividad diaria para estimar sus necesidades diarias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le TDEE (dépense énergétique totale) combine métabolisme de base, mouvement, entraînements et activité quotidienne pour estimer vos besoins énergétiques journaliers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE (dispendio energetico totale) combina metabolismo base con movimento, allenamenti e attività giornaliera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE（総消費エネルギー）は基礎代謝に移動、ワークアウト、日々のアクティビティを加え、一日の必要量を推定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE(총 일일 에너지 소비)는 기초 대사에 이동, 운동, 일일 활동을 더해 하루 필요량을 추정합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE (całkowite dzienne zapotrzebowanie) łączy metabolizm bazowy, ruch, treningi i aktywność dzienną, by oszacować dzienne zapotrzebowanie energetyczne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE (общий дневной расход энергии) объединяет базовый обмен, движение, тренировки и дневную активность, чтобы оценить дневную потребность в энергии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE（每日总能量消耗）综合基础代谢率、身体活动、运动训练及日常活动等因素，用以评估每日能量需求。"
          }
        }
      }
    },
