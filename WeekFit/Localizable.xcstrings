    "coach.rationale.protectNext.messageFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is the next meaningful block. Keep this %2$@ easy so you arrive fresh instead of carrying extra fatigue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — следующий важный блок. Держите эту %2$@ легкой, чтобы прийти свежим, а не с лишней усталостью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@是下一个有意义的区块。保持这款%2$@轻松，让您到达新鲜，而不是带来额外的疲劳。"
          }
        }
      }
    },
    "coach.rationale.protectNext.title": {
      "extractionState": "manual",
