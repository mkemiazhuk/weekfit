    "coach.scenario.performanceDuring.avoid.doNotChaseEveryPoint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not chase every point at full intensity today."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня не гонитесь за каждым очком на полной интенсивности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天不要以全速去追逐每一个要点。"
          }
        }
      }
    },
    "coach.scenario.performanceDuring.avoid.doNotChasePersonalRecords": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not chase personal records when daily load is already high."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не гонитесь за личными рекордами, когда дневная нагрузка уже высокая."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当每日负载已较高时，请勿追求个人纪录。"
          }
        }
      }
    },
    "coach.scenario.performanceDuring.hard.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay repeatable before fatigue builds. Quality reps matter more than forcing intensity."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте повторяемость до накопления усталости. Качественные повторы важнее форсирования интенсивности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持重复训练次数，直至出现疲劳感。高质量的重复训练比强行增加训练强度更为重要。"
          }
        }
      }
    },
    "coach.scenario.performanceDuring.hard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control the hard work"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контролируйте тяжелую работу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "掌控繁重的工作"
          }
        }
      }
    },
    "coach.scenario.performanceDuring.loaded.messageFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Make this a clean execution session, not a test of your limit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Сделайте эту тренировку чистой по выполнению, а не проверкой предела."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@使这成为一个干净的执行会话，而不是对您的限制的测试。"
          }
        }
      }
    },
    "coach.scenario.performanceDuring.loaded.title": {
      "extractionState": "manual",
      "localizations": {
