        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補おうとすることは、価値よりも疲労を増すことが多いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보상하려고 노력하는 것은 종종 가치보다 더 많은 피로를 추가합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próby rekompensaty często dodają więcej zmęczenia niż korzyści."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попытка компенсировать часто добавляет больше усталости, чем пользы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试图弥补往往带来的疲惫感，反而比其益处更多。"
          }
        }
      }
    },
    "coach.priority.turningEasyMovementIntoWorkStealsFrom.4383" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leichte Bewegungen in harte Arbeit zu verwandeln untergräbt die Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning easy movement into hard work undercuts recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertir el movimiento suave en trabajo intenso resta recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformer un mouvement facile en travail intense affaiblit la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasformare un movimento facile in lavoro duro compromette il recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡単な動きを過酷な作業に変えることは、回復を損なう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쉬운 움직임을 힘든 일로 바꾸면 회복이 방해된다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamiana łatwego ruchu w ciężką pracę osłabia regenerację."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если превратить лёгкое движение в жёсткую работу, восстановление пострадает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若将轻松的运动转变为高强度训练，身体恢复将会受到影响。"
          }
        }
      }
    },
    "coach.priority.underFuelingMattersMostWhenLoadTiming.3491" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterbetankung ist am wichtigsten, wenn Last, Timing oder der Plan für morgen relevant werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under-fueling matters most when load, timing, or tomorrow's plan makes it relevant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La falta de combustible importa sobre todo cuando la carga, el momento o el plan de mañana lo hacen relevante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sous-alimentation compte surtout quand la charge, le timing ou le plan de demain le rendent pertinent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sotto-alimentazione è più importante quando il carico, il tempo o il piano di domani lo rendono rilevante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燃料不足は、負荷、タイミング、あるいは明日の計画がそれに関連する場合に最も重要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연료 부족은 무게, 시간 조절, 또는 내일 계획과 관련될 때 가장 중요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedożywienie ma największe znaczenie, gdy obciążenie, timing lub plan na jutro to uzasadniają."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаток еды особенно важен, когда нагрузка, время или завтрашний план делают его значимым."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当压力、时间或次日计划使得饮食变得至关重要时，缺乏食物就显得尤为关键。"
          }
        }
      }
    },
