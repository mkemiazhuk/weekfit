    "coach.priority.veryLowSleepDuringAnEveningRecovery.4908" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr niedriger Schlaf während eines abendlichen Erholungsblocks sollte den Tag in Richtung Erholung lenken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very low sleep during an evening recovery block should steer the day toward recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormir muy poco en un bloque de recuperación vespertino debe orientar el día hacia la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sommeil très faible pendant un bloc de récupération en soirée doit orienter la journée vers la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sonno molto basso durante un blocco di recupero sera dovrebbe guidare il giorno verso il recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕方の回復ブロックの間に非常に低い眠りは回復に向かって日を応援する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저녁 회복 구획 도중 아주 낮은 잠은 회복을 향해 하루를 steer 해야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bardzo krótki sen podczas wieczornego bloku regeneracji powinien skierować dzień ku regeneracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очень короткий сон во время вечернего восстановительного блока должен вести день к восстановлению."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在傍晚恢复期期间若出现极短睡眠，则次日有望恢复。"
          }
        }
      }
    },
    "coach.priority.whenReadinessIsLimitedAddingTrainingUsually.3088" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Bereitschaft begrenzt ist, kostet das Hinzufügen von Training normalerweise mehr als es gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When readiness is limited, adding training usually costs more than it gives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con disponibilidad limitada, añadir entrenamiento suele costar más de lo que aporta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la disponibilité est limitée, ajouter de l’entraînement coûte généralement plus qu’il n’apporte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando la disponibilità è limitata, l'aggiunta di formazione di solito costa più di quanto dà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備が限られているとき、トレーニングを追加すると、通常はそれよりも費用がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽을 때 제한된, 훈련을 추가하는 것은 보통 더 많은 것을 줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy ograniczonej gotowości dodanie treningu zwykle kosztuje więcej, niż daje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда готовность ограничена, дополнительная тренировка обычно стоит больше, чем дает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当准备程度有限时，额外训练带来的收益通常往往不及其成本。"
          }
        }
      }
    },
    "coach.priority.yourFitnessDidNotDisappearOvernightThe.4563" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Fitness ist nicht über Nacht verschwunden. Der Engpass ist Schlaf, also würde ich aufhören, zusätzliche Arbeit zu jagen und heute Abend die Intervention machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your fitness did not disappear overnight. The bottleneck is sleep, so I would stop chasing extra work and make tonight the intervention."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su forma no desapareció de la noche a la mañana. El cuello de botella es el sueño: dejaría de buscar trabajo extra y haría de esta noche la intervención."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre forme n’a pas disparu du jour au lendemain. Le goulot d’étranglement, c’est le sommeil : je cesserais de chercher du travail supplémentaire et ferais de cette nuit l’intervention."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo fitness non è sparito durante la notte. Il collo di bottiglia e' sonno, quindi smettero' di inseguire un lavoro extra e faro' l'intervento stasera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのフィットネスは一晩消えませんでした。 ボトルネックは眠っているので、余分な作業を追い止めて、介入を一晩するつもりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 피트니스는 밤새 사라지지 않았습니다. 병목은 잠입니다, 그래서 나는 여분 일을 쫓고 개입을 자아냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma nie zniknęła z dnia na dzień. Wąskim gardłem jest sen — przestałbym gonić za dodatkową pracą i uczynił dziś wieczorem interwencją."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Форма не исчезла за ночь. Узкое место — сон, поэтому я бы перестал догонять работу и сделал сегодняшний вечер главным вмешательством."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这种状态并未在一夜之间消失。而最狭窄的环节便是睡眠，因此我本可以不再紧赶进度，将今晚视为关键的干预时机。"
          }
        }
      }
    },
