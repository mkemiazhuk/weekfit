          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 주변 영양 계획"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planuj odżywianie wokół treningów"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планируйте питание вокруг тренировок"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据训练计划制定营养方案"
          }
        }
      }
    },
    "support.guides.item17.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasser, Tee, Kaffee, Mahlzeiten, Dehnen, Sauna, Atmung und Schlaf-Routinen helfen Coach, Ihren Tag besser zu verstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water, tea, coffee, meals, stretching, sauna, breathing, and sleep routines all help Coach understand your day better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agua, té, café, comidas, estiramientos, sauna, respiración y rutinas de sueño ayudan a Entrenador a entender mejor su día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eau, thé, café, repas, étirements, sauna, respiration et routines de sommeil aident Coach à mieux comprendre votre journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acqua, tè, caffè, pasti, stretching, sauna, respirazione e routine sonno aiutano Coach a capire meglio la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水、お茶、コーヒー、食事、ストレッチ、サウナ、呼吸、睡眠ルーティンもコーチの理解を助けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물, 차, 커피, 식사, 스트레칭, 사우나, 호흡, 수면 루틴도 코치 이해에 도움이 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woda, herbata, kawa, posiłki, rozciąganie, sauna, oddychanie i rutyny snu pomagają Trener lepiej zrozumieć dzień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вода, чай, кофе, еда, растяжка, сауна, дыхание и рутины сна помогают Тренеру лучше понимать ваш день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "饮水、饮茶、喝咖啡、进食、拉伸运动、桑拿、呼吸练习以及睡眠规律，都能帮助教练更好地了解您的日常生活。"
          }
        }
      }
    },
