          "stringUnit" : {
            "state" : "translated",
            "value" : "I segnali di recupero sono bassi. Priorizzi il movimento facile, l'idratazione e una notte precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復信号は低いです。 簡単な動き、水分補給、そして早い夜を優先します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복 신호는 낮습니다. 쉬운 운동, 수화 및 이전 밤을 우선."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sygnały regeneracji są niskie. Postaw na łatwy ruch, nawodnienie i wcześniejszą noc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигналы восстановления низкие. В приоритете легкое движение, вода и более ранний сон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复信号偏低。优先轻松活动、补水和休息。"
          }
        }
      }
    },
