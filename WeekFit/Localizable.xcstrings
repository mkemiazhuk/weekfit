    "challenge.recovery7.v2.task.5.alternative" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Pause kann sitzen. Verbreiten Sie sie - stopfen Sie sie nicht zusammen, wenn der Tag fast vorbei ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each break can be seated. Spread them out — don’t cram them together if the day is almost over."
