    "support.faq.item10.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit betrachtet Workouts, Bewegung, Erholung, Körperdaten, Mahlzeiten und Apple Health-Informationen, um personalisierte Aktivität- und Ernährung-Ziele zu erstellen. Wenn sich Ihr Tag ändert, können sich Ziele anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit looks at your workouts, movement, recovery, body data, meals, and Apple Health information to build personalized Activity and Nutrition targets. As your day changes, targets can also adjust to better reflect your current energy and recovery needs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit revisa entrenamientos, movimiento, recuperación, datos corporales, comidas y Apple Health para crear objetivos personalizados de Actividad y Nutrición. Durante el día, los objetivos también pueden ajustarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit examine entraînements, mouvement, récupération, données corporelles, repas et Apple Health pour construire des objectifs Activité et Nutrition personnalisés. Les objectifs peuvent aussi s'ajuster au fil de la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit analizza allenamenti, movimento, recupero, dati corporei, pasti e Apple Health per costruire obiettivi Attività e Nutrizione personalizzati. Con il cambiare della giornata, gli obiettivi possono adattarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitはワークアウト、移動、回復、体データ、食事、Apple Health情報を見て、パーソナライズされたアクティビティと栄養目標を作ります。一日が変わると目標も調整されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 운동, 이동, 회복, 신체 데이터, 식사, Apple Health 정보를 바탕으로 맞춤 활동 및 영양 목표를 만듭니다. 하루가 바뀌면 목표도 조정될 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit analizuje treningi, ruch, regenerację, dane ciała, posiłki i Apple Health, by budować spersonalizowane cele Aktywność i Odżywianie. W ciągu dnia cele mogą się też dostosowywać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit учитывает тренировки, движение, восстановление, данные тела, питание и Apple Health, чтобы строить персональные цели Активности и Питания. Когда день меняется, цели могут обновляться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 综合考量训练、运动、恢复、身体数据、营养及 Apple Health 信息，以制定个性化的「活动」与「营养」目标。当每日情况发生变化时，这些目标亦可相应更新。"
          }
        }
      }
    },
    "support.faq.item10.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie werden Aktivität- und Ernährungsziele berechnet?"
