        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの体は蓄積された負荷の兆候を示しています。今日は回復、水分補給、睡眠の質を優先してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 몸이 누적된 부담의 징후를 보여주고 있습니다. 오늘은 회복, 수분 섭취, 수면의 질을 우선시하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciało pokazuje oznaki nagromadzonego obciążenia. Dziś priorytetem są regeneracja, nawodnienie i jakość snu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
