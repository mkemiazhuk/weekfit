        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadzone dane służą do aktualizacji planu, metryk, kontekstu Coach i codziennych wskazówek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные, введенные пользователем, используются для обновления плана, метрик, контекста Тренера и ежедневных рекомендаций."
          }
        },
        "zh-Hans" : {
