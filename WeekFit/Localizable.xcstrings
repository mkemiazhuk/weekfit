    "support.faq.item38.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf erscheint meist nur, wenn Apple Health Schlafdaten hat. Auf dem iPhone kann Sleep Focus oder ein anderer Schlaf-Tracker nötig sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep usually appears only when Apple Health has sleep data available. On iPhone, Sleep Focus or another sleep tracker may be needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño suele aparecer solo cuando Apple Health tiene datos. En iPhone puede necesitar Sleep Focus u otro rastreador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil n'apparaît généralement que lorsqu'Apple Health a des données disponibles. Sur iPhone, Sleep Focus ou un autre tracker peut être nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno di solito appare solo quando Apple Health ha dati sonno. Su iPhone potrebbero servire Sleep Focus o un altro tracker."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は通常、Apple Healthに睡眠データがある場合のみ表示されます。iPhoneではSleep Focusや別の睡眠トラッカーが必要な場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면은 보통 Apple Health에 수면 데이터가 있을 때만 표시됩니다. iPhone에서는 Sleep Focus나 다른 수면 추적기가 필요할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen zwykle pojawia się tylko, gdy Apple Health ma dostępne dane. Na iPhone może być potrzebny Sleep Focus lub inny tracker."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон обычно появляется только тогда, когда в Apple Health есть данные сна. На iPhone может понадобиться Фокус сна или другой трекер сна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠功能通常仅在 Apple Health 中存有睡眠数据时才会显示。在 iPhone 上，您可能需要使用“睡眠专注”或其他睡眠追踪工具。"
          }
        }
      }
    },
