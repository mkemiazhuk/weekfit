    "insights.snapshot.fallback.focus.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights wird nützlich, sobald Schlaf, Erholung, Essen, Trinken und Aktivität genug jüngste Historie haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights becomes useful once sleep, recovery, food, drink and activity have enough recent history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights resulta útil cuando sueño, recuperación, comida, bebidas y actividad tienen historial reciente suficiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights devient utile lorsque sommeil, récupération, alimentation, boissons et activité ont assez d'historique récent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights diventa utile quando sonno, recupero, cibo, bevande e attività hanno abbastanza storico recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠・回復・食事・水分・アクティビティに十分な直近履歴が集まると、Insightsが役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면, 회복, 식사, 음료, 활동에 충분한 최근 기록이 쌓이면 Insights가 유용해집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights staje się użyteczny, gdy sen, regeneracja, jedzenie, napoje i aktywność mają wystarczającą ostatnią historię."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инсайты становятся полезными, когда у сна, восстановления, еды, напитков и активности накопится достаточно недавней истории."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在睡眠、恢复、饮食及活动方面具备足够近期的历史记录后，相关洞察才具有实用价值。"
          }
        }
      }
