          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hidratación importa más cuando la carga de entrenamiento es lo bastante alta como para elevar el costo de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
