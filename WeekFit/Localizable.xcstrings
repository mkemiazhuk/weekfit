        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — самый явный паттерн. Остальная часть экрана объясняет, поддерживается ли этот сигнал стабильностью тренировок, питания и гидратации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@是最清晰的图案。屏幕的其余部分解释了该信号是否得到训练、营养和水分一致性的支持。"
          }
