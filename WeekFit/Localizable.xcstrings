      }
    },
    "challenge.recovery7.task.6.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start your wind-down routine at your chosen time."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните спокойное завершение дня в выбранное время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您选定的时间，从容地结束这一天。"
          }
