    "login.note.appleHealth" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health verbessert die Personalisierung. Sie behalten die Kontrolle - verbinden Sie sich, wenn Sie bereit sind."
          }
        },
