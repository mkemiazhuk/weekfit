    "coach.scenario.recoveryBefore.walk.easy.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte es bequem. Dieser Spaziergang soll die Erholung unterstützen, nicht zusätzlichen Stress verursachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it comfortable. This walk is here to support recovery, not add stress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manténgase cómodo. Esta caminata apoya la recuperación, no el estrés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez à l’aise. Cette marche sert la récupération, pas le stress."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantienilo comodo. Questa passeggiata serve a favorire il recupero, non a creare stress."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快適に保ってください。この散歩は回復をサポートするためのもので、ストレスを増やすものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편안하게 유지하세요. 이 산책은 회복을 돕기 위한 것이며, 스트레스를 더하기 위한 것이 아닙니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostań w komforcie. Ten spacer wspiera regenerację, a nie stres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите комфортный темп. Эта прогулка нужна для поддержки восстановления, а не для добавления стресса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持舒适。这次步行旨在助力康复，而非增加压力。"
          }
        }
      }
    },
