    "recovery.stressIndex.summary.generic" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physiologische Belastung wird aus Ihren verfügbaren Erholungssignalen geschätzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physiological strain is estimated from your available recovery signals."
