          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы пропустили %@. Не переедайте в следующий прием пищи для компенсации. Лучше распределите недостающие %lld ккал в завтрашнем плане."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你错过了 %@。下一餐别暴食补回来；把缺少的 %lld 千卡分散到明天。"
          }
        }
      }
