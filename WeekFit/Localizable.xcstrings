    "coach.scenario.performanceDuring.racket.loaded.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Spiele mit Kontrolle und vermeide es, jeden Ballwechsel mit maximalem Einsatz zu bestreiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Play with control and avoid turning every rally into a maximal effort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Juegue con control y evite convertir cada rally en esfuerzo máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Jouez avec contrôle et évitez de transformer chaque échange en effort maximal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Gioca con controllo ed evita di trasformare ogni scambio in uno sforzo massimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ コントロールを意識してプレーし、すべてのラリーを全力で戦うことを避けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 컨트롤을 유지하며 모든 랠리를 최대 노력으로 바꾸지 않도록 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Graj z kontrolą i unikaj zamiany każdej wymiany w maksymalny wysiłek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Играйте с контролем и не превращайте каждый розыгрыш в максимальное усилие."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@尽情玩耍，避免将每次拉力变成最大努力。"
          }
        }
      }
    },
