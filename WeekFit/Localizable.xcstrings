        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin comida registrada. Si la primera comida es más tarde, mantenga hidratación estable y evite picar sin necesidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun repas enregistré. Si votre premier repas est prévu plus tard, gardez l'hydratation stable et évitez les grignotages inutiles."
