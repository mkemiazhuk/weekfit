    "coach.priority.preparationOverridesStableOverviewUnlessASafety.4411" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorbereitung übertrumpft stabile Übersicht, es sei denn, ein Sicherheitsbegrenzer ist dringlicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparation overrides stable overview unless a safety limiter is more urgent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La preparación prevalece sobre la vista estable salvo que un limitante de seguridad sea más urgente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La préparation prime sur la vue d'ensemble stable sauf si un frein de sécurité est plus urgent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La preparazione prevale su una panoramica stabile a meno che un limitatore di sicurezza non sia più urgente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全リミッターがより緊急でない限り、準備は安定した概観に優先する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전 제한기가 더 긴급하지 않은 한, 준비가 안정적인 개요를 우선한다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przygotowanie ma pierwszeństwo przed stabilnym przeglądem, chyba że pilniejszy jest limit bezpieczeństwa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подготовка важнее спокойного обзора, если нет более срочного ограничения по безопасности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非安全限制条件更为紧急，否则准备阶段将覆盖稳定概览。"
          }
        }
      }
    },
