    "termsPrivacy.legal.retention.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit speichert App-Daten nur so lange wie nötig für Funktionen, Plan, Metriken und Personalisierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit retains app data only as needed to provide functionality, maintain your plan, show metrics, and personalize the experience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit conserva los datos de la app solo el tiempo necesario para funciones, mantener su plan, mostrar métricas y personalizar la experiencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit conserve les données de l'app uniquement le temps nécessaire pour fournir les fonctionnalités, maintenir votre plan, afficher les métriques et personnaliser l'expérience."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit conserva i dati solo quanto serve per funzionalità, piano, metriche e personalizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは機能、プラン、指標、パーソナライズに必要な期間のみアプリデータを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 기능, 플랜, 지표, 개인화에 필요한 기간만 앱 데이터를 보관합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit przechowuje dane aplikacji tylko tak długo, jak to potrzebne do funkcji, planu, metryk i personalizacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit хранит данные приложения только в объеме, необходимом для работы функций, поддержания плана, отображения метрик и персонализации опыта."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 仅存储应用程序运行所需的功能、计划维护、指标展示及个性化体验所必需的数据量。"
          }
        }
      }
    },
    "termsPrivacy.legal.retention.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen von Aktivitäten, Entfernen von Berechtigungen oder App-Daten kann Funktionen, Einblicke und historischen Kontext reduzieren oder entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting activities, removing permissions, or deleting app data may reduce or remove related features, insights, and historical context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar actividades, quitar permisos o borrar datos puede reducir o eliminar funciones, análisis y contexto histórico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer des activités, retirer des autorisations ou effacer des données peut réduire ou supprimer des fonctionnalités, analyses et contexte historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare attività, permessi o dati app può ridurre o rimuovere funzioni, insight e contesto storico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティ削除、権限削除、アプリデータ削除は、関連機能、インサイト、履歴文脈を減らすか削除する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활동 삭제, 권한 제거, 앱 데이터 삭제는 관련 기능, 인사이트, 기록 맥락을 줄이거나 제거할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwanie aktywności, cofanie uprawnień lub kasowanie danych może ograniczyć funkcje, analizy i kontekst historyczny."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление активностей, отключение разрешений или удаление данных приложения может уменьшить или убрать связанные функции, инсайты и исторический контекст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除操作、撤销权限或删除应用数据，均可能导致相关功能、洞察及历史上下文减少或消失。"
          }
        }
      }
    },
    "termsPrivacy.legal.retention.p3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Apple Health-Berechtigungen jederzeit über Apple Health oder iOS-Einstellungen verwalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can manage Apple Health permissions at any time through Apple Health or iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede gestionar los permisos de Apple Health en cualquier momento en Apple Health o Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez gérer les autorisations Apple Health à tout moment dans Apple Health ou Réglages iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi gestire i permessi Apple Health in qualsiasi momento tramite Salute o Impostazioni iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Healthの権限は、Apple HealthまたはiOS設定でいつでも管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health 권한은 Apple Health 또는 iOS 설정에서 언제든 관리할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprawnienia Apple Health można w każdej chwili zarządzać w Apple Health lub Ustawieniach iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете управлять разрешениями Apple Health в любое время через Apple Health или настройки iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可随时通过“Apple Health”或“iOS 设置”管理“Apple Health”的权限。"
          }
        }
      }
    },
