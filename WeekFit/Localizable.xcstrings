          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "米をプレートし、鶏とブロッコリーを加えて、オリーブオイルのドリスルで仕上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쌀을 판, 닭고기와 브로콜리를 추가 한 다음 올리브 오일의 덩어리로 마무리하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ułóż ryż, dodaj kurczaka i brokuły, skończ skropieniem oliwy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выложите рис, добавьте курицу и брокколи, сверху сбрызните оливковым маслом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将米饭盛入盘中，加入鸡肉和西兰花，最后淋上少许橄榄油即可。"
          }
        }
      }
    },
    "meals.starter.cottageToast.step1" : {
