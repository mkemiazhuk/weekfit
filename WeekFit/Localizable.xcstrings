    "coach.copy.recoveryCapacityIsLowReduceWorkoutIntensity.145": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery capacity is low. Reduce workout intensity and sleep earlier tonight."
          }
