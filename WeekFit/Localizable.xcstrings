    "settings.account.appleReplaceLocal.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung mit Apple startet einen separaten Account-Bereich auf diesem Gerät. Ihr aktueller lokaler Plan, Mahlzeiten und Einstellungen werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing in with Apple starts a separate account workspace on this device. Your current local plan, meals, and preferences will be removed. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sesión con Apple crea un espacio de cuenta independiente en este dispositivo. Se eliminarán su plan local, comidas y preferencias actuales. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion avec Apple crée un espace de compte distinct sur cet appareil. Votre plan local, vos repas et vos préférences actuels seront supprimés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedere con Apple avvia un workspace account separato su questo dispositivo. Il piano locale attuale, i pasti e le preferenze verranno rimossi. Non è reversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleでサインインすると、このデバイス上で別のアカウントワークスペースが始まります。現在のローカルのプラン、食事、設定は削除されます。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple로 로그인하면 이 기기에서 별도의 계정 작업 공간이 시작됩니다. 현재 로컬 플랜, 식사, 설정이 제거됩니다. 되돌릴 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logowanie przez Apple tworzy oddzielną przestrzeń konta na tym urządzeniu. Obecny lokalny plan, posiłki i preferencje zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход с Apple откроет отдельное пространство аккаунта на этом устройстве. Текущий локальный план, приёмы пищи и настройки будут удалены. Это нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Apple 登录将在该设备上启用独立的账户空间。当前的本地设置、饮食选项及配置功能将被移除。此变更不可撤销。"
          }
        }
      }
    },
