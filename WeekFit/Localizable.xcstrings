    "support.guides.item23.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Woche zählt mehr als ein perfekter Tag. Nutzen Sie Trends, um die nächste Woche anzupassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your week matters more than one perfect day. Use trends to adjust the next week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su semana importa más que un día perfecto. Use tendencias para ajustar la próxima semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre semaine compte plus qu'une journée parfaite. Utilisez les tendances pour ajuster la semaine suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La settimana conta più di un giorno perfetto. Usa le tendenze per la prossima settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完璧な一日より週全体が大切。傾向を見て次の週を調整しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완벽한 하루보다 한 주가 중요합니다. 추세로 다음 주를 조정하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy się tydzień, nie jeden idealny dzień. Używaj trendów, by dostosować następny tydzień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неделя важнее одного идеального дня. Используйте тренды, чтобы точнее настроить следующую неделю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一周的重要性胜过一个完美的日子。善用趋势，让接下来的一周规划更加精准。"
          }
        }
      }
    },
    "support.guides.item23.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Mustern suchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for patterns"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque patrones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherchez des schémas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca schemi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パターンを探す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패턴 찾기"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukaj wzorców"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищите закономерности"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寻找规律"
          }
        }
      }
    },
    "support.guides.item24.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prozentwerte und Ziele sollen Bewusstsein fördern, nicht Druck. Manche Tage sind höher, niedriger, leichter oder anspruchsvoller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentages and targets are there to guide awareness, not to create pressure. Some days will be higher, lower, easier, or more demanding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los porcentajes y objetivos guían la conciencia, no crean presión. Algunos días serán más altos, más bajos, más fáciles o más exigentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pourcentages et objectifs servent à guider la conscience, pas à créer de la pression. Certains jours seront plus hauts, plus bas, plus faciles ou plus exigeants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentuali e obiettivi guidano la consapevolezza, non la pressione. Alcuni giorni sono più alti, bassi, leggeri o impegnativi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パーセンテージと目標は意識を高めるためのもので、プレッシャーではありません。日によって高低や負荷は変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백분율과 목표는 인식을 위한 것이지 압박이 아닙니다. 날마다 높고 낮고 가볍고 부담될 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procenty i cele służą świadomości, nie presji. Niektóre dni będą wyższe, niższe, łatwiejsze lub bardziej wymagające."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проценты и цели нужны для осознанности, а не для давления. Некоторые дни будут выше, ниже, легче или тяжелее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设定百分比与目标旨在提升认知，而非施加压力。某些日子可能要求更高、更低、更简单或更艰巨。"
          }
        }
      }
    },
    "support.guides.item24.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine perfekten Zahlen jagen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not chase perfect numbers"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No persiga números perfectos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne poursuivez pas des chiffres parfaits"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non inseguire numeri perfetti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完璧な数字を追わない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완벽한 숫자 쫓지 않기"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie gonić za idealnymi liczbami"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не гонитесь за идеальными числами"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要追求完美的数字"
          }
        }
      }
    },
    "support.guides.item25.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den ersten Tagen Health verbinden, ein bis zwei Workouts planen, Mahlzeiten und Wasser protokollieren und nach Aktivität Coach prüfen. WeekFit wird mit mehr Daten nützlicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For the first few days, connect Health, plan one or two workouts, log meals and water, and check Coach after activity. WeekFit gets more useful as your data builds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los primeros días, conecte Health, planifique uno o dos entrenamientos, registre comidas y agua y consulte Entrenador tras la actividad. WeekFit mejora conforme crecen los datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les premiers jours, connectez Health, planifiez un ou deux entraînements, enregistrez repas et eau, et consultez Coach après l'activité. WeekFit devient plus utile à mesure que les données s'accumulent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei primi giorni collega Salute, pianifica uno o due allenamenti, registra pasti e acqua e controlla Coach dopo l’attività. WeekFit migliora con i dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の数日はHealthを接続し、ワークアウトを1〜2件計画し、食事と水を記録し、活動後にコーチを確認。データが増えるほどWeekFitは有用になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 며칠은 Health 연결, 운동 1~2개 계획, 식사·물 기록, 활동 후 코치 확인. 데이터가 쌓일수록 WeekFit이 유용해집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwsze dni: połącz Health, zaplanuj jeden–dwa treningi, loguj posiłki i wodę i sprawdź Trener po aktywności. WeekFit staje się użyteczniejszy wraz z danymi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В первые дни подключите Здоровье, запланируйте одну-две тренировки, записывайте еду и воду и проверяйте Тренера после активности. WeekFit становится полезнее по мере накопления данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在最初的几天里，请先开启健康追踪功能，规划一到两次锻炼计划，记录饮食与饮水量，并在锻炼后查看教练建议。随着您积累更多数据，WeekFit 的功能将变得更加实用。"
          }
        }
      }
    },
