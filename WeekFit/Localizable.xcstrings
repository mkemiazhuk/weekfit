    "coach.priority.givenValueValueMayExceedWhatYou.4860" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegeben %@ , kann %@ das überschreiten, wovon Sie sich erholen können. Ich würde heute Abend schützen und bereit sein, die Arbeit von %@ morgen gegen Erholung zu tauschen, wenn die Bereitschaft noch niedrig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Given %@, %@ may exceed what you can recover from. I would protect tonight and be ready to swap tomorrow's %@ work for recovery if readiness is still low."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dado %@ , %@ puede superar lo que puede recuperar. Protegería esta noche y estaría listo para cambiar el trabajo %@ de mañana por recuperación si la preparación sigue baja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte tenu de %@ , %@ peut dépasser ce que vous pouvez récupérer. Je protégerais ce soir et serais prêt à échanger le travail %@ de demain contre de la récupération si la disponibilité reste basse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dato %@ , %@ potrebbe superare ciò da cui puoi recuperare. Proteggerei stasera e sarei pronto a scambiare il lavoro di %@ di domani per il recupero se la prontezza è ancora bassa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与えられた %@ により、 %@ は回復できる量を超える可能性があります。私は今夜は保護し、翌日の %@ の作業を回復のために交換できるように準備しておくでしょう、もし準備がまだ低い場合は。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주어진 %@ 상황에서, %@ 는 당신이 회복할 수 있는 한계를 초과할 수 있습니다. 저는 오늘 밤 보호하고, 내일 %@ 작업을 회복을 위해 교체할 준비를 하겠습니다, 만약 준비도가 여전히 낮다면세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biorąc %@ , %@ może przekroczyć to, z czego zdążysz się zregenerować. Chroniłbym dziś wieczorem i był gotów zamienić jutrzejszą pracę %@ na regenerację, jeśli gotowość wciąż będzie niska."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С учетом %@, %@ может быть выше того, от чего вы успеете восстановиться. Сегодня я бы сохранил вечер спокойным и был готов заменить завтрашнюю %@ работу на восстановление, если готовность останется низкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鉴于%@的情况，%@可能超出您可恢复的范围。我今晚会采取防护措施，若准备度仍较低，则可将明日的%@工作替换为恢复操作。"
          }
        }
      }
    },
