        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy aktywna sesja jest niejasna, kończ z rezerwą zamiast udowadniać pierwotny plan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активная тренировка не распознана точно, поэтому завершите с запасом, а не доказывайте исходный план."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于当前活跃环节尚不明确，应以保留方案收尾，而非落实原定计划。"
          }
        }
      }
    },
    "coach.humanDecision.becauseTheActiveSessionIsUnclearKeep.486" : {
