    "coach.insight.logYourFoodSoTheCoachCan.69" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokolliere Ihre Nahrung, damit der Trainer Energie, Eiweiß und Erholung anhand der tatsächlichen Aufnahme ausgleichen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log your food so the coach can balance energy, protein and recovery from real intake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre su comida para que Coach equilibre energía, proteína y recuperación a partir de la ingesta real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez votre alimentation pour que Coach équilibre énergie, protéines et récupération à partir de l'apport réel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra il Suo cibo in modo che l'allenatore possa bilanciare energia, proteine e recupero dalla reale assunzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際の摂取量からエネルギー、タンパク質、回復をコーチがバランスできるように、食べたものを記録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 섭취량을 바탕으로 코치가 에너지, 단백질, 회복을 균형 있게 조절할 수 있도록 음식을 기록하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loguj jedzenie, aby Coach mógł balansować energię, białko i regenerację na podstawie realnego spożycia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите еду, чтобы Тренер точнее оценил энергию, белок и восстановление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录您的饮食摄入情况，以便教练根据实际摄入量来平衡能量、蛋白质摄入及恢复情况。"
          }
        }
      }
    },
