    },
    "coach.priority.aRecentSessionMakesRecoveryFuelAnd.3635" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kürzliche Sitzung macht Erholung, Nahrung und Hydration zum nächsten nützlichen Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recent session makes recovery, fuel, and hydration the next useful step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión reciente hace que recuperación, combustible e hidratación sean el siguiente paso útil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une séance récente fait de la récupération, du carburant et de l'hydratation la prochaine étape utile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sessione recente rende il recupero, il rifornimento e l'idratazione il prossimo passo utile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近のセッションにより、回復、燃料補給、そして水分補給が次に取るべき有用なステップとなる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 세션은 회복, 연료 보충, 수분 공급을 다음 유용한 단계로 만듭니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnia sesja sprawia, że regeneracja, paliwo i nawodnienie to następny sensowny krok."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавняя тренировка делает восстановление, еду и воду следующим полезным шагом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近期的一项研究指出，恢复体力、补充能量及补充水分是接下来的关键步骤。"
          }
        }
      }
    },
