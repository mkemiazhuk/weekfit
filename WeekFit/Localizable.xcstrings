    "nutrition.proteinIntakeIsProgressingWellNfiberAndHealthyFats" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Proteinzufuhr entwickelt sich gut.\nBallaststoffe und gesunde Fette liegen noch unter dem Gesamtfortschritt der Ernährung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein intake is progressing well.\\nFiber and healthy fats remain below overall nutrition progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ingesta de proteína avanza bien.\\nLa fibra y las grasas saludables siguen por debajo del progreso nutricional general."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'apport en protéines progresse bien.\\nLes fibres et les graisses saines restent en dessous de la progression nutritionnelle globale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assunzione di proteine procede bene.\nFibre e grassi salutari restano sotto il progresso nutrizionale complessivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タンパク質の摂取は順調です。\n食物繊維と良質な脂質は、栄養全体の進捗より低めです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
