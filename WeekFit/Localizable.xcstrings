    "support.guides.item22.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfache Erinnerungen können helfen, dem Plan an vollen Tagen zu folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple reminders can help you follow the plan during busy days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordatorios simples pueden ayudar a seguir el plan en días ocupados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des rappels simples peuvent aider à suivre le plan les journées chargées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria semplici possono aiutare a seguire il piano nei giorni intensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンプルなリマインダーは忙しい日に計画を守るのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간단한 알림은 바쁜 날 계획 따르기에 도움이 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proste przypomnienia mogą pomóc trzymać plan w busy dni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простые напоминания помогают следовать плану в занятые дни."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简单的提醒有助于在繁忙的日子里遵循计划。"
          }
        }
      }
    },
