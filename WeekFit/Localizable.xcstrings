        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 빈몸으로 버티는 날이 아닙니다. 에너지를 채워 내일 세트를 살리세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
