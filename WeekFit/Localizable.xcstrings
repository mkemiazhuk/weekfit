    "today.aiCoach.missedMealFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben %@ verpasst. Essen Sie bei der nächsten Mahlzeit NICHT über, um auszugleichen. Verteilen Sie stattdessen die fehlenden %lld kcal auf morgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You missed %@. DON'T overeat on your next meal to compensate. Instead, spread the missing %lld kcal across tomorrow's layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omitió %@ . No compense comiendo de más en la siguiente comida. Reparta las %lld kcal faltantes en el plan de mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez manqué %@ . Ne compensez pas en surmangeant au repas suivant. Répartissez plutôt les %lld kcal manquantes sur le plan de demain."
