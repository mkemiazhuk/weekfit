    "coach.scenario.recoveryDuring.default.loaded.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Lassen Sie diese Bewegung der Genesung dienen, anstatt sie in ein Training zu verwandeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Let this movement help recovery rather than turning it into training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Deje que este movimiento ayude a la recuperación en lugar de convertirlo en entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Laissez ce mouvement aider la récupération plutôt que de le transformer en entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Lascia che questo movimento aiuti la guarigione piuttosto che trasformarlo in allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ この動きをトレーニングに変えるのではなく、回復を助けるものにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 움직임이 훈련으로 바뀌기보다는 회복에 도움이 되게 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pozwól temu ruchowi wspierać regenerację, zamiast zamieniać go w trening."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Пусть это движение помогает восстановлению, а не превращается в тренировку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@让这个动作帮助恢复，而不是将其转化为训练。"
          }
        }
      }
    },
