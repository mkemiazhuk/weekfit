    "coach.priority.recoveryDay.onTrack.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist erledigt. Das unterstützt den Tag; kein zusätzlicher Erholungsaufwand nach dem Training ist nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is done. That supports the day; no post-workout recovery push is needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terminado. Eso apoya el día; no hace falta empuje de recuperación post-entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est terminé. Cela soutient la journée ; aucun push de récupération post-entraînement n'est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è fatto. Questo supporta la giornata; non è necessario alcun impulso di recupero post-allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は完了しました。それは1日をサポートします；運動後の回復の追加は必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 완료되었습니다. 이는 하루를 지원하며, 운동 후 회복 촉진은 필요하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zakończone. To wspiera dzień — nie trzeba pchać regeneracji po treningu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ завершена. Это поддерживает день; дополнительный восстановительный рывок после тренировки не нужен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
