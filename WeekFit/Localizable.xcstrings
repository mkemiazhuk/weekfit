    "insights.vm.learnings.recoveryStable.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung hat genug Geschichte und hält stetig, so dass Veränderungen im Schlaf oder Training klarer interpretiert werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery has enough history and is holding steady, so changes in sleep or training can be interpreted more clearly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación tiene historial suficiente y se mantiene estable, así que los cambios de sueño o entrenamiento pueden interpretarse con más claridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération a assez d'historique et reste stable, les changements de sommeil ou d'entraînement peuvent donc s'interpréter plus clairement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero ha abbastanza storia e sta tenendo costante, quindi i cambiamenti nel sonno o formazione possono essere interpretati più chiaramente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復には十分な歴史があり、着実に保持されているため、睡眠やトレーニングの変更はより明確に解釈することができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복은 충분한 역사가 있고 꾸준한 유지됩니다, 그래서 잠 또는 훈련에서 변화는 더 명확하게 해석될 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja ma wystarczającą historię i trzyma stabilnie, więc zmiany snu lub treningu można interpretować jaśniej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достаточно истории восстановления, и оно держится стабильно — изменения сна или тренировок можно интерпретировать яснее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复期已具备足够的历史基础且保持稳定，因此对睡眠或训练变化的解读将更为清晰。"
          }
        }
      }
    },
