        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some scheduled tasks passed without updates. Mark them completed or skipped so the coach can adapt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas tareas programadas pasaron sin actualizarse. Márquelas completadas u omitidas para que Coach pueda adaptarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines tâches planifiées sont passées sans mise à jour. Marquez-les terminées ou ignorées pour que Coach puisse s'adapter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni compiti programmati sono passati senza aggiornamenti. Marchiali come completati o saltati in modo che l'allenatore possa adattarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかの予定されたタスクは更新なしで進みました。コーチが調整できるように、それらを完了またはスキップとしてマークしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 예정된 작업이 업데이트 없이 지나갔습니다. 코치가 조정할 수 있도록 완료 또는 건너뛰기로 표시하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Część zaplanowanych zadań minęła bez aktualizacji. Oznacz je jako ukończone lub pominięte, aby Coach mógł się dostosować."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые запланированные задачи прошли без обновлений. Отметьте их выполненными или пропущенными, чтобы Тренер адаптировал день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分已安排的任务未进行更新。请标记这些任务为已完成或未完成，以便教练调整当日安排。"
          }
        }
      }
    },
