    "onboarding.v8.coach.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It weighs recovery, activity, nutrition, goals and plans — then suggests the next useful step."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывает восстановление, активность, питание, цели и планы — и предлагает полезный следующий шаг."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它综合考量康复情况、活动水平、营养状况、目标及计划——进而提出下一步可行的建议。"
          }
        }
      }
    },
