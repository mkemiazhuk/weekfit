    "coach.insight.yourBodyIsShowingSignsOfAccumulated.263" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Körper zeigt Anzeichen von angesammelter Belastung. Priorisieren Sie heute Erholung, Flüssigkeitszufuhr und Schlafqualität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body is showing signs of accumulated load. Prioritize recovery, hydration and sleep quality today."
