    "insights.fallback.baseline.driver.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights benötigt mehr überlappende Schlaf-, Erholungs-, Trainings- und Ernährungsdaten, bevor sie die Geschichten ranken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
