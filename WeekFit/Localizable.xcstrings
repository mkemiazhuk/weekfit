    "coach.priority.ifNothingChangesTomorrowStartsWithThe.2872" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich nichts ändert, beginnt der morgige Tag mit derselben Müdigkeit plus einer weiteren Nacht schlechter Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If nothing changes, tomorrow starts with the same fatigue plus one more night of poor recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si nada cambia, mañana empieza con la misma fatiga más otra noche de mala recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rien ne change, demain commence avec la même fatigue plus une nuit de récupération insuffisante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se nulla cambia, domani inizia con la stessa stanchezza più una notte in più di scarso recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も変わらなければ、明日は同じ疲労に加えて、もう一晩回復が不十分な状態で始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 바뀌지 않으면, 내일은 똑같은 피로에 밤새 회복이 부족한 하루가 더해진 상태로 시작된다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli nic się nie zmieni, jutro zacznie się z tym samym zmęczeniem plus kolejną nocą słabej regeneracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ничего не изменить, завтра начнется с той же усталости и еще одной ночи плохого восстановления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果情况依旧，明天将从同样的疲惫感开始，再加上又一晚恢复不佳的夜晚。"
          }
        }
      }
    },
    "coach.priority.ifReadinessDoesNotImproveByTraining.1695" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Bereitschaft bis zur Trainingszeit nicht zunimmt, machen Sie die Sitzung einfacher oder verschieben Sie die Intensität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If readiness does not improve by training time, make the session easier or move the intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la preparación no mejora a la hora de entrenar, haga la sesión más fácil o mueva la intensidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la disponibilité ne s'améliore pas à l'heure d'entraîner, facilitez la séance ou déplacez l'intensité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la prontezza non migliora entro il momento dell'allenamento, rendi la sessione più facile o riduci l'intensità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もしトレーニング時までに準備が整わない場合は、セッションを簡単にするか、強度を変えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훈련 시간까지 준비 상태가 개선되지 않으면 세션을 더 쉽게 하거나 강도를 조정하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli gotowość nie poprawi się do czasu treningu, ułatw sesję albo przesuń intensywność."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если к тренировке готовность не улучшится, сделайте ее легче или перенесите интенсивность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若经过训练后准备状态仍未改善，则应简化训练环节或调整训练强度。"
          }
        }
      }
    },
    "coach.priority.ifRecoveryDoesNotImproveTomorrowS.4644" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich die Erholung nicht verbessert, wird der Plan für morgen enger und die Intensität wird zu einem Glücksspiel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If recovery does not improve, tomorrow's plan gets narrower and intensity becomes a gamble."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la recuperación no mejora, el plan de mañana se estrecha y la intensidad se vuelve una apuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la récupération ne s'améliore pas, le plan de demain se resserre et l'intensité devient un pari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il recupero non migliora, il piano di domani diventa più ristretto e l'intensità diventa un rischio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もし回復が進まなければ、明日の計画は狭くなり、強度はギャンブルになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복이 좋아지지 않으면, 내일 계획은 더 축소되고 강도는 도박이 된다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli regeneracja się nie poprawi, jutrzejszy plan zawęzi się, a intensywność stanie się ryzykiem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если восстановление не улучшится, завтрашний план станет уже, а интенсивность — рискованнее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若康复情况未见改善，明天的计划将愈发受限，而治疗强度则成了一场赌博。"
          }
        }
      }
    },
    "coach.priority.ifYouWakeUpFlatReduceTomorrow.1653" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie flach aufwachst, reduziere die Intensität von morgen, bevor Sie den Plan erzwingst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you wake up flat, reduce tomorrow's intensity before forcing the plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si amanece plano, reduzca la intensidad de mañana antes de forzar el plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous vous réveillez à plat, réduisez l'intensité de demain avant de forcer le plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ti svegli scarico, riduci l'intensità di domani prima di forzare il piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もし目覚めたときに調子が悪ければ、計画を無理に実行する前に、明日の強度を下げてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만약 오늘 컨디션이 좋지 않다면, 계획을 억지로 실행하기 전에 내일의 강도를 줄이세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli obudzisz się bez energii, obniż jutrzejszą intensywność, zanim wymusisz plan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если проснетесь разбитым, снизьте завтрашнюю интенсивность до того, как давить план."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你醒来时感觉身体僵硬，请在坚持原定计划前降低明天的训练强度。"
          }
        }
      }
    },
