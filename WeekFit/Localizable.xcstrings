    "onboarding.v8.arrive.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung, Aktivität, Ernährung und Pläne — als ein klarer Tag gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery, activity, nutrition and plans — read as one clear day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación, actividad, nutrición y planes — leídos como un día claro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération, activité, nutrition et plans — lus comme une journée claire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero, attività, nutrizione e piani — letti come una giornata chiara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復、活動、栄養、予定—一つの明確な一日として。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복, 활동, 영양, 계획 — 하나의 명확한 하루로 읽힙니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja, aktywność, odżywianie i plany — odczytane jako jeden jasny dzień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление, активность, питание и планы — как один ясный день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "康复、活力、营养与规划——宛如一个晴朗的日子。"
          }
        }
      }
    },
