    "support.faq.item01.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit ist Ihr persönlicher Trainings- und Erholungs-Coach. Es hilft Ihnen, Workouts, Mahlzeiten, Hydration, Schlaf und Routinen an einem Ort zu planen und begleitet Sie tagsüber anhand Ihrer Aktivität, Erholung und Gesundheitsdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit is your personal training and recovery coach. It helps you plan workouts, meals, hydration, sleep, and routines in one place, while guiding you throughout the day using your activity, recovery, and health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit es su Entrenador personal de entrenamiento y recuperación. Ayuda a planificar entrenamientos, comidas, hidratación, sueño y rutinas en un solo lugar, guiándole durante el día con su actividad, recuperación y datos de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit est votre Coach personnel d'entraînement et de récupération. Il aide à planifier entraînements, repas, hydratation, sommeil et routines au même endroit, en vous guidant dans la journée avec vos données d'activité, de récupération et de santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit è il tuo Coach personale di allenamento e recupero. Ti aiuta a pianificare allenamenti, pasti, idratazione, sonno e routine in un unico posto, guidandoti durante la giornata in base ad attività, recupero e dati salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは、あなた専用のトレーニングと回復のコーチです。ワークアウト、食事、水分、睡眠、ルーティンを一か所で計画し、アクティビティ、回復、健康データに基づいて一日をガイドします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 개인 맞춤 훈련 및 회복 코치입니다. 운동, 식사, 수분, 수면, 루틴을 한곳에서 계획하고 활동, 회복, 건강 데이터를 바탕으로 하루를 안내합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit to osobisty Trener treningu i regeneracji. Pomaga planować treningi, posiłki, nawodnienie, sen i rutyny w jednym miejscu, prowadząc przez dzień na podstawie aktywności, regeneracji i danych zdrowotnych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit — ваш персональный помощник для тренировок и восстановления. Он помогает планировать тренировки, питание, воду, сон и рутины в одном месте и подсказывает, что важно в течение дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit —— 您的专属训练与恢复助手。它可在单一界面中帮您规划训练计划、膳食安排、饮水管理、睡眠安排及日常事务，并提醒您一天中需要注意的关键事项。"
          }
        }
      }
    },
    "support.faq.item01.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist WeekFit?"
          }
