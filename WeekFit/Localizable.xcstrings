    "coach.rationale.arriveSettledHeat.messageFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will add heat stress. Keep this %2$@ easy so you start hydrated, calm, and not already taxed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ добавит тепловой стресс. Держите эту %2$@ легкой, чтобы начать гидратированным, спокойным и без лишней нагрузки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@会增加热应力。保持这款%2$@轻松，这样您就可以开始补充水分、保持冷静，而且不会过税。"
          }
        }
      }
    },
    "coach.rationale.arriveSettledHeat.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive settled for heat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подойдите к теплу спокойно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抵达后已安顿好，准备应对高温。"
          }
        }
      }
    },
    "coach.rationale.digestionEasy.messageFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is the next useful reset. Keep this %2$@ easy so appetite and digestion stay steady."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — сейчас полезный вариант. Держите %2$@ легкой, чтобы аппетит и пищеварение оставались стабильными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@是下一个有用的重置。保持这款%2$@轻松，让食欲和消化保持稳定。"
          }
        }
      }
    },
