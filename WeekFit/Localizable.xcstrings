    "insights.vm.progression.betterDistribution" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Ebene ist eine bessere Verteilung: Halten Sie das Volumen ähnlich und verteilen Sie harte Anstrengungen über die Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next level is better distribution: keep volume similar and spread hard efforts across the week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El siguiente nivel es mejor distribución: mantenga volumen similar y reparta esfuerzos duros en la semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le niveau suivant est une meilleure distribution : gardez un volume similaire et répartissez les efforts intenses sur la semaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello successivo è una migliore distribuzione: mantenere il volume simile e diffondere gli sforzi duri per tutta la settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のレベルはよりよい配分です:容積を同じような保ち、週を渡る堅い努力を広げて下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 단계는 더 나은 배포입니다 : 유사한 볼륨을 유지하고 일주일에 걸쳐 열심히 노력 확산."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejny poziom to lepszy rozkład: utrzymuj podobny wolumen i rozłóż ciężkie wysiłki w tygodniu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующий уровень — лучшее распределение: сохраните объём и распределите тяжёлые усилия по неделе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一个阶段是优化分配：保持工作量不变，将高强度任务合理分配到一周内。"
          }
        }
      }
    },
    "insights.vm.progression.buildThreeHours" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Ebene baut auf drei Stunden wöchentlicher Aktivität auf, bevor man Intensität jagt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next level is building toward three hours of weekly activity before chasing intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El siguiente nivel es avanzar hacia tres horas de actividad semanal antes de buscar intensidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le niveau suivant est de viser trois heures d'activité hebdomadaire avant de chercher l'intensité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello successivo sta costruendo verso tre ore di attività settimanale prima di inseguire l'intensità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のレベルは、強度を追いかける前に毎週の活動の3時間に向かって構築されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 단계는 강도를 쫓기 전에 주간 활동의 3 시간으로 건물."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejny poziom to budowanie w kierunku trzech godzin tygodniowej aktywności przed gonieniem intensywności."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующий уровень — выйти на три часа еженедельной активности, прежде чем гнаться за интенсивностью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一个阶段是先实现每周三小时的活动量，然后再逐步提升活动强度。"
          }
        }
      }
    },
    "insights.vm.progression.controlledSession" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Ebene ist eine weitere kontrollierte Sitzung oder ein kleiner Intensitätsstoß, nur wenn die Erholung stabil bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next level is one more controlled session or a small intensity bump, only if recovery stays stable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El siguiente nivel es una sesión controlada más o un pequeño aumento de intensidad, solo si la recuperación se mantiene estable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le niveau suivant est une séance contrôlée de plus ou une légère hausse d'intensité, seulement si la récupération reste stable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello successivo è una sessione più controllata o un piccolo urto di intensità, solo se il recupero rimane stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のレベルは、回復が安定したままの場合だけ、より制御されたセッションまたは小さな強度のバンプです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 단계는 하나의 더 제어 세션 또는 작은 강도 범프, 만 복구가 안정 유지되는 경우에."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejny poziom to jedna kontrolowana sesja więcej lub mały wzrost intensywności — tylko jeśli regeneracja pozostaje stabilna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующий уровень — ещё одна контролируемая сессия или небольшой рост интенсивности, только если восстановление стабильно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一个阶段是进行另一场受控训练，或仅在恢复情况稳定时，适当增加训练强度。"
          }
        }
      }
    },
    "insights.vm.progression.holdUntilRecovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Lautstärke stabil, bis die Wiederherstellung steigt, bevor Sie eine weitere harte Sitzung hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold volume steady until recovery rises before adding another hard session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga el volumen estable hasta que la recuperación suba antes de añadir otra sesión dura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le volume stable jusqu'à ce que la récupération remonte avant d'ajouter une séance intense."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenere il volume costante fino a quando il recupero aumenta prima di aggiungere un'altra sessione difficile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のハード セッションを加える前に回復が上がるまで容積を着実に握って下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구가 다른 하드 세션을 추가하기 전에 상승 할 때까지 볼륨을 유지."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj wolumen stabilnie, aż regeneracja wzrośnie, zanim dodasz ciężką sesję."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите объём стабильным, пока восстановление не вырастет, прежде чем добавлять ещё одну тяжёлую сессию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在恢复期开始前，保持成交量稳定，随后方可开启下一轮强势交易时段。"
          }
        }
      }
    },
    "insights.vm.reflection.clearestPatternFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Es ist das deutlichste Muster. Der Rest des Bildschirms erklärt, ob dieses Signal durch Training, Ernährung und Hydratationskonsistenz unterstützt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is the clearest pattern. The rest of the screen explains whether that signal is supported by training, nutrition and hydration consistency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es el patrón más claro. El resto de la pantalla explica si esa señal está respaldada por entrenamiento, nutrición e hidratación consistente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est le schéma le plus clair. Le reste de l'écran explique si ce signal est soutenu par l'entraînement, la nutrition et la régularité d'hydratation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è il modello più chiaro. Il resto dello schermo spiega se quel segnale è supportato da formazione, nutrizione e consistenza idratante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 一番クリアなパターンです。 画面の残りの部分は、その信号がトレーニング、栄養、水分補給の一貫性によってサポートされているかどうかを説明します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 가장 명확한 패턴입니다. 화면의 나머지는 훈련, 영양 및 수화 일관성에 의해 지원되는지 설명합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to najwyraźniejszy wzorzec. Reszta ekranu wyjaśnia, czy ten sygnał wspierają trening, odżywianie i regularność nawodnienia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — самый явный паттерн. Остальная часть экрана объясняет, поддерживается ли этот сигнал стабильностью тренировок, питания и гидратации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@是最清晰的图案。屏幕的其余部分解释了该信号是否得到训练、营养和水分一致性的支持。"
          }
        }
      }
    },
    "insights.vm.reflection.coachPatternFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das stärkste Muster unterstützt das gleiche Thema, das Coach jetzt sieht: %@ Verwenden Sie Insights für das Muster, Coach für den nächsten unmittelbaren Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The strongest pattern supports the same theme Coach is watching now: %@. Use Insights for the pattern, Coach for the next immediate step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El patrón más fuerte apoya el mismo tema que Coach observa ahora: %@ . Use Insights para el patrón y Coach para el siguiente paso inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schéma le plus fort soutient le même thème que Coach observe maintenant : %@ . Utilisez Insights pour le schéma, Coach pour la prochaine étape immédiate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello più forte supporta lo stesso tema Coach sta guardando ora: %@ . Utilizzare Insights per il modello, Coach per il prossimo passo immediato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も強いパターンは、同じテーマCoachをサポートしています。 %@ . パターンにInsightsを使うと、Coachは次のステップで使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 강한 패턴은 동일한 테마 Coach를 지원합니다. %@ . 본을 위한 Insights를, 다음 즉시 단계를 위한 Coach 사용하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najsilniejszy wzorzec wspiera ten sam temat, który Coach obserwuje teraz: %@ . Używaj Insights do wzorca, Coach do następnego kroku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самый сильный паттерн поддерживает ту же тему, за которой сейчас следит Тренер: %@. Используйте Инсайты для паттерна, Тренера — для следующего шага."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最强大的模式延续了教练当前关注的同一主题：%@。利用“洞察”功能分析当前模式，并利用“教练”功能规划下一步行动。"
          }
        }
      }
    },
