    "challenge.recovery7.intro.howItWorksBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treten Sie einmal bei und kehren Sie dann jeden Tag für die nächste kleine Wiederherstellungsaktion zurück. Sie können alle sieben Tage jederzeit eine Vorschau anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join once, then return each day for the next small recovery action. You can preview all seven days anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Únase una vez y vuelva cada día por la siguiente acción de recuperación. Puede previsualizar los siete días en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoignez une fois, puis revenez chaque jour pour la prochaine petite action de récupération. Vous pouvez prévisualiser les sept jours à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unisciti una volta, quindi tornare ogni giorno per la prossima piccola azione di recupero. Puoi visualizzare in anteprima tutti e sette i giorni in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度に、次の小さな回復アクションのために毎日戻ります。 いつでも7日間のプレビューが可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번에 가입하면 다음 작은 복구 작업을 매일 반환합니다. 7 일 언제든지 미리보기 할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz raz, potem wracaj codziennie po kolejne małe działanie. Możesz podejrzeć wszystkie siedem dni w każdej chwili."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присоединись один раз и возвращайся каждый день за следующим действием. Все семь дней можно посмотреть заранее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需参与一次，随后每日返回即可进行下一项小型恢复操作。您可随时预览全部七天内容。"
          }
        }
      }
    },
