    "recovery.insight.lowDeep.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefschlaf war begrenzt, was die körperliche Erholungsqualität beeinträchtigen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep sleep was limited, which may reduce physical recovery quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño profundo fue limitado, lo que puede reducir la recuperación física."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil profond était limité, ce qui peut réduire la qualité de récupération physique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno profondo era limitato, che può ridurre la qualità di recupero fisico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディープスリープは、物理的な回復品質を低下させることができる限られた、でした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깊은 잠은 제한되었습니다, 육체적인 회복 질을 감소시킬지도 모릅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen głęboki był ograniczony, co może obniżyć fizyczną regenerację."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубокого сна было мало, что может снизить качество физического восстановления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深睡有限，可能降低身体恢复质量。"
          }
        }
      }
    },
