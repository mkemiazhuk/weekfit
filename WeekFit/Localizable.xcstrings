        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快適な範囲内にとどまってください。深さや強度を無理に追求しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편안한 범위 내에 머무르세요. 깊이나 강도를 억지로 조절하지 마세요."
