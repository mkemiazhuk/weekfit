    "settings.profile.bodyGoal.missingHealthNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health hat noch kein Gewicht oder keine Größe. Wählen Sie das passende Ziel — Kalorien- und Aktivitätsziele folgen daraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health does not have your weight or height yet. Pick the goal that fits you — calories and activity targets will follow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health aún no tiene su peso ni estatura. Elija el objetivo que encaje: las calorías y metas de actividad seguirán ese objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health n'a pas encore votre poids ni votre taille. Choisissez l'objectif qui vous convient — les calories et l'activité suivront."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health non ha ancora peso o altezza. Scegli l’obiettivo adatto — calorie e obiettivi attività seguiranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Healthに体重や身長がまだありません。合う目標を選んでください — カロリーとアクティビティ目標はそれに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health에 체중이나 키가 아직 없습니다. 맞는 목표를 고르세요 — 칼로리와 활동 목표가 따라갑니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health nie ma jeszcze wagi ani wzrostu. Wybierz cel, który pasuje — kalorie i cele aktywności będą go odzwierciedlać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Apple Health пока нет веса или роста. Выберите цель — от неё посчитаются калории и активность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health 目前尚未获取您的体重或身高数据。请选择适合您的目标——卡路里与活动目标将自动随之设定。"
          }
        }
      }
    },
