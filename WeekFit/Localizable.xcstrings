    "insights.vm.opportunity.proveLoad.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Verbesserung wird wahrscheinlich von der Absorption der aktuellen Trainingslast kommen, nicht mehr Volumen hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next improvement is likely to come from absorbing the current training load, not adding more volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La próxima mejora probablemente vendrá de absorber la carga actual, no de añadir más volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prochaine amélioration viendra probablement de l'absorption de la charge actuelle, pas de plus de volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prossimo miglioramento è probabile che venga da assorbire il carico di allenamento corrente, non aggiungendo più volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の改善は、より多くのボリュームを追加しない、現在のトレーニング負荷を吸収することから来る可能性が高いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 개선은 현재 교육 부하를 흡수하여 더 많은 볼륨을 추가 할 가능성이 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejna poprawa prawdopodobnie wyniknie z absorpcji obecnego obciążenia, a nie z większego wolumenu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующее улучшение скорее придёт от усвоения текущей нагрузки, а не от добавления объёма."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来的提升更多源于对当前负荷的掌握，而非增加负荷量。"
          }
        }
      }
    },
    "insights.vm.opportunity.proveLoad.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
