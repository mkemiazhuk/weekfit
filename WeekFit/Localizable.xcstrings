    "onboarding.v6.coach.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach reads recovery, activity, nutrition and plans — then gives a clear next step, not just more numbers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренер учитывает восстановление, активность, питание и планы — и даёт ясный следующий шаг, а не ещё цифры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练会评估患者的恢复情况、活动量及营养状况并制定计划——随后给出明确的后续步骤，而非仅提供更多数据。"
          }
        }
      }
    },
    "onboarding.v6.coach.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tells you what matters next."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренер говорит, что важно сейчас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练会告诉你接下来该关注什么。"
          }
        }
      }
    },
