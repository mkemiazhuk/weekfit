    "support.faq.item11.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMR (Grundumsatz) ist Ihr geschätzter Grundenergiebedarf — die Kalorien, die Ihr Körper in Ruhe verbraucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMR (Basal Metabolic Rate) is your estimated base energy need — the calories your body uses at rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMR (tasa metabólica basal) es su necesidad energética estimada en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le BMR (métabolisme de base) est votre besoin énergétique estimé au repos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMR (metabolismo basale) è il fabbisogno energetico base stimato — le calorie a riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMR（基礎代謝率）は推定の基礎エネルギー必要量 — 安静時に体が使うカロリーです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMR(기초대사량)는 추정 기본 에너지 필요량 — 휴식 시 몸이 쓰는 칼로리입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMR (podstawowa przemiana materii) to szacunkowe zapotrzebowanie energetyczne w spoczynku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMR (базальный обмен) — это примерная базовая потребность в энергии: калории, которые тело тратит в покое."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基础代谢率（BMR）是您估算的基础能量需求——即您的身体在静息状态下消耗的卡路里。"
          }
        }
      }
    },
