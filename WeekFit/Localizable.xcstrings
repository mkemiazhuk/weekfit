    "coach.priority.aShortCompletedActivityIsRecentEnough.3695" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze abgeschlossene Aktivität ist kürzlich genug, um sich daran zu erinnern, aber nicht intensiv genug für die Erholung nach dem Training."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short completed activity is recent enough to remember, but not heavy enough for post-workout recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una actividad corta completada es lo bastante reciente para recordarla, pero no lo bastante pesada para recuperación post-entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une courte activité terminée est assez récente pour s'en souvenir, mais pas assez lourde pour une récupération post-entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'attività breve e completata è abbastanza recente da ricordarla, ma non abbastanza intensa da richiedere il recupero post-allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短時間で完了した活動は、記憶するには十分に最近ですが、運動後の回復には十分な負荷ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧게 완료된 활동은 기억할 수 있을 만큼 최근이지만, 운동 후 회복을 위해 충분히 강하지는 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótka ukończona aktywność jest na tyle świeża, by ją pamiętać, ale nie na tyle ciężka na regenerację po treningu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткая активность была недавно, но она недостаточно тяжелая, чтобы требовать восстановления после тренировки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一项简短的已完成训练项目记忆犹新，但其强度尚不足以影响训练后的恢复。"
          }
        }
      }
    },
