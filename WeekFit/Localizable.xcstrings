    "challenge.recovery7.overview.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmen Sie an einer kostenlosen siebentägigen Übung mit einer sanften Aktion jeden Tag teil. Sie bestätigen jeden Tag selbst - nichts ist von Apple Health als vollständig gekennzeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join a free seven-day practice with one gentle action each day. You confirm each day yourself—nothing is marked complete from Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Únase a una práctica gratuita de siete días con una acción suave cada día. Usted confirma cada día; nada se marca desde Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoignez une pratique gratuite de sept jours avec une action douce chaque jour. Vous confirmez chaque jour vous-même — rien n'est marqué terminé depuis Apple Health."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unire una pratica libera di sette giorni con un'azione gentile ogni giorno. Confermate ogni giorno voi stessi – niente è segnato completo da Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日1つの穏やかな行動で無料の7日間の練習に参加してください。 Apple Healthから毎日確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 한 개의 부드러운 행동을 가진 무료 7 일 연습에 가입하십시오. 매일 자신을 확인-nothing은 Apple Health에서 완료됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz do bezpłatnej siedmiodniowej praktyki z łagodnym działaniem dziennie. Potwierdzasz sam — nic nie jest oznaczane z Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатная семидневная практика: одно мягкое действие каждый день. Вы сами отмечаете выполнение — Apple Health ничего не отмечает автоматически."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加为期七天的免费练习计划，每天只需进行一次温和的练习。您每天自行确认完成情况——Apple Health 中不会显示任何项目已完成。"
          }
        }
      }
    },
