    "Sleep stages and recovery insights may take a few valid nights before they appear consistently." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlafphasen und Erholungserkenntnisse können einige gültige Nächte dauern, bevor sie konsistent erscheinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep stages and recovery insights may take a few valid nights before they appear consistently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fases de sueño y análisis de recuperación pueden tardar varias noches válidas en mostrarse con regularidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les phases de sommeil et analyses de récupération peuvent nécessiter quelques nuits valides avant d’apparaître régulièrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fasi del sonno e le intuizioni di recupero possono richiedere alcune notti valide prima che appariscano costantemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠段階と回復の洞察は、一貫して表示される前に、いくつかの有効な夜を取ることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 단계 및 복구 통찰력은 일관되게 나타나기 전에 몇 가지 유효한 밤을 취할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fazy snu i analizy regeneracji mogą wymagać kilku poprawnych nocy, zanim pojawią się regularnie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стадии сна и выводы о восстановлении могут начать стабильно появляться после нескольких корректно записанных ночей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠阶段及关于恢复情况的结论，可能在经历数夜规范记录后开始稳定显现。"
          }
        }
      }
    },
