    "coach.scenario.heatBefore.late.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende heute Abend Wärme zur Unterstützung der Erholung. Halte die Sitzung angenehm, damit sie den Schlaf nicht stört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use heat as recovery support tonight. Keep the session comfortable so it does not disturb sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use el calor como apoyo de recuperación esta noche. Mantenga la sesión cómoda para no alterar el sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la chaleur comme soutien à la récupération ce soir. Gardez la séance confortable pour ne pas perturber le sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il calore come supporto per il recupero stasera. Mantieni la sessione confortevole in modo che non disturbi il sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜は回復サポートとして温熱を使用してください。睡眠を妨げないように、セッションは快適に保ちましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 밤에는 회복 지원을 위해 열을 사용하세요. 수면을 방해하지 않도록 세션을 편안하게 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystaj ciepło jako wsparcie regeneracji dziś wieczorem. Utrzymuj sesję komfortową, by nie zakłócać snu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте тепло сегодня вечером как поддержку восстановления. Держите тепло комфортным, чтобы оно не нарушило сон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今晚可利用体温辅助恢复。保持体感温暖，以免影响睡眠。"
          }
        }
      }
    },
    "coach.scenario.heatBefore.normal.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Hitzesitzung moderat. Das Ziel ist Entspannung und Erholung, nicht Ausdauer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the heat session moderate. The goal is relaxation and recovery, not endurance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga la sesión de calor moderada. El objetivo es relajación y recuperación, no resistencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la séance de chaleur modérée. L’objectif est la détente et la récupération, pas l’endurance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la sessione di calore moderata. L'obiettivo è il rilassamento e il recupero, non la resistenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱のセッションは中程度に保ってください。目標はリラクゼーションと回復であり、持久力ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 세션을 적당히 유지하세요. 목표는 지구력이 아니라 휴식과 회복입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj sesję cieplną umiarkowaną. Celem jest relaks i regeneracja, nie wytrzymałość."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите тепло умеренным. Цель — расслабление и восстановление, а не выносливость."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将热身训练强度保持在适中水平。其目的在于促进放松与恢复，而非提升耐力。"
          }
        }
      }
    },
