    "recovery.stressIndex.howToUse.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den Stress Index als zusätzlichen Kontext für die physiologische Belastung. Der Recovery Score bleibt das Hauptsignal für die Bereitschaft — berücksichtige auch Schlaf, aktuelle Last und dein Gefühl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Stress Index as supporting context for how much physiological strain your body appears to be under. Keep Recovery Score as the primary readiness signal, and weigh sleep, recent workload, and how you feel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el Stress Index como contexto auxiliar de la carga fisiológica. La puntuación de recuperación sigue siendo la señal principal de preparación — considera también el sueño, la carga reciente y cómo te sientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le Stress Index comme contexte secondaire sur la charge physiologique. Le score de récupération reste le signal principal de disponibilité — tenez aussi compte du sommeil, de la charge récente et de vos sensations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa lo Stress Index come contesto secondario sul carico fisiologico. Il punteggio di recupero resta il segnale principale di disponibilità — considera anche sonno, carico recente e sensazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Indexは体の生理的負荷の補助的な目安として使ってください。回復スコアを主な準備度の信号とし、睡眠・最近の負荷・体感も合わせて考えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index는 몸의 생리적 부담을 보는 보조 맥락으로 사용하세요. 회복 점수를 주된 준비 신호로 두고 수면, 최근 부하, 느낌도 함께 고려하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj Stress Index jako dodatkowego kontekstu obciążenia fizjologicznego. Wynik regeneracji zostaje głównym sygnałem gotowości — uwzględnij też sen, ostatnie obciążenie i samopoczucie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используй Stress Index как дополнительный контекст физиологической нагрузки. Оценка восстановления остаётся главным сигналом готовности — учитывай также сон, недавнюю нагрузку и самочувствие."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 Stress Index 作为生理负荷的辅助参考。恢复评分仍是主要的准备度信号——同时结合睡眠、近期负荷和主观感受。"
          }
        }
      }
    },
