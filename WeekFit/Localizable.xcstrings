    "today.aiCoach.doneLowWaterFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline abgeschlossen, aber Hydration unterschritten ( %@ L). Gehen Sie NICHT dehydriert schlafen. Trinken Sie jetzt 300 ml Wasser für stabile Nacht-Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline cleared, but hydration failed (%@L). DO NOT go to sleep dehydrated. Sip 300ml of water now to stabilize night recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Línea de time completada, pero la hidratación falló ( %@ L). No se acueste deshidratado. Beba 300 ml de agua ahora para estabilizar la recuperación nocturna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline terminée, mais hydratation insuffisante ( %@ L). Ne vous couchez pas déshydraté. Buvez 300 ml d'eau maintenant pour stabiliser la récupération nocturne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline completata, ma idratazione insufficiente ( %@ L). NON andare a dormire disidratato. Bevi 300 ml d’acqua ora per stabilizzare il recupero notturno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムラインはクリアしましたが、水分が不足（ %@ リットル）。脱水のまま就寝しないでください。今すぐ300ミリリットルの水を摂り、夜の回復を安定させて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타임라인은 완료했지만 수분 부족( %@ 리터). 탈수 상태로 자지 마세요. 지금 물 300밀리리터를 마셔 밤 회복을 안정시키세요."
          }
