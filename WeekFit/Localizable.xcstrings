    "coach.insight.someScheduledTasksPassedWithoutUpdatesMark.522" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige geplante Aufgaben wurden ohne Updates abgeschlossen. Markieren Sie sie als erledigt oder übersprungen, damit der Coach sich anpassen kann."
