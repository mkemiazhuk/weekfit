    "recovery.recoveryIsModerateKeepIntensityControlledUntilSignalsImprove" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erholung ist moderat. Halten Sie die Intensität kontrolliert, bis sich die Signale verbessern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery is moderate. Keep intensity controlled until signals improve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación es moderada. Controle la intensidad hasta que mejoren las señales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération est modérée. Gardez l'intensité sous contrôle jusqu'à amélioration des signaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero è moderato. Mantenere l'intensità controllata fino a quando i segnali migliorano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復は適度です。 信号が改善するまでの強度制御を維持して下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구는 온건합니다. 신호가 향상될 때까지 강도를 유지하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja jest umiarkowana. Kontroluj intensywność, dopóki sygnały się nie poprawią."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление умеренное. Держите интенсивность под контролем, пока сигналы не улучшатся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复中等。信号改善前，请控制强度。"
          }
        }
      }
    },
