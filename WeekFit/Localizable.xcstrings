    "coach.priority.onceLoadIsHighMoreStressIs.4588" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Last hoch ist, ist mehr Stress selten die Gelegenheit. Die Arbeit zu bewältigen, ist es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once load is high, more stress is rarely the opportunity. Absorbing the work is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la carga es alta, más estrés rara vez es la oportunidad. Absorber el trabajo lo es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois la charge élevée, plus de stress est rarement l'opportunité. Absorber le travail l'est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta che il carico è elevato, più stress raramente è l'opportunità. Assorbire il lavoro lo è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負荷が高いとき、さらなるストレスはめったにチャンスではありません。仕事を吸収することこそがチャンスです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일이 많을 때, 더 많은 스트레스는 거의 기회가 되지 않는다. 일을 흡수하는 것이 기회이다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy obciążenie jest wysokie, więcej stresu rzadko jest szansą. Wchłanianie pracy — tak."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда нагрузка уже высокая, дополнительный стресс редко дает пользу. Важнее усвоить сделанную работу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦负荷过高，增加应力往往并非可行之选；此时，将负荷吸收才是正确做法。"
          }
        }
      }
    },
