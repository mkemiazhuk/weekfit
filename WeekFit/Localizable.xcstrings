    "meals.starter.beefBuckwheat.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen Sie den Buchweizen in gesalzenem Wasser bis zart und flauschig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook the buckwheat in salted water until tender and fluffy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine el alforfón en agua con sal hasta que quede tierno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez le sarrasin dans de l'eau salée jusqu'à tendreté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuocere il grano saraceno in acqua salata fino a tenera e soffice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔らかく、ふわふわまで塩水でそばを炊きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소금물에 buckwheat를 쿡하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugotuj grykę w osolonej wodzie do miękkości."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отварите гречку в подсоленной воде до мягкости и рассыпчатости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将荞麦放入加盐的水中煮熟，直至变软且蓬松。"
          }
        }
      }
    },
    "meals.starter.beefBuckwheat.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saison das Rindfleisch und Sear über hohe Hitze, bis zu Ihrem Geschmack gebräunt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Season the beef and sear over high heat until browned to your liking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sazone la ternera y selle a fuego alto hasta el punto deseado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assaisonnez le bœuf et saisissez à feu vif jusqu'à la coloration souhaitée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condiziona il manzo e sega a fuoco alto fino a brunire a vostro piacimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肉を焼くまで、高い熱で牛肉とシーサーを味わってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쇠고기 시즌과 높은 열을 통해 당신의 리킹에 갈색."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopraw wołowinę i obsmaż na mocnym ogniu do pożądanej barwy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приправьте говядину и обжарьте на сильном огне до нужной степени прожарки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给牛肉调味，然后用大火煎至所需熟度。"
          }
        }
      }
    },
    "meals.starter.beefBuckwheat.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauté die Pilze, bis ihre Feuchtigkeit verdunstet und sie golden werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauté the mushrooms until their moisture evaporates and they turn golden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltee los champiñones hasta que se evapore la humedad y se doren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites sauter les champignons jusqu'à évaporation de l'humidité et coloration dorée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versare i funghi fino a quando la loro umidità evapora e diventano d'oro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キノコは水分が蒸発し、黄金色になるまで煮込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그들의 습기 evaporates 및 그들은 황금을 돌 때까지 버섯."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaż grzyby, aż woda odparuje i zrumienią się."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обжарьте грибы, пока не уйдёт влага и они не станут золотистыми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将蘑菇翻炒至水分蒸发、色泽呈金黄色。"
          }
        }
      }
    },
    "meals.starter.beefBuckwheat.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
