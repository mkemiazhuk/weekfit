          }
        }
      }
    },
    "challenge.recovery7.v2.task.3.criterion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a comfortable 15-minute walk, or choose an accessible movement alternative. Shorter sessions can add up to 15 minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
