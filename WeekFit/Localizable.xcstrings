    "meals.starter.shoyuRamen.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bauen Sie eine leichte Shoyu-Brühe mit Sojasauce, Knoblauch und Pilzaroma."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build a light shoyu broth with soy sauce, garlic, and mushroom aroma."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare un caldo shoyu ligero con salsa de soja, ajo y aroma de setas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez un bouillon shoyu léger avec sauce soja, ail et arôme de champignon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruisci un brodo shoyu leggero con salsa di soia, aglio e aroma di fungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "醤油、ニンニク、マッシュルームの香りで、軽く醤油スープをつくります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간장, 마늘, 버섯 향기로 가벼운 shoyu 국물을 만듭니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przygotuj lekki bulion shoyu z soją, czosnkiem i aromatem grzybów."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сварите лёгкий соевый бульон с чесноком и ароматом грибов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用酱油、大蒜和蘑菇香调出清淡的素汤。"
          }
        }
      }
    },
    "meals.starter.shoyuRamen.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen Sie Nudeln bis federnd, dann abtropfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook noodles until springy, then drain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine los fideos hasta que queden firmes y escúrralos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez les nouilles jusqu'à ce qu'elles soient fermes, puis égouttez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuocere spaghetti fino a primavera, poi scolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヌードルをバネまで煮込み、ドレインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봄까지 쿡 국수, 그 후 배수."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotuj makaron, aż będzie sprężysty, następnie odcedź."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отварите лапшу до упругости и слейте воду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将面条煮至有弹性，然后沥干。"
          }
        }
      }
    },
    "meals.starter.shoyuRamen.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfannen Sie das Schweinefleisch kurz und schneiden Sie das weich gekochte Ei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pan-sear the pork briefly and slice the soft-boiled egg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dore el cerdo brevemente en la sartén y corte el huevo pasado por agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez brièvement le porc à la poêle et tranchez l'œuf mollet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pan-sear il maiale brevemente e tagliare l'uovo morbido-boiled."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "豚肉を軽く炒め、ゆるやかな卵をスライス。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돼지고기와 부드러운 계란을 슬라이딩합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótko obsmaż wieprzowinę na patelni i pokrój jajko na miękko."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слегка обжарьте свинину и нарежьте яйцо всмятку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将猪肉快速煎至熟透，然后将溏心蛋切片。"
          }
        }
      }
    },
    "meals.starter.shoyuRamen.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfannenbrühe über Nudeln und oben mit Schweinefleisch, Eiern und Pilzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladle broth over noodles and top with pork, egg, and mushrooms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierta el caldo sobre los fideos y cubra con cerdo, huevo y setas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versez le bouillon sur les nouilles et garnissez de porc, œuf et champignons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brodo di mestolo su tagliatelle e top con maiale, uovo e funghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麺の上と豚肉、卵、マッシュルームで炒める。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국수와 돼지고기, 계란, 버섯을 곁들인다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalej makaron bulionem i udekoruj wieprzowiną, jajkiem i grzybami."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залейте лапшу бульоном и выложите сверху свинину, яйцо и грибы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将高汤淋在面条上，最后铺上猪肉、鸡蛋和蘑菇。"
          }
        }
      }
    },
