    "coach.priority.recoveryActivitiesShouldReinforceRestraintNotCreate.4227" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholungsaktivitäten sollten Zurückhaltung verstärken, nicht eine weitere Erholungsaufgabe schaffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery activities should reinforce restraint, not create another recovery task."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actividades de recuperación deben reforzar la contención, no crear otra tarea de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les activités de récupération doivent renforcer la retenue, pas créer une autre tâche de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le attività di recupero dovrebbero rafforzare la moderazione, non creare un altro compito di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復活動は、別の回復タスクを作るのではなく、抑制を強化するべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복 활동은 또 다른 회복 과제를 만들기보다는 절제를 강화해야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywności regeneracyjne powinny wzmacniać powściągliwość, a nie tworzyć kolejnego zadania regeneracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановительные активности должны помогать сдержанности, а не создавать еще одну задачу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复活动应有助于强化自我约束，而非增加额外的恢复任务。"
          }
        }
      }
    },
