    "coach.priority.fallbackShouldOnlyHappenWhenThereIs.4348" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fallback sollte nur dann stattfinden, wenn es wirklich nichts Nützliches zu überlegen gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback should only happen when there is truly nothing useful to reason about."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fallback solo debería ocurrir cuando no hay nada útil que razonar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le repli ne devrait avoir lieu que s'il n'y a vraiment rien d'utile à analyser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fallback dovrebbe avvenire solo quando non c'è davvero nulla di utile su cui ragionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォールバックは、本当に何も有用な推論材料がない場合にのみ発生するべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체는 정말로 논리적으로 이용할 수 있는 것이 전혀 없을 때만 발생해야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback powinien nastąpić tylko wtedy, gdy naprawdę nie ma nic sensownego do rozważenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервный текст нужен только когда действительно не о чем полезно сказать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在确实无法进行有效推理时，才应启用备用方案。"
          }
        }
      }
    },
