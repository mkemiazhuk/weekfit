    "recovery.insight.moderate.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf war nützlich, aber die Genesungssignale waren nicht vollständig optimal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep was useful, but recovery signals were not fully optimal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño fue útil, pero las señales de recuperación no fueron del todo óptimas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil a été utile, mais les signaux de récupération n'étaient pas optimaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno era utile, ma i segnali di recupero non erano completamente ottimali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は便利でしたが、回復信号は完全に最適ではありませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면이 유용했지만 복구 신호는 완전히 최적화되지 않았습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen był pomocny, ale sygnały regeneracji nie były w pełni optymalne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон был полезен, но сигналы восстановления не были полностью оптимальными."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠有帮助，但恢复信号尚未完全理想。"
          }
        }
      }
    },
