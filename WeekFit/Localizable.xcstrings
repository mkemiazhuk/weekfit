    "coach.priority.nothingUsefulNeedsSolvingOvernightSleepIs.5138" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts Nützliches muss über Nacht gelöst werden. Schlaf ist der wertvollste Schritt, bevor der Morgenplan zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing useful needs solving overnight. Sleep is the highest-value move before the morning plan matters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada útil necesita resolverse de noche. El sueño es el movimiento de mayor valor antes de que importe el plan matutino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien d'utile ne demande à être résolu cette nuit. Le sommeil est le mouvement le plus précieux avant que le plan du matin compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla di utile necessita di essere risolto durante la notte. Dormire è la mossa di massimo valore prima che il piano del mattino conti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "役に立つことは一晩で解決する必要はない。朝の計画が重要になる前に、睡眠が最も価値のある行動だ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하룻밤 사이에 해결해야 할 유용한 것은 없다. 아침 계획이 중요해지기 전에는 잠이 가장 가치 있는 선택이다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic użytecznego nie wymaga rozwiązania w nocy. Sen to ruch o najwyższej wartości, zanim liczy się poranny plan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночью ничего полезного решать не нужно. До утреннего плана лучший шаг — сон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有什么有价值的事情需要一夜之间完成。在制定晨间计划之前，睡眠才是最具价值的举措。"
          }
        }
      }
    },
