    "coach.final.avoid.fuel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not wait to eat until energy has already dropped."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не откладывайте еду до момента, когда энергия уже провалится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿等到体力下降后才进食。"
          }
        }
      }
    },
    "coach.final.avoid.hydration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not catch up with one large amount of water."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не догоняйте воду одним большим объемом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿一次性饮用大量水。"
          }
        }
      }
    },
    "coach.final.avoid.live": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not turn the current session into extra stress."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не превращайте текущую тренировку в лишний стресс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿将当前会话变成额外的压力源。"
          }
        }
      }
    },
    "coach.final.avoid.prepare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not spend your best energy before the main session starts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не тратьте силы до начала основной нагрузки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要在主环节开始前耗尽你的最佳精力。"
          }
        }
      }
    },
    "coach.final.avoid.readiness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not use readiness as a reason to add extra work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не используйте готовность как повод добавлять лишнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿以“尚未准备就绪”为由增加额外工作量。"
          }
        }
      }
    },
    "coach.final.avoid.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not add load when recovery is already the useful priority."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не добавляйте нагрузку, когда восстановление уже важнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当恢复已作为重要优先级时，请勿增加负载。"
          }
        }
      }
    },
    "coach.final.avoid.stable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not add tasks where the day is already working."
