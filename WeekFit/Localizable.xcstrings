    "meals.starter.salmonNigiri.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen Sie Sushi-Reis bis zart, dann würzen Sie leicht mit Reisessig und einer Prise Salz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook sushi rice until tender, then season lightly with rice vinegar and a pinch of salt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine el arroz para sushi hasta tierno y aderece ligeramente con vinagre de arroz y una pizca de sal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez le riz à sushi jusqu'à tendreté, puis assaisonnez légèrement de vinaigre de riz et d'une pincée de sel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuocere riso sushi fino a tenero, quindi condire leggermente con aceto di riso e un pizzico di sale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "米酢と塩のピンチで軽く煮る。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쿡 스시 밥을 부드럽게 할 때까지, 그 후 계절 쌀 식초와 소금의 꼬치."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugotuj ryż do sushi do miękkości, lekko skrop octem ryżowym i szczyptą soli."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отварите рис для суши до готовности и слегка заправьте рисовым уксусом с щепоткой соли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将寿司米煮至软烂，然后用米醋和少许盐轻调味。"
          }
        }
      }
    },
    "meals.starter.salmonNigiri.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneiden Sie den Lachs in dünne Stücke über die Breite von zwei Fingern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slice the salmon into thin pieces about the width of two fingers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corte el salmón en láminas finas del ancho de dos dedos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tranchez le saumon en fines lamelles environ de la largeur de deux doigts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagliare il salmone in pezzi sottili sulla larghezza di due dita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本の指の幅について細い部分に鮭をスライスします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연어를 2개의 손가락의 폭에 관하여 얇은 조각으로 결합하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrój łososia na cienkie plastry około szerokości dwóch palców."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нарежьте лосось тонкими ломтиками шириной примерно с два пальца."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将三文鱼切成约两指宽的薄片。"
          }
        }
      }
    },
    "meals.starter.salmonNigiri.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forme den Reis in kleine Ovale und überdecke jedes Stück mit Lachs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shape the rice into small ovals and top each piece with salmon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forme el arroz en óvalos pequeños y cubra cada uno con salmón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formez le riz en petits ovales et posez le saumon sur chaque pièce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formare il riso in piccoli ovali e top ogni pezzo con salmone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "米を小さな卵巣に形づけ、鮭で各部分を上ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
