      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetze, was die Sitzung verbraucht hat, ohne das Tagesziel vollständig zu verfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace what the session spent without chasing the full day target."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reponga lo que gastó la sesión sin perseguir el objetivo diario completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacez ce que la séance a dépensé sans courir après l'objectif journalier complet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci ciò che la sessione ha speso senza inseguire l'obiettivo dell'intera giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションで消費した分を、1日の目標を追いかけずに補充してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션에서 소비한 것을 하루 전체 목표를 쫓지 않고 교체하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzupełnij to, co sesja wydała, bez gonienia pełnego dziennego celu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Верните то, что потратила тренировка, без погони за дневной целью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将训练所耗时间返还，无需追逐每日目标。"
          }
        }
      }
    },
