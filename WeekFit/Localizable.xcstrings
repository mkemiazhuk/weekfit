    "activity.youAreCloseToYourTargetAShortWalk" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind nahe an Ihrem Ziel. Ein kurzer Spaziergang kann den Tag abrunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are close to your target. A short walk may complete the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está cerca de su objetivo. Una caminata corta puede completar el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes proche de votre objectif. Une courte marche peut compléter la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È vicino al Suo obiettivo. Una breve camminata può completare la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標に近づいています。短いウォークで今日を締めくくれるかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표에 가깝습니다. 짧은 걷기로 하루를 마무리할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest blisko celu. Krótki spacer może domknąć dzień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы близко к цели. Короткая прогулка может закрыть день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已接近目标。再走一小段或许就能完成今天。"
          }
        }
      }
    },
