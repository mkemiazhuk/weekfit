    "coach.copy.noFoodLoggedYetIfYourFirst.216": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No food logged yet. If your first meal is planned later, keep hydration steady and avoid unnecessary snacking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет ни одной записи о еде. Если первый прием пищи будет позже, пейте воду ровно и не перекусывайте просто так."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未记录进食情况。若您的第一餐计划稍后进食，请保持水分摄入稳定，并避免不必要的零食摄入。"
          }
        }
      }
    },
    "coach.copy.noFoodLoggedYetIfYouTrain.201": {
