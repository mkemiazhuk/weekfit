    },
    "meals.starter.chickenRamen.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weich kochen die Eier, dann halbieren sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft-boil the eggs, then halve them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
