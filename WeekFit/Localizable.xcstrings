          }
        }
      }
    },
    "recovery.stressIndex.confidence.medium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent signal coverage is limited, so today’s estimate is less certain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покрытие недавних сигналов ограничено, поэтому сегодняшняя оценка менее уверенная."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期信号覆盖有限，因此今日估算把握较低。"
          }
        }
      }
    },
    "recovery.stressIndex.conflict.highRecoveryElevatedStress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear generally recovered, but current physiological strain is elevated. Consider a controlled session rather than maximum intensity."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целом вы выглядите восстановленными, но текущая физиологическая нагрузка повышена. Рассмотрите контролируемую тренировку вместо максимальной интенсивности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整体恢复不错，但当前生理负荷偏高。建议可控训练，而非最大强度。"
          }
        }
      }
    },
    "recovery.stressIndex.conflict.highRecoveryLowStress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery and stress signals both support normal training."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигналы восстановления и нагрузки поддерживают обычную тренировку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复与负荷信号都支持正常训练。"
          }
        }
      }
    },
    "recovery.stressIndex.conflict.lowRecoveryHighStress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is low and several physiological signals are outside baseline. Prioritize recovery today."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление низкое, и несколько физиологических сигналов вне базового уровня. Сегодня лучше сделать приоритетом восстановление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复偏低，且多项生理信号偏离基线。今天优先恢复。"
          }
        }
      }
    },
    "recovery.stressIndex.conflict.lowRecoveryLowStress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stress signals are calm, but recovery is limited by sleep or accumulated fatigue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигналы нагрузки спокойны, но восстановление ограничено сном или накопленной усталостью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负荷信号平稳，但恢复受睡眠或累积疲劳限制。"
          }
        }
      }
    },
    "recovery.stressIndex.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stress Index estimates physiological strain from available health and activity signals. It is not a medical diagnosis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс нагрузки оценивает физиологическую нагрузку по доступным сигналам здоровья и активности. Это не медицинский диагноз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负荷指数根据可用的健康与活动信号估算生理负荷，并非医学诊断。"
          }
        }
      }
    },
