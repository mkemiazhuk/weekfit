    "recovery.stressIndex.about.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index schätzt die physiologische Belastung aus verfügbaren Gesundheits- und Aktivitätssignalen in Bezug auf Ihre persönlichen Grundlinien. Höhere Werte bedeuten im Allgemeinen eine größere detektierte Dehnung; sie sind nicht das Gegenteil von Recovery Score."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index estimates physiological strain from available health and activity signals relative to your personal baselines. Higher values generally mean greater detected strain; they are not the inverse of Recovery Score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index estima la tensión fisiológica a partir de señales de salud y actividad disponibles respecto a sus referencias personales. Valores más altos suelen indicar mayor tensión detectada; no es lo opuesto a la puntuación de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Stress Index estime la tension physiologique à partir des signaux de santé et d'activité disponibles, par rapport à vos références personnelles. Des valeurs plus élevées indiquent en général une tension détectée plus forte ; ce n'est pas l'inverse du score de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index stima il ceppo fisiologico dai segnali di salute e attività disponibili relativi alle vostre basi personali. Valori più elevati generalmente significano una maggiore varietà rilevata; non sono l'inverso di Recovery Score."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index は、個人のベースラインと比較して、利用可能な健康状態および活動シグナルから生理学的負担を推定します。一般に、値が高いほど、検出されるひずみが大きくなります。それらは回復スコアの逆数ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index는 개인 기준을 기준으로 이용 가능한 건강 및 활동 신호로부터 생리적 부담을 추정합니다. 값이 높을수록 일반적으로 감지된 변형률이 더 크다는 의미입니다. 이는 회복 점수의 반대가 아닙니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index szacuje obciążenie fizjologiczne na podstawie dostępnych sygnałów zdrowia i aktywności względem osobistych linii bazowych. Wyższe wartości zwykle oznaczają większe wykryte obciążenie; to nie odwrotność wyniku regeneracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индекс нагрузки оценивает физиологическую нагрузку по доступным сигналам здоровья и активности относительно ваших личных базовых уровней. Более высокие значения обычно означают большую обнаруженную нагрузку; это не обратная величина оценки восстановления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负荷指数基于可获取的健康与活动信号，相对于您的个人基准水平，对生理负荷进行评估。数值越高通常表示检测到的负荷越大；但该指数并非恢复能力评估的倒数指标。"
          }
        }
      }
    },
