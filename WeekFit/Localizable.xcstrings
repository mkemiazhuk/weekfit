    "recovery.insight.interrupted.action" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlafkontinuität hatte einen sichtbaren Einfluss auf die Erholungsqualität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep continuity had a visible impact on recovery quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La continuidad del sueño tuvo un impacto visible en la calidad de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La continuité du sommeil a eu un impact visible sur la qualité de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La continuità del sonno ha avuto un impatto visibile sulla qualità del recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠連続性は回復品質に目に見える影響を持っていた。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep continuity는 회복 질에 눈에 보이는 충격을 가지고 있었습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciągłość snu wyraźnie wpłynęła na jakość regeneracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непрерывность сна заметно повлияла на качество восстановления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠的连续性对恢复质量产生了显著影响。"
          }
        }
      }
    },
