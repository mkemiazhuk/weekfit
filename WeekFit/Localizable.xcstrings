          "stringUnit": {
            "state": "translated",
            "value": "请选择您今晚开始减速的时间。"
          }
        }
      }
    },
    "challenge.recovery7.task.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make space to unwind"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободите время, чтобы расслабиться"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打造一处放松身心的空间"
          }
        }
      }
    },
    "challenge.recovery7.task.2.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stretch, breathe, or move lightly—stay within what feels good today."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Растяжка, дыхание или лёгкое движение — в комфортных пределах на сегодня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉伸、呼吸或轻微活动——目前均在舒适范围内。"
          }
        }
      }
    },
    "challenge.recovery7.task.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take five minutes for gentle movement that feels comfortable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уделите пять минут мягкому движению, которое вам комфортно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花五分钟时间，进行一种您感到舒适的轻柔运动。"
          }
        }
      }
    },
    "challenge.recovery7.task.3.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an option that matches your energy and surroundings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите вариант под вашу энергию и окружение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择与您能量水平和周围环境相匹配的选项。"
          }
        }
      }
    },
    "challenge.recovery7.task.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make time for a comfortable walk or an accessible movement alternative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите время для комфортной прогулки или доступной альтернативы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预留时间进行舒适的步行，或选择其他便于行动的活动替代方案。"
          }
        }
      }
    },
    "challenge.recovery7.task.4.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short pause without screens can help you settle before bed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткая пауза без экранов поможет спокойнее перейти ко сну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在睡前短暂远离电子屏幕，有助于您平静下来。"
          }
        }
      }
    },
    "challenge.recovery7.task.4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set aside a quiet moment to unwind this evening."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите тихое время, чтобы вечером разгрузиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抽出一段安静的时间，在傍晚时分放松身心。"
          }
        }
      }
    },
    "challenge.recovery7.task.5.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match effort to energy. Rest and lighter movement both count."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подстройте нагрузку под энергию. Отдых и более лёгкое движение тоже считаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将运动强度与能量消耗相匹配。充分休息与减轻运动负荷同样重要。"
          }
        }
      }
    },
    "challenge.recovery7.task.5.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose today’s activity based on how you feel."
          }
        },
