    "recovery.insight.moderateSleep.action" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schauen Sie sich die Wachzeit, den Tiefschlaf und den REM-Schlaf an, um die Punktzahl zu verstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at awake time, deep sleep and REM sleep to understand the score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observe el tiempo despierto, sueño profundo y REM para entender la puntuación."
