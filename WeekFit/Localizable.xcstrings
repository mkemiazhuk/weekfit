    "support.faq.item33.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Sie können Mahlzeiten, Wasser, Workouts, Erholung oder Routinen tagsüber einfach protokollieren und Coach reagieren lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. You can simply log meals, water, workouts, recovery, or routines during the day and let Coach react to your activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. Puede registrar comidas, agua, entrenamientos, recuperación o rutinas durante el día y dejar que Entrenador reaccione a su actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui. Vous pouvez simplement enregistrer repas, eau, entraînements, récupération ou routines dans la journée et laisser Coach réagir à votre activité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì. Puoi registrare pasti, acqua, allenamenti, recupero o routine durante la giornata e lasciare che Coach reagisca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はい。食事、水、ワークアウト、回復、ルーティンをその日に記録するだけで、コーチに反応させられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네. 하루 동안 식사, 물, 운동, 회복, 루틴을 기록하고 코치가 반응하게 할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak. Możesz po prostu logować posiłki, wodę, treningi, regenerację lub rutyny w ciągu dnia, a Trener zareaguje na aktywność."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да. Можно просто записывать еду, воду, тренировки, восстановление или рутины в течение дня, а Тренер будет реагировать на вашу активность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是的。您只需记录每日的饮食、饮水、训练、恢复或日常活动，教练便会针对您的活动情况做出相应反馈。"
          }
        }
      }
    },
    "support.faq.item33.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann ich WeekFit ohne Planung nutzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I use WeekFit without planning?"
          }
        },
        "es" : {
