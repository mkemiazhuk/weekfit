          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga la cena orientata alle proteine"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕食はタンパク質中心に"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저녁은 단백질 중심으로 드세요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
