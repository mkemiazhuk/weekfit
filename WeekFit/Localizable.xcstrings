    "today.aiCoach.hydrationCriticalFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritische Lücke: Sie haben %lld kcal verbrannt, aber nur %@ L getrunken. Ihre Blutviskosität ist erhöht. TRINKEN Sie innerhalb der nächsten Stunde 500 ml mineralisiertes Wasser. Vermeiden Sie Diuretika wie Kaffee."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Critical lag: You burned %lld kcal but only drank %@L. Your blood viscosity is elevated. DRINK 500ml of mineralized water within the next hour. Avoid diuretics like coffee."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retraso crítico: quemó %lld kcal pero solo bebió %@ L. La viscosidad sanguínea está elevada. Beba 500 ml de agua mineralizada en la próxima hora. Evite diuréticos como el café."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retard critique : vous avez brûlé %lld kcal mais n'avez bu que %@ L. Votre viscosité sanguine est élevée. Buvez 500 ml d'eau minéralisée dans l'heure. Évitez les diurétiques comme le café."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardo critico: hai bruciato %lld kcal ma bevuto solo %@ L. La viscosità del sangue è elevata. BEVI 500 ml d’acqua mineralizzata entro un’ora. Evita diuretici come il caffè."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重大な遅れ：%lld キロカロリー消費したのに %@ リットルしか摂取していません。血液粘度が上昇しています。今後1時間以内に500ミリリットルのミネラル水を飲んでください。コーヒーなどの利尿作用は避けて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심각한 지연: %lld 킬로칼로리 소모했지만 %@ 리터만 마셨습니다. 혈액 점도가 높아졌습니다. 1시간 내 500밀리리터 미네랄 워터를 마시세요. 커피 같은 이뇨 작용은 피하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krytyczne opóźnienie: spalono %lld kcal, a wypito tylko %@ L. Lepkość krwi jest podwyższona. Wypij 500 ml wody mineralnej w ciągu godziny. Unikaj diuretyków, np. kawy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы сожгли %lld ккал, а выпили только %@ л — сейчас нужно больше воды. В течение часа выпейте 500 мл и на время сократите нагрузку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "补水严重滞后：已消耗 %lld 千卡，只喝了 %@ 升。请在下一小时内喝约 500 毫升水，并暂缓咖啡等利尿饮品。"
          }
        }
      }
    },
