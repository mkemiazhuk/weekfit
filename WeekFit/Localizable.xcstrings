    "coach.priority.thisIsOneOfTheBetterRecovery.4266" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist eines der besseren Erholungsfenster. Wenn Sie heute bedeutende Arbeit vorantreiben möchten, haben Sie Raum, aber es gibt nichts, was man erzwingen müsste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is one of the better recovery windows. If you want to push meaningful work today, you have room, but there is nothing to force."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es una de las mejores ventanas de recuperación. Si quiere empujar trabajo significativo hoy, tiene margen, pero no hay nada que forzar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est l’une des meilleures fenêtres de récupération. Si vous voulez pousser un travail significatif aujourd’hui, vous avez de la marge, mais rien n’est à forcer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è una delle finestre di recupero migliori. Se vuoi portare avanti lavoro significativo oggi, ha spazio, ma non c'è nulla da forzare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは回復するのに比較的良い時間帯の一つです。今日、重要な作業に取り組みたい場合は余地がありますが、無理に何かをする必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 더 나은 회복 창 중 하나입니다. 오늘 의미 있는 작업을 진행하고 싶다면 여유가 있지만, 억지로 할 필요는 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jedno z lepszych okien regeneracji. Jeśli chcesz dziś wykonać istotną pracę, masz przestrzeń, ale nic nie trzeba wymuszać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это одно из лучших окон восстановления. Если хотите сделать важную работу сегодня, пространство есть, но форсировать ничего не нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是最佳的恢复时机之一。若您今天需要处理重要事务，现有空间已足够，无需仓促行事。"
          }
        }
      }
    },
    "coach.priority.thisIsRecoverySupportNotPerformanceWork.4381" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist Unterstützung bei der Erholung, keine Leistungsarbeit. Beginnen Sie sanft und beenden Sie es mit einem besseren Gefühl als zu Beginn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is recovery support, not performance work. Start gently and finish feeling better than you started."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es apoyo de recuperación, no trabajo de rendimiento. Empiece con suavidad y termine sintiéndose mejor que al empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est un soutien à la récupération, pas du travail de performance. Commencez en douceur et terminez en vous sentant mieux qu’au départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è supporto per il recupero, non lavoro sulle prestazioni. Inizia con calma e finisci sentendoti meglio di come ha iniziato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはパフォーマンス向上の作業ではなく、回復のサポートです。優しく始め、始めたときよりも気分が良くなるように終えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 회복 지원이지, 수행 작업이 아닙니다. 천천히 시작하고 시작할 때보다 기분이 나아진 상태로 마치세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wsparcie regeneracji, nie praca wydajnościowa. Zacznij łagodnie i zakończ czując się lepiej niż na start."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это для восстановления, а не для результата. Начните мягко и завершите лучше, чем начали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是为了恢复，而非追求结果。从温和处开始，最终达到比开始时更好的状态。"
          }
        }
      }
    },
