          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "15 分钟的轻松散步，或一种经济实惠的替代方案。短时课程时长最多可压缩至 15 分钟。"
          }
        }
      }
    },
