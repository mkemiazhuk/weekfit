    "coach.scenario.enduranceAfter.load.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Gestalte den restlichen Tag einfach, damit die Einheit die Fitness unterstützt, anstatt zusätzliche Müdigkeit zu verursachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Keep the next part of the day easy so the session supports fitness instead of adding fatigue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Mantenga el resto del día suave para que la sesión apoye la forma en lugar de añadir fatiga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Gardez la suite de la journée facile pour que la séance soutienne la forme plutôt que d’ajouter de la fatigue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Mantieni facile la parte successiva della giornata in modo che la sessione supporti la forma fisica invece di aggiungere stanchezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ その日の残りの時間は軽く過ごし、セッションが疲労を増すのではなく、フィットネスをサポートするようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ 나머지 하루 일정을 가볍게 유지하여 이번 세션이 피로를 추가하는 것이 아니라 체력 향상을 돕도록 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Utrzymuj resztę dnia na luzie, by sesja wspierała formę, a nie dokładała zmęczenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Держите следующую часть дня легкой, чтобы тренировка помогла форме, а не добавила усталость."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@保持一天的下一部分轻松，以便课程支持健身，而不是增加疲劳。"
          }
        }
      }
    },
