        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 시간에는 회복이 주로 잠을 자는 것으로 이루어진다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tej porze regenerację wygrywa się głównie przez pozostanie we śnie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В это время восстановление чаще всего выигрывается сном."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此时此刻，恢复的主要途径就是继续入睡。"
          }
        }
      }
    },
    "coach.priority.aVeryHighLoadLateInThe.4884" : {
      "extractionState" : "manual",
