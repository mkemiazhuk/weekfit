    "coach.scenario.performanceDuring.loaded.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Mach dies zu einer sauberen Ausführungsphase, nicht zu einem Test deiner Grenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Make this a clean execution session, not a test of your limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Haga de esto una sesión de ejecución limpia, no una prueba de su límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Faites-en une séance d’exécution propre, pas un test de votre limite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Fai di questa una sessione di esecuzione pulita, non un test dei tuoi limiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ これは自分の限界を試すものではなく、クリーンな実行セッションにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이것을 한계 테스트가 아닌 깔끔한 실행 세션으로 만들어라."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zrób z tego czystą sesję wykonania, a nie test granicy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Сделайте эту тренировку чистой по выполнению, а не проверкой предела."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@使这成为一个干净的执行会话，而不是对您的限制的测试。"
          }
        }
      }
    },
