    "support.guides.item04.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivität zeigt, wie viel Sie sich im Vergleich zu Ihrem aktuellen Ziel bewegt haben. Spaziergänge, Workouts, Trainingsminuten und Apple Watch-Aktivität beeinflussen diese Zahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activity shows how much you have moved compared to your current goal. Walks, workouts, exercise minutes, and Apple Watch activity can all move this number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actividad muestra cuánto se ha movido respecto a su objetivo actual. Caminatas, entrenamientos, minutos de ejercicio y actividad de Apple Watch pueden subir este número."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activité montre combien vous avez bougé par rapport à votre objectif actuel. Marches, entraînements, minutes d'exercice et activité Apple Watch peuvent faire monter ce chiffre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attività mostra quanto ti sei mosso rispetto all’obiettivo attuale. Passeggiate, allenamenti, minuti esercizio e attività Apple Watch influenzano il valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティは現在の目標と比べてどれだけ動いたかを示します。ウォーク、ワークアウト、運動時間、Apple Watchのアクティビティがこの数値に影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활동는 현재 목표 대비 얼마나 움직였는지 보여줍니다. 걷기, 운동, 운동 시간, Apple Watch 활동이 이 수치에 영향을 줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywność pokazuje, ile się poruszyłeś względem obecnego celu. Spacery, treningi, minuty ćwiczeń i aktywność Apple Watch mogą podnieść tę liczbę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активность показывает, сколько вы двигались относительно текущей цели. Прогулки, тренировки, минуты упражнений и активность Apple Watch могут менять это число."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活动数据可显示您相较于当前目标的实际进展量。步行、健身训练、运动时长以及 Apple Watch 活动数据均会影响这一数值。"
          }
        }
      }
    },
    "support.guides.item04.title" : {
