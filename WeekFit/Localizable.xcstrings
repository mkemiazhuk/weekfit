            "state" : "translated",
            "value" : "保护接下来的内容"
          }
        }
      }
    },
    "coach.rationale.protectTomorrow.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgen bringt echte Nachfrage mit sich. Halte dieses %@ einfach, damit heute die Erholung unterstützt, anstatt vom nächsten Trainingstag zu leihen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomorrow carries real demand. Keep this %@ easy so today supports recovery instead of borrowing from the next training day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mañana trae demanda real. Mantenga este %@ suave para que hoy apoye la recuperación en lugar de restar del próximo día de entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demain comporte une vraie exigence. Gardez ce %@ facile pour que aujourd’hui soutienne la récupération au lieu d’emprunter au prochain jour d’entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domani comporta una vera domanda. Mantieni questo %@ facile in modo che oggi supporti il recupero invece di prendere in prestito dal prossimo giorno di allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明日は本当の需要を伴います。この %@ は簡単にして、今日が次のトレーニング日から借りるのではなく回復を支えるようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일은 실제 수요를 가져옵니다. 오늘은 다음 훈련 날에서 빌리지 않고 회복을 지원할 수 있도록 이것을 %@ 쉽게 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutro niesie realne wymagania. Utrzymuj ten %@ na łatwym poziomie, by dziś wspierać regenerację zamiast zaciągać z następnego dnia treningowego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завтра есть реальная нагрузка. Держите эту %@ легкой, чтобы сегодняшний день поддержал восстановление, а не забрал ресурс у следующей тренировки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明天有实际训练量。保持这个%@轻松，让今天支持恢复，而不是透支下次。"
          }
        }
      }
    },
    "coach.rationale.protectTomorrow.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schütze morgen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
