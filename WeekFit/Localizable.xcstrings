    "challenge.recovery7.summary.partialBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verpasste Tage bleiben auf dem Rekord. Sie können immer noch eine Gewohnheit von den Aufgaben, die Sie abgeschlossen haben, behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Missed days stay on the record. You can still keep a habit from the tasks you completed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días omitidos quedan registrados. Aún puede conservar un hábito de las tareas completadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours manqués restent visibles. Vous pouvez quand même garder une habitude des tâches terminées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni scomparsi rimangono al registro. Si può ancora mantenere un'abitudine dai compiti che hai completato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録に残った日が残っています。 あなたはまだあなたが完了したタスクから習慣を維持することができます."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록에 남아있는 일. 완료된 작업에서 습관을 유지할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pominięte dni pozostają w historii. Nadal możesz zachować nawyk z ukończonych zadań."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропущенные дни остаются в итоге. Привычку можно выбрать из выполненных задач."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错过的日子仍会被记录在案。您仍可以保留已完成任务所形成的习惯。"
          }
        }
      }
    },
