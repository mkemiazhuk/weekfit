          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mocny poranek wciąż potrzebuje łagodnego rozruchu przed aktywnością."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
