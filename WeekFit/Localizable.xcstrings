    "challenge.recovery7.v2.task.3.alternative" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Gehen nicht verfügbar ist, verwenden Sie eine andere sanfte Bewegung, die Sie insgesamt etwa 15 Minuten aufrechterhalten können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If walking isn’t available, use another gentle movement you can sustain for about 15 minutes total."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si caminar no es posible, elija otro movimiento suave sostenible unos 15 minutos en total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la marche n'est pas possible, choisissez un autre mouvement doux que vous pouvez tenir environ 15 minutes au total."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se camminare non è disponibile, utilizzare un altro movimento gentile si può sostenere per circa 15 minuti totale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩くことができない場合は、別の穏やかな動きを使用して、約15分間持続できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷는 것은 사용할 수없는 경우, 15 분 정도 지속 할 수있는 또 다른 부드러운 움직임을 사용하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli spacer nie wchodzi w grę, wybierz inny delikatny ruch na około 15 minut łącznie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если прогулка недоступна, выбери другое мягкое движение примерно на 15 минут суммарно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若无法进行步行，请选择其他温和的运动方式，且每次运动总时长应控制在约 15 分钟以内。"
          }
        }
      }
    },
    "challenge.recovery7.v2.task.3.criterion" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machen Sie einen komfortablen 15-minütigen Spaziergang oder wählen Sie eine zugängliche Bewegungsalternative. Kürzere Sitzungen können bis zu 15 Minuten hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a comfortable 15-minute walk, or choose an accessible movement alternative. Shorter sessions can add up to 15 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camine cómodamente 15 minutos o elija una alternativa accesible. Sesiones más cortas pueden sumar 15 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites une marche confortable de 15 minutes, ou une alternative accessible. Des sessions plus courtes peuvent totaliser 15 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendere una comoda passeggiata di 15 minuti, o scegliere un'alternativa di movimento accessibile. Le sessioni più brevi possono aggiungere fino a 15 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "徒歩約15分、またはアクセス可能な動きの選択肢を選ぶ。 ショートセッションは15分まで追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도보 15 분, 또는 접근 가능한 운동 대안을 선택하십시오. 단축 세션은 15 분까지 추가 할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób wygodny 15-minutowy spacer lub dostępną alternatywę. Krótsze sesje mogą dać 15 minut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комфортная прогулка 15 минут или доступная альтернатива. Короткие сессии можно сложить до 15 минут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 分钟的轻松散步，或一种经济实惠的替代方案。短时课程时长最多可压缩至 15 分钟。"
          }
        }
      }
    },
