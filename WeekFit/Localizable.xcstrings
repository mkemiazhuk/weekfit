    "healthAccess.weekfitReliesOnAppleHealthAndAppleWatchSleep" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woche Fit setzt auf Apple Health und Apple Watch Schlaf-Tracking. Manchmal werden Schlafdaten nicht aufgezeichnet, auch wenn Sie Ihre Uhr über Nacht tragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit relies on Apple Health and Apple Watch sleep tracking. Sometimes sleep data is not recorded even if you wear your watch overnight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit depende de Apple Health y del seguimiento del sueño con Apple Watch. A veces no se registran datos de sueño aunque use el reloj por la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit s’appuie sur Apple Health et le suivi du sommeil avec Apple Watch. Parfois les données de sommeil ne sont pas enregistrées même si vous portez votre montre la nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rassegna Fit si basa sul monitoraggio del sonno Apple Health e Apple Watch. A volte i dati del sonno non vengono registrati anche se si indossa l'orologio durante la notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週刊 Apple HealthとApple Watchの睡眠追跡に適しています。 夜間に時計を着用してもデータが記録されないことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주 메뉴 Apple Health 및 Apple Watch 수면 추적에 적합합니다. 때로는 수면 데이터가 야간 시계를 착용하더라도 기록되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit korzysta z Apple Health i śledzenia snu Apple Watch. Czasem dane snu nie są zapisywane, nawet gdy nosisz zegarek w nocy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit опирается на Apple Health и отслеживание сна Apple Watch. Иногда данные сна не записываются, даже если вы носите часы ночью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 使用 Apple Health 及 Apple Watch 的睡眠追踪功能。即使您整夜佩戴该手表，睡眠数据仍可能无法被记录。"
          }
        }
      }
    },
