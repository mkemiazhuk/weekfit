    "healthAccess.weekfitReliesOnAppleHealthAndAppleWatchSleep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit relies on Apple Health and Apple Watch sleep tracking. Sometimes sleep data is not recorded even if you wear your watch overnight."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit опирается на Apple Health и отслеживание сна Apple Watch. Иногда данные сна не записываются, даже если вы носите часы ночью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 使用 Apple Health 及 Apple Watch 的睡眠追踪功能。即使您整夜佩戴该手表，睡眠数据仍可能无法被记录。"
          }
        }
      }
