            "value" : "支持性语境仍在逐步形成。"
          }
        }
      }
    },
    "insights.vm.learnings.loadPressing.textFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Die Erholung hält nicht Schritt, daher sieht das Problem eher nach Lastmanagement als nach Motivation aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Recovery is not keeping pace, so the issue looks like load management rather than motivation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La recuperación no sigue el ritmo, así que el problema parece gestión de carga más que motivación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La récupération ne suit pas, le problème ressemble donc plutôt à la gestion de charge qu'à la motivation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Il recupero non sta tenendo il passo, quindi il problema sembra la gestione del carico piuttosto che la motivazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 回復はペースを維持していないので、問題はモチベーションではなく負荷管理のように見える。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 복구는 속도를 유지하지 않습니다, 그래서 문제는 motivation 보다는 오히려 짐 관리 같이 보입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Regeneracja nie nadąża, więc problem wygląda na zarządzanie obciążeniem, a nie motywację."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Восстановление не успевает — проблема скорее в управлении нагрузкой, чем в мотивации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Recovery没有跟上步伐，因此问题看起来是负载管理而不是动机。"
          }
        }
      }
    },
    "insights.vm.learnings.loadPressing.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainingslast drückt Erholung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training load is pressing recovery"
          }
        },
        "es" : {
