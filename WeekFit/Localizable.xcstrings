    "termsPrivacy.legal.about.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit ist eine App für persönliches Training, Erholung, Ernährung, Hydration, Schlaf und Routinenplanung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit is a personal training, recovery, nutrition, hydration, sleep, and routine planning app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit es una app personal de entrenamiento, recuperación, nutrición, hidratación, sueño y planificación de rutinas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit est une application personnelle d'entraînement, de récupération, de nutrition, d'hydratation, de sommeil et de planification de routines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit è un’app per allenamento personale, recupero, nutrizione, idratazione, sonno e pianificazione routine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは、個人のトレーニング、回復、栄養、水分、睡眠、ルーティン計画のアプリです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 개인 훈련, 회복, 영양, 수분, 수면, 루틴 계획 앱입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit to aplikacja do treningu, regeneracji, odżywiania, nawodnienia, snu i planowania rutyn."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit — приложение для личного планирования тренировок, восстановления, питания, гидратации, сна и повседневных рутин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit —— 一款用于个人训练规划、恢复、营养管理、水分补充、睡眠管理及日常生活习惯管理的应用程序。"
          }
        }
      }
    },
    "termsPrivacy.legal.about.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App hilft, Ihren Tag zu organisieren, gesundheitsbezogene Metriken zu prüfen und coaching-artige Vorschläge vor, während und nach Workouts zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app helps you organize your day, review health-related metrics, and receive coaching-style suggestions before, during, and after workouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app le ayuda a organizar el día, revisar métricas de salud y recibir sugerencias al estilo coaching antes, durante y después de los entrenamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app vous aide à organiser votre journée, consulter des métriques liées à la santé et recevoir des suggestions de type coaching avant, pendant et après les entraînements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app aiuta a organizzare la giornata, rivedere metriche salute e ricevere suggerimenti in stile coaching prima, durante e dopo gli allenamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日を整理し、健康関連の指標を確認し、ワークアウトの前・中・後にコーチング形式の提案を受けるのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루를 정리하고 건강 관련 지표를 보며 운동 전·중·후 코칭형 제안을 받는 데 도움이 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja pomaga uporządkować dzień, przeglądać metryki zdrowotne i otrzymywać sugestie w stylu coachingu przed, w trakcie i po treningach."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение помогает организовать день, просматривать связанные со здоровьем метрики и получать рекомендации в стиле коучинга до, во время и после тренировок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用程序可帮助您规划每日生活、查看与健康相关的指标，并在训练前、训练期间及训练后获得教练式建议。"
          }
        }
      }
    },
    "termsPrivacy.legal.about.p3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit ist für persönliches Wellness, Fitnessplanung, Gewohnheits-Tracking und Lifestyle-Unterstützung gedacht. Nicht für Notfälle oder klinische Entscheidungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit is intended for personal wellness, fitness planning, habit tracking, and lifestyle support. It is not intended for emergency use or clinical decision-making."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit está pensado para bienestar personal, planificación fitness, seguimiento de hábitos y apoyo al estilo de vida. No está destinado a emergencias ni decisiones clínicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit est destiné au bien-être personnel, à la planification fitness, au suivi d'habitudes et au soutien du mode de vie. Il n'est pas prévu pour les urgences ni les décisions cliniques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit è pensato per wellness personale, pianificazione fitness, abitudini e stile di vita. Non per emergenze o decisioni cliniche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは個人のウェルネス、フィットネス計画、習慣トラッキング、ライフスタイル支援向けです。緊急時や臨床判断には使いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 개인 웰니스, 피트니스 계획, 습관 추적, 라이프스타일 지원용입니다. 응급·임상 결정용이 아닙니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit służy osobistemu wellness, planowaniu fitness, śledzeniu nawyków i wsparciu stylu życia. Nie jest przeznaczony do nagłych przypadków ani decyzji klinicznych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit предназначен для личного благополучия, фитнес-планирования, отслеживания привычек и поддержки образа жизни. Он не предназначен для экстренных ситуаций или клинических решений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 旨在促进个人健康、制定健身计划、追踪生活习惯以及支持健康生活方式。本产品不适用于紧急状况或临床决策。"
          }
        }
      }
    },
