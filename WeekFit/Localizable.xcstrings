        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su primera comida sigue pendiente. Con actividad próxima, considere combustible ligero o intensidad controlada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre premier repas est toujours en attente. Avec de l'activité à venir, envisagez un carburant léger ou gardez l'intensité maîtrisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo primo pasto e' ancora in sospeso. Con l'attività in arrivo, prendere in considerazione il combustibile leggero o mantenere l'intensità controllata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初めてのお食事はおまかせください。 活動によって、軽い燃料を考慮すればまたは制御される強度を保って下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 식사는 여전히 종료됩니다. 활동으로, 빛 연료를 고려하거나 통제되는 강렬을 지킵니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwszy posiłek wciąż oczekuje. Przy nadchodzącej aktywności rozważyć lekkie paliwo lub kontrolowaną intensywność."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первый прием пищи еще впереди. Если скоро активность, подумайте о легкой еде или снизьте интенсивность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一餐还在前方。如果近期有活动安排，请考虑选择清淡饮食或降低活动强度。"
          }
        }
      }
    },
