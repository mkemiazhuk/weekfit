    "support.faq.item27.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synced bedeutet, die Aktivität stammt aus Apple Health oder Apple Watch und wurde automatisch Ihrem Plan hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synced means the activity came from Apple Health or Apple Watch and was automatically added to your plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizado significa que la actividad vino de Apple Health o Apple Watch y se añadió automáticamente a su plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisé signifie que l'activité vient d'Apple Health ou Apple Watch et a été ajoutée automatiquement à votre plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synced significa che l’attività proviene da Apple Health o Apple Watch ed è stata aggiunta automaticamente al piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syncedは、アクティビティがApple HealthまたはApple Watch由来で、プランに自動追加されたことを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synced는 활동이 Apple Health 또는 Apple Watch에서 왔고 계획에 자동 추가되었음을 의미합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsynchronizowane oznacza, że aktywność pochodzi z Apple Health lub Apple Watch i została dodana automatycznie do planu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизировано означает, что активность пришла из Apple Health или Apple Watch и была автоматически добавлена в план."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“已同步”表示该活动源自 Apple Health 或 Apple Watch，并已自动添加到计划中。"
          }
        }
      }
    },
