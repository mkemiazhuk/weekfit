    "meals.starter.salmonRoll.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rollen Sie fest, schneiden Sie dann mit einem scharfen nassen Messer in mundgerechte Stücke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roll tightly, then slice into bite-size pieces with a sharp wet knife."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enrolle apretado y corte en bocados con cuchillo afilado húmedo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roulez serré, puis coupez en bouchées avec un couteau aiguisé mouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotolare strettamente, quindi tagliare a pezzi taglienti con un coltello affilato bagnato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しっかりとロールします。, その後、鋭い濡れたナイフでビットサイズの部分にスライス."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단단히, 그 후에 날카로운 젖은 칼을 가진 가닥 크기 조각으로 째."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiń ciasno i pokrój na kawałki ostrym, mokrym nożem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плотно сверните ролл и нарежьте на кусочки острым смоченным ножом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将卷起的部分紧紧卷好，然后用带汁的锋利刀具切成小块。"
          }
        }
      }
    },
    "meals.starter.salmonRoll.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
