    "onboarding.aha.gain.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainingstage und ruhige Tage verlangen Unterschiedliches. WeekFit hält Training, Erholung und Zufuhr im Dialog."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training days and quiet days ask different things. WeekFit keeps training, recovery, and intake in conversation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días de entrenamiento y los días tranquilos piden cosas distintas. WeekFit mantiene entrenamiento, recuperación e ingesta en conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours d’entraînement et les jours calmes demandent des choses différentes. WeekFit maintient entraînement, récupération et apports en dialogue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni di allenamento e quelli più tranquilli chiedono cose diverse. WeekFit tiene allenamento, recupero e apporto in dialogo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレーニング日と静かな日では求められることが異なります。WeekFitはトレーニング、回復、摂取を一体で見ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훈련일과 조용한 날은 다른 것을 요구합니다. WeekFit은 훈련, 회복, 섭취를 함께 연결합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dni treningowe i spokojne wymagają innych rzeczy. WeekFit łączy trening, regenerację i spożycie w jedną rozmowę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировочные и спокойные дни требуют разного. WeekFit связывает тренировки, восстановление и питание."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练日与休息日需要不同的安排。WeekFit 将训练、恢复与营养有机结合。"
          }
        }
      }
    },
    "onboarding.aha.gain.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit genug Energie aufbauen\nfür die Arbeit, die vor Ihnen liegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build with enough fuel\nfor the work ahead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construya con combustible suficiente\npara el trabajo por delante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construisez avec assez d’énergie\npour le travail à venir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruisci con energia sufficiente\nper il lavoro che ti aspetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これからの取り組みに備え、\n十分な燃料で積み上げましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로의 일을 위해\n충분한 에너지로 쌓아 가세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buduj z wystarczającą energią\nna nadchodzący wysiłek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стройте с достаточным\nтопливом для работы впереди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配备充足的燃料\n为接下来的工作做好准备。"
          }
        }
      }
    },
    "onboarding.aha.lose.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Apps geben jeden Tag denselben Rat. Ihre Tage sind nicht gleich. WeekFit passt die Empfehlungen an, wie Sie sich fühlen, sich bewegen und was bevorsteht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most apps give the same advice every day. Your days aren't the same. WeekFit adapts guidance to how you feel, move, and what's ahead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de apps dan el mismo consejo cada día. Sus días no son iguales. WeekFit adapta la orientación a cómo se siente, se mueve y lo que viene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des apps donnent les mêmes conseils chaque jour. Vos journées ne se ressemblent pas. WeekFit adapte les conseils à ce que vous ressentez, à votre mouvement et à ce qui vous attend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte delle app dà lo stesso consiglio ogni giorno. I tuoi giorni non sono uguali. WeekFit adatta i suggerimenti a come ti senti, ti muovi e a cosa ti aspetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くのアプリは毎日同じアドバイスをします。あなたの日々は同じではありません。WeekFitは気分、動き、これからの予定に合わせてガイダンスを調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 앱은 매일 같은 조언을 합니다. 당신의 하루는 같지 않습니다. WeekFit은 기분, 움직임, 앞일에 맞춰 안내를 조정합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większość aplikacji daje te same rady każdego dnia. Twoje dni nie są takie same. WeekFit dostosowuje wskazówki do tego, jak się czujesz, poruszasz i co przed Tobą."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большинство приложений дают один и тот же совет каждый день. Ваши дни — разные. WeekFit подстраивает подсказки под самочувствие, движение и то, что впереди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多数应用程序每天提供的建议都如出一辙，但您的每一天都各不相同。WeekFit 则根据您的身心感受、运动习惯以及未来计划，动态调整指导建议。"
          }
        }
      }
    },
    "onboarding.aha.lose.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Ziel bleibt gleich.\nDie heutige Empfehlung sollte es nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your goal stays the same.\nToday's guidance should not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su objetivo sigue igual.\nLa orientación de hoy, no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre objectif reste le même.\nLes conseils du jour, non."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo obiettivo resta lo stesso.\nLa guida di oggi non dovrebbe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標は変わりません。\n今日のガイダンスは変わるべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표는 그대로입니다.\n오늘의 안내는 그렇지 않아야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel pozostaje ten sam.\nDzisiejsze wskazówki — nie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель остаётся прежней.\nПодсказки на сегодня — нет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长期目标不变。\n今天的建议可以不同。"
          }
        }
      }
    },
    "onboarding.aha.maintain.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalt ist keine feste Zahl. WeekFit formt die heutige Empfehlung danach, wie Sie geschlafen und sich bewegt haben und was geplant ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenance isn't one fixed number. WeekFit shapes today's guidance around how you slept, moved, and what's planned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mantenimiento no es un número fijo. WeekFit adapta la orientación de hoy a cómo durmió, se movió y lo planificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le maintien n’est pas un chiffre fixe. WeekFit adapte les conseils du jour à votre sommeil, votre mouvement et ce qui est prévu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mantenimento non è un numero fisso. WeekFit modella la guida di oggi in base a come hai dormito, ti sei mosso e a cosa è in programma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "維持は固定の数字ではありません。WeekFitは睡眠、動き、予定に合わせて今日のガイダンスを形作ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유지는 하나의 고정 숫자가 아닙니다. WeekFit은 수면, 움직임, 계획에 맞춰 오늘의 안내를 만듭니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymanie to nie jedna stała liczba. WeekFit kształtuje dzisiejsze wskazówki wokół snu, ruchu i planu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддержание веса — это не одно и то же число каждый день. WeekFit формирует подсказки по сну, движению и планам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康管理并非一个固定数值。WeekFit 正在重新定义当前的指导原则，涵盖您的睡眠状况、活动情况以及未来计划。"
          }
        }
      }
    },
    "onboarding.aha.maintain.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleiben Sie stabil —\nwährend sich Ihr Tag verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay steady —\nas your day changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manténgase estable —\ncuando su día cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez stable —\nquand votre journée change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta stabile —\nmentre la giornata cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日が変わっても\n安定を保ちましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루가 바뀌어도\n꾸준히 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj się stabilnie —\ngdy dzień się zmienia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите баланс —\nпока день меняется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持稳定——\n随一天的变化调整。"
          }
        }
      }
    },
    "onboarding.begin.plan.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körpersignale hängen zusammen. Fügen Sie hinzu, was Sie vorhaben — dann wird die heutige Empfehlung relevanter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body signals are connected. Add what you plan to do, and today's guidance becomes more relevant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las señales corporales están conectadas. Añada lo que planea hacer y la orientación de hoy será más relevante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signaux corporels sont connectés. Ajoutez ce que vous prévoyez, et les conseils du jour deviennent plus pertinents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segnali del corpo sono collegati. Aggiungi ciò che hai in programma e la guida di oggi diventa più pertinente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "からだのシグナルはつながっています。予定を追加すると、今日のガイダンスがより的確になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신체 신호는 연결되어 있습니다. 계획을 추가하면 오늘의 안내가 더 적절해집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sygnały ciała są połączone. Dodaj plany, a dzisiejsze wskazówki staną się trafniejsze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигналы тела подключены. Добавьте, что планируете — и подсказки станут точнее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
