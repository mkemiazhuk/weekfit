    "coach.activityContext.nothingNeedsChasingYetKeepFuelFluids.369" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts muss noch verfolgt werden. Halten Sie Kraftstoff, Flüssigkeiten und Energie stabil, bis die Vorbereitung tatsächlich wichtig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing needs chasing yet. Keep fuel, fluids, and energy steady until preparation actually matters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada requiere perseguirse aún. Mantenga combustible, líquidos y energía estables hasta que la preparación importe de verdad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne demande à être rattrapé pour l'instant. Gardez carburant, fluides et énergie stables jusqu'à ce que la préparation compte vraiment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non serve ancora rincorrere. Mantenere il carburante, i fluidi e l'energia costante fino a quando la preparazione effettivamente conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだまだ追いかける必要はありません。 燃料、流体、エネルギーを安定して調製する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 아직 쫓는다. 연료를 유지, 유체, 에너지는 실제로 준비 할 때까지 꾸준히."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie nic nie wymaga gonienia. Utrzymać paliwo, płyny i energię, dopóki przygotowanie naprawdę nie będzie ważne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ничего не нужно догонять. Держите питание, воду и энергию ровно до момента подготовки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前尚无需仓促行动。在真正需要准备之前，请保持燃料、液体及体力的稳定。"
          }
        }
      }
    },
    "coach.activityContext.noUrgentIssueIsAskingForAttention.376" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine dringende Frage verlangt Aufmerksamkeit. Halten Sie Nahrung, Wasser und Bewegung stabil."
          }
