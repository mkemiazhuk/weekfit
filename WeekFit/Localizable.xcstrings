          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションは実際のトレーニングのストレスを生み出すことがあります。徐々に取り入れ、強度よりも質を重視してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션은 실제 훈련 스트레스를 만들 수 있습니다. 점진적으로 수행하고, 강도보다 질을 더 높게 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sesja może wygenerować realny stres treningowy. Wchodź stopniowo i stawiaj jakość ponad intensywność."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта тренировка может дать реальный стресс для тела. Входите постепенно и держите качество выше интенсивности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
