    "healthAccess.sleepSetup.noData.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheit → Browsen → Schlaf → Alle Daten anzeigen\nWenn keine neuen Einträge erscheinen, zeichnet Apple Watch den Schlaf noch nicht auf."
          }
        },
        "en" : {
          "stringUnit" : {
