        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no es el día de exprimirse en vacío. Recargue para que las series de mañana cuenten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
