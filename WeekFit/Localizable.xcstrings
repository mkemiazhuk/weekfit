            "state" : "translated",
            "value" : "Сегодня расход энергии очень высокий (%lld ккал). Держите эту прогулку по-настоящему легкой и не поднимайте пульс — сейчас важнее спокойное восстановление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日能量消耗很高（%lld 千卡）。这次步行请保持低强度，别把心率拉高。"
          }
        }
      }
    },
    "today.aiCoach.walkLowWaterFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagesanalyse: Nur %@ L Wasser protokolliert bei %lld Workouts. Niedrigintensive Belastung erhöht Gefäßdehydration. Warten Sie NICHT bis zum Abend — protokollieren Sie jetzt 350 ml."
