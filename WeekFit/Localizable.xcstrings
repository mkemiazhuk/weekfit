        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak zapisanych posiłków. Jeśli pierwszy posiłek jest później, utrzymać nawodnienie i unikać zbędnego podjadania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока нет ни одной записи о еде. Если первый прием пищи будет позже, пейте воду ровно и не перекусывайте просто так."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未记录进食情况。若您的第一餐计划稍后进食，请保持水分摄入稳定，并避免不必要的零食摄入。"
          }
