    "insights.view.fallbackSupport.recoveryResponse.nutrition.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery will show whether better fueling is changing how you adapt to training."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление покажет, меняет ли питание то, как вы адаптируетесь к тренировкам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复情况将揭示饮食是否会影响您对训练的适应能力。"
          }
        }
      }
    },
    "insights.view.fallbackSupport.recoveryResponse.sleep.text": {
      "extractionState": "manual",
