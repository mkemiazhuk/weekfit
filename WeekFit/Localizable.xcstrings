    "coach.priority.atThisHourRecoveryIsMostlyWon.5167" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um diese Stunde wird die Erholung hauptsächlich dadurch erreicht, dass man schläft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At this hour, recovery is mostly won by staying asleep."
          }
