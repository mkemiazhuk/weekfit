          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete meals, logs, activities, coach history, cached images, and local preferences stored on this device. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará comidas, registros, actividades, historial de Coach, imágenes en caché y preferencias locales en este dispositivo. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera les repas, journaux, activités, historique Coach, images en cache et préférences locales sur cet appareil. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina pasti, log, attività, cronologia Coach, immagini in cache e preferenze locali su questo dispositivo. Non è reversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスに保存された食事、ログ、アクティビティ、Coach履歴、キャッシュ画像、ローカル設定を削除します。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 저장된 식사, 로그, 활동, Coach 기록, 캐시 이미지, 로컬 설정을 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To usunie posiłki, logi, aktywności, historię Coach, zapisane obrazy i lokalne preferencje na tym urządzeniu. Tej operacji nie można cofnąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит блюдо, журналы, активности, историю Тренера, кэшированные изображения и локальные настройки на этом устройстве. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将清除该设备上的菜品、日志、活动记录、教练历史记录、缓存图像及本地设置。此操作不可撤销。"
          }
        }
      }
    },
