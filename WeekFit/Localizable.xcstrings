    "support.guides.item10.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan zeigt, was kommt, was jetzt passiert und was abgeschlossen, verpasst oder aus Apple Health synchronisiert wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan shows what is coming, what is happening now, and what was already completed, missed, or synced from Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan muestra lo que viene, lo que ocurre ahora y lo completado, omitido o sincronizado desde Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan montre ce qui arrive, ce qui se passe maintenant et ce qui a été terminé, manqué ou synchronisé depuis Apple Health."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piano mostra cosa arriva, cosa accade ora e cosa è completato, mancato o sincronizzato da Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランはこれから、今進行中、完了・見逃し・Apple Health同期済みを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획은 다가올 일, 지금 진행 중, 완료·누락·Apple Health 동기화를 보여줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan pokazuje, co nadchodzi, co dzieje się teraz oraz co ukończono, pominięto lub zsynchronizowano z Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "План показывает, что впереди, что происходит сейчас и что уже выполнено, пропущено или синхронизировано из Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该计划图展示了未来将发生的情况、当前正在发生的情况，以及此前已完成、遗漏或已从 Apple Health 同步的内容。"
          }
        }
      }
    },
