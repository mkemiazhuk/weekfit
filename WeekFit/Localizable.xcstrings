    "challenge.recovery7.intro.expect.continue.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Planung einer Zeit ist optional. Eine Aufgabe abzuschließen bedeutet, auf \"Ich habe es getan\" zu tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planning a time is optional. Completing a task means tapping “I did it”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planificar una hora es opcional. Completar una tarea significa tocar «Lo hice»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifier une heure est facultatif. Terminer une tâche signifie appuyer sur « J'ai fait »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianificare un tempo è facoltativo. Completare un compito significa toccare “ho fatto”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間の計画は任意です。 タスクのコンパイルは、「私はそれをした」をタップすることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획 시간은 선택 사항입니다. 작업을 완료하면 \"나는 그것을했다\"."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planowanie godziny jest opcjonalne. Ukończenie to stuknięcie „Zrobiłem”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назначить время можно по желанию. Завершение — это «Я сделал»."
