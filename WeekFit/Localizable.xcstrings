    "coach.thereIsNothingToAchieveHereLetTheBreath" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier gibt es nichts zu erreichen. Lassen Sie den Atem angenehm und lenken Sie die Aufmerksamkeit zurück, wenn der Geist abschweift."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is nothing to achieve here. Let the breath stay comfortable and return your attention whenever the mind drifts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada que lograr aquí. Mantenga la respiración cómoda y vuelva la atención cuando la mente divague."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a rien à accomplir ici. Gardez une respiration confortable et ramenez votre attention quand l'esprit vagabonde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui non c’è nulla da raggiungere. Mantenga il respiro confortevole e riporti l’attenzione quando la mente vaga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで達成することはありません。呼吸を快適に保ち、意識がそれたら戻しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 이룰 것은 없습니다. 호흡은 편안하게, 마음이 흐트러지면 다시 집중하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma tu nic do osiągnięcia. Oddychaj wygodnie i wracaj uwagą, gdy umysł odpływa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь нечего достигать. Дышите комфортно и возвращайте внимание, когда мысли уходят."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里没有需要达成的目标。请保持放松的状态，当思绪飘散时，重新将注意力拉回当下。"
          }
        }
      }
    },
