    "coach.scenario.recoveryDuring.stretch.easy.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleiben Sie innerhalb eines komfortablen Bereichs. Erzwingen Sie weder Tiefe noch Intensität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay within a comfortable range. Do not force depth or intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manténgase en un rango cómodo. No fuerce profundidad ni intensidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez dans une amplitude confortable. Ne forcez ni profondeur ni intensité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
