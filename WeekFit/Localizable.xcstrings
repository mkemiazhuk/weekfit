    "coach.priority.trainingOnlyWorksIfYouCanAbsorb.2751" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training funktioniert nur, wenn Sie es aufnehmen kannst. Der Schlaf, die Energie und die Flüssigkeiten von heute Nacht entscheiden, ob morgen Anpassung oder nur mehr Erschöpfung ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training only works if you can absorb it. Tonight's sleep, fuel, and fluids decide whether tomorrow is adaptation or just more fatigue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento solo funciona si puede asimilarlo. El sueño, la comida y los líquidos esta noche deciden si mañana es adaptación o más fatiga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entraînement ne fonctionne que si vous pouvez l’assimiler. Le sommeil, l’alimentation et les fluides ce soir décident si demain sera adaptation ou simple fatigue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allenamento funziona solo se puoi assorbirlo. Il sonno di stasera, il cibo e i liquidi decidono se domani sarà adattamento o solo altra fatica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレーニングは、それを吸収できる場合にのみ効果があります。今夜の睡眠、栄養、そして水分が、明日が適応の日になるか、ただの疲労の日になるかを決めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훈련은 당신이 그것을 흡수할 수 있을 때만 효과가 있습니다. 오늘 밤의 수면, 영양, 수분이 내일이 적응이 될지 아니면 단지 더 피곤해질지를 결정합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trening działa tylko, gdy możesz go przyswoić. Sen, paliwo i płyny dziś wieczorem decydują, czy jutro to adaptacja, czy tylko większe zmęczenie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировка работает только если тело может ее усвоить. Сегодняшний сон, еда и вода решат, станет завтра сильнее или просто устанет еще больше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练只有在身体能够吸收它时才会见效。今天的睡眠、饮食和水分摄入，将决定明天是变得更强壮，还是仅仅变得更加疲惫。"
          }
        }
      }
    },
