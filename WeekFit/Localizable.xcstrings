    "onboarding.v10.coach.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was sich geändert hat. Warum es zählt. Was als Nächstes — dann in Heute handeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What changed. Why it matters. What to do next — then act on Today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué cambió. Por qué importa. Qué hacer después — y actuar en Hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui a changé. Pourquoi c'est important. Quoi faire ensuite — puis agir sur Aujourd’hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa è cambiato. Perché conta. Cosa fare dopo — poi agisci in Oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何が変わったか。なぜ重要か。次に何をするか—その後今日で行動。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇이 바뀌었는지. 왜 중요한지. 다음에 할 일 — 그다음 오늘에서 행동."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co się zmieniło. Dlaczego to ważne. Co dalej — potem działaj w Dziś."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что изменилось. Почему важно. Что дальше — затем действуйте на Сегодня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发生了哪些变化？为何这些变化至关重要？接下来该怎么做？——即刻在 今天 上采取行动。"
          }
        }
      }
    },
