    "highlights.story.empty.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woche Fit benötigt mindestens 20 Tage Erholung, Aktivität, Ernährung und Schlafdaten, bevor es Ihre erste monatliche Geschichte synthetisieren kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit needs at least 20 days of recovery, activity, nutrition, and sleep data before it can synthesize your first monthly story."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit necesita al menos 20 días de datos de recuperación, actividad, nutrición y sueño antes de sintetizar su primera historia mensual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit a besoin d'au moins 20 jours de données de récupération, activité, nutrition et sommeil avant de synthétiser votre première histoire mensuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rassegna Fit ha bisogno di almeno 20 giorni di recupero, attività, nutrizione e dati di sonno prima di poter sintetizzare la tua prima storia mensile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週刊 最低20日間のリカバリ、アクティビティ、栄養、睡眠データが必要で、最初の月間ストーリーを合成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주 메뉴 적합은 적어도 20 일의 회복, 활동, 영양 및 당신의 첫번째 월간 이야기를 종합할 수 있기 전에 잠 자료의 필요로 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit potrzebuje co najmniej 20 dni danych regeneracji, aktywności, odżywiania i snu, by stworzyć pierwszą miesięczną historię."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit нужно минимум 20 дней данных о восстановлении, активности, питании и сне, чтобы собрать первую месячную историю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 需要至少 20 天的恢复、活动、饮食及睡眠数据，才能生成首月记录。"
          }
        }
      }
    },
