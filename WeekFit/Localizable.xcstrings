    "recovery.stressIndex.summary.signalsStable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre wichtigsten Signale bleiben nahe der Baseline — konsistent mit geringerer physiologischer Belastung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your key signals remain close to baseline, which is consistent with lower physiological strain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus señales clave se mantienen cerca de la referencia, lo que es coherente con menor tensión fisiológica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos signaux clés restent proches de la référence, ce qui correspond à une tension physiologique plus faible."
