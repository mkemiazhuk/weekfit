    "coach.priority.startingUnderFueledAndDryMakesThe.1745" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterversorgt und ausgetrocknet zu starten, macht dasselbe Training teurer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starting under-fueled and dry makes the same workout cost more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar con poca energía y deshidratado hace que el mismo entrenamiento cueste más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partir sous-alimenté et déshydraté rend le même entraînement plus coûteux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniziare sottoalimentati e a digiuno rende lo stesso allenamento più costoso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燃料不足で水分も足りない状態で始めると、同じトレーニングでもより多くの負担がかかる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연료가 부족하고 수분이 없는 상태로 시작하면 같은 운동도 더 많은 에너지를 소모하게 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start niedożywiony i odwodniony sprawia, że ten sam trening kosztuje więcej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старт без еды и воды делает ту же тренировку тяжелее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在没有食物和水的情况下开始训练，会使同样的训练变得更为困难。"
          }
        }
      }
    },
