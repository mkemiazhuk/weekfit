    "login.localReplaceApple.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie ohne Konto fortfahren, wird ein separater lokaler Arbeitsbereich auf diesem Gerät gestartet. Daten von Ihrem Apple-Konto auf diesem Gerät werden entfernt. Melden Sie sich stattdessen mit der gleichen Apple ID an, wenn Sie sie behalten möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuing without an account starts a separate local workspace on this device. Data from your Apple account on this device will be removed. Sign in with the same Apple ID instead if you want to keep it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar sin cuenta crea un espacio local separado en este dispositivo. Se eliminarán los datos de su cuenta Apple en este dispositivo. Inicie sesión con el mismo Apple ID si desea conservarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer sans compte crée un espace local distinct sur cet appareil. Les données de votre compte Apple sur cet appareil seront supprimées. Connectez-vous avec le même Apple ID pour les conserver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuare senza un account inizia uno spazio di lavoro locale separato su questo dispositivo. I dati dal tuo account Apple su questo dispositivo verranno rimossi. Accedi con lo stesso ID Apple invece se vuoi tenerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントなしで継続すると、このデバイス上の別のローカルワークスペースが始まります。 このデバイス上のAppleアカウントからのデータが削除されます。 保存したい場合は、同じApple IDでサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정없이 계속이 장치에서 별도의 로컬 작업 공간을 시작합니다. Apple 계정의 데이터가 제거됩니다. 같은 Apple ID로 로그인하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontynuacja bez konta tworzy osobny lokalny obszar na tym urządzeniu. Dane konta Apple na tym urządzeniu zostaną usunięte. Zaloguj się tym samym Apple ID, aby je zachować."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжение без аккаунта откроет отдельное локальное пространство на этом устройстве. Данные аккаунта Apple на этом устройстве будут удалены. Войдите тем же Apple ID, если хотите их сохранить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若未登录账户继续操作，将在本设备上创建一个新的本地工作区。您本设备上 Apple 账户中的数据将被清除。若您希望保留这些数据，请使用同一 Apple ID 重新登录。"
          }
        }
      }
    },
