    "recovery.stressIndex.conflict.highRecoveryElevatedStress" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wirken allgemein erholt, aber die aktuelle physiologische Belastung ist erhöht. Erwägen Sie eine kontrollierte Session statt maximaler Intensität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You appear generally recovered, but current physiological strain is elevated. Consider a controlled session rather than maximum intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece recuperado en general, pero la tensión fisiológica actual está elevada. Considere una sesión controlada en lugar de intensidad máxima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous semblez globalement récupéré, mais la tension physiologique actuelle est élevée. Envisagez une séance contrôlée plutôt qu'une intensité maximale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra generalmente recuperato, ma lo strain fisiologico attuale è elevato. Consideri una sessione controllata invece dell’intensità massima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全体的には回復しているように見えますが、現在の生理的負荷は高め。最大強度よりコントロールされたセッションを検討。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전반적으로 회복된 것 같지만 현재 생리적 부담이 높습니다. 최대 강도보다 조절된 세션을 고려하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyglądasz na ogólnie zregenerowanego, ale bieżące obciążenie fizjologiczne jest podwyższone. Rozważ kontrolowaną sesję zamiast maksymalnej intensywności."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В целом вы выглядите восстановленными, но текущая физиологическая нагрузка повышена. Рассмотрите контролируемую тренировку вместо максимальной интенсивности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整体恢复不错，但当前生理负荷偏高。建议可控训练，而非最大强度。"
          }
        }
      }
    },
    "recovery.stressIndex.conflict.highRecoveryLowStress" : {
