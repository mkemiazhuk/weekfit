    "termsPrivacy.legal.dataUse.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit nutzt verfügbare Aktivitäts-, Workout-, Ernährungs-, Hydrations-, Schlaf-, Erholungs-, Körper- und Planner-Daten für App-Funktionen und Personalisierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit uses available activity, workout, nutrition, hydration, sleep, recovery, body, and planner data to provide app functionality and personalize your experience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa actividad, entrenamientos, nutrición, hidratación, sueño, recuperación, datos corporales y planificador disponibles para ofrecer funciones y personalizar su experiencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit utilise l'activité, les entraînements, la nutrition, l'hydratation, le sommeil, la récupération, les données corporelles et le planificateur disponibles pour fournir les fonctionnalités et personnaliser votre expérience."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa attività, allenamenti, nutrizione, idratazione, sonno, recupero, corpo e dati planner disponibili per funzionalità e personalizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは利用可能なアクティビティ、ワークアウト、栄養、水分、睡眠、回復、体、Plannerデータを使い、アプリ機能と体験をパーソナライズします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 사용 가능한 활동, 운동, 영양, 수분, 수면, 회복, 신체, Planner 데이터로 앱 기능과 개인화를 제공합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit wykorzystuje dostępną aktywność, treningi, odżywianie, nawodnienie, sen, regenerację, dane ciała i planer, aby zapewnić funkcje i personalizować doświadczenie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit использует доступные данные активности, тренировок, питания, гидратации, сна, восстановления, тела и планирования, чтобы обеспечивать функции приложения и персонализировать опыт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 利用现有的活动、训练、营养、水分补充、睡眠、恢复、身体及计划等相关数据，以提供应用程序功能并打造个性化使用体验。"
          }
        }
      }
    },
    "termsPrivacy.legal.dataUse.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Daten können Metriken anzeigen, Plan-Status aktualisieren, abgeschlossene Workouts importieren, Tageskontext berechnen, Coach-Vorschläge erzeugen, Erinnerungen unterstützen und Ihre Routine verständlich machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This data may be used to show metrics, update Plan statuses, import completed workouts, calculate daily context, generate Coach suggestions, support reminders, and help you understand your routine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos datos pueden usarse para métricas, estados del Plan, importar entrenamientos completados, calcular el contexto diario, generar sugerencias de Coach, recordatorios y entender su rutina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces données peuvent servir à afficher des métriques, mettre à jour les statuts du Plan, importer des entraînements terminés, calculer le contexte quotidien, générer des suggestions Coach, prendre en charge les rappels et aider à comprendre votre routine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi dati possono mostrare metriche, aggiornare stati Plan, importare allenamenti completati, calcolare contesto giornaliero, generare suggerimenti Coach, promemoria e routine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのデータで指標表示、Planステータス更新、完了ワークアウトのインポート、一日の文脈計算、Coach提案、リマインダー、ルーティン理解を支えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 데이터로 지표 표시, Plan 상태 업데이트, 완료 운동 가져오기, 하루 맥락 계산, Coach 제안, 알림, 루틴 이해를 지원합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane mogą służyć do metryk, statusów Planu, importu ukończonych treningów, kontekstu dnia, sugestii Coach, przypomnień i zrozumienia rutyny."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти данные могут использоваться для отображения метрик, обновления статусов плана, импорта завершенных тренировок, расчета дневного контекста, генерации подсказок Тренера, поддержки напоминаний и помощи в понимании вашей рутины."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些数据可用于展示关键指标、更新计划状态、导入已完成的训练记录、计算每日训练情境、生成教练提示、支持提醒功能，以及帮助您更好地理解日常训练流程。"
          }
        }
      }
    },
    "termsPrivacy.legal.dataUse.p3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Genauigkeit von Einblicken hängt von Genauigkeit, Vollständigkeit und Timing der WeekFit verfügbaren Daten ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The accuracy of insights depends on the accuracy, completeness, and timing of the data available to WeekFit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La precisión de los análisis depende de la exactitud, integridad y momento de los datos disponibles para WeekFit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La précision des analyses dépend de l'exactitude, de l'exhaustivité et du timing des données disponibles pour WeekFit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accuratezza degli insight dipende da accuratezza, completezza e tempistiche dei dati disponibili a WeekFit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インサイトの精度は、WeekFitに利用可能なデータの正確さ、完全性、タイミングに依存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인사이트 정확도는 WeekFit에 사용 가능한 데이터의 정확성, 완전성, 시점에 따라 달라집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokładność analiz zależy od poprawności, kompletności i czasu danych dostępnych dla WeekFit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точность инсайтов зависит от точности, полноты и своевременности данных, доступных WeekFit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内幕消息的准确性取决于 WeekFit 可获取数据的准确性、完整性和及时性。"
          }
        }
      }
    },
