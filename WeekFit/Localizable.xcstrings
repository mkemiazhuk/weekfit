    "coach.insight.windDownWithLightRecoverySupportAvoid.503" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entspannen Sie sich mit leichter Erholungsunterstützung. Vermeiden Sie schwere Mahlzeiten und zwingen Sie vor dem Schlafengehen nicht, mehr Wasser zu trinken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wind down with light recovery support. Avoid heavy meals and avoid forcing more water before sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baje revoluciones con apoyo de recuperación ligero. Evite comidas pesadas y no fuerce más agua antes de dormir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décompressez avec un soutien de récupération léger. Évitez les repas lourds et ne forcez pas plus d'eau avant le sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilassati con un leggero supporto al recupero. Eviti pasti pesanti e non forzare l'assunzione di più acqua prima di dormire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽い回復サポートでリラックスしてください。就寝前に重い食事を避け、無理に水分を多く摂るのも避けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가벼운 회복 지원으로 몸을 풀어주세요. 무거운 식사는 피하고, 잠자기 전에는 물을 억지로 많이 마시지 마세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wycisz się lekkim wsparciem regeneracji. Unikaj ciężkich posiłków i nie forsuj więcej wody przed snem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершайте день спокойно. Избегайте тяжелой еды и не заставляйте себя пить больше перед сном."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让这一天以平静的心态结束。避免食用油腻食物，也不要强迫自己在睡前饮用过多液体。"
          }
        }
      }
    },
