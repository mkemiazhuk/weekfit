    "WeekFit relies on Apple Health and Apple Watch sleep tracking. Sometimes sleep data is not recorded even if you wear your watch overnight.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit relies on Apple Health and Apple Watch sleep tracking. Sometimes sleep data is not recorded even if you wear your watch overnight."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit использует Apple Health и отслеживание сна Apple Watch. Иногда данные сна не записываются, даже если вы носите часы всю ночь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 使用 Apple Health 及 Apple Watch 的睡眠追踪功能。即使您整夜佩戴该手表，睡眠数据仍可能无法被记录。"
          }
        }
      }
    },
    "WeekFit Support": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit Support"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддержка WeekFit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 WeekFit"
          }
        }
      }
    },
    "WeekFit uses the health, activity, nutrition, recovery, and planner data you allow or enter to make the app more useful. You can change Apple Health permissions anytime in Apple Health or iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit uses the health, activity, nutrition, recovery, and planner data you allow or enter to make the app more useful. You can change Apple Health permissions anytime in Apple Health or iOS Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit использует разрешенные или введенные вами данные здоровья, активности, питания, восстановления и планировщика, чтобы сделать приложение полезнее. Разрешения Apple Health можно изменить в любое время в Apple Health или настройках iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 利用系统授予或您手动提供的健康、活动、饮食、恢复及日程规划数据，不断优化应用功能。您可随时在 Apple Health 应用或 iOS 设置中修改 Apple Health 的授权权限。"
          }
        }
      }
    },
