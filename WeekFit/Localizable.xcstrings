    "termsPrivacy.legal.privacy.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit verkauft keine persönlichen Gesundheitsinformationen und teilt Apple Health-Daten nicht mit Werbetreibenden oder Datenbrokern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit does not sell personal health information and does not share Apple Health data with advertisers or data brokers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit no vende información personal de salud ni comparte datos de Apple Health con anunciantes o intermediarios de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit ne vend pas d'informations de santé personnelles et ne partage pas les données Apple Health avec des annonceurs ou courtiers en données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit non vende informazioni sanitarie personali e non condivide dati Apple Health con inserzionisti o broker."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは個人の健康情報を販売せず、Apple Healthデータを広告主やデータブローカーと共有しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 개인 건강 정보를 판매하지 않으며 Apple Health 데이터를 광고주·데이터 브로커와 공유하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit nie sprzedaje danych zdrowotnych i nie udostępnia danych Apple Health reklamodawcom ani brokerom danych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit не продает персональную медицинскую информацию и не передает данные Apple Health рекламодателям или брокерам данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 不出售个人医疗信息，也不将 Apple Health 相关数据传递给广告主或数据经纪商。"
          }
        }
      }
    },
    "termsPrivacy.legal.privacy.p3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo möglich, erfolgt Datenverarbeitung auf dem Gerät, um unnötige Übertragung und Sammlung zu reduzieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where possible, data processing is performed on device to reduce unnecessary data transfer and collection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando es posible, el procesamiento se realiza en el dispositivo para reducir transferencias y recopilación innecesarias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la mesure du possible, le traitement des données est effectué sur l'appareil pour limiter les transferts et la collecte inutiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando possibile, l’elaborazione avviene sul dispositivo per ridurre trasferimenti e raccolta non necessari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能な限り、不要な転送と収集を減らすためデバイス上で処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능하면 불필요한 전송·수집을 줄이기 위해 기기에서 처리합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam, gdzie to możliwe, przetwarzanie odbywa się na urządzeniu, aby ograniczyć niepotrzebny transfer i zbieranie danych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По возможности обработка данных выполняется на устройстве, чтобы уменьшить ненужную передачу и сбор данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在可能的情况下，数据处理均在本地设备上进行，以减少不必要的数据传输与数据收集。"
          }
        }
      }
    },
    "termsPrivacy.legal.privacy.p4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn künftige Funktionen externe Verarbeitung, Kontodienste, Cloud-Sync, Analysen oder Support-Diagnose erfordern, sollten diese separat offengelegt und gemäß Datenschutzrichtlinie und App Store-Anforderungen behandelt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If future features require external processing, account services, cloud sync, analytics, or support diagnostics, those features should be disclosed separately and handled according to the app privacy policy and applicable App Store requirements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si funciones futuras requieren procesamiento externo, servicios de cuenta, sincronización en la nube, analítica o diagnósticos de soporte, se informarán por separado y se gestionarán según la política de privacidad y los requisitos del App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si des fonctionnalités futures nécessitent un traitement externe, des services de compte, une synchronisation cloud, des analyses ou des diagnostics d'assistance, elles seront présentées séparément et gérées conformément à la politique de confidentialité et aux exigences de l'App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se funzioni future richiedono elaborazione esterna, account, sync cloud, analytics o diagnostica supporto, devono essere disclose separatamente secondo privacy e App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将来の機能で外部処理、アカウントサービス、クラウド同期、分析、サポート診断が必要な場合は、別途開示し、プライバシーポリシーとApp Store要件に従う必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "향후 기능에 외부 처리, 계정 서비스, 클라우드 동기화, 분석, 지원 진단이 필요하면 별도 공개하고 개인정보 정책·App Store 요건을 따라야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli przyszłe funkcje wymagają przetwarzania zewnętrznego, usług konta, synchronizacji w chmurze, analityki lub diagnostyki wsparcia, zostaną opisane osobno i obsłużone zgodnie z polityką prywatności oraz wymaganiami App Store."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если будущие функции потребуют внешней обработки, учетных сервисов, облачной синхронизации, аналитики или диагностик поддержки, такие функции должны быть раскрыты отдельно и обрабатываться согласно политике конфиденциальности приложения и требованиям App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若未来功能需要外部处理、账户服务、云同步、分析或支持性诊断，则此类功能应单独披露，并依据应用隐私政策及适用的 App Store 要求进行处理。"
          }
        }
      }
    },
