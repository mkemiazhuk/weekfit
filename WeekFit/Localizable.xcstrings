    "onboarding.v2.health.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Workout, jeder Schritt und jede Aktivität auf der Apple Watch wird automatisch Teil der heutigen Empfehlung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every workout, every step and every activity you complete on Apple Watch automatically becomes part of today's guidance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada entrenamiento, paso y actividad en Apple Watch pasa automáticamente a formar parte de la orientación de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque entraînement, chaque pas et chaque activité sur Apple Watch devient automatiquement partie des conseils du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni allenamento, ogni passo e ogni attività completata su Apple Watch entra automaticamente nella guida di oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchで完了するワークアウト、歩数、すべての活動が自動的に今日のガイダンスの一部になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch에서 완료하는 모든 운동, 걸음, 활동이 자동으로 오늘의 안내에 포함됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy trening, krok i aktywność z Apple Watch automatycznie wchodzą w dzisiejsze wskazówki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая тренировка, каждый шаг и каждая активность с Apple Watch автоматически становятся частью подсказок на сегодня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在 Apple Watch 上完成的每一次锻炼、每一步行走以及每一项活动，都会自动成为今日运动指导的一部分。"
          }
        }
      }
    },
