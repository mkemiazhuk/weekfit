    "coach.scenario.recoveryAfter.breathing.late.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut. Halte den Abend ruhig und lass dieses Herunterschalten sich in den Schlaf tragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good. Keep the evening quiet and let this downshift carry toward sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien. Mantenga la noche tranquila y deje que esta transición lleve hacia el sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien. Gardez la soirée calme et laissez cette transition mener vers le sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bene. Mantieni la serata tranquilla e lascia che questa decelerazione conduca verso il sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いいですね。夜を静かに保ち、このダウンシフトが眠りへと導くようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋아요. 저녁 시간을 조용히 보내고 이 느린 리듬이 잠으로 이어지게 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrze. Utrzymaj spokojny wieczór i pozwól temu zwolnieniu poprowadzić do snu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хорошо. Сохраните вечер спокойным и позвольте этому снижению темпа перейти ко сну."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很好。保持夜晚安静，让这次降速逐渐引导你进入睡眠状态。"
          }
        }
      }
    },
    "coach.scenario.recoveryAfter.breathing.normal.message" : {
      "extractionState" : "manual",
