    "highlights.story.foundRhythm.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erholung blieb stabil, weil Ihr Schlaf-Timing und Ihre Trainingsbelastung in diesem Monat konsistenter waren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery stayed steady because your sleep timing and training load were more consistent this month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación se mantuvo estable porque su horario de sueño y la carga de entrenamiento fueron más consistentes este mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération est restée stable car votre horaire de sommeil et votre charge d'entraînement étaient plus constants ce mois-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero è rimasto stabile perché il tempo di sonno e il carico di allenamento sono stati più coerenti questo mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月は睡眠のタイミングとトレーニングの負荷がより一貫したため、回復は着実にとどまりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복은 당신의 수면 타이밍과 훈련 짐이 더 일관되게 된 때문에 꾸준한 유지했습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja była stabilna, bo harmonogram snu i obciążenie treningowe były bardziej stałe w tym miesiącu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление оставалось стабильным, потому что сон и тренировочная нагрузка в этом месяце были ровнее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复情况保持稳定，是因为本月的睡眠与训练负荷均更为均衡。"
          }
        }
      }
    },
