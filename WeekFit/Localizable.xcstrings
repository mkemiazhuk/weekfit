    "coach.humanDecision.time.activeSauna.evening.recommendation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutze es zur Entspannung, nicht um den Tag zu verlängern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use it to relax, not to extend the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsela para relajarse, no para alargar el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servez-vous-en pour vous détendre, pas pour prolonger la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usalo per rilassarti, non per prolungare la giornata."
