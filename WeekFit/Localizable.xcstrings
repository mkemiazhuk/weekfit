          "stringUnit": {
            "state": "translated",
            "value": "Insights needs more overlapping sleep, recovery, training and nutrition data before ranking stories."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсайтам нужно больше пересекающихся данных о сне, восстановлении, тренировках и питании перед ранжированием историй."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Insights 在对报道进行排序前，需要更多关于睡眠、恢复、训练及营养方面的交叉数据。"
          }
        }
      }
    },
