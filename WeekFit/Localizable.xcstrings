    "recovery.stressIndex.meaning.elevated" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Körper scheint heute stärker belastet als üblich. Leichteres Workout oder zusätzliche Erholung kann passender sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body appears to be under more strain than usual today. A lighter workout or additional recovery may be more appropriate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su cuerpo parece estar bajo más tensión de lo habitual hoy. Un entrenamiento más ligero o recuperación extra puede ser más apropiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre corps semble subir plus de tension que d'habitude aujourd'hui. Un entraînement plus léger ou une récupération supplémentaire peut être plus approprié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il corpo sembra sotto più strain del solito oggi. Workout più leggero o recupero extra può essere più adatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はからだの負荷がいつもより高く見えます。軽いワークアウトや追加回復が適切かも。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 몸의 부담이 평소보다 큰 것 같습니다. 더 가벼운 운동이나 추가 회복이 더 맞을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciało wydaje się dziś pod większym obciążeniem niż zwykle. Lżejszy trening lub dodatkowa regeneracja mogą być bardziej odpowiednie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня тело выглядит под большей нагрузкой, чем обычно. Более лёгкая тренировка или дополнительное восстановление могут подойти лучше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天身体负荷高于平常。更轻松的训练或额外恢复可能更合适。"
          }
        }
      }
    },
    "recovery.stressIndex.meaning.high" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Körper scheint ungewöhnlich stark belastet. Ein leichterer Tag passt besser — besonders wenn auch die Erholung begrenzt wirkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body appears to be under unusually high strain. A lighter day may fit better — especially if Recovery also looks limited."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su cuerpo parece estar bajo una tensión inusualmente alta. Un día más ligero puede encajar mejor, especialmente si la recuperación parece limitada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre corps semble subir une tension inhabituellement élevée. Une journée plus légère peut mieux convenir — surtout si la récupération semble limitée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il corpo sembra sotto strain insolitamente alto. Una giornata più leggera può adattarsi meglio — soprattutto se anche il recupero sembra limitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "からだの負荷が異常に高く見えます。軽い一日がより適切—特に回復も限定的なら。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸의 부담이 유난히 높아 보입니다. 더 가벼운 하루가 더 맞을 수 있습니다 — 특히 회복도 제한적이라면."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciało wydaje się pod nietypowo wysokim obciążeniem. Lżejszy dzień może lepiej pasować — zwłaszcza gdy regeneracja wygląda ograniczona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тело выглядит под необычно высокой нагрузкой. Более лёгкий день может подойти лучше — особенно если восстановление тоже ограничено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身体负荷异常偏高。轻松一天可能更合适——尤其恢复也偏弱时。"
          }
        }
      }
    },
    "recovery.stressIndex.meaning.low" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Vergleich zu deinem üblichen Muster ist die Belastung ruhig. Behalte den Recovery Score als Hauptsignal für die Bereitschaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strain looks calm relative to your usual pattern. Keep Recovery Score as the main readiness signal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frente a tu patrón habitual, la carga es tranquila. Mantén la puntuación de recuperación como señal principal de preparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par rapport à votre schéma habituel, la charge est calme. Gardez le score de récupération comme signal principal de disponibilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispetto al tuo schema abituale, il carico è calmo. Tieni il punteggio di recupero come segnale principale di disponibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつものパターンに対して負荷は穏やかです。回復スコアを主な準備度の信号として保ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평소 패턴 대비 부담이 차분합니다. 회복 점수를 주된 준비 신호로 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W porównaniu z Twoim zwykłym wzorcem obciążenie jest spokojne. Trzymaj wynik regeneracji jako główny sygnał gotowości."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По сравнению с обычным паттерном нагрузка спокойная. Держи оценку восстановления как главный сигнал готовности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相对你的日常模式，负荷较轻。请继续以恢复评分作为主要的准备度信号。"
          }
        }
      }
    },
    "recovery.stressIndex.meaning.moderate" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas Belastung ist vorhanden. Wenn Erholung solide wirkt, erwägen Sie eine kontrollierte Session statt hartem Druck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some strain appears present. If Recovery still looks solid, consider a controlled session rather than pushing hard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay cierta tensión presente. Si la recuperación sigue sólida, considere una sesión controlada en lugar de exigirse al máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une certaine tension est présente. Si la récupération reste solide, envisagez une séance contrôlée plutôt que de pousser fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’è un po’ di strain. Se il recupero sembra solido, consideri sessione controllata invece di spingere forte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多少の負荷あり。回復が堅実なら、強く押すよりコントロールされたセッションを。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약간의 부담이 있습니다. 회복이 견실하면 세게 밀기보다 조절된 세션을 고려하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widać pewną tensję. Jeśli regeneracja nadal wygląda solidnie, rozważ kontrolowaną sesję zamiast mocnego wysiłku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть некоторая нагрузка. Если восстановление всё ещё выглядит уверенным, рассмотрите контролируемую тренировку вместо максимальной."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在一定负荷。若恢复仍不错，可做可控训练，不必硬推。"
          }
        }
      }
    },
    "recovery.stressIndex.meaning.unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index schätzt physiologische Belastung aus Ihren eigenen jüngsten Gesundheitssignalen. Tragen Sie Apple Watch konsequent, damit WeekFit Ihre persönliche Baseline lernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index estimates physiological strain from your own recent health signals. Wear Apple Watch consistently so WeekFit can learn your personal baseline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index estima la tensión fisiológica a partir de sus señales de salud recientes. Use Apple Watch de forma constante para que WeekFit aprenda su referencia personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Stress Index estime la tension physiologique à partir de vos signaux de santé récents. Portez Apple Watch régulièrement pour que WeekFit apprenne votre référence personnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index stima lo strain fisiologico dai Suoi segnali salute recenti. Indossi Apple Watch costantemente così WeekFit impara la Sua baseline personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Indexはご自身の最近の健康シグナルから生理的負荷を推定します。WeekFitが個人ベースラインを学べるようApple Watchを着用し続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index는 본인의 최근 건강 신호로 생리적 부담을 추정합니다. WeekFit이 개인 기준선을 학습하도록 Apple Watch를 꾸준히 착용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index szacuje obciążenie fizjologiczne na podstawie ostatnich sygnałów zdrowia. Noś Apple Watch regularnie, aby WeekFit poznał Twoją osobistą linię bazową."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индекс нагрузки оценивает физиологическую нагрузку по вашим недавним сигналам здоровья. Носите Apple Watch регулярно, чтобы WeekFit мог сформировать ваш личный базовый уровень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负荷指数根据你近期健康信号估算生理负荷。请规律佩戴 Apple Watch，以便 WeekFit 学习你的个人基线。"
          }
        }
      }
    },
