            "value" : "¿Puedo usar WeekFit sin planificar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puis-je utiliser WeekFit sans planifier ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso usare WeekFit senza pianificare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画なしでWeekFitは使えますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획 없이 WeekFit을 사용할 수 있나요?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy mogę używać WeekFit bez planowania?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно ли использовать WeekFit без планирования?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
