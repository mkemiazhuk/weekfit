    "recovery.insight.lowDeep.actionText" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine konsistente Schlafenszeit und eine niedrigere Stimulation am späten Abend können helfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A consistent bedtime and lower late-evening stimulation may help."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una hora de acostarse constante y menos estimulación al final del día pueden ayudar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une heure de coucher régulière et moins de stimulation en fin de soirée peuvent aider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una stimolazione costante del letto e inferiore del tardo serale può aiutare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一貫した就寝時間と下降の刺激が役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일관적인 bedtime 및 더 낮은 늦게 일절 자극은 도울지도 모릅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stała pora snu i mniej stymulacji wieczorem mogą pomóc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стабильный отбой и меньше стимуляции вечером могут помочь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定就寝时间、减少深夜刺激可能会有帮助。"
          }
        }
      }
    },
