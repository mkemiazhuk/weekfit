    "termsPrivacy.legal.disclaimer.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit bietet allgemeine Wellness-, Fitness-, Erholungs-, Hydrations-, Schlaf- und Ernährungsinformationen nur zu Bildungs- und Informationszwecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit provides general wellness, fitness, recovery, hydration, sleep, and nutrition information for educational and informational purposes only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit ofrece información general de bienestar, fitness, recuperación, hidratación, sueño y nutrición solo con fines educativos e informativos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit fournit des informations générales sur le bien-être, la forme, la récupération, l'hydratation, le sommeil et la nutrition à des fins éducatives et informatives uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit fornisce informazioni generali su wellness, fitness, recupero, idratazione, sonno e nutrizione solo a scopo informativo ed educativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは一般的なウェルネス、フィットネス、回復、水分、睡眠、栄養情報を教育・情報目的のみで提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 일반 웰니스, 피트니스, 회복, 수분, 수면, 영양 정보를 교육·정보 목적으로만 제공합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit dostarcza ogólne informacje o wellness, kondycji, regeneracji, nawodnieniu, śnie i odżywianiu wyłącznie w celach edukacyjnych i informacyjnych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit предоставляет общую информацию о благополучии, фитнесе, восстановлении, гидратации, сне и питании только в образовательных и информационных целях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 提供的关于身心健康、健身、恢复、水分补充、睡眠及营养的一般性信息，仅用于教育和信息传播目的。"
          }
        }
      }
    },
    "termsPrivacy.legal.disclaimer.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit bietet keine medizinische Beratung, Diagnose, Behandlung, Verschreibung, Therapie oder professionelle Gesundheitsdienste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit does not provide medical advice, diagnosis, treatment, prescription, therapy, or professional healthcare services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit no ofrece asesoramiento médico, diagnóstico, tratamiento, prescripción, terapia ni servicios profesionales de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit ne fournit pas de conseil médical, de diagnostic, de traitement, de prescription, de thérapie ni de services de santé professionnels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit non fornisce consulenza medica, diagnosi, trattamento, prescrizione, terapia o servizi sanitari professionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは医療アドバイス、診断、治療、処方、セラピー、専門的ヘルスケアサービスを提供しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 의료 조언, 진단, 치료, 처방, 테라피, 전문 의료 서비스를 제공하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit nie świadczy porad medycznych, diagnozy, leczenia, recept, terapii ani profesjonalnych usług zdrowotnych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit не предоставляет медицинские советы, диагнозы, лечение, рецепты, терапию или профессиональные медицинские услуги."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 不提供医疗建议、诊断、治疗方案、处方、治疗措施或专业医疗服务。"
          }
        }
      }
    },
    "termsPrivacy.legal.disclaimer.p3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coaching-Einblicke, Ernährungsvorschläge, Erholungshinweise, Erinnerungen, Aktivitätsstatus und Metrik-Zusammenfassungen ersetzen keine Beratung durch Arzt, Ernährungsberater, Physiotherapeut oder andere qualifizierte Fachkräfte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coaching insights, nutrition suggestions, recovery guidance, reminders, activity status, and metric summaries are not a substitute for advice from a doctor, dietitian, physiotherapist, or other qualified professional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las orientaciones de coaching, sugerencias nutricionales, guía de recuperación, recordatorios, estados de actividad y resúmenes de métricas no sustituyen el consejo de un médico, dietista, fisioterapeuta u otro profesional cualificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les analyses coaching, suggestions nutrition, conseils de récupération, rappels, statuts d'activité et résumés de métriques ne remplacent pas l'avis d'un médecin, diététicien, physiothérapeute ou autre professionnel qualifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insight Coach, suggerimenti nutrizionali, guida recupero, promemoria, stato attività e riepiloghi metriche non sostituiscono un medico, dietista, fisioterapista o altro professionista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coachの洞察、栄養提案、回復ガイダンス、リマインダー、アクティビティ状態、指標サマリーは、医師、栄養士、理学療法士など専門家の助言の代わりにはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach 인사이트, 영양 제안, 회복 안내, 알림, 활동 상태, 지표 요약은 의사, 영양사, 물리치료사 등 전문가 조언을 대체하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówki coachingowe, sugestie żywieniowe, regeneracja, przypomnienia, status aktywności i podsumowania metryk nie zastępują opinii lekarza, dietetyka, fizjoterapeuty ani innego specjalisty."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коучинговые инсайты, рекомендации по питанию, советы по восстановлению, напоминания, статусы активности и сводки метрик не заменяют консультацию врача, диетолога, физиотерапевта или другого квалифицированного специалиста."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练指导、营养建议、恢复指导、提醒信息、活动状态及指标摘要均不能替代医生、营养师、物理治疗师或其他合格专业人士提供的专业建议。"
          }
        }
      }
    },
    "termsPrivacy.legal.disclaimer.p4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsultieren Sie vor gesundheitsbezogenen Entscheidungen, neuen Trainingsprogrammen, Ernährungsumstellungen oder App-basierter Orientierung bei medizinischen Erkrankungen, Verletzungen, Schwangerschaft, Medikamenten oder anderen Bedenken immer eine qualifizierte Fachkraft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always consult a qualified healthcare professional before making health-related decisions, starting a new training program, changing your diet, or relying on app-based guidance if you have any medical condition, injury, pregnancy, medication use, or other health concern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulte siempre a un profesional sanitario cualificado antes de decisiones de salud, un nuevo plan de entrenamiento, cambios de dieta o confiar en la app si tiene una condición médica, lesión, embarazo, medicación u otra preocupación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez toujours un professionnel de santé qualifié avant toute décision liée à la santé, un nouveau programme d'entraînement, un changement alimentaire ou si vous vous fiez aux conseils de l'app en cas de condition médicale, blessure, grossesse, médication ou autre préoccupation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta sempre un professionista qualificato prima di decisioni salute, nuovi programmi, cambi dieta o affidarti all’app in caso di condizioni mediche, infortuni, gravidanza, farmaci o altre preoccupazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康に関する決定、新しいトレーニング、食事変更、アプリのガイダンスに頼る前に、病状、けが、妊娠、服薬、その他の懸念がある場合は必ず専門家に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강 관련 결정, 새 훈련, 식단 변경, 앱 안내 의존 전에 질환, 부상, 임신, 약물, 기타 우려가 있으면 항상 자격 있는 전문가와 상담하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze skonsultuj się z wykwalifikowanym specjalistą przed decyzjami zdrowotnymi, nowym planem treningowym, zmianą diety lub poleganiem na aplikacji przy schorzeniu, urazie, ciąży, lekach lub innych obawach."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда консультируйтесь с квалифицированным медицинским специалистом перед решениями, связанными со здоровьем, началом новой программы тренировок, изменением питания или использованием рекомендаций приложения, если у вас есть заболевание, травма, беременность, прием лекарств или другие вопросы по здоровью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若您患有任何疾病、受过外伤、处于妊娠期、正在服用药物或存在其他健康顾虑，在做出与健康相关的决定、开始新的训练计划、调整饮食方案或依赖应用程序提供的指导前，请务必咨询具备资质的医疗保健专业人员。"
          }
        }
      }
    },
