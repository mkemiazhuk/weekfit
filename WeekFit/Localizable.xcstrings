    "support.faq.item18.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit nutzt zeitadaptive Ziele tagsüber. Morgenziele sind bewusst leichter, damit der Fortschritt realistisch zum Tagesverlauf passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit uses time-adaptive targets during the day. Morning targets are intentionally lighter so progress reflects where your day realistically is instead of expecting full-day nutrition too early."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa objetivos adaptativos en el tiempo. Los objetivos matutinos son más ligeros a propósito para reflejar dónde está realmente su día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit utilise des objectifs adaptatifs dans le temps. Les objectifs du matin sont volontairement plus légers pour refléter où en est réalistement votre journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa obiettivi adattivi nel tempo durante il giorno. Quelli mattutini sono più leggeri per riflettere dove sei realmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは日中に時間適応型目標を使います。朝の目標は意図的に軽く、一日の現実的な位置に合わせた進捗になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 하루 중 시간 적응형 목표를 사용합니다. 아침 목표는 의도적으로 가볍게, 하루 진행에 맞는 진행률을 반영합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit stosuje cele adaptacyjne w czasie. Poranne cele są celowo lżejsze, by postęp odzwierciedlał realny etap dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit использует цели, адаптированные ко времени дня. Утренние цели специально легче, чтобы прогресс отражал реальное состояние дня, а не требовал полного дневного объема сразу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 采用根据一天中的不同时段量身定制的目标。晨间目标特意设定得较为简单，以便进展情况能真实反映当日的实际状态，而非要求一次性完成全天的训练量。"
          }
        }
      }
    },
    "support.faq.item18.title" : {
