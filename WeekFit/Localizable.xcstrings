    "insights.view.fallbackSupport.trainingContext.hydration.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydration ist am wichtigsten, wenn die Trainingslast hoch genug ist, um die Wiederherstellungskosten zu erhöhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
