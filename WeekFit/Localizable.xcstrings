    "recovery.insight.noSleep.action" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Apple Watch im Schlaf oder überprüfen Sie die Sleep Focus-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Apple Watch during sleep or check Sleep Focus settings."
