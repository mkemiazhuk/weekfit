    "onboarding.v13.photo.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit schätzt Kalorien, zerlegt den Teller in Zutaten in Gramm und füllt die Nährwerte — schnelles Logging."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit estimates calories, breaks the plate into ingredients by grams, and fills nutrition — so logging stays fast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit estima calorías, divide el plato en ingredientes en gramos y completa la nutrición — registro rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit estime les calories, découpe l’assiette en ingrédients en grammes et remplit la nutrition — pour un suivi rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit stima le calorie, scompone il piatto in ingredienti in grammi e compila la nutrizione — logging veloce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カロリーを推定し、皿をグラム単位の材料に分解、栄養も入力。記録が速くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "칼로리를 추정하고, 접시를 그램 단위 재료로 나누며 영양을 채웁니다 — 기록이 빨라집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit oszacuje kalorie, rozłoży talerz na składniki w gramach i uzupełni nutrition — szybkie logowanie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit оценит калории, разложит блюдо на ингредиенты в граммах и заполнит nutrition — логировать быстро."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 估算热量，按克数拆分食材，并填好营养数据——记录更快。"
          }
        }
      }
    },
