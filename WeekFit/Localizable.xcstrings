    "coach.humanDecision.keepItEasySoItHelpsRecovery.2124" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie es einfach, damit es die Erholung unterstützt und Energie für die nächste Einheit übrig bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it easy so it supports recovery and leaves energy for the next session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manténlo suave para apoyar recuperación y dejar energía para la siguiente sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez-le facile pour soutenir la récupération et laisser de l’énergie pour la prochaine séance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantienilo semplice in modo che supporti il recupero e lasci energia per la sessione successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復をサポートし、次のセッションのためのエネルギーを残すように、簡単にしておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복을 돕고 다음 세션을 위한 에너지를 남길 수 있도록 쉽게 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj łatwo, by wspierać regenerację i zostawić energię na następną sesję."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите легко, чтобы поддержать восстановление и сохранить силы на следующую тренировку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持简单，以利于恢复，并为下一次训练保留精力。"
          }
        }
      }
    },
    "coach.humanDecision.keepRecoveryWorkEasyAndMakeTonight.2892" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
