    "onboarding.v6.coach.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach liest Erholung, Aktivität, Ernährung und Pläne — und gibt einen klaren nächsten Schritt, nicht nur mehr Zahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach reads recovery, activity, nutrition and plans — then gives a clear next step, not just more numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach lee recuperación, actividad, nutrición y planes — y da un siguiente paso claro, no solo más números."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach lit récupération, activité, nutrition et plans — puis donne une prochaine étape claire, pas seulement plus de chiffres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach legge recupero, attività, nutrizione e piani — poi dà un passo chiaro, non solo più numeri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coachは回復、活動、栄養、予定を読み—数字だけでなく明確な次の一歩を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach는 회복, 활동, 영양, 계획을 읽고 — 숫자가 아닌 명확한 다음 단계를 제공합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach czyta regenerację, aktywność, odżywianie i plany — potem daje jasny następny krok, nie tylko więcej liczb."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренер учитывает восстановление, активность, питание и планы — и даёт ясный следующий шаг, а не ещё цифры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练会评估患者的恢复情况、活动量及营养状况并制定计划——随后给出明确的后续步骤，而非仅提供更多数据。"
          }
        }
      }
    },
