            "state" : "translated",
            "value" : "Schlaf, Erholung und die kürzliche Belastung stimmen gut überein, und es gibt keine geplante Einheit, die um Energie konkurriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep, recovery, and recent load line up well, and there is no planned session competing for energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sueño, recuperación y carga reciente encajan bien, y no hay sesión planificada compitiendo por energía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommeil, récupération et charge récente s’alignent bien, et aucune séance prévue ne rivalise pour l’énergie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonno, recupero e carico recente sono ben allineati e non c'è alcuna sessione programmata che competa per l'energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠、回復、最近の負荷の状態がうまく整っており、エネルギーを競う予定のセッションはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
