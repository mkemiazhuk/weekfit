    "support.faq.item24.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht unbedingt. WeekFit legt mehr Wert auf Balance, Erholung, Beständigkeit und Bewusstsein als auf perfekte Zahlen jeden Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not necessarily. WeekFit focuses more on balance, recovery, consistency, and awareness than hitting perfect numbers every day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesariamente. WeekFit prioriza equilibrio, recuperación, consistencia y conciencia más que números perfectos cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas nécessairement. WeekFit privilégie équilibre, récupération, régularité et conscience plutôt que des chiffres parfaits chaque jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non necessariamente. WeekFit privilegia equilibrio, recupero, costanza e consapevolezza rispetto a numeri perfetti ogni giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必ずしもそうではありません。WeekFitは毎日完璧な数字より、バランス、回復、一貫性、意識を重視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꼭 그렇지는 않습니다. WeekFit은 매일 완벽한 숫자보다 균형, 회복, 일관성, 인식을 더 중시합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niekoniecznie. WeekFit stawia na równowagę, regenerację, regularność i świadomość, a nie idealne liczby każdego dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не обязательно. WeekFit больше фокусируется на балансе, восстановлении, последовательности и осознанности, а не на идеальных числах каждый день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "并非如此。WeekFit 更注重平衡性、恢复能力、持续性和自我觉察，而非每天追求完美的数据指标。"
          }
        }
      }
    },
    "support.faq.item24.title" : {
