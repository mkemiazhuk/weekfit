    "settings.language.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gewählte Sprache betrifft Texte, Daten und Hinweise. Die Engine-Entscheidungen bleiben auf denselben Gesundheits- und Plansignalen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected language affects app copy, dates, and localized guidance. Engine decisions stay based on the same health and planner signals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma elegido cambia los textos, las fechas y las indicaciones. Las decisiones del motor siguen basándose en las mismas señales de salud y del plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue choisie change les textes, les dates et les conseils. Les décisions du moteur restent basées sur les mêmes signaux de santé et de planning."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lingua scelta influisce su testi, date e indicazioni. Le decisioni del motore restano basate sugli stessi segnali di salute e piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した言語はアプリの文言、日付、案内に影響します。エンジンの判断は同じ健康・プラン信号に基づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 언어는 앱 문구, 날짜, 안내에 영향을 줍니다. 엔진 결정은 동일한 건강·플랜 신호를 기준으로 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrany język zmienia teksty, daty i podpowiedzi. Decyzje silnika nadal opierają się na tych samych sygnałach zdrowia i planu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный язык влияет на текст приложения, даты и локализованные рекомендации. Решения движков остаются основанными на тех же сигналах здоровья и планирования."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选语言会影响应用文案、日期和本地化指导。引擎决策仍基于相同的健康与计划信号。"
          }
        }
      }
