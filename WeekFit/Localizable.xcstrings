    "onboarding.v6.plan.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Plan for the week’s workouts and recovery. Use Meals to save dishes Coach can recommend when you need them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Plan — тренировки и восстановление на неделю. В Meals — сохранённые блюда, которые Тренер может предложить, когда нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“计划”部分包含为期一周的训练与恢复方案；“膳食”部分则收录了教练在需要时可提供的精选餐单。"
          }
        }
      }
