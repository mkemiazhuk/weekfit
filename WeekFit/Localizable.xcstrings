    "coach.humanDecision.keepSaunaShortAndComfortableIWould.2009" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Sauna kurz und angenehm. Ich würde danach die Trainingsintensität reduzieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep sauna short and comfortable. I would reduce training intensity afterwards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauna corta y cómoda. Reduciría intensidad de entrenamiento después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le sauna court et confortable. Je réduirais l’intensité d’entraînement ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga la sauna breve e confortevole. Ridurrei l'intensità dell'allenamento successivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サウナは短く快適に保ってください。その後のトレーニングの強度は下げると思います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사우나는 짧고 편안하게 유지하세요. 그 후에는 훈련 강도를 줄이겠습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauna krótko i wygodnie. Potem obniżyłbym intensywność treningu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте сауну короткой и комфортной. После нее я бы снизил интенсивность тренировки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桑拿时间要短且保持舒适；训练结束后，我会适当降低训练强度。"
          }
        }
      }
    },
    "coach.humanDecision.keepSaunaShortRehydrateAfterwardsAndMake.2110" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Sauna kurz. Trinken Sie danach Wasser und machen Sie Erholung zur nächsten Priorität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep sauna short. Rehydrate afterwards and make recovery the next priority."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauna corta. Rehidrátate después y haz de la recuperación la siguiente prioridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le sauna court. Réhydratez-vous ensuite et faites de la récupération la prochaine priorité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni la sauna breve. Reidratati dopo e fai della recupero la prossima priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サウナは短時間にしてください。その後、再び水分を補給し、次の優先事項は回復にしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사우나는 짧게 하세요. 이후 수분을 보충하고 다음 우선순위는 회복으로 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauna krótko. Potem nawodnij się i regeneracja jako następny priorytet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте сауну короткой. После — пейте постепенно и переходите к восстановлению."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桑拿时间尽量缩短；结束后及时补充水分，并将恢复列为首要任务。"
          }
        }
      }
    },
