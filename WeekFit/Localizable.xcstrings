    "coach.proposal.review.weather.precip.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschieben Sie Aktivitäten im Freien – bevorzugen Sie Indoor-Optionen oder verlegen Sie sie auf früher / an einen trockeneren Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postpone outdoor plans — prefer indoor options, or move them earlier / to a drier day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posponga planes al aire libre — prefiera interior, o muévalos antes / a un día más seco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reportez les plans extérieurs — privilégiez l’intérieur, ou déplacez-les plus tôt / un jour plus sec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posticipa i piani all'aperto — preferisci opzioni al chiuso, oppure spostali prima / a un giorno più asciutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋外の予定は延期してください — 室内の選択肢を好むか、予定を前倒しにするか、乾いた日へ移動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "야외 계획을 연기하세요 — 실내 옵션을 선호하거나, 더 일찍 하거나, 더 건조한 날로 옮기세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełóż plany na zewnątrz — wybierz indoor lub wcześniejszy termin / suchszy dzień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отложите занятия на улице — лучше зал, раньше или в сухой день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请推迟户外计划——改室内，或提前／改到更干燥的一天。"
          }
        }
      }
    },
