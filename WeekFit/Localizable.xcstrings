          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卵、ハム、マッシュルーム、トマト、トーストを一緒にプレート。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계란, 햄, 버섯, 토마토, 토스트를 함께 도금합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ułóż jajka, szynkę, grzyby, pomidory i tost razem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выложите на тарелку яйца, ветчину, грибы, помидоры и тост."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将鸡蛋、火腿、蘑菇、番茄和烤面包片一同铺在盘中。"
          }
        }
      }
    },
