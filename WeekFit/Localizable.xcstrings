        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación es baja y varias señales fisiológicas están fuera de la referencia. Priorice la recuperación hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
