    "termsPrivacy.legal.termsOfUse.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Nutzung von WeekFit stimmen Sie zu, die App nur für rechtmäßige, persönliche, nicht-kommerzielle Wellness- und Fitnesszwecke zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By using WeekFit, you agree to use the app only for lawful, personal, non-commercial wellness and fitness purposes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al usar WeekFit, acepta utilizar la app solo de forma legal, personal, no comercial y para bienestar y fitness."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En utilisant WeekFit, vous acceptez de n'utiliser l'app que de manière légale, personnelle, non commerciale et pour le bien-être et la forme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando WeekFit accetti di usarla solo per scopi lawful, personali e non commerciali di wellness e fitness."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitの利用により、合法的な個人の非商用ウェルネス・フィットネス目的でのみ使用することに同意します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 사용 시 합법적·개인·비상업적 웰니스·피트니스 목적으로만 사용하는 데 동의합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korzystając z WeekFit, zgadzasz się używać aplikacji wyłącznie legalnie, osobiście, niekomercyjnie oraz do wellness i fitness."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используя WeekFit, вы соглашаетесь применять приложение только для законных, личных, некоммерческих целей благополучия и фитнеса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 WeekFit 即表示您同意仅将该应用程序用于合法、个人且非商业性的健康与健身用途。"
          }
        }
      }
    },
    "termsPrivacy.legal.termsOfUse.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind verantwortlich für Aktivitätswahl, Trainingsintensität, Ernährungsentscheidungen, Hydrationsgewohnheiten, Erholungsansatz und Nutzung aller App-Informationen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are responsible for your own activity choices, workout intensity, nutrition decisions, hydration habits, recovery approach, and use of any information shown in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es responsable de sus elecciones de actividad, intensidad de entrenamiento, decisiones de nutrición, hidratación, recuperación y uso de la información mostrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes responsable de vos choix d'activité, de l'intensité d'entraînement, de la nutrition, de l'hydratation, de la récupération et de l'utilisation des informations affichées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei responsabile di scelte attività, intensità allenamento, nutrizione, idratazione, recupero e uso delle informazioni nell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティ選択、トレーニング強度、栄養判断、水分習慣、回復アプローチ、アプリ情報の利用は自己責任です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활동 선택, 운동 강도, 영양 결정, 수분 습관, 회복 접근, 앱 정보 사용은 사용자 책임입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiadasz za wybór aktywności, intensywność treningu, decyzje żywieniowe, nawodnienie, regenerację i korzystanie z informacji w aplikacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы отвечаете за собственный выбор активности, интенсивность тренировок, решения по питанию, привычки гидратации, подход к восстановлению и использование любой информации, показанной в приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您负责自行选择运动项目、设定训练强度、制定饮食方案、养成补水习惯、规划恢复方案，并充分利用应用程序中提供的所有信息。"
          }
        }
      }
    },
    "termsPrivacy.legal.termsOfUse.p3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit kann Vorschläge basierend auf verfügbaren Daten geben, garantiert aber keine Leistungs-, Erholungs-, Gesundheits-, Fitness- oder Wellness-Ergebnisse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit may provide suggestions based on the data available to the app, but those suggestions are not a guarantee of performance, recovery, health, fitness, or wellness results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit puede ofrecer sugerencias según los datos disponibles, pero no garantiza rendimiento, recuperación, salud, fitness ni resultados de bienestar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit peut proposer des suggestions selon les données disponibles, sans garantir performance, récupération, santé, forme ou résultats bien-être."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit può fornire suggerimenti sui dati disponibili, ma non garantisce risultati di performance, recupero, salute, fitness o wellness."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは利用可能なデータに基づく提案を出しますが、パフォーマンス、回復、健康、フィットネス、ウェルネスの結果を保証しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 사용 가능한 데이터 기반 제안을 제공하지만 성과, 회복, 건강, 피트니스, 웰니스 결과를 보장하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit może sugerować na podstawie dostępnych danych, lecz nie gwarantuje wyników wydolności, regeneracji, zdrowia, kondycji ani wellness."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit может давать рекомендации на основе доступных приложению данных, но эти рекомендации не гарантируют результаты в производительности, восстановлении, здоровье, фитнесе или благополучии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 可根据应用程序中的可用数据提供建议，但这些建议并不能保证在运动表现、恢复、健康、健身或整体福祉方面取得预期效果。"
          }
        }
      }
    },
    "termsPrivacy.legal.termsOfUse.p4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden Sie jede Aktivität und suchen Sie professionelle Hilfe bei Schmerzen, Schwindel, Atemnot, ungewöhnlichem Unbehagen oder anderen besorgniserregenden Symptomen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You should stop any activity and seek appropriate professional help if you feel pain, dizziness, shortness of breath, unusual discomfort, or any other concerning symptoms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenga cualquier actividad y busque ayuda profesional adecuada si siente dolor, mareo, falta de aire, molestia inusual u otros síntomas preocupantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez toute activité et consultez un professionnel approprié en cas de douleur, vertige, essoufflement, inconfort inhabituel ou autre symptôme inquiétant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompi l’attività e cerca aiuto professionale in caso di dolore, vertigini, fiato corto, disagio insolito o altri sintomi preoccupanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "痛み、めまい、息切れ、異常な不快感、その他気になる症状がある場合は活動を止め、適切な専門家の助けを求めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통증, 어지러움, 호흡 곤란, 이상한 불편함, 기타 우려 증상이 있으면 활동을 중단하고 전문가 도움을 받으세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przerwij aktywność i zwróć się o pomoc do specjalisty przy bólu, zawrotach głowy, duszności, nietypowym dyskomforcie lub innych niepokojących objawach."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прекратите любую активность и обратитесь за профессиональной помощью, если почувствуете боль, головокружение, одышку, необычный дискомфорт или другие тревожные симптомы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如出现疼痛、头晕、呼吸困难、异常不适感或其他警示症状，请立即停止一切活动，并寻求专业医疗帮助。"
          }
        }
      }
    },
