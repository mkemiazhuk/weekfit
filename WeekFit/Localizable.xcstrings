    "meals.starter.turkeySweetPotato.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braten oder Mikrowelle die Süßkartoffel bis weich, dann teilen oder würfeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roast or microwave the sweet potato until soft, then split or cube it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asse o caliente la batata en microondas hasta que esté blanda y córtela o en cubos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rôtissez ou chauffez au micro-ondes la patate douce jusqu'à tendreté, puis coupez ou écrasez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roast o microonde la patata dolce fino a morbido, poi dividere o cubare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローストまたは電子レンジ 甘いジャガイモ 柔らかくなるまで、分割またはキューブします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로스트 또는 전자 레인지 부드러운 때까지 달콤한 감자, 다음 분할 또는 cube 그것."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upiecz lub podgrzej batata w mikrofalówce do miękkości, następnie przekrój lub pokrój w kostki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запеките или приготовьте батат в микроволновке до мягкости, затем разрежьте или нарежьте кубиками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将红薯放入微波炉加热至软烂，然后切成块或丁。"
          }
        }
      }
    },
    "meals.starter.turkeySweetPotato.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen Sie den Truthahn in einer Pfanne, bis er gebräunt und vollständig gekocht ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook the turkey in a pan until browned and fully cooked through."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine el pavo en la sartén hasta que esté dorado y completamente hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez la dinde à la poêle jusqu'à coloration et cuisson complète."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuocere il tacchino in una pentola fino a brunire e cucinare completamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "茶色にし、十分に調理されるまで鍋で七面鳥を調理して下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쿡 turkey 에 the pan 까지 갈색과 완전히 요리."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usmaż indyka na patelni, aż się zrumieni i będzie w pełni ugotowany."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обжарьте индейку на сковороде до румяности и полной готовности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将火鸡放入煎锅中煎至表面呈金黄色且内部完全熟透。"
          }
        }
      }
    },
    "meals.starter.turkeySweetPotato.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blanch oder sauté die grünen Bohnen bis zart-knusprig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blanch or sauté the green beans until tender-crisp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blanquee o saltee las judías verdes hasta quedar tiernas y crujientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blanchissez ou faites sauter les haricots verts jusqu'à tendreté croquante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spruzzare o far saltare i fagiolini fino a tenerissimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランクやマルシェは、入札が限られるまで緑色の豆をサテ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "블랑 또는 sauté는 부드러운 주름까지 녹색 콩."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blanszuj lub smaż fasolkę szparagową do chrupko-tender."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бланшируйте или обжарьте стручковую фасоль до лёгкого хруста."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将四季豆焯水或煸炒至嫩脆。"
          }
        }
      }
    },
    "meals.starter.turkeySweetPotato.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platten Sie die Süßkartoffel mit Truthahn und grünen Bohnen, dann Saison zum Geschmack."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
