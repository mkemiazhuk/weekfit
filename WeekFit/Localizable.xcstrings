    "insights.vm.opportunity.keepRhythm.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erholung ist bereits stark genug, dass die nächste nützliche Lektion darin besteht, welche Gewohnheit sie bei Trainingsänderungen stabil hält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery is already strong enough that the next useful lesson is which habit keeps it stable when training changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación ya es lo bastante fuerte; la próxima lección útil es qué hábito la mantiene estable cuando cambia el entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération est déjà assez forte : la prochaine leçon utile est quel habitude la maintient stable quand l'entraînement change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero è già abbastanza forte che la prossima lezione utile è quale abitudine lo mantiene stabile quando la formazione cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復は、トレーニングが変化するときに、次の便利なレッスンが安定した状態に保つことができるほど十分に強いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구는 이미 강한 충분히 그 다음 유용한 교훈은 교육 변화 때 안정 유지 습관."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja jest już wystarczająco silna — kolejną użyteczną lekcją jest, który nawyk utrzymuje ją stabilną, gdy trening się zmienia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление уже достаточно сильное — следующий полезный урок: какая привычка держит его стабильным при изменении тренировок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复情况已经相当显著——接下来值得关注的要点是：在训练计划调整期间，哪种习惯能帮助他保持稳定状态。"
          }
        }
      }
    },
