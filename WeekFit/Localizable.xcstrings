    "meals.starter.chickenRice.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen Sie den Reis bis zart und flauschig, dann warm halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook the rice until tender and fluffy, then keep warm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine el arroz hasta que quede tierno y manténgalo caliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez le riz jusqu'à tendreté et gardez-le au chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuocere il riso fino a tenero e soffice, quindi tenere caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔らかく、ふわふわまでご飯を炊き、暖かさを保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밥을 부드럽게하고 푹신할 때까지 요리하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugotuj ryż do miękkości i utrzymuj ciepły."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отварите рис до мягкости и рассыпчатости, затем держите тёплым."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将大米煮至软烂且蓬松，然后保温。"
          }
        }
      }
    },
    "meals.starter.chickenRice.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saison das Huhn und Pfanne bis durch gekocht und leicht gebräunt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Season the chicken and pan-sear until cooked through and lightly browned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sazone el pollo y selléelo en la sartén hasta que esté hecho y ligeramente dorado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assaisonnez le poulet et faites-le dorer à la poêle jusqu'à cuisson et légère coloration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condire il pollo e pan-sear fino a cotto attraverso e leggermente brunito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調理し、軽く茶色になるまで、鶏肉とパン片を味わってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닭고기와 냄비를 통해 요리하고 가볍게 갈색."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopraw kurczaka i obsmaż na patelni do miękkości i lekkiego zrumienienia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приправьте курицу и обжарьте на сковороде до готовности и лёгкой корочки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给鸡肉调味，用平底锅煎至熟透并表面形成一层薄脆外壳。"
          }
        }
      }
    },
    "meals.starter.chickenRice.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dampf oder schnell sauté den Brokkoli bis hellgrün und zart-knusprig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam or quickly sauté the broccoli until bright green and tender-crisp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine al vapor o saltee el brócoli hasta verde brillante y tierno-crisp."
