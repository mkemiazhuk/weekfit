    "coach.insight.energyIntakeIsBehindTodaySNeeds.876" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Energieaufnahme liegt hinter den heutigen Bedürfnissen zurück. Fügen Sie jetzt eine einfache Mahlzeit oder einen Snack hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energy intake is behind today’s needs. Add a simple meal or snack now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ingesta de energía va retrasada respecto a las necesidades de hoy. Añada una comida o tentempié simple ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'apport énergétique est en retard par rapport aux besoins d'aujourd'hui. Ajoutez un repas ou encas simple maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'apporto energetico è al di sotto dei bisogni odierni. Aggiunga ora un pasto o uno spuntino semplice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の必要量に対してエネルギー摂取が不足しています。今すぐ簡単な食事や軽食を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 필요한 만큼의 에너지 섭취가 부족합니다. 지금 간단한 식사나 간식을 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spożycie energii jest w tyle względem dzisiejszych potrzeb. Dodaj prosty posiłek lub przekąskę teraz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня энергии не хватает под потребности дня. Добавьте простой прием пищи или перекус сейчас."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量摄入已满足当今的需求。现在只需添加一份简单的正餐或零食即可。"
          }
        }
      }
    },
    "coach.insight.energyIsLightButProteinIsThe.873" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie ist Licht, aber Protein ist der nützlichste nächste Schritt für Erholung und Stabilität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energy is light, but protein is the most useful next step for recovery and stability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La energía es ligera, pero la proteína es el paso más útil para recuperación y estabilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'énergie est légère, mais les protéines sont la prochaine étape la plus utile pour la récupération et la stabilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'energia è luce, ma le proteine sono il passo successivo più utile per il recupero e la stabilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギーは光ですが、回復と安定のためにはタンパク質が最も役立つ次のステップです。"
