    "meals.starter.huevosRancheros.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwärmen Sie die Maistortillas in einer trockenen Pfanne, bis sie weich und leicht geröstet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm the corn tortillas in a dry pan until soft and lightly toasted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caliente las tortillas de maíz en sartén seca hasta blandas y ligeramente tostadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réchauffez les tortillas de maïs à sec jusqu'à souplesse et légère coloration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaldare le tortille di mais in una padella asciutta fino a quando morbido e leggermente tostato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トウモロコシのトルティーヤを乾いたパンに温め、柔らかく軽くトーストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연약하고 가볍게 토스트까지 건조한 팬에 있는 옥수수 tortillas를 데우십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgrzej tortille kukurydziane na suchej patelni do miękkości i lekkiego rumienia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подогрейте кукурузные тортильи на сухой сковороде до мягкости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将玉米薄饼在干煎锅中加热至变软。"
          }
        }
      }
    },
    "meals.starter.huevosRancheros.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhitzen Sie die schwarzen Bohnen mit einem Spritzer Wasser und die gehackten Tomaten, bis sie saucy sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heat the black beans with a splash of water and the chopped tomatoes until saucy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caliente los frijoles negros con un poco de agua y tomate picado hasta quedar en salsa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chauffez les haricots noirs avec un peu d'eau et les tomates hachées jusqu'à sauce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riscaldare i fagioli neri con uno spruzzo d'acqua e i pomodori tritati fino a far rosolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黒豆を水と切り刻んだトマトで焼く。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물의 스플래시와 젓가락 토마토를 사용하여 검은 콩을 가열하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgrzej czarną fasolę z odrobiną wody i posiekanymi pomidorami do sosu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подогрейте чёрную фасоль с небольшим количеством воды и нарезанными помидорами до соусной консистенции."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将黑豆与少许水及切碎的番茄一同加热，直至汤汁收浓。"
          }
        }
      }
    },
    "meals.starter.huevosRancheros.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frittieren Sie die Eier und legen Sie jedes auf eine Tortilla."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fry the eggs and place each one on a tortilla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fría los huevos y coloque uno en cada tortilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites frire les œufs et posez-en un sur chaque tortilla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friggere le uova e mettere ciascuno su una tortilla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卵を炒め、それぞれをトルティーヤに置きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계란을 붓고 토르톨라에 각각 배치하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usmaż jajka i połóż po jednym na każdej tortilli."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожарьте яйца и выложите каждое на тортилью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将鸡蛋煎熟，然后将每个鸡蛋放在一片玉米饼上。"
          }
        }
      }
    },
    "meals.starter.huevosRancheros.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löffel die Bohne-Tomaten-Mischung über die Eier und servieren heiß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoon the bean–tomato mix over the eggs and serve hot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubra los huevos con la mezcla de frijol y tomate y sirva caliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nappez le mélange haricots–tomate sur les œufs et servez chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoon la miscela di fagioli-pomodoro sulle uova e servire caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卵の上にミックスし、ホットを提供する豆 - トマトスプーン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스푼 a bean-tomato 혼합 위에 계란 고 serve 뜨거운."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polej jajka sosem z fasoli i pomidorów i podaj na ciepło."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выложите смесь фасоли с помидорами поверх яиц и подавайте горячим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将豆类和番茄混合物铺在鸡蛋上，趁热上桌。"
          }
        }
      }
    },
