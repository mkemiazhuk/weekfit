    "coach.copy.energyIntakeAndActivityStrainAreElevated.73": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy intake and activity strain are elevated. Keep food light, hydrate steadily, and protect recovery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Энергии уже достаточно, а нагрузка повышена. Держите еду легкой, пейте спокойно и не добавляйте лишний стресс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能量摄入与活动强度均有所增加。请保持饮食清淡，规律补充水分，并保障身体恢复。"
          }
        }
      }
    },
    "coach.copy.energyIntakeBehind.39": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Intake Behind"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает энергии"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能量摄入背景"
          }
        }
      }
    },
    "coach.copy.energyIntakeIsAlreadyHighAndActivity.70": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy intake is already high and activity strain is elevated. Keep the evening light, avoid more food, and prioritize recovery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Энергии уже много, а нагрузка повышена. Держите вечер легким, не добавляйте еду без голода и дайте себе восстановиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能量摄入已处于较高水平，且体力活动负荷也显著增加。请保持晚间光照，避免过量进食，并优先进行恢复。"
          }
        }
      }
    },
    "coach.copy.energyIntakeIsBehindYourStrainAdd.157": {
      "extractionState": "manual",
      "localizations": {
