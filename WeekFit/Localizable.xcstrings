    "coach.priority.sleepOrRecoveryIsLimitingTheDay.1684" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf oder Erholung begrenzt den Tag. Halten Sie %@ flexibel und lass das Aufwärmen die Intensität bestimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep or recovery is limiting the day. Keep %@ flexible and let the warm-up decide intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño o la recuperación limitan el día. Mantenga %@ flexible y deje que el calentamiento decida la intensidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil ou la récupération limitent la journée. Gardez %@ flexible et laissez l'échauffement décider de l'intensité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno o il recupero stanno limitando la giornata. Mantenga %@ flessibile e lascia che il riscaldamento decida l'intensità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠や回復が1日を制限しています。 %@ を柔軟に保ち、ウォームアップで強度を決めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면이나 회복이 하루를 제한하고 있습니다. %@ 를 융통성 있게 유지하고 워밍업에 따라 강도를 결정하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen lub regeneracja ograniczają dzień. Trzymaj %@ elastycznie i pozwól rozgrzewce zdecydować o intensywności."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон или восстановление ограничивают день. Оставьте %@ гибкой и пусть разминка решит интенсивность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠或恢复限制了今天。让%@保持灵活，由热身决定强度。"
          }
        }
      }
    },
