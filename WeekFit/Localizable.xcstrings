    "support.faq.item23.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ernährung erscheint, nachdem Sie eine Mahlzeit protokolliert oder im Plan hinzugefügt und als abgeschlossen bestätigt haben. Ohne Eintrag bleiben die Werte bei null."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrition appears after you log a meal or add it in Planner and confirm it as completed. If nothing was logged or confirmed, the values stay at zero."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrición aparece tras registrar una comida o añadirla en Plan y confirmarla. Sin registro ni confirmación, los valores quedan en cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nutrition apparaît après enregistrement d'un repas ou ajout dans Plan avec confirmation. Sans journal ni confirmation, les valeurs restent à zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrizione appare dopo aver registrato un pasto o aggiunto e confermato completato nel Piano. Senza registrazioni, i valori restano a zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事を記録するか、プランに追加して完了として確認すると栄養が表示されます。記録がなければ値はゼロのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사를 기록하거나 계획에 추가해 완료로 확인하면 영양이 표시됩니다. 기록이 없으면 값은 0입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odżywianie pojawia się po zalogowaniu posiłku lub dodaniu w Plannerze z potwierdzeniem. Bez logów wartości zostają na zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Питание появляется после того, как вы записали еду или добавили ее в Планировщик и подтвердили выполнение. Если ничего не записано и не подтверждено, значения остаются нулевыми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "营养数据将在您记录餐食、在“规划器”中添加餐食并确认已完成后显示。若未记录或确认任何餐食，相关数值将保持为零。"
          }
        }
      }
    },
