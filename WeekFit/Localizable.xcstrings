    "coach.insight.yourWorkoutLoadCreatedMassiveMuscularDemand.57" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Trainingsbelastung hat heute einen enormen Muskelbedarf erzeugt. Priorisiere langsame Proteine und entspannende Abendrituale, um die Überkompensation über Nacht zu maximieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your workout load created massive muscular demand today. Prioritize slow proteins and restful wind-down rituals to maximize supercompensation overnight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su carga de entrenamiento creó demanda muscular masiva hoy. Priorice proteínas lentas y rituales de bajar revoluciones reposadores para maximizar la supercompensación durante la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre charge d'entraînement a créé une demande musculaire massive aujourd'hui. Priorisez des protéines lentes et des rituels de décompression reposants pour maximiser la supercompensation la nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Suo carico di allenamento ha creato una richiesta muscolare enorme oggi. Dai priorità a proteine a lento assorbimento e rituali di rilassamento per massimizzare la supercompensazione durante la notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のトレーニング負荷は筋肉に大きな負担をかけました。夜間の超回復を最大化するために、吸収の遅いタンパク質とリラックスできる就寝前の習慣を優先してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 당신의 운동 부하는 근육에 엄청난 부담을 주었습니다. 초과보상을 최대화하기 위해 느린 단백질과 편안한 마무리 루틴을 우선시하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie treningowe stworzyło dziś ogromne zapotrzebowanie mięśniowe. Priorytetem są wolne białka i spokojne rytuały wyciszenia, by zmaksymalizować superkompensację w nocy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировочная нагрузка сегодня дала большой запрос на мышцы. Сделайте ставку на белок и спокойный вечер, чтобы тело лучше восстановилось ночью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如今的训练强度对肌肉提出了更高要求。请多摄入蛋白质，并安排一个安静的夜晚，以便身体在夜间更好地恢复。"
          }
        }
      }
    },
