    "highlights.story.recoveryResilient.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Erholung blieb trotz leichter Aktivität und ungleichem Schlaf stabil. Ein paar schwächere Tage haben das Gesamtmuster nicht verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recovery stayed steady despite lighter activity and uneven sleep. A few weaker days did not change the overall pattern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su recuperación se mantuvo estable pese a actividad más ligera y sueño irregular. Unos días más débiles no cambiaron el patrón general."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre récupération est restée stable malgré une activité plus légère et un sommeil inégal. Quelques jours plus faibles n'ont pas changé le schéma global."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vostro recupero è rimasto stabile nonostante l'attività più leggera e sonno irregolare. Alcuni giorni più deboli non hanno cambiato il modello generale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの回復はより軽い活動および不均等な睡眠にもかかわらず着実にとどまりました。 数少ない日が全体のパターンを変えなかった。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 회복은 더 가벼운 활동에도 불구하고 꾸준히 유지되고 심지어는 수면. 몇몇 약한 일은 전반적인 본을 바꾸지 않았습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja była stabilna mimo lżejszej aktywności i nierównego snu. Kilka słabszych dni nie zmieniło ogólnego wzorca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление оставалось стабильным несмотря на меньшую активность и неровный сон. Несколько слабых дней не изменили общий паттерн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽管活动量减少且睡眠不规律，恢复情况仍保持稳定。数日状态欠佳并未改变整体恢复趋势。"
          }
        }
      }
    },
