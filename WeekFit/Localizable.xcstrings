    "support.faq.item25.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workouts und Aktivität können den geschätzten Energiebedarf erhöhen und Fortschritt, Erholung und Ernährung-Ziele beeinflussen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workouts and activity can increase your estimated energy needs, which may affect activity progress, recovery, and nutrition targets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamientos y actividad pueden aumentar su necesidad energética estimada, afectando progreso de actividad, recuperación y objetivos nutricionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînements et activité peuvent augmenter vos besoins énergétiques estimés, ce qui peut affecter progrès d'activité, récupération et objectifs nutrition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenamenti e attività possono aumentare il fabbisogno energetico stimato e influenzare progresso attività, recupero e obiettivi nutrizionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウトとアクティビティは推定エネルギー必要量を増やし、アクティビティ進捗、回復、栄養目標に影響することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동과 활동은 추정 에너지 필요량을 늘리고 활동 진행, 회복, 영양 목표에 영향을 줄 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treningi i aktywność mogą zwiększyć szacunkowe zapotrzebowanie energetyczne, wpływając na postęp aktywności, regenerację i cele odżywiania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировки и активность могут увеличить примерную потребность в энергии, что влияет на прогресс активности, восстановление и цели питания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练与活动可增加机体对能量的近似需求，进而影响运动表现、恢复过程及营养目标。"
          }
        }
      }
    },
    "support.faq.item25.title" : {
      "extractionState" : "manual",
      "localizations" : {
