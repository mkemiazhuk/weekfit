    "coach.scenario.performanceBefore.hard.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einheit kann echten Trainingsstress erzeugen. Steigere sie allmählich und halte die Qualität höher als die Intensität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This session can create real training stress. Build into it gradually and keep quality higher than intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión puede crear estrés de entrenamiento real. Entre gradualmente y priorice calidad sobre intensidad."
