    "onboarding.v6.health.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workouts, Schritte und Erholung von der Apple Watch fließen automatisch ein — Empfehlungen bleiben synchron ohne extra Erfassung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workouts, steps and recovery from Apple Watch flow in automatically — so guidance stays in sync without extra logging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamientos, pasos y recuperación de Apple Watch entran automáticamente — la orientación se mantiene al día sin registro extra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînements, pas et récupération depuis Apple Watch arrivent automatiquement — les conseils restent synchronisés sans log supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenamenti, passi e recupero da Apple Watch entrano automaticamente — la guida resta sincronizzata senza registrazioni extra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchのワークアウト、歩数、回復は自動で取り込まれ—追加記録なしでガイダンスが同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch의 운동, 걸음, 회복이 자동으로 반영되어 — 추가 기록 없이 안내가 동기화됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treningi, kroki i regeneracja z Apple Watch wpływają automatycznie — wskazówki pozostają zsynchronizowane bez dodatkowego logowania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировки, шаги и восстановление с Apple Watch подтягиваются сами — подсказки остаются актуальными без лишнего логирования."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple Watch 进行的训练、步数统计及恢复过程均会自动完成——提示信息将持续有效，且无需额外日志记录。"
          }
        }
      }
    },
