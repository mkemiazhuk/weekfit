    "support.faq.item13.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit beginnt mit Ihrem geschätzten BMR und baut einen dynamischen TDEE aus Workouts, Bewegung, aktiven Kalorien, Erholung und täglicher Aktivität. Kalorien-, Protein-, Kohlenhydrat-, Fett- und Wasserziele passen sich dann Ihrem gewählten Ziel an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit starts with your estimated BMR, then builds a dynamic TDEE using workouts, movement, active calories, recovery, and daily activity. Calories, protein, carbs, fats, and water targets then adapt based on your selected goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit parte de su BMR estimado y construye un TDEE dinámico con entrenamientos, movimiento, calorías activas, recuperación y actividad diaria. Calorías, proteína, carbohidratos, grasas y agua se adaptan a su objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit part de votre BMR estimé, puis construit un TDEE dynamique avec entraînements, mouvement, calories actives, récupération et activité quotidienne. Calories, protéines, glucides, lipides et eau s'adaptent ensuite à votre objectif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit parte dal BMR stimato, poi costruisce un TDEE dinamico con allenamenti, movimento, calorie attive, recupero e attività giornaliera. Obiettivi di calorie, proteine, carboidrati, grassi e acqua si adattano al tuo obiettivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは推定BMRから始め、ワークアウト、移動、消費カロリー、回復、日々のアクティビティで動的TDEEを構築します。カロリー、タンパク質、炭水化物、脂質、水の目標は選択した目標に合わせて調整されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 추정 BMR에서 시작해 운동, 이동, 활동 칼로리, 회복, 일일 활동으로 동적 TDEE를 만듭니다. 칼로리, 단백질, 탄수화물, 지방, 수분 목표가 선택한 목표에 맞춰집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit zaczyna od szacunkowego BMR, potem buduje dynamiczne TDEE z treningów, ruchu, aktywnych kalorii, regeneracji i aktywności. Kalorie, białko, węglowodany, tłuszcze i woda dostosowują się do wybranego celu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit начинает с примерного BMR, затем строит динамический TDEE с учетом тренировок, движения, активных калорий, восстановления и дневной активности. Калории, белки, углеводы, жиры и вода адаптируются к контексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 首先基于基础代谢率（BMR）启动计算，随后结合训练计划、日常活动、主动代谢热量、恢复期及日间活动量，动态推算每日总能量消耗（TDEE）。蛋白质、碳水化合物、脂肪及水分摄入量均根据个体情况自动调整。"
          }
        }
      }
    },
