    "coach.priority.highReadinessIsAnOpportunityNotPressure.4268" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hohe Bereitschaft ist eine Chance, kein Druck. Der Wert liegt darin, sie gezielt zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High readiness is an opportunity, not pressure. The value is using it deliberately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta preparación es oportunidad, no presión. El valor está en usarla de forma deliberada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une forte disponibilité est une opportunité, pas une pression. La valeur est de l'utiliser délibérément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta prontezza è un'opportunità, non una pressione. Il valore sta nell'utilizzarla deliberatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高い準備態勢は圧力ではなく、機会です。その価値は、それを意図的に活用することにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "높은 준비 상태는 압력이 아니라 기회입니다. 그 가치는 그것을 의도적으로 사용하는 데 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysoka gotowość to szansa, nie presja. Wartość jest w świadomym wykorzystaniu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высокая готовность — это возможность, а не давление. Важно использовать ее осознанно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高度战备状态是一种机遇，而非压力；其价值在于有意识地加以利用。"
          }
        }
      }
    },
