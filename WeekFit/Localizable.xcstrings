    "coach.humanDecision.keepingFluidsAvailableMattersMoreNowThan.3333" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flüssigkeiten verfügbar zu halten ist jetzt wichtiger, als ein weiteres großes Getränk zu erzwingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeping fluids available matters more now than forcing another large drink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tener líquidos a mano importa más ahora que forzar otra bebida grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder les fluides disponibles compte plus maintenant que forcer une autre grande boisson."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avere liquidi a disposizione è più importante ora che forzare un'altra grande bevuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一杯多く飲ませるよりも、常に水分を取れるようにしておくことの方が今は重要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또 다른 큰 음료를 억지로 마시는 것보다 지금은 수분을 쉽게 섭취할 수 있도록 하는 것이 더 중요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępność płynów ważniejsza teraz niż wymuszanie kolejnego dużego picia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас важнее держать воду под рукой, чем заставлять себя пить много."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如今，确保患者随时有液体可饮，比强行让其再喝一杯饮料更为重要。"
          }
        }
      }
    },
