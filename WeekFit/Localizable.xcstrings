    "insights.vm.learnings.absorbingWorkload.textFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Die Erholung blieb stabil, was darauf hindeutet, dass Ihr Körper die Arbeitsbelastung gut absorbiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Recovery stayed stable, suggesting your body is absorbing the workload well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La recuperación se mantuvo estable, lo que sugiere que su cuerpo absorbe bien la carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La récupération est restée stable, ce qui suggère que votre corps absorbe bien la charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Recupero rimasto stabile, suggerendo che il vostro corpo assorbe bene il carico di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 回復は安定した、あなたの体が十分にワークロードを吸収することを提案します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 회복은 안정되어, 당신의 몸을 건의하는 것은 workload를 잘 흡수합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Regeneracja pozostała stabilna, co sugeruje, że ciało dobrze absorbuje obciążenie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Восстановление оставалось стабильным — организм хорошо поглощает нагрузку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Recovery保持稳定，表明您的身体正在很好地吸收工作量。"
          }
        }
      }
    },
    "insights.vm.learnings.absorbingWorkload.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery absorbiert Ihre Arbeitsbelastung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery is absorbing your workload"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación absorbe su carga"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération absorbe votre charge"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero assorbe il carico di lavoro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復はあなたのワークロードを吸収します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구는 작업 부하를 흡수"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja absorbuje obciążenie"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление поглощает вашу нагрузку"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复过程会消耗您的体能储备。"
          }
        }
      }
    },
    "insights.vm.learnings.adjacent.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hauptgeschichte ist klar genug, um darauf zu reagieren, aber benachbarte Schlaf-, Erholungs-, Trainings- oder Ernährungsmuster müssen sich mehr überschneiden, bevor sie zu separaten Entdeckungen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The main story is clear enough to act on, but adjacent sleep, recovery, training or nutrition patterns need more overlap before they become separate discoveries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La historia principal es lo bastante clara para actuar, pero patrones adyacentes de sueño, recuperación, entrenamiento o nutrición necesitan más solapamiento antes de ser descubrimientos separados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'histoire principale est assez claire pour agir, mais les schémas adjacents de sommeil, récupération, entraînement ou nutrition ont besoin de plus de recoupement avant de devenir des découvertes séparées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La storia principale è abbastanza chiara da agire, ma il sonno adiacente, il recupero, la formazione o i modelli di nutrizione hanno bisogno di più sovrapposizione prima che diventino scoperte separate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインストーリーは、行動するのに十分明確であるが、隣接する睡眠、回復、トレーニング、または栄養パターンは、それらが別の発見になる前に、より多くの重複を必要とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주요 이야기는 행동에 충분히 명확하지만, 인접한 수면, 회복, 훈련 또는 영양 패턴은 별도의 발견되기 전에 더 오버랩이 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Główna historia jest wystarczająco jasna, by działać, ale sąsiednie wzorce snu, regeneracji, treningu lub odżywiania potrzebują większego nakładania, zanim staną się osobnymi odkryciami."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главная история достаточно ясна для действий, но смежным паттернам сна, восстановления, тренировок или питания нужно больше пересечения, прежде чем они станут отдельными открытиями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核心故事对于行动而言已足够清晰，但若要使与睡眠、恢复、训练或营养相关的辅助模式产生更多交集，这些模式方能成为独立的突破点。"
          }
        }
      }
    },
    "insights.vm.learnings.adjacent.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der unterstützende Kontext bildet sich noch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The supporting context is still forming"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
