          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление мягкое — начните с лёгкого белкастого завтрака и не перегружайте порции."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复期建议采取温和方式——从清淡的蛋白类早餐开始，并注意控制进食分量。"
          }
        }
      }
    },
    "coach.proposal.guidance.morningFuelSteadyEnergy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
