    "support.faq.item16.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wasserziel basiert hauptsächlich auf Körpergewicht, mit extra Hydration bei höherer Aktivität und aktiven Kalorien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water target is based mainly on body weight, with extra hydration added when your activity and active calories are higher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El objetivo de agua se basa sobre todo en peso corporal, con hidratación extra cuando la actividad y calorías activas son mayores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'objectif eau repose surtout sur le poids corporel, avec un supplément d'hydratation quand activité et calories actives sont plus élevées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’obiettivo acqua si basa principalmente sul peso, con idratazione extra quando attività e calorie attive sono più alte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水の目標は主に体重に基づき、アクティビティと消費カロリーが高いほど追加の水分が加わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수분 목표는 주로 체중에 기반하며, 활동과 활동 칼로리가 높을수록 추가 수분이 더해집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel wody opiera się głównie na masie ciała, z dodatkowym nawodnieniem przy wyższej aktywności i aktywnych kaloriach."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель воды в основном зависит от веса тела. Дополнительная гидратация добавляется, когда активность и активные калории выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "饮水量的主要取决于体重。当活动量及消耗的热量增加时，需补充额外水分。"
          }
        }
      }
    },
    "support.faq.item16.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
