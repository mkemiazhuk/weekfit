    "support.faq.item31.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Plan, tippen Sie auf Plus, wählen Sie die Aktivität und speichern Sie. Wenn sie bereits stattfand, markieren Sie sie als abgeschlossen oder lassen Sie Apple Health sie synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Plan, tap plus, choose the activity, and save it. If the activity already happened, you can mark it completed or let Apple Health sync it automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Plan, toque más, elija la actividad y guarde. Si ya ocurrió, márquela completada o deje que Apple Health la sincronice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Plan, touchez plus, choisissez l'activité et enregistrez. Si l'activité a déjà eu lieu, marquez-la terminée ou laissez Apple Health la synchroniser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Piano, tocca più, scegli l’attività e salva. Se è già avvenuta, segnala completata o lascia sincronizzare Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランを開き、プラスをタップしてアクティビティを選び保存します。すでに終わっている場合は完了にするか、Apple Healthの同期に任せられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획을 열고 더하기를 탭해 활동을 선택해 저장하세요. 이미 끝났다면 완료로 표시하거나 Apple Health 동기화를 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Plan, dotknij plus, wybierz aktywność i zapisz. Jeśli już się odbyła, oznacz jako ukończoną lub pozwól Apple Health zsynchronizować."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте План, нажмите плюс, выберите активность и сохраните ее. Если активность уже была, отметьте ее выполненной или позвольте Apple Health синхронизировать ее автоматически."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“开放模式”→点击“+”号→选择相应活动→保存。若该活动已发生，您可以将其标记为已完成，或让 Apple Health 自动同步。"
          }
        }
      }
    },
    "support.faq.item31.title" : {
      "extractionState" : "manual",
      "localizations" : {
