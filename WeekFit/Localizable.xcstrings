        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже на неделю восстановления, поэтому тренировки вряд ли являются главным стрессором."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
