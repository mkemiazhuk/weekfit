    "recovery.insight.light.text" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf- und Nachtsignale deuten darauf hin, dass die Erholung nicht vollständig wiederhergestellt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep and overnight signals suggest recovery was not fully restored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño y las señales nocturnas sugieren que la recuperación no se restauró por completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil et les signaux nocturnes suggèrent que la récupération n'était pas entièrement restaurée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnali del sonno e della notte suggeriscono che il recupero non è stato completamente restaurato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠と一晩の信号は、回復が完全に復元されていないことを示唆しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 및 야간 신호는 복구가 완전히 복원되지 않았습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen i nocne sygnały sugerują, że regeneracja nie została w pełni odbudowana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон и ночные сигналы показывают, что восстановление ещё не полное."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠与夜间信号显示恢复尚未完全到位。"
          }
        }
