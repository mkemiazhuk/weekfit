    "coach.priority.stableDay.workComplete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The useful work is already banked. Keep the rest of the day simple and let recovery continue in the background."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полезная работа уже сделана. Держите остаток дня простым и дайте восстановлению спокойно продолжаться."
          }
