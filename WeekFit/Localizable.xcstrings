    "recovery.stressIndex.howToUse.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Stress Index as supporting context for how much physiological strain your body appears to be under. Keep Recovery Score as the primary readiness signal, and weigh sleep, recent workload, and how you feel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте индекс нагрузки как дополнительный контекст о физиологической нагрузке. Оценка восстановления остаётся главным сигналом готовности — учитывайте также сон, недавнюю нагрузку и самочувствие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把负荷指数当作生理负荷的辅助参考。仍以恢复评分为主要就绪信号，并结合睡眠、近期训练量和主观感受。"
          }
