    "challenge.recovery7.task.1.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when you’ll start slowing down this evening."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, когда сегодня вечером начнёте замедляться."
