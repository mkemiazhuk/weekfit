    "coach.priority.useTimeAwareProgressNotTheFull.2038" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie zeitbewussten Fortschritt, nicht das Ziel für den ganzen Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use time-aware progress, not the full-day target."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use el progreso según la hora, no la meta de todo el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez une progression adaptée à l’heure, pas l’objectif de la journée entière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usi il progresso consapevole del tempo, non l'obiettivo dell'intera giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日の目標ではなく、時間に応じた進捗を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 하루 목표가 아니라 시간에 맞춘 진행을 사용하세요."
          }
        },
        "pl" : {
