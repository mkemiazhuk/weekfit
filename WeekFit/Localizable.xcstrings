        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystaj ją do relaksu, a nie do przedłużania dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте ее для расслабления, а не чтобы продлить день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将其用于放松身心，而非用来延长白天的时间。"
          }
        }
      }
    },
