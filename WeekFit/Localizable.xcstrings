    "appReviewDemo.sheet.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Modus verwendet Beispiel-Gesundheits- und Aktivitätsdaten, so dass alle WeekFit-Funktionen ohne Zugriff auf persönliche Apple Health-Daten überprüft werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This mode uses sample health and activity data so all WeekFit features can be reviewed without access to personal Apple Health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modo usa datos de salud y actividad de ejemplo para revisar todas las funciones de WeekFit sin acceso a sus datos personales de Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mode utilise des exemples de données de santé et d'activité pour que toutes les fonctionnalités WeekFit puissent être évaluées sans accès à vos données Apple Health personnelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa modalità utilizza i dati di salute e attività del campione in modo che tutte le funzionalità di WeekFit possano essere esaminate senza l'accesso ai dati personali Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモードは、サンプルヘルスとアクティビティのデータを使用しており、WeekFitのすべての機能は、個人的なApple Healthデータにアクセスすることなく確認することができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모드는 샘플 건강 및 활동 데이터를 사용하므로 모든 WeekFit 기능은 Apple Health 데이터에 액세스하지 않고 검토 할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten tryb używa przykładowych danych zdrowia i aktywności, aby ocenić wszystkie funkcje WeekFit bez dostępu do osobistych danych Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом режиме используются демонстрационные данные о здоровье и активности, чтобы все функции WeekFit можно было проверить без доступа к личным данным Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此模式下，系统使用健康与活动状态的演示数据，以便用户无需访问 Apple Health 的个人数据即可测试 WeekFit 的所有功能。"
          }
        }
      }
    },
