    "onboarding.intro.today.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute vereint Erholung, Bewegung, Ernährung und das Nächste in einem klaren Bild."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
