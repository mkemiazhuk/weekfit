        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동과 식사를 한 번 저장하세요. 오늘가 행동을 요청할 때 재사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
