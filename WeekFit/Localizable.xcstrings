    "onboarding.v12.ready.subtitle.muscleGain" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist nicht der Tag für leeres Durchhalten. Tanken Sie auf, damit morgen die Sätze zählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today isn't the day to grind empty. Fuel up so tomorrow's sets count."
          }
