          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyzing your day: You have only %@L of water logged with %lld workouts done. Low-intensity volume will increase vascular dehydration. DO NOT wait until evening — log 350ml right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizando su día: solo %@ L de agua registrados con %lld entrenamientos hechos. El volumen de baja intensidad aumenta la deshidratación vascular. No espere hasta la noche: registre 350 ml ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse de votre journée : seulement %@ L d'eau enregistrés avec %lld entraînements terminés. Un volume léger augmente la déshydratation vasculaire. N'attendez pas le soir — enregistrez 350 ml maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisi giornata: solo %@ L acqua con %lld allenamenti. Volume a bassa intensità aumenta disidratazione vascolare. NON aspettare la sera — registra 350 ml ora."
          }
        },
        "ja" : {
