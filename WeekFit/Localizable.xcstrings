    "settings.account.healthPrivacyNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen Ihres WeekFit-Kontos entfernt WeekFit-Daten, aber iOS-Berechtigungen bleiben, bis Sie sie in Einstellungen → WeekFit und Apple Health widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your WeekFit account removes WeekFit data, but iOS permissions stay until you revoke them in Settings → WeekFit and Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar su cuenta de WeekFit quita los datos de WeekFit, pero los permisos de iOS permanecen hasta que los revoque en Ajustes → WeekFit y Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de votre compte WeekFit retire les données WeekFit, mais les autorisations iOS restent actives jusqu'à ce que vous les révoquiez dans Réglages → WeekFit et Apple Health."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare l’account WeekFit rimuove i dati WeekFit, ma i permessi iOS restano finché non li revochi in Impostazioni → WeekFit e Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitアカウントを削除するとWeekFitデータは消えますが、iOSの権限は、設定 → WeekFitおよびApple Healthで取り消すまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 계정을 삭제하면 WeekFit 데이터는 제거되지만, iOS 권한은 설정 → WeekFit 및 Apple Health에서 해제할 때까지 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie konta WeekFit usuwa dane WeekFit, lecz uprawnienia iOS pozostają aktywne, dopóki nie cofnie się ich w Ustawieniach → WeekFit i Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление аккаунта WeekFit стирает данные WeekFit, но разрешения iOS остаются, пока вы не отзовёте их в Настройки → WeekFit и Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除您的 WeekFit 账户将清除 WeekFit 相关数据，但 iOS 权限仍会保留，直至您在“设置”→“WeekFit”与“Apple Health”中撤销这些权限。"
          }
        }
      }
    },
