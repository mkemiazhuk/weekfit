    "settings.account.deleteSuccess.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr WeekFit-Konto und WeekFit-Daten sind entfernt. Sie kehren zur Anmeldung zurück. Um Apple Health, Standort oder Mitteilungen zu widerrufen, öffnen Sie iOS-Einstellungen → WeekFit (und Health → Teilen → Apps)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your WeekFit account and WeekFit data are gone. You’ll return to sign-in.\n\nTo revoke Apple Health, Location, or Notifications, open iOS Settings → WeekFit (and Health → Sharing → Apps)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su cuenta de WeekFit y los datos de WeekFit se han eliminado. Volverá al inicio de sesión.\n\nPara revocar Apple Health, Ubicación o Notificaciones, abra Ajustes de iOS → WeekFit (y Salud → Compartir → Apps)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte WeekFit et vos données WeekFit ont été supprimés. Vous allez revenir à la connexion. Pour révoquer Apple Health, la Localisation ou les Notifications, ouvrez Réglages iOS → WeekFit (et Santé → Partage → Apps)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account WeekFit e i dati WeekFit sono stati eliminati. Tornerai all’accesso. Per revocare Apple Health, Posizione o Notifiche, apri Impostazioni iOS → WeekFit (e Salute → Condivisione → App)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitアカウントとWeekFitデータは削除されました。サインイン画面に戻ります。 Apple Health、位置情報、通知を取り消すには、iOSの設定 → WeekFit（およびヘルス → 共有 → アプリ）を開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 계정과 WeekFit 데이터가 삭제되었습니다. 로그인 화면으로 돌아갑니다. Apple Health, 위치, 알림을 해제하려면 iOS 설정 → WeekFit(및 건강 → 공유 → 앱)을 여세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto WeekFit i dane WeekFit zostały usunięte. Nastąpi powrót do ekranu logowania.\n\nAby cofnąć Apple Health, Lokalizację lub Powiadomienia, otwórz Ustawienia iOS → WeekFit (oraz Zdrowie → Udostępnianie → Aplikacje)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт WeekFit и данные WeekFit удалены. Вы вернётесь на экран входа.\n\nЧтобы отозвать доступ к Apple Health, геолокации или уведомлениям, откройте Настройки iOS → WeekFit (и Здоровье → Общий доступ → Программы)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 WeekFit 账户和 WeekFit 数据已删除。你将返回登录页。\n\n若要撤销 Apple 健康、定位或通知权限，请打开 iOS 设置 → WeekFit（以及健康 → 共享 → App）。"
          }
        }
      }
    },
