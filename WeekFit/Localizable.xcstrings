    "support.faq.item14.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit folgt grob: BMR + Aktivität + Workouts = Täglicher Energiebedarf Ihr gewähltes Ziel passt dann Kalorien-, Protein-, Kohlenhydrat-, Fett- und Hydrationsziele an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit roughly follows:\\n\\nBMR + Activity + Workouts = Daily Energy Need\\n\\nYour selected goal then adjusts calories, protein, carbs, fats, and hydration targets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit sigue aproximadamente:\\n\\nBMR + Actividad + Entrenamientos = Necesidad energética diaria\\n\\nSu objetivo ajusta calorías, proteína, carbohidratos, grasas e hidratación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit suit approximativement :\\n\\nBMR + Activité + Entraînements = Besoin énergétique quotidien\\n\\nVotre objectif ajuste ensuite calories, protéines, glucides, lipides et hydratation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit segue approssimativamente: BMR + Attività + Workouts = fabbisogno energetico giornaliero Il tuo obiettivo regola calorie, proteine, carboidrati, grassi e idratazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitはおおよそ次の考え方です： BMR + アクティビティ + Workouts = 一日のエネルギー必要量 選択した目標に応じてカロリー、タンパク質、炭水化物、脂質、水分の目標が調整されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 대략 다음을 따릅니다: BMR + 활동 + Workouts = 일일 에너지 필요량 선택한 목표에 따라 칼로리, 단백질, 탄수화물, 지방, 수분 목표가 조정됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit w przybliżeniu stosuje:\\n\\nBMR + Aktywność + Treningi = Dzienne zapotrzebowanie\\n\\nWybrany cel dostosowuje kalorie, białko, węglowodany, tłuszcze i nawodnienie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit примерно следует формуле:\n\nBMR + Активность + Тренировки = дневная потребность в энергии\n\nВыбранная цель затем корректирует калории, белки, углеводы, жиры и воду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 大致遵循以下公式：\n\n基础代谢率 + 活动量 + 训练量 = 每日能量需求\n\n所选目标随后会对卡路里、蛋白质、碳水化合物、脂肪及水分进行调整。"
          }
        }
      }
    },
