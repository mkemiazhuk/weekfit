    "coach.eveningRecap.feeling.reaction.energized.active" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gute Energie nach einem ganzen Tag. Halten Sie das Abendlicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good energy after a full day. Keep the evening light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buena energía tras un día completo. Mantén la tarde ligera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonne énergie après une journée pleine. Gardez le soir léger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buona energia dopo una giornata intera. Tenere la luce serale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日中良いエネルギー。 夜の光を保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 후 좋은 에너지. 저녁 빛 유지."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobra energia po pełnym dniu. Wieczór trzymaj lekko."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отличная энергия после насыщенного дня. Оставьте вечер лёгким."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充实一天后仍有精神。晚上保持轻松。"
          }
        }
      }
    },
