    },
    "coach.insight.yourMuscleWorkloadIsExceptionallyHighToday.726" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Muskelbelastung ist heute außergewöhnlich hoch. Konzentriere Sie auf erholsame Entspannungsrituale und Unterstützung der nächtlichen Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your muscle workload is exceptionally high today. Focus on restful wind-down rituals and overnight recovery support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su carga muscular es excepcionalmente alta hoy. Enfoque rituales de bajar revoluciones reposadores y apoyo nocturno a la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre charge musculaire est exceptionnellement élevée aujourd'hui. Concentrez-vous sur des rituels de décompression reposants et un soutien nocturne à la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico di lavoro dei tuoi muscoli è eccezionalmente alto oggi. Concentrati su rituali di rilassamento serali e sul supporto al recupero durante la notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの筋肉の負荷は今日非常に高いです。安らかなくつろぎの儀式と夜間の回復サポートに集中してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 당신의 근육 부담이 매우 높습니다. 편안한 마무리 루틴과 밤새 회복 지원에 집중하세요."
