    "coach.priority.youVeAlreadyAccumulatedEnoughLoadToday.4890" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben heute schon genug Ladung angesammelt. Verwenden Sie Stretching und Atmung, um in den Erholungsmodus überzugehen und die Schlafqualität zu unterstützen %@ ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've already accumulated enough load today. Use stretching and breathing to transition into recovery mode, support sleep quality%@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya acumuló carga suficiente hoy. Use estiramientos y respiración para pasar a modo recuperación y apoyar la calidad del sueño %@ ."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà accumulé assez de charge aujourd’hui. Utilisez étirements et respiration pour passer en mode récupération et soutenir la qualité du sommeil %@ ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai gia' accumulato abbastanza carico oggi. Utilizzare stretching e respirazione alla transizione in modalità di recupero, supporto qualità del sonno %@ ."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は十分な負荷が蓄積されています。 ストレッチと呼吸を使用して、回復モードへの移行、睡眠の質をサポート %@ お問い合わせ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 충분한 부하를 축적했습니다. 회복 형태로 전환하는 기지개하고 breathing, 지원 잠 질 %@ ·"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgromadziłeś już dziś wystarczające obciążenie. Użyj rozciągania i oddechu, by przejść w tryb regeneracji i wspierać jakość snu %@ ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня нагрузки уже достаточно. Используйте растяжку и дыхание, чтобы перейти к восстановлению и поддержать качество сна%@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如今您的训练负荷已相当大。请运用拉伸与呼吸法，进入恢复阶段，以保障睡眠质量%@。"
          }
        }
      }
    },
