    "coach.priority.sleepOrRecoveryIsLimitingTheDay.1684": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep or recovery is limiting the day. Keep %@ flexible and let the warm-up decide intensity."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон или восстановление ограничивают день. Оставьте %@ гибкой и пусть разминка решит интенсивность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠或恢复活动会限制全天活动量。请保持一定的灵活性，让热身活动来决定活动强度。"
          }
        }
      }
    },
    "coach.priority.sleepPreparationIsTheHighestValueMove.2860": {
