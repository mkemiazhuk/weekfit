    "meals.starter.shakshuka.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwärmen Sie das Olivenöl in einer Pfanne und erweichen Sie die Zwiebel und den Paprika für 4-5 Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm the olive oil in a skillet and soften the onion and bell pepper for 4–5 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caliente el aceite de oliva en sartén y ablande cebolla y pimiento 4–5 min."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chauffez l'huile d'olive dans une poêle et attendrissez oignon et poivron 4–5 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaldare l'olio d'oliva in una padella e ammorbidire la cipolla e il peperone per 4-5 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フライパンでオリーブオイルを温め、玉ねぎとピーマンを4〜5分間柔らかくします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 ~ 5 분 동안 양파와 배추를 부드럽게 한 후추 올리브 오일을 따뜻하게하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgrzej oliwę na patelni i zeszklij cebulę z papryką przez 4–5 min."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разогрейте оливковое масло на сковороде и обжарьте лук с перцем 4–5 минут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在煎锅中加热橄榄油，将洋葱与辣椒翻炒4–5分钟。"
          }
        }
      }
    },
    "meals.starter.shakshuka.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie die Tomaten, Saison, und köcheln, bis die Sauce leicht verdickt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the tomatoes, season, and simmer until the sauce thickens slightly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada tomates, sazone y cocine a fuego lento hasta que la salsa espese un poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les tomates, assaisonnez et laissez mijoter jusqu'à légère épaississement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere i pomodori, la stagione e cuocere fino a quando la salsa si ispessisce leggermente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トマト、季節、煮汁を加え、醤油が少し厚くなるまで煮込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토마토, 계절, 그리고 약간의 소스까지 동시 추가."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj pomidory, dopraw i duś, aż sos lekko zgęstnieje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте помидоры, посолите и тушите, пока соус немного загустеет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入番茄，调味后小火慢炖，直至酱汁略微浓稠。"
          }
        }
      }
    },
    "meals.starter.shakshuka.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machen Sie Brunnen in der Sauce und Riss in den Eiern. Bedecke und koche, bis die Weißen untergehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make wells in the sauce and crack in the eggs. Cover and cook until the whites set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga huecos en la salsa y rompa los huevos. Tape y cocine hasta que cuaje la clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites des creux dans la sauce et cassez les œufs. Couvrez et cuisez jusqu'à prise des blancs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare pozzi nella salsa e crack nelle uova. Coprire e cuocere fino al set di bianchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卵のソースと亀裂でよくします。 ホワイトセットまでカバーして調理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소스에서 잘 만들고 달걀에 균열. 흰색 세트까지 커버와 요리."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób dołki w sosie i wbij jajka. Przykryj i gotuj, aż białka się zetną."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте углубления в соусе и разбейте яйца. Накройте и готовьте до схватывания белков."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在酱汁中挖出孔洞，将鸡蛋打入其中。盖上锅盖，烹煮至蛋白凝固。"
          }
        }
      }
    },
    "meals.starter.shakshuka.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden Sie mit schwarzem Pfeffer und servieren Sie direkt aus der Pfanne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish with black pepper and serve straight from the pan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine con pimienta negra y sirva directo de la sartén."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez avec du poivre noir et servez directement de la poêle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finire con pepe nero e servire direttamente dalla pentola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黒胡椒で仕上げ、パンからストレートに仕立てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검은 후추와 냄비에서 똑바로 봉사."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokończ pieprzem i podaj prosto z patelni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поперчите и подавайте прямо со сковороды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后撒上黑胡椒，直接从锅中盛出即可上桌。"
          }
        }
      }
    },
