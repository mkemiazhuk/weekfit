        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozciągaj się, oddychaj lub poruszaj lekko — zostań w granicach tego, co dziś czujesz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растяжка, дыхание или лёгкое движение — в комфортных пределах на сегодня."
