        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda przerwa może być siedząca. Rozłóż je — nie pakuj na koniec dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
