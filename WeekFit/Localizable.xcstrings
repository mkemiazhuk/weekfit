    "support.faq.item08.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Prozentwerte helfen, das Gleichgewicht tagsüber zu verstehen. Sie sind keine perfekten Scores oder Ziele, denen man hinterherjagen soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The percentages help you understand balance during the day. They are not meant to be perfect scores or goals to chase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los porcentajes ayudan a entender el equilibre del día. No son puntuaciones perfectas ni metas a perseguir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pourcentages aident à comprendre l'équilibre dans la journée. Ce ne sont pas des scores parfaits ni des objectifs à poursuivre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le percentuali aiutano a capire l’equilibrio durante la giornata. Non sono punteggi perfetti o obiettivi da inseguire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パーセンテージは、その日のバランスを理解するのに役立ちます。完璧なスコアや追いかける目標ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백분율은 하루 균형을 이해하는 데 도움이 됩니다. 완벽한 점수나 쫓아야 할 목표가 아닙니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procenty pomagają zrozumieć równowagę w ciągu dnia. To nie idealne wyniki ani cele do gonienia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проценты помогают понимать баланс дня. Это не идеальные оценки и не цели, за которыми нужно гнаться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "百分比有助于把握当天的平衡状态。它们并非完美的评估指标，也非需要全力追求的目标。"
          }
        }
      }
    },
