    "coach.scenario.performanceAfter.protectRecovery.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Verschiebe den Rest des Tages weg von Intensität, damit Ihr Körper die Belastung aufnehmen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Shift the rest of the day away from intensity so your body can absorb the load."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Aleje el resto del día de la intensidad para que el cuerpo asimile la carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Orientez le reste de la journée loin de l’intensité pour que le corps assimile la charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Trasforma il resto della giornata in modo da allontanarti dall'intensità, così il tuo corpo può assorbire il carico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ 残りの時間は強度を下げて体が負荷を吸収できるようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ 나머지 시간을 강도에서 벗어나 보내어 몸이 부하를 흡수할 수 있게 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Skieruj resztę dnia z dala od intensywności, by ciało mogło przyswoić obciążenie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Уведите остаток дня от интенсивности, чтобы тело могло усвоить нагрузку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@将一天的其余时间从强度转移，这样你的身体就可以吸收负荷。"
          }
        }
      }
    },
