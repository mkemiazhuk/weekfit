    "settings.nightComfort.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachtkomfort mildert Helligkeit und Leuchten am Abend. Tagsüber bleibt die Oberfläche lebendig und kontrastreich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night Comfort softens brightness and glow in the evening. During the day the UI stays vivid and high-contrast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El confort nocturno suaviza el brillo y el resplandor por la noche. Durante el día, la interfaz sigue viva y con alto contraste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le confort nocturne adoucit la luminosité et la lueur le soir. En journée, l’interface reste vive et contrastée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il comfort notturno attenua luminosità e bagliore la sera. Di giorno l’interfaccia resta vivida e ad alto contrasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナイトコンフォートは夕方の明るさと輝きを和らげます。日中はUIが鮮やかでコントラストが高いままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나이트 컴포트는 저녁에 밝기와 빛을 부드럽게 합니다. 낮에는 UI가 선명하고 대비가 높게 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komfort nocny łagodzi jasność i poświatę wieczorem. W ciągu dnia interfejs pozostaje wyrazisty i kontrastowy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночной комфорт смягчает яркость и свечение вечером. Днём интерфейс остаётся контрастным и сочным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜间舒适会在傍晚降低亮度与光泽；白天界面保持鲜艳且高对比度。"
          }
        }
      }
    },
