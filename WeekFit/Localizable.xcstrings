    "coach.priority.nothingNeedsForcingKeepTheRecoveryWork.4462" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts muss erzwungen werden. Halten Sie die Erholungsarbeit einfach und nutze den Rest des Tages, um stabil zu bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing needs forcing. Keep the recovery work easy and use the rest of the day to stay steady."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada necesita forzarse. Mantenga el trabajo de recuperación fácil y use el resto del día para mantenerse estable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne demande à être forcé. Gardez le travail de récupération facile et utilisez le reste de la journée pour rester stable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'è nulla da forzare. Mantenga il lavoro di recupero leggero e usa il resto della giornata per mantenerti stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も無理にする必要はありません。回復作業は簡単にして、残りの時間は安定して過ごしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 억지로 할 필요가 없습니다. 회복 작업은 쉽게 하고, 나머지 시간은 안정적으로 지내세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie wymaga forsowania. Trzymaj pracę regeneracyjną lekko i wykorzystaj resztę dnia, by pozostać stabilnie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не нужно форсировать. Восстановительную работу держите легкой, а остаток дня — ровным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需强求。让康复过程保持轻松，利用当天剩余时间保持稳定状态。"
          }
        }
      }
    },
