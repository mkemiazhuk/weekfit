    "coach.priority.aCoachShouldUseGoodReadinessAs.3134" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Trainer sollte gute Bereitschaft als Chance nutzen und nicht nur auf fehlendes Wasser oder Nahrung reagieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A coach should use good readiness as an opportunity, not only react to missing water or food."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach debería usar buena preparación como oportunidad, no solo reaccionar a agua o comida faltantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach devrait utiliser une bonne disponibilité comme opportunité, pas seulement réagir à l'eau ou la nourriture manquantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un allenatore dovrebbe usare una buona preparazione come un'opportunità, non solo reagire alla mancanza di acqua o cibo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーチは、水や食べ物が不足したときに反応するだけでなく、良い準備を機会として活用すべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코치는 물이나 음식을 놓친 것에만 반응하는 것이 아니라, 준비가 잘 되어 있는 것을 기회로 삼아야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach powinien wykorzystać dobrą gotowość jako szansę, a nie tylko reagować na brak wody czy jedzenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хорошую готовность стоит использовать как возможность, а не только реагировать на нехватку воды или еды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练应将良好的备战状态视为一个契机，而不仅仅是针对缺水或缺粮的情况做出反应。"
          }
        }
      }
    },
    "coach.priority.aCoachShouldUseTheCurrentReal.3766" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
