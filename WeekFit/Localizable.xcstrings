    "coach.humanDecision.todayIsBuiltToAbsorbTrainingStress.3353" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist darauf ausgelegt, Trainingsstress zu absorbieren, nicht einen neuen zu erzeugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today is built to absorb training stress, not create a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy está pensado para absorber el estrés del entrenamiento, no para crear uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd'hui est conçu pour absorber le stress d'entraînement, pas en créer un nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi è costruito per assorbire lo stress dell'allenamento, non per crearne uno nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日という日は、新たなストレスを作るのではなく、トレーニングのストレスを吸収するために作られています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 새로운 스트레스를 만드는 것이 아니라 훈련 스트레스를 흡수하도록 만들어졌다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś jest zbudowany pod wchłanianie stresu treningowego, a nie pod tworzenie nowego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня день лучше подходит для усвоения нагрузки, а не для новой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天更适合巩固现有训练内容，而非进行新训练。"
          }
        }
      }
    },
    "coach.humanDecision.todaySLimiterIsRecoveryTheBody.2081" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der heutige Begrenzungsfaktor ist die Erholung. Der Körper ist nicht bereit für produktive Intensität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's limiter is recovery. The body is not ready for productive intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
