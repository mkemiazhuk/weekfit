    "support.faq.item37.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workouts, Mahlzeiten, Hydration, Schlaf, Erholung, Routinen und synchronisierte Apple Health-Daten können Coach-Vorschläge tagsüber beeinflussen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workouts, meals, hydration, sleep, recovery, routines, and synced Apple Health data can all affect Coach suggestions throughout the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamientos, comidas, hidratación, sueño, recuperación, rutinas y Apple Health sincronizado pueden influir en las sugerencias de Entrenador durante el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînements, repas, hydratation, sommeil, récupération, routines et Apple Health synchronisé peuvent tous influencer les suggestions du Coach dans la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenamenti, pasti, idratazione, sonno, recupero, routine e dati Apple Health sincronizzati possono influenzare i suggerimenti del Coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウト、食事、水分、睡眠、回復、ルーティン、同期されたApple Healthデータは、一日を通じてコーチの提案に影響することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동, 식사, 수분, 수면, 회복, 루틴, 동기화된 Apple Health 데이터가 하루 종일 코치 제안에 영향을 줄 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treningi, posiłki, nawodnienie, sen, regeneracja, rutyny i zsynchronizowane Apple Health wpływają na sugestie Trener w ciągu dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировки, питание, вода, сон, восстановление, рутины и синхронизированные данные Apple Health могут влиять на подсказки Тренера в течение дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练、饮食、水分摄入、睡眠、恢复情况、日常习惯以及 Apple Health 提供的同步数据，均可能影响教练在一天中提供的建议。"
          }
        }
      }
    },
