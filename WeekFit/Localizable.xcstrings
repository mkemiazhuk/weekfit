    "insights.vm.opportunity.nutritionVisible.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine vollständigere Protokollierung der Mahlzeiten würde zeigen, ob Lebensmittel tatsächlich die Erholung beeinflussen oder nur Lärm hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More complete meal logging would show whether food is actually influencing recovery or just adding noise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un registro de comidas más completo mostraría si la comida influye de verdad en la recuperación o solo añade ruido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un journal de repas plus complet montrerait si l'alimentation influence vraiment la récupération ou ajoute seulement du bruit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più completa registrazione pasto mostrerebbe se il cibo in realtà sta influenzando il recupero o semplicemente aggiungendo rumore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より多くの完全な食事のロギングは食糧が実際に回復に影響を与えるか、またはちょうど騒音を加えるかどうか示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 완전한 식사 로깅은 음식이 실제로 손상을 입히거나 소음을 추가하는지 보여줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełniejsze logowanie posiłków pokaże, czy jedzenie naprawdę wpływa na regenerację, czy tylko dodaje szumu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более полная запись блюд покажет, влияет ли еда на восстановление или только добавляет шум."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更详尽的膳食记录将有助于判断食物是否真正促进了恢复，抑或仅引入了干扰因素。"
          }
        }
      }
    },
