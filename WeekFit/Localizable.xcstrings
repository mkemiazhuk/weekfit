            "value" : "Что такое HRV?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "什么是 HRV？"
          }
        }
      }
    },
    "support.faq.item40.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHR steht für Ruheherzfrequenz. Eine niedrigere Ruheherzfrequenz kann manchmal bessere Erholung oder weniger Stress bedeuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHR stands for resting heart rate. Lower resting heart rate can sometimes reflect better recovery or lower stress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHR significa frecuencia cardíaca en reposo. Una frecuencia en reposo más baja a veces refleja mejor recuperación o menos estrés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHR signifie fréquence cardiaque au repos. Une fréquence au repos plus basse peut parfois refléter une meilleure récupération ou moins de stress."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHR indica frequenza cardiaca a riposo. Un valore più basso può talvolta riflettere miglior recupero o minore stress."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHRは安静時心拍数です。低い安静時心拍は、回復が良い、またはストレスが少ないことを示すことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHR는 안정 시 심박수입니다. 낮을수록 회복이 좋거나 스트레스가 적을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHR to tętno spoczynkowe. Niższe tętno spoczynkowe czasem oznacza lepszą regenerację lub mniejszy stres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHR — пульс в покое. Более низкий пульс в покое иногда может отражать лучшее восстановление или меньший стресс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHR 代表静息心率。较低的静息心率有时可反映更好的恢复状况或较低的压力水平。"
          }
        }
      }
    },
