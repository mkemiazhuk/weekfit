        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No persiga récords personales cuando la carga diaria ya es alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne visez pas les records personnels quand la charge quotidienne est déjà élevée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non inseguire record personali quando il carico giornaliero è già elevato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日々の負荷がすでに高いときは、自己記録を追い求めないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일일 부하가 이미 높은 경우 개인 기록을 쫓지 마십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie goni rekordów, gdy dzienne obciążenie jest już wysokie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не гонитесь за личными рекордами, когда дневная нагрузка уже высокая."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当每日负载已较高时，请勿追求个人纪录。"
          }
        }
      }
    },
    "coach.scenario.performanceDuring.hard.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibe wiederholbar, bevor die Ermüdung zunimmt. Qualitativ hochwertige Wiederholungen sind wichtiger, als Intensität zu erzwingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay repeatable before fatigue builds. Quality reps matter more than forcing intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manténgase repetible antes de que llegue la fatiga. Repeticiones de calidad importan más que forzar intensidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez reproductible avant que la fatigue s’installe. Des répétitions de qualité valent mieux que forcer l’intensité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimani ripetibile prima che si accumuli la fatica. Le ripetizioni di qualità contano più che forzare l'intensità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疲労がたまる前に繰り返せる状態を保ちましょう。強引に強度を上げるよりも、質の高い反復が重要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피로가 쌓이기 전에 반복 가능하게 유지하세요. 강도를 억지로 높이는 것보다 좋은 반복 횟수가 더 중요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bądź powtarzalny, zanim pojawi się zmęczenie. Jakościowe powtórzenia są ważniejsze niż wymuszanie intensywności."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте повторяемость до накопления усталости. Качественные повторы важнее форсирования интенсивности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持重复训练次数，直至出现疲劳感。高质量的重复训练比强行增加训练强度更为重要。"
          }
        }
      }
    },
