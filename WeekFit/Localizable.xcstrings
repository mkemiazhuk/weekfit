    "meals.starter.avocadoToast.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toast the bread until golden and crisp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поджарьте хлеб до золотистой корочки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将面包烤至表面呈金黄色。"
          }
        }
      }
    },
    "meals.starter.avocadoToast.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mash the avocado with a pinch of salt and spread it thickly on the toast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разомните авокадо с щепоткой соли и густо намажьте на тост."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将牛油果与一小撮盐一起捣碎，然后均匀地涂在烤面包片上。"
          }
        }
      }
    },
    "meals.starter.avocadoToast.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook the eggs soft-scrambled or sunny-side up, then place them on the avocado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приготовьте яйца всмятку или глазуньей и выложите поверх авокадо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将鸡蛋炒至嫩炒蛋或单面煎熟，然后将其摆放在牛油果上。"
          }
        }
      }
    },
    "meals.starter.avocadoToast.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top with sliced tomatoes and serve immediately."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте нарезанные помидоры и сразу подавайте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入切好的番茄，随即上桌。"
          }
        }
      }
    },
    "meals.starter.avocadoToast.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avocado Toast"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тост с авокадо"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "牛油果吐司"
          }
        }
      }
    },
    "meals.starter.beefBuckwheat.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook the buckwheat in salted water until tender and fluffy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварите гречку в подсоленной воде до мягкости и рассыпчатости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将荞麦放入加盐的水中煮熟，直至变软且蓬松。"
          }
        }
      }
    },
    "meals.starter.beefBuckwheat.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season the beef and sear over high heat until browned to your liking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приправьте говядину и обжарьте на сильном огне до нужной степени прожарки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给牛肉调味，然后用大火煎至所需熟度。"
          }
        }
      }
    },
    "meals.starter.beefBuckwheat.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauté the mushrooms until their moisture evaporates and they turn golden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обжарьте грибы, пока не уйдёт влага и они не станут золотистыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将蘑菇翻炒至水分蒸发、色泽呈金黄色。"
          }
        }
      }
    },
    "meals.starter.beefBuckwheat.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve the beef and mushrooms over buckwheat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подавайте говядину с грибами на гречке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将牛肉与蘑菇一同烹制在荞麦上。"
          }
        }
      }
    },
    "meals.starter.chickenRamen.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simmer chicken in broth with soy sauce until cooked through, then slice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварите курицу в бульоне с соевым соусом до готовности, затем нарежьте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将鸡肉放入含酱油的高汤中煮熟，然后切块。"
          }
        }
      }
    },
    "meals.starter.chickenRamen.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook the noodles separately until just tender."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварите лапшу отдельно до мягкости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将面条分别煮熟，直至刚变软即可。"
          }
        }
      }
    },
    "meals.starter.chickenRamen.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft-boil the eggs, then halve them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сварите яйца всмятку и разрежьте пополам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将鸡蛋煮至半熟，然后对半切开。"
          }
        }
      }
    },
    "meals.starter.chickenRamen.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assemble bowls with noodles, hot broth, chicken, bok choy, and egg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите тарелки: лапша, горячий бульон, курица, бок-чой и яйцо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将面条、热汤、鸡肉、小白菜和鸡蛋一同盛入碗中。"
          }
        }
      }
    },
    "meals.starter.chickenRamen.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chicken Ramen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рамен с курицей"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鸡肉拉面"
          }
        }
      }
    },
    "meals.starter.chickenRice.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook the rice until tender and fluffy, then keep warm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварите рис до мягкости и рассыпчатости, затем держите тёплым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将大米煮至软烂且蓬松，然后保温。"
          }
        }
      }
    },
    "meals.starter.chickenRice.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season the chicken and pan-sear until cooked through and lightly browned."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приправьте курицу и обжарьте на сковороде до готовности и лёгкой корочки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给鸡肉调味，用平底锅煎至熟透并表面形成一层薄脆外壳。"
          }
        }
      }
    },
    "meals.starter.chickenRice.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam or quickly sauté the broccoli until bright green and tender-crisp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приготовьте брокколи на пару или быстро обжарьте до ярко-зелёного цвета и лёгкого хруста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将西兰花焯水，或快速翻炒至呈现鲜绿色并略带脆感。"
          }
        }
      }
    },
    "meals.starter.chickenRice.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plate the rice, add chicken and broccoli, then finish with a drizzle of olive oil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выложите рис, добавьте курицу и брокколи, сверху сбрызните оливковым маслом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将米饭盛入盘中，加入鸡肉和西兰花，最后淋上少许橄榄油即可。"
          }
        }
      }
    },
    "meals.starter.cottageToast.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toast the bread until golden and crisp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поджарьте хлеб до золотистой корочки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将面包烤至表面呈金黄色。"
          }
        }
      }
    },
    "meals.starter.cottageToast.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread a generous layer of cottage cheese over the toast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Намажьте на тост щедрый слой творога."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在吐司上均匀涂抹一层凝乳。"
          }
        }
      }
    },
    "meals.starter.cottageToast.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slice the avocado and fan it over the cottage cheese."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарежьте авокадо и разложите веером поверх творога."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将牛油果切块，呈扇形铺在凝乳上。"
          }
        }
      }
    },
    "meals.starter.cottageToast.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season with salt and black pepper, then serve right away."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посолите, поперчите и сразу подавайте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加盐和胡椒，随即上桌。"
          }
        }
      }
    },
    "meals.starter.eggsOatmeal.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook the oatmeal with water or milk over medium heat until creamy, about 4–5 minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сварите овсянку на воде или молоке на среднем огне до кремовой текстуры, 4–5 минут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将燕麦片与水或牛奶一同置于中火上烹煮，直至质地呈奶油状，约需 4–5 分钟。"
          }
        }
      }
    },
    "meals.starter.eggsOatmeal.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a non-stick pan, soft-scramble or gently fry the eggs with a pinch of salt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На антипригарной сковороде мягко взболтайте или аккуратно пожарьте яйца с щепоткой соли."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不粘锅中，加入少许盐，将鸡蛋轻柔地炒散或简单煎熟。"
          }
        }
      }
    },
    "meals.starter.eggsOatmeal.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoon the oatmeal into a bowl and place the eggs on top while both are warm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выложите овсянку в миску и сверху положите яйца, пока всё ещё тёплое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将燕麦放入碗中，趁燕麦尚温热时，将鸡蛋放在上面。"
          }
        }
      }
    },
    "meals.starter.eggsOatmeal.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish with blueberries and serve immediately."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте чернику и сразу подавайте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后加入蓝莓，立即上桌。"
          }
        }
      }
    },
    "meals.starter.englishBreakfast.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toast the bread and keep it warm while you cook the rest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поджарьте хлеб и держите тёплым, пока готовите остальное."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将面包烤好并保持温热，同时准备其他食材。"
          }
        }
      }
    },
    "meals.starter.englishBreakfast.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauté the mushrooms and tomatoes in a lightly oiled pan until tender."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обжарьте грибы и помидоры на слегка смазанной сковороде до мягкости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将蘑菇与番茄放入略刷油的煎锅中，煎至变软。"
          }
        }
      }
    },
    "meals.starter.englishBreakfast.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm the ham and fry or scramble the eggs to your liking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подогрейте ветчину и пожарьте или взболтайте яйца по вкусу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将火腿加热，并根据口味将鸡蛋煎熟或翻炒。"
          }
        }
      }
    },
    "meals.starter.englishBreakfast.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plate the eggs, ham, mushrooms, tomatoes, and toast together."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выложите на тарелку яйца, ветчину, грибы, помидоры и тост."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将鸡蛋、火腿、蘑菇、番茄和烤面包片一同铺在盘中。"
          }
        }
      }
    },
    "meals.starter.englishBreakfast.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "English Breakfast"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Английский завтрак"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "英式早餐"
          }
        }
      }
    },
    "meals.starter.huevosRancheros.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm the corn tortillas in a dry pan until soft and lightly toasted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подогрейте кукурузные тортильи на сухой сковороде до мягкости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将玉米薄饼在干煎锅中加热至变软。"
          }
        }
      }
    },
    "meals.starter.huevosRancheros.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat the black beans with a splash of water and the chopped tomatoes until saucy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подогрейте чёрную фасоль с небольшим количеством воды и нарезанными помидорами до соусной консистенции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将黑豆与少许水及切碎的番茄一同加热，直至汤汁收浓。"
          }
        }
      }
    },
    "meals.starter.huevosRancheros.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fry the eggs and place each one on a tortilla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожарьте яйца и выложите каждое на тортилью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将鸡蛋煎熟，然后将每个鸡蛋放在一片玉米饼上。"
          }
        }
      }
    },
    "meals.starter.huevosRancheros.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoon the bean–tomato mix over the eggs and serve hot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выложите смесь фасоли с помидорами поверх яиц и подавайте горячим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将豆类和番茄混合物铺在鸡蛋上，趁热上桌。"
          }
        }
      }
    },
    "meals.starter.huevosRancheros.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Huevos Rancheros"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уэвос ранчерос"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "乡村风味鸡蛋"
          }
        }
      }
    },
    "meals.starter.japaneseBreakfast.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm the cooked brown rice until steaming."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подогрейте варёный коричневый рис до горячего пара."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将煮至呈褐色的米饭加热至冒热蒸汽。"
          }
        }
      }
    },
    "meals.starter.japaneseBreakfast.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly wilt the spinach and soft-cook the eggs (poached or lightly fried)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро припустите шпинат и приготовьте яйца всмятку или лёгкой глазуньей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将菠菜快速焯水，并将鸡蛋软熟（水煮或浅煎）。"
          }
        }
      }
    },
    "meals.starter.japaneseBreakfast.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange rice, eggs, and spinach in a bowl; tear nori over the top."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выложите в миску рис, яйца и шпинат; сверху порвите нори."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将米饭、鸡蛋和菠菜放入碗中；将海苔撕成碎片铺在顶部。"
          }
        }
      }
    },
    "meals.starter.japaneseBreakfast.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish with a drizzle of soy sauce and serve warm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбрызните соевым соусом и подавайте тёплым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后淋上少许酱油，趁热上桌。"
          }
        }
      }
    },
    "meals.starter.japaneseBreakfast.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Japanese Breakfast"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Японский завтрак"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日式早餐"
          }
        }
      }
    },
    "meals.starter.salmonNigiri.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook sushi rice until tender, then season lightly with rice vinegar and a pinch of salt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварите рис для суши до готовности и слегка заправьте рисовым уксусом с щепоткой соли."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将寿司米煮至软烂，然后用米醋和少许盐轻调味。"
          }
        }
      }
    },
    "meals.starter.salmonNigiri.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slice the salmon into thin pieces about the width of two fingers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарежьте лосось тонкими ломтиками шириной примерно с два пальца."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将三文鱼切成约两指宽的薄片。"
          }
        }
      }
    },
    "meals.starter.salmonNigiri.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shape the rice into small ovals and top each piece with salmon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сформируйте рис в небольшие овалы и накрой каждый кусочек лососем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将米饭分成若干小椭圆块，每块上铺上三文鱼片。"
          }
        }
      }
    },
    "meals.starter.salmonNigiri.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve with soy sauce and pickled ginger on the side."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подавайте с соевым соусом и маринованным имбирём."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搭配酱油与腌姜一同食用。"
          }
        }
      }
    },
    "meals.starter.salmonNigiri.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salmon Nigiri"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нигири с лососем"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与鲑鱼共舞"
          }
        }
      }
    },
    "meals.starter.salmonQuinoa.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinse and cook the quinoa until the grains are tender and the liquid is absorbed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промойте и сварите киноа до мягкости зёрен и полного впитывания жидкости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将藜麦冲洗后煮沸，直至谷粒变软且充分吸收汤汁。"
          }
        }
      }
    },
    "meals.starter.salmonQuinoa.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pat the salmon dry, season, and pan-sear skin-side down until crisp, then finish on the flesh side."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обсушите лосось, приправьте и обжарьте сначала кожей вниз до хруста, затем доведите со стороны мякоти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将三文鱼表面擦干，调味后以皮面朝下煎至外皮酥脆，最后换面继续煎至熟透。"
          }
        }
      }
    },
    "meals.starter.salmonQuinoa.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt the spinach briefly in the same pan with a splash of water or oil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В той же сковороде быстро припустите шпинат с каплей воды или масла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一口煎锅中，加入少许水或油，快速将菠菜煸炒。"
          }
        }
      }
    },
    "meals.starter.salmonQuinoa.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve the salmon over quinoa with spinach on the side."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подавайте лосось на киноа со шпинатом сбоку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将三文鱼从侧面铺在藜麦菠菜上。"
          }
        }
      }
    },
    "meals.starter.salmonRoll.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay a sheet of nori on a bamboo mat and spread an even layer of seasoned rice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положите лист нори на коврик и равномерно распределите приправленный рис."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一张海苔铺在竹垫上，然后均匀地铺上一层调味米。"
          }
        }
      }
    },
    "meals.starter.salmonRoll.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add strips of salmon and avocado along the center line."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выложите полоски лосося и авокадо по центру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿中心线摆放几片三文鱼片与牛油果片。"
          }
        }
      }
    },
    "meals.starter.salmonRoll.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll tightly, then slice into bite-size pieces with a sharp wet knife."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плотно сверните ролл и нарежьте на кусочки острым смоченным ножом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将卷起的部分紧紧卷好，然后用带汁的锋利刀具切成小块。"
          }
        }
      }
    },
    "meals.starter.salmonRoll.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve immediately with soy sauce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подавайте сразу с соевым соусом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接搭配酱油食用。"
          }
        }
      }
    },
    "meals.starter.salmonRoll.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salmon Avocado Roll"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ролл с лососем и авокадо"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三文鱼牛油果卷"
          }
        }
      }
    },
    "meals.starter.shakshuka.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm the olive oil in a skillet and soften the onion and bell pepper for 4–5 minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разогрейте оливковое масло на сковороде и обжарьте лук с перцем 4–5 минут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在煎锅中加热橄榄油，将洋葱与辣椒翻炒4–5分钟。"
          }
        }
      }
    },
    "meals.starter.shakshuka.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the tomatoes, season, and simmer until the sauce thickens slightly."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте помидоры, посолите и тушите, пока соус немного загустеет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入番茄，调味后小火慢炖，直至酱汁略微浓稠。"
          }
        }
      }
    },
    "meals.starter.shakshuka.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make wells in the sauce and crack in the eggs. Cover and cook until the whites set."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте углубления в соусе и разбейте яйца. Накройте и готовьте до схватывания белков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在酱汁中挖出孔洞，将鸡蛋打入其中。盖上锅盖，烹煮至蛋白凝固。"
          }
        }
      }
    },
    "meals.starter.shakshuka.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish with black pepper and serve straight from the pan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поперчите и подавайте прямо со сковороды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后撒上黑胡椒，直接从锅中盛出即可上桌。"
          }
        }
      }
    },
    "meals.starter.shakshuka.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shakshuka"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шакшука"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙克舒卡"
          }
        }
      }
    },
    "meals.starter.shoyuRamen.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a light shoyu broth with soy sauce, garlic, and mushroom aroma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сварите лёгкий соевый бульон с чесноком и ароматом грибов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用酱油、大蒜和蘑菇香调出清淡的素汤。"
          }
        }
      }
    },
    "meals.starter.shoyuRamen.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook noodles until springy, then drain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварите лапшу до упругости и слейте воду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将面条煮至有弹性，然后沥干。"
          }
        }
      }
    },
    "meals.starter.shoyuRamen.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan-sear the pork briefly and slice the soft-boiled egg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слегка обжарьте свинину и нарежьте яйцо всмятку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将猪肉快速煎至熟透，然后将溏心蛋切片。"
          }
        }
      }
    },
    "meals.starter.shoyuRamen.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladle broth over noodles and top with pork, egg, and mushrooms."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Залейте лапшу бульоном и выложите сверху свинину, яйцо и грибы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将高汤淋在面条上，最后铺上猪肉、鸡蛋和蘑菇。"
          }
        }
      }
    },
    "meals.starter.shoyuRamen.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoyu Ramen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рамен с соевым бульоном"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日式豆腐汤拉面"
          }
        }
      }
    },
    "meals.starter.shrimpPasta.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boil the pasta in salted water until al dente, then reserve a splash of cooking water."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварите пасту в подсоленной воде до al dente и оставьте немного воды от варки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将意面放入加盐的水中煮至弹牙，随后留出一小杯煮面水。"
          }
        }
      }
    },
    "meals.starter.shrimpPasta.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauté the shrimp quickly until just opaque and pink."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро обжарьте креветки до непрозрачного розового цвета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将虾快速煎至呈不透明的粉红色。"
          }
        }
      }
    },
    "meals.starter.shrimpPasta.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the tomatoes to the pan and cook until they soften and release juices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте помидоры на сковороду и готовьте, пока они не размягчатся и не пустят сок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将番茄放入锅中，翻炒至番茄变软并渗出汁液。"
          }
        }
      }
    },
    "meals.starter.shrimpPasta.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toss the pasta with shrimp and tomatoes, loosening with pasta water if needed, then serve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смешайте пасту с креветками и помидорами, при необходимости разбавьте водой от варки, и подавайте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将面糊与虾和番茄混合，必要时用煮制时使用的水稀释，然后盛盘上桌。"
          }
        }
      }
    },
    "meals.starter.tofuBrownRice.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook the brown rice until tender; keep covered to steam finish."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварите бурый рис до мягкости и оставьте под крышкой, чтобы дошёл на пару."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将糙米煮至软烂；盖上锅盖，利用蒸汽将其蒸熟。"
          }
        }
      }
    },
    "meals.starter.tofuBrownRice.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press excess water from the tofu, cube it, and pan-fry until golden on the edges."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отожмите лишнюю влагу из тофу, нарежьте кубиками и обжарьте до золотистых краёв."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将豆腐挤干多余水分，切成方块，然后煎至边缘呈金黄色。"
          }
        }
      }
    },
    "meals.starter.tofuBrownRice.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stir-fry the bok choy until the stems soften and the leaves just wilt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обжарьте пак-чой, пока стебли не смягчатся, а листья слегка не привянут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将包菜翻炒至菜梗变软，叶片略微收拢。"
          }
        }
      }
    },
    "meals.starter.tofuBrownRice.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plate the rice with tofu and bok choy, then finish with soy sauce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выложите рис с тофу и пак-чой, сверху полейте соевым соусом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将米饭与豆腐、小白菜一同摆盘，最后淋上酱油即可。"
          }
        }
      }
    },
    "meals.starter.tunaRoll.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mix the tuna with a little mayo and chili sauce until evenly coated."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смешайте тунец с небольшим количеством майонеза и соуса чили до равномерного покрытия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将金枪鱼与少许蛋黄酱及辣椒酱混合，直至均匀裹上酱汁。"
          }
        }
      }
    },
    "meals.starter.tunaRoll.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread rice over nori and add cucumber strips plus the spicy tuna filling."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распределите рис по нори, добавьте полоски огурца и начинку из острого тунца."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将米饭铺在海苔上，加入黄瓜条和辣金枪鱼馅料。"
          }
        }
      }
    },
    "meals.starter.tunaRoll.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll firmly and slice into even pieces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плотно сверните и нарежьте на ровные кусочки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将食材紧密卷起，然后切成大小均匀的块状。"
          }
        }
      }
    },
    "meals.starter.tunaRoll.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top with sesame if you like and serve with soy sauce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При желании посыпьте кунжутом и подавайте с соевым соусом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如愿意，可撒上芝麻，搭配酱油一同上桌。"
          }
        }
      }
    },
    "meals.starter.tunaRoll.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spicy Tuna Roll"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Острый ролл с тунцом"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鲱鱼刺身"
          }
        }
      }
    },
    "meals.starter.turkeySweetPotato.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roast or microwave the sweet potato until soft, then split or cube it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запеките или приготовьте батат в микроволновке до мягкости, затем разрежьте или нарежьте кубиками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将红薯放入微波炉加热至软烂，然后切成块或丁。"
          }
        }
      }
    },
    "meals.starter.turkeySweetPotato.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook the turkey in a pan until browned and fully cooked through."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обжарьте индейку на сковороде до румяности и полной готовности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将火鸡放入煎锅中煎至表面呈金黄色且内部完全熟透。"
          }
        }
      }
    },
    "meals.starter.turkeySweetPotato.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanch or sauté the green beans until tender-crisp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бланшируйте или обжарьте стручковую фасоль до лёгкого хруста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将四季豆焯水或煸炒至嫩脆。"
          }
        }
      }
    },
    "meals.starter.turkeySweetPotato.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plate the sweet potato with turkey and green beans, then season to taste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выложите батат с индейкой и фасолью, приправьте по вкусу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将红薯与火鸡及四季豆一同铺在盘中，然后按个人口味调味。"
          }
        }
      }
    },
    "meals.starter.yogurtBerries.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoon the Greek yogurt into a bowl and smooth the surface."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выложите греческий йогурт в миску и разровняйте поверхность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将希腊酸奶倒入碗中，并将表面抹平。"
          }
        }
      }
    },
    "meals.starter.yogurtBerries.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinse and slice the strawberries."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промойте и нарежьте клубнику."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将草莓冲洗干净并切块。"
          }
        }
      }
    },
    "meals.starter.yogurtBerries.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange the strawberries over the yogurt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разложите клубнику поверх йогурта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将草莓摆放在酸奶之上。"
          }
        }
      }
    },
    "meals.starter.yogurtBerries.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drizzle with honey and serve chilled or at room temperature."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полейте мёдом и подавайте охлаждённым или комнатной температуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "淋上蜂蜜，可冷藏或室温下享用。"
          }
        }
      }
    },
    "meals.suggested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендовано"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐使用"
          }
        }
      }
    },
    "meals.todaySMatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TODAY'S MATCH"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СЕГОДНЯШНЕЕ СОВПАДЕНИЕ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日巧合"
          }
        }
      }
    },
    "meals.value.gramServingFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldg serving"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порция %lld г"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldg 服务"
          }
        }
      }
    },
    "meals.value.kcalFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kcal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ккал"
          }
        },
