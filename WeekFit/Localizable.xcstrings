    "insights.snapshot.fallback.supportCard.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reliable baseline will let Insights compare averages, direction and change instead of reporting raw logging counts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надёжный базовый уровень позволит Инсайтам сравнивать средние значения, направление и изменения вместо сырых счётчиков записей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个可靠的基线将使 Insights 能够比较平均值、变化趋势及变化幅度，而非仅报告原始日志计数。"
          }
        }
      }
    },
