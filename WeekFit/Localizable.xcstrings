    "meals.starter.salmonQuinoa.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spülen und kochen Sie die Quinoa, bis die Körner empfindlich sind und die Flüssigkeit absorbiert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rinse and cook the quinoa until the grains are tender and the liquid is absorbed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjuague y cocine la quinoa hasta granos tiernos y líquido absorbido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rincez et cuisez le quinoa jusqu'à tendreté des grains et absorption du liquide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sciacquare e cuocere la quinoa fino a quando i cereali sono teneri e il liquido viene assorbito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穀物が柔らかく、液体が吸収されるまでキノアを洗い、調理して下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rinse는 곡물이 부드럽고 액체가 흡수 될 때까지 quinoa를 요리합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opłucz i ugotuj komosę do miękkich ziaren i wchłonięcia płynu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промойте и сварите киноа до мягкости зёрен и полного впитывания жидкости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将藜麦冲洗后煮沸，直至谷粒变软且充分吸收汤汁。"
          }
        }
      }
    },
    "meals.starter.salmonQuinoa.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pat den Lachs trocken, Saison, und pan-sear Haut-Seite nach unten, bis knusprig, dann beenden Sie auf der Fleisch-Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pat the salmon dry, season, and pan-sear skin-side down until crisp, then finish on the flesh side."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seque el salmón, sazone y selle con la piel abajo hasta crujiente y termine del lado de la carne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séchez le saumon, assaisonnez et faites-le dorer côté peau jusqu'à croustillant, puis finissez côté chair."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pat il salmone asciutto, stagione e pan-sear la pelle-side giù fino a fresco, poi finire sul lato della carne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーモンの乾燥、季節、そしてパンの皮の側面を鮮やかに、そして肉側面で終えて下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연어 건조, 계절, 그리고 crisp까지 팬 눈물 피부 측 아래로, 그 후에 육체 측에 끝."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osusz łososia, dopraw i obsmaż skórą w dół do chrupkości, dokończ od strony mięsa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обсушите лосось, приправьте и обжарьте сначала кожей вниз до хруста, затем доведите со стороны мякоти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将三文鱼表面擦干，调味后以皮面朝下煎至外皮酥脆，最后换面继续煎至熟透。"
          }
        }
      }
    },
    "meals.starter.salmonQuinoa.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilt den Spinat kurz in der gleichen Pfanne mit einem Spritzer Wasser oder Öl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilt the spinach briefly in the same pan with a splash of water or oil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marchite el espinaca brevemente en la misma sartén con un poco de agua o aceite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flétrissez brièvement les épinards dans la même poêle avec un peu d'eau ou d'huile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versare brevemente gli spinaci nella stessa padella con uno spruzzo di acqua o olio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほうれん草を水や油のスプラッシュで同じ鍋で簡単に傾けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물 또는 기름의 스플래시와 같은 팬에서 척추를 짧게 빌트."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótko zwiędź szpinak na tej samej patelni z odrobiną wody lub oleju."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В той же сковороде быстро припустите шпинат с каплей воды или масла."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一口煎锅中，加入少许水或油，快速将菠菜煸炒。"
          }
        }
      }
    },
    "meals.starter.salmonQuinoa.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servieren Sie den Lachs über Quinoa mit Spinat an der Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
