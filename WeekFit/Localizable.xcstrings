    "login.localReplaceApple.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuing without an account starts a separate local workspace on this device. Data from your Apple account on this device will be removed. Sign in with the same Apple ID instead if you want to keep it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжение без аккаунта откроет отдельное локальное пространство на этом устройстве. Данные аккаунта Apple на этом устройстве будут удалены. Войдите тем же Apple ID, если хотите их сохранить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若未登录账户继续操作，将在本设备上创建一个新的本地工作区。您本设备上 Apple 账户中的数据将被清除。若您希望保留这些数据，请使用同一 Apple ID 重新登录。"
          }
        }
      }
    },
