    "coach.insight.yourCalorieAndCarbohydrateIntakeHasHeavily.169" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Kalorien- und Kohlenhydrataufnahme hat die täglichen Grenzen stark überschritten. Geben Sie Ihrer Verdauung eine vollständige Pause - konzentrieren Sie sich ausschließlich auf saubere Flüssigkeitszufuhr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your calorie and carbohydrate intake has heavily crossed the daily limits. Give your digestion a complete rest—focus strictly on clean hydration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su ingesta calórica y de carbohidratos ha superado ampliamente los límites diarios. De un descanso completo a la digestión — enfoque estrictamente hidratación limpia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre apport calorique et en glucides a largement dépassé les limites quotidiennes. Accordez une pause complète à la digestion — concentrez-vous strictement sur une hydratation propre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Suo apporto calorico e di carboidrati ha superato di molto i limiti giornalieri. Dai al Suo sistema digerente un completo riposo: concentrati strettamente su un’idratazione pulita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのカロリーと炭水化物の摂取量は、日々の制限を大幅に超えています。消化器官を完全に休ませ、純粋な水分補給に集中してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 칼로리와 탄수화물 섭취량이 하루 한도를 크게 초과했습니다. 소화를 완전히 쉬게 하고, 오직 깨끗한 수분 섭취에만 집중하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spożycie kalorii i węglowodanów mocno przekroczyło dzienne limity. Daj trawieniu pełny odpoczynek — skup się wyłącznie na czystym nawodnieniu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калорий и углеводов сегодня уже слишком много. Дайте пищеварению полный отдых и держитесь чистой воды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如今，热量与碳水化合物的摄入量已过于庞大。请让消化系统充分休息，并坚持饮用纯净水。"
          }
        }
      }
    },
    "coach.insight.yourCoachHasNoUrgentConflictTo.776" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
