    "insights.vm.learnings.sleepBelowTarget.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf bleibt oft genug unter dem Ziel, dass es der klarste Flaschenhals ist, den man als nächstes testen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep remains below target often enough that it is the clearest bottleneck to test next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño sigue por debajo del objetivo con frecuencia, así que es el cuello de botella más claro a probar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil reste souvent sous l'objectif, c'est donc le goulot d'étranglement le plus clair à tester ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno rimane sotto il bersaglio spesso abbastanza che è il collo di bottiglia più chiaro per testare il prossimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眠りは、次のテストに最も明確なボトルネックであることを十分にターゲットの下に残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면은 대상 아래에 남아있어 가장 명확한 병목을 테스트합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen zbyt często jest poniżej celu, więc to najwyraźniejsze wąskie gardło do przetestowania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон часто ниже цели — это самое явное узкое место для проверки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预期结果往往低于目标值——这是验证过程中最明显的薄弱环节。"
          }
        }
      }
    },
    "insights.vm.learnings.sleepConsistent.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf ist konsistent genug, um die Genesung zu unterstützen, anstatt aktuelle Probleme zu erklären."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
