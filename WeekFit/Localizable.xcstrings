    "coach.copy.yourMuscularLoadIsExceptionallyHighToday.64" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Muskelbelastung ist heute außergewöhnlich hoch. Priorisieren Sie langsames Protein für die Reparatur über Nacht und vermeiden Sie die Trainingsintensität vor dem Schlafengehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your muscular load is exceptionally high today. Prioritize slow protein for overnight repair and avoid pushing training intensity before bed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su carga muscular es excepcionalmente alta hoy. Priorice proteína lenta para reparación nocturna y evite apretar intensidad antes de dormir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre charge musculaire est exceptionnellement élevée aujourd'hui. Priorisez des protéines lentes pour la réparation nocturne et évitez de pousser l'intensité d'entraînement avant le coucher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vostro carico muscolare è eccezionale oggi. Priorizzare le proteine lente per la riparazione notturna e evitare di spingere l'intensità di allenamento prima di andare a letto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "筋肉の負荷は今日非常に高いです。 夜間の修理のための遅い蛋白質を優先し、ベッドの前に訓練の強度を押しることを避けて下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 근육 짐은 오늘 특별하게 높습니다. 하룻밤의 수리를 위한 느린 단백질을 우선화하고 침대의 앞에 훈련 강렬을 밀어내는 것을 피하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie mięśniowe jest dziś wyjątkowo wysokie. Priorytet wolnych białek na nocną regenerację i unikać forsowania intensywności przed snem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мышечная нагрузка сегодня очень высокая. Добавьте белок на ночь и не повышайте интенсивность перед сном."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如今的肌肉训练强度已非常高。夜间补充蛋白质即可，但睡前请勿增加训练强度。"
          }
        }
      }
    },
