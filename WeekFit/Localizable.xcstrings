            "value" : "日式豆腐汤拉面"
          }
        }
      }
    },
    "meals.starter.shrimpPasta.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen Sie die Pasta in gesalzenem Wasser bis al dente, dann reservieren Sie einen Spritzer kochendes Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boil the pasta in salted water until al dente, then reserve a splash of cooking water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine la pasta en agua con sal al dente y reserve un poco del agua de cocción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez les pâtes dans de l'eau salée al dente, puis réservez un peu d'eau de cuisson."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuocere la pasta in acqua salata fino al dente, quindi riservare una spruzzata di acqua di cottura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスタを塩水で沸騰させ、アルデントまで水を注ぎ、調理水をまく。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "al dente까지 소금에 절인 물에서 파스타를 기름을 바르고 요리 물의 매시를 예약하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotuj makaron w osolonej wodzie al dente, a następnie odłóż odrobinę wody z gotowania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отварите пасту в подсоленной воде до al dente и оставьте немного воды от варки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将意面放入加盐的水中煮至弹牙，随后留出一小杯煮面水。"
          }
        }
      }
    },
    "meals.starter.shrimpPasta.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauté die Garnele schnell bis nur opak und rosa."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauté the shrimp quickly until just opaque and pink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltee las gambas rápidamente hasta que estén justo opacas y rosadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites sauter les crevettes rapidement jusqu'à ce qu'elles soient juste opaques et roses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versare i gamberi rapidamente fino a poco opaco e rosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ちょうど不透明とピンクまで、スリンプをすばやくサウテ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauté 새우는 단지 opaque와 분홍색까지 빨리."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaż krewetki krótko, aż będą właśnie nieprzezroczyste i różowe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстро обжарьте креветки до непрозрачного розового цвета."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将虾快速煎至呈不透明的粉红色。"
          }
        }
      }
    },
    "meals.starter.shrimpPasta.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie die Tomaten in die Pfanne und kochen, bis sie weicher werden und Säfte freisetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the tomatoes to the pan and cook until they soften and release juices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada los tomates a la sartén y cocine hasta que se ablanden y suelten jugo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les tomates à la poêle et cuisez jusqu'à ce qu'elles ramollissent et libèrent leur jus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere i pomodori alla pentola e cuocere fino ad ammorbidire e rilasciare i succhi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トマトをパンに入れ、ジュースを柔らかくし、解放するまで調理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "냄비에 토마토를 추가하고 그들이 부드럽게하고 주스를 방출 때까지 요리."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj pomidory na patelnię i gotuj, aż zmiękną i puszczą sok."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте помидоры на сковороду и готовьте, пока они не размягчатся и не пустят сок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将番茄放入锅中，翻炒至番茄变软并渗出汁液。"
          }
        }
      }
    },
    "meals.starter.shrimpPasta.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werfen Sie die Pasta mit Garnelen und Tomaten, lockern Sie mit Pasta Wasser, wenn nötig, dann dienen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toss the pasta with shrimp and tomatoes, loosening with pasta water if needed, then serve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezcle la pasta con gambas y tomates, aflojando con agua de cocción si hace falta, y sirva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mélangez les pâtes avec les crevettes et les tomates, en assouplissant avec l'eau de cuisson si besoin, puis servez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toss la pasta con gamberi e pomodori, allentando con acqua di pasta se necessario, poi servire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリンプとトマトのパスタを投げ、必要に応じてパスタ水でゆるめると、サーブ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새우와 토마토와 파스타를 곁들인 토스, 필요한 경우 파스타 물로 느슨하게."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymieszaj makaron z krewetkami i pomidorami, rozluźniając wodą z gotowania w razie potrzeby, i podawaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смешайте пасту с креветками и помидорами, при необходимости разбавьте водой от варки, и подавайте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将面糊与虾和番茄混合，必要时用煮制时使用的水稀释，然后盛盘上桌。"
          }
        }
      }
    },
    "meals.starter.tofuBrownRice.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen Sie den braunen Reis bis zum Trocknen; bis zum Dampfende bedeckt halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook the brown rice until tender; keep covered to steam finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine el arroz integral hasta que esté tierno; manténgalo tapado para terminar al vapor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez le riz complet jusqu'à tendreté ; gardez couvert pour finir à la vapeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuocere il riso integrale fino a tenero; tenere coperto a vapore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔らかくなるまで玄米を調理し、蒸気の終わりに覆われ続ける。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 때까지 갈색 쌀을 요리; 스팀 마무리에 덮여."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotuj brązowy ryż do miękkości; przykryj, aby dokończyć parowaniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отварите бурый рис до мягкости и оставьте под крышкой, чтобы дошёл на пару."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将糙米煮至软烂；盖上锅盖，利用蒸汽将其蒸熟。"
          }
        }
      }
    },
    "meals.starter.tofuBrownRice.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie überschüssiges Wasser aus dem Tofu, würfeln Sie es und braten Sie bis zum Gold an den Rändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press excess water from the tofu, cube it, and pan-fry until golden on the edges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presione el exceso de agua del tofu, córtelo en cubos y dórelo en la sartén por los bordes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressez l'excès d'eau du tofu, coupez-le en cubes et faites-le dorer à la poêle sur les bords."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premere l'acqua in eccesso dal tofu, cubarlo e pan-fry fino all'oro sui bordi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "豆腐から余分な水をプレス, それをキューブ, エッジの黄金までパンフライ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도후에서 과잉 물을 누르고, cube, 가장자리에 황금까지 팬 프라이."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odciskaj wodę z tofu, pokrój w kostki i smaż na patelni, aż brzegi będą złote."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отожмите лишнюю влагу из тофу, нарежьте кубиками и обжарьте до золотистых краёв."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将豆腐挤干多余水分，切成方块，然后煎至边缘呈金黄色。"
          }
        }
      }
    },
    "meals.starter.tofuBrownRice.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rühren Sie den Bok Choy, bis die Stiele erweichen und die Blätter nur welken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stir-fry the bok choy until the stems soften and the leaves just wilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltee el bok choy hasta que los tallos se ablanden y las hojas apenas se marchiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites sauter le bok choy jusqu'à ce que les tiges ramollissent et que les feuilles flétrissent à peine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stir-fry il bok choy fino a quando i gambi si ammorbidiscono e le foglie appena wilt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "茎が柔らかくなるまでボクのチョイを炒め、葉はただ拭く。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄기 연화와 잎까지 bok choy를 자극합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smażaj bok choy, aż łodygi zmiękną, a liście lekko zwiędną."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обжарьте пак-чой, пока стебли не смягчатся, а листья слегка не привянут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将包菜翻炒至菜梗变软，叶片略微收拢。"
          }
        }
      }
    },
    "meals.starter.tofuBrownRice.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platten Sie den Reis mit Tofu und Bok Choy, dann beenden Sie mit Sojasauce."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plate the rice with tofu and bok choy, then finish with soy sauce."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirva el arroz con tofu y bok choy y termine con salsa de soja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposez le riz avec le tofu et le bok choy, puis terminez avec de la sauce soja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montare il riso con tofu e bok choy, poi finire con salsa di soia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "豆腐とボクチョイでご飯をプレートし、醤油で仕上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두부와 bok choy를 가진 밥을 도금하고, 그 후에 간장으로 끝냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ułóż ryż z tofu i bok choy, a na końcu dodaj sos sojowy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выложите рис с тофу и пак-чой, сверху полейте соевым соусом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将米饭与豆腐、小白菜一同摆盘，最后淋上酱油即可。"
          }
        }
      }
    },
    "meals.starter.tunaRoll.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mischen Sie den Thunfisch mit etwas Mayo- und Chili-Sauce, bis er gleichmäßig beschichtet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mix the tuna with a little mayo and chili sauce until evenly coated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezcle el atún con un poco de mayonesa y salsa picante hasta cubrirlo por igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mélangez le thon avec un peu de mayo et de sauce piquante jusqu'à enrobage uniforme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mescolare il tonno con un po' di maio e salsa di peperoncino fino a ricoprire uniformemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さなマヨと唐辛子ソースでマグロを均一にコーティングするまで混ぜます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약간 마요와 칠리 소스를 섞어도 입을 때까지."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymieszaj tuńczyka z odrobiną majonezu i ostrego sosu, aż równo się pokryje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смешайте тунец с небольшим количеством майонеза и соуса чили до равномерного покрытия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将金枪鱼与少许蛋黄酱及辣椒酱混合，直至均匀裹上酱汁。"
          }
        }
      }
    },
    "meals.starter.tunaRoll.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbreiten Sie Reis über Nori und fügen Sie Gurkenstreifen sowie die scharfe Thunfischfüllung hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spread rice over nori and add cucumber strips plus the spicy tuna filling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extienda el arroz sobre el nori y añada tiras de pepino y el relleno de atún picante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étalez le riz sur le nori et ajoutez des lanières de concombre plus la garniture au thon épicé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalmare il riso su nori e aggiungere strisce di cetriolo più il ripieno di tonno piccante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライスをノリの上に広げ、キュウリのストリップとスパイシーなマグロの充填を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nori를 통해 쌀을 확산하고 cucumber 스트립 플러스 매운 tuna 충전을 추가합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozłóż ryż na nori i dodaj paski ogórka oraz nadzienie z ostrego tuńczyka."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
