      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgen steht viel Arbeit an, deshalb sollte man sich heute Abend um die Erholung kümmern."
          }
        },
        "en" : {
          "stringUnit" : {
