          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servire il manzo e i funghi su grano saraceno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そばの上に牛肉とキノコを添えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "buckwheat에 쇠고기와 버섯을 구워."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaj wołowinę z grzybami na gryce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подавайте говядину с грибами на гречке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将牛肉与蘑菇一同烹制在荞麦上。"
          }
        }
      }
    },
    "meals.starter.chickenRamen.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simmer Huhn in Brühe mit Sojasauce, bis durch gekocht, dann Scheibe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simmer chicken in broth with soy sauce until cooked through, then slice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine el pollo en caldo con salsa de soja hasta que esté hecho y córtelo en lonchas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites mijoter le poulet dans le bouillon avec la sauce soja jusqu'à cuisson, puis tranchez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pollo materno in brodo con salsa di soia fino a cottura, poi fetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煮るチキンのスープと醤油で煮るまで煮込み、スライスします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간장에서 닭고기, 볶음까지 볶음까지 간장."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotuj kurczaka w bulionie z soją sos do miękkości, potem pokrój."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отварите курицу в бульоне с соевым соусом до готовности, затем нарежьте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将鸡肉放入含酱油的高汤中煮熟，然后切块。"
          }
        }
      }
    },
    "meals.starter.chickenRamen.step2" : {
