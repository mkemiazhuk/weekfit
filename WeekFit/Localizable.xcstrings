    "settings.appearance.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hell nutzt dieselben hochwertigen Keramik-Oberflächen wie Dunkel — nur bei Tageslicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light uses the same premium ceramic surfaces as Dark — just in daylight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro usa las mismas superficies cerámicas premium que Oscuro, pero a plena luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Clair reprend les mêmes surfaces céramique premium que le mode Sombre — en lumière du jour."
