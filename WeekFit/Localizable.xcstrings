    "recovery.details.confidence.lowExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Schätzung stützt sich hauptsächlich auf den Schlaf, weil die Ruheherzfrequenz oder die Baseline-Geschichte begrenzt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This estimate relies mostly on sleep because HRV, resting heart rate, or baseline history is limited."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta estimación depende sobre todo del sueño porque la HRV, la frecuencia en reposo o el historial de referencia son limitados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette estimation repose surtout sur le sommeil, car la HRV, la fréquence au repos ou l'historique de référence est limité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa stima si basa principalmente sul sonno perché HRV, la frequenza cardiaca di riposo, o la storia di base è limitata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宿泊予定は、宿泊時0分、心拍数の安静、またはベースラインの履歴が限られているため、ほとんど眠っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV, 안정시 심박수 또는 기본 기록이 제한되어 있기 때문에 이 추정치는 대부분 수면에 의존합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten szacunek opiera się głównie na śnie, bo HRV, tętno spoczynkowe lub historia bazowa są ograniczone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка основана преимущественно на сне, так как ВСР, пульс в покое или базовые данные ограничены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该估算主要依赖睡眠，因为 HRV、静息心率或基线历史不足。"
          }
        }
      }
    },
