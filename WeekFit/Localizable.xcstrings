      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights benötigt ein paar echte protokollierte Tage, bevor es Muster vergleichen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights needs a few real logged days before it can compare patterns."
          }
        },
        "es" : {
          "stringUnit" : {
