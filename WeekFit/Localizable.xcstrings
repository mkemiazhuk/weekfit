        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝はライトスタート。 あなたの最初の食事の前に水和を着実に保ち、強度を押しることを避けて下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 아침을 시작합니다. 수화를 유지하고 첫 번째 식사 전에 강도를 밀어."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacząć lekko dziś rano. Utrzymać nawodnienie i unikać forsowania intensywności przed pierwszym posiłkiem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните утро легче. Пейте ровно и не давите интенсивность до первого приема пищи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让早晨开始得更轻松些。定时饮水，且在首次进食前不要增加饮水量。"
