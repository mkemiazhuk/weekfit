    "coach.humanDecision.yourMealIsInNowGiveIt.3279" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Mahlzeit ist drin. Lassen Sie sie jetzt etwas Zeit zum Verdauen und halten Sie die Flüssigkeiten in Bewegung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your meal is in. Now give it time to settle and keep fluids moving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su comida está hecha. Déle tiempo para asentarse y mantenga los líquidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre repas est pris. Laissez-le se stabiliser et continuez les fluides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Suo pasto è pronto. Adesso lascialo digerire e continua a mantenere i liquidi in movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの食事は終わりました。今は落ち着かせて、体液の流れを維持してください。"
