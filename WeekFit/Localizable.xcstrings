    "onboarding.v6.plan.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie Plan für Workouts und Erholung in der Woche. Nutzen Sie Meals, um Gerichte zu speichern, die Coach bei Bedarf empfehlen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Plan for the week’s workouts and recovery. Use Meals to save dishes Coach can recommend when you need them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Plan para entrenamientos y recuperación de la semana. Use Meals para guardar platos que Coach pueda recomendar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Plan pour les entraînements et la récupération de la semaine. Utilisez Meals pour enregistrer des plats que Coach pourra recommander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Plan per allenamenti e recupero della settimana. Usa Meals per salvare piatti che Coach può consigliare quando serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planで週のワークアウトと回復を。MealsでCoachが必要なときに勧められる料理を保存。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan으로 주간 운동과 회복을. Meals로 Coach가 필요할 때 추천할 요리를 저장하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj Plan na treningi i regenerację w tygodniu. Meals służy do zapisywania dań, które Coach może polecić."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Plan — тренировки и восстановление на неделю. В Meals — сохранённые блюда, которые Тренер может предложить, когда нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
