    "support.guides.item01.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie zuerst Apple Health und erlauben Sie die benötigten Daten. Aktivität, Schlaf, Workouts, Herzdaten, Hydration und Körpermetriken helfen, Ihren Tag besser zu verstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First, connect Apple Health and allow the data WeekFit needs. Activity, sleep, workouts, heart data, hydration, and body metrics help the app understand your day better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero conecte Apple Health y permita los datos que WeekFit necesita. Actividad, sueño, entrenamientos, datos cardíacos, hidratación y métricas corporales ayudan a entender mejor su día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par connecter Apple Health et autoriser les données dont WeekFit a besoin. Activité, sommeil, entraînements, données cardiaques, hydratation et métriques corporelles aident l'app à mieux comprendre votre journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega prima Apple Health e consenti i dati necessari. Attività, sonno, allenamenti, dati cardiaci, idratazione e metriche corporee aiutano a capire meglio la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずApple Healthを接続し、WeekFitに必要なデータを許可してください。アクティビティ、睡眠、ワークアウト、心拍、水分、体の指標が一日の理解を助けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 Apple Health를 연결하고 필요한 데이터를 허용하세요. 활동, 수면, 운동, 심장 데이터, 수분, 신체 지표가 하루 이해에 도움이 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij od połączenia Apple Health i zezwolenia na dane, których WeekFit potrzebuje. Aktywność, sen, treningi, dane serca, nawodnienie i metryki ciała pomagają aplikacji lepiej zrozumieć dzień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала подключите Apple Health и разрешите данные, нужные WeekFit. Активность, сон, тренировки, пульс, вода и параметры тела помогают приложению лучше понимать ваш день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首先，连接 Apple Health 并授权 WeekFit 访问所需数据。活动记录、睡眠数据、锻炼记录、心率数据、水分摄入情况及身体指标，均有助于该应用更精准地掌握您的每日状态。"
          }
        }
      }
    },
