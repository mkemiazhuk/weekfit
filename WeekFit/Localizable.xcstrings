    "recovery.details.confidence.highExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf, HRV, und Ruhe-Herzfrequenz waren mit genügend baseline-Geschichte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep, HRV, and resting heart rate were available with enough baseline history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sueño, HRV y frecuencia cardíaca en reposo estaban disponibles con suficiente historial de referencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommeil, HRV et fréquence cardiaque au repos étaient disponibles avec assez d'historique de référence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormire, HRV, e la frequenza cardiaca di riposo sono stati disponibili con abbastanza storia di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠、HRV、安静時心拍数が十分なベースライン履歴で利用できました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면, HRV 및 안정시 심박수는 충분한 기준 기록으로 제공되었습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen, HRV i tętno spoczynkowe były dostępne z wystarczającą historią linii bazowej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступны сон, ВСР и пульс в покое с достаточной историей базовых значений."
