        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien. Gardez la récupération simple et poursuivez la journée à un rythme confortable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bene. Mantieni semplice il recupero e continua la giornata a un ritmo confortevole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "良いです。回復は簡単に保ち、快適なペースで一日を続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋아요. 회복을 간단하게 하고 편안한 속도로 하루를 계속 이어가세요."
