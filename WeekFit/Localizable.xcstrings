    "support.faq.item43.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja. Sie können Apple Health-Berechtigungen jederzeit in Apple Health oder den iPhone-Einstellungen prüfen, ändern oder entziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. You can review, change, or remove Apple Health permissions anytime in Apple Health or iPhone Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. Puede revisar, cambiar o quitar permisos de Apple Health en cualquier momento en Apple Health o Ajustes del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui. Vous pouvez consulter, modifier ou retirer les autorisations Apple Health à tout moment dans Apple Health ou Réglages iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì. Puoi rivedere, modificare o revocare i permessi Apple Health in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はい。Apple Healthの権限は、Apple HealthまたはiPhoneの設定でいつでも確認、変更、取り消しできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네. Apple Health 권한은 Apple Health 또는 iPhone 설정에서 언제든 검토·변경·해제할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak. Możesz w każdej chwili przejrzeć, zmienić lub cofnąć uprawnienia Apple Health w Apple Health lub Ustawieniach iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да. Вы можете просмотреть, изменить или удалить разрешения Apple Health в любое время в Apple Health или настройках iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是的，您随时可以在 Apple Health 或 iPhone 的设置中查看、修改或删除 Apple Health 的权限。"
          }
        }
      }
    },
