    "support.guides.item20.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung ist genauso wichtig wie Training. Stapeln Sie nicht zu viele harte Einheiten ohne leichteren Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery matters as much as training. Try not to stack too many hard sessions without an easier day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación importa tanto como el entrenamiento. Evite acumular demasiadas sesiones duras sin un día más fácil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération compte autant que l'entraînement. Évitez d'enchaîner trop de séances intenses sans jour plus facile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero conta quanto l’allenamento. Evita troppe sessioni intense senza un giorno più leggero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復はトレーニングと同じくらい大切です。軽い日なしにハードなセッションを重ねすぎないで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복은 훈련만큼 중요합니다. 가벼운 날 없이 하드한 세션만 쌓지 마세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja jest równie ważna jak trening. Unikaj zbyt wielu ciężkich sesji bez łatwiejszego dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление так же важно, как тренировки. Не ставьте слишком много тяжелых тренировок подряд без более легкого дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复与训练同样重要。避免连续进行高强度训练，除非之后安排一个低强度训练日。"
          }
        }
      }
    },
    "support.guides.item20.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harte und leichte Tage balancieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance hard and easy days"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibre días duros y fáciles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Équilibrez jours intenses et faciles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilancia giorni intensi e leggeri"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードとイージーの日をバランス"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강한 날과 가벼운 날 균형"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równoważ ciężkie i lekkie dni"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Балансируйте тяжелые и легкие дни"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平衡忙碌与轻松的日子"
          }
        }
      }
    },
    "support.guides.item21.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmung, Dehnen, Mobilität, Gehen, Sauna und Schlaf-Routinen helfen WeekFit, Erholung und Tagesbelastung zu verstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing, stretching, mobility, walking, sauna, and sleep routines can all help WeekFit understand recovery and daily load."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración, estiramientos, movilidad, caminar, sauna y rutinas de sueño ayudan a WeekFit a entender recuperación y carga diaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration, étirements, mobilité, marche, sauna et routines de sommeil aident WeekFit à comprendre récupération et charge quotidienne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirazione, stretching, mobilità, camminata, sauna e routine sonno aiutano WeekFit a capire recupero e carico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸、ストレッチ、モビリティ、ウォーク、サウナ、睡眠ルーティンは回復と一日の負荷理解に役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호흡, 스트레칭, 가동성, 걷기, 사우나, 수면 루틴이 회복·하루 부하 이해에 도움이 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddychanie, rozciąganie, mobilność, spacer, sauna i rutyny snu pomagają WeekFit zrozumieć regenerację i dzienną obciążenie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дыхание, растяжка, мобилити, ходьба, сауна и рутины сна помогают WeekFit понимать восстановление и дневную нагрузку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸、拉伸、关节活动度训练、步行、桑拿及睡眠习惯，均有助于 WeekFit 系统分析恢复情况与日常负荷。"
          }
        }
      }
    },
