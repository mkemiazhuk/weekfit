        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kluczowe sygnały pozostają blisko linii bazowej, co odpowiada niższemu obciążeniu fizjologicznemu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключевые сигналы близки к базовому уровню, что согласуется с более низкой физиологической нагрузкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关键信号接近基线，与较低生理负荷一致。"
