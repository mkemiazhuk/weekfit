    "coach.scenario.performanceBefore.closeToStart.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session starts soon. Start below target effort and build only after the first block feels easy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировка скоро начнется. Начните ниже целевого усилия и добавляйте только после того, как первый блок ощущается легким."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练即将开始。请先从低于目标强度的强度开始，仅在第一个动作组感觉轻松后再增加强度。"
          }
        }
      }
    },
    "coach.scenario.performanceBefore.closeToStart.titleFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get ready for %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовьтесь к %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为%@做好准备"
          }
        }
      }
    },
    "coach.scenario.performanceBefore.hard.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session can create real training stress. Build into it gradually and keep quality higher than intensity."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта тренировка может дать реальный стресс для тела. Входите постепенно и держите качество выше интенсивности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这项训练可为身体带来真实的压力。请循序渐进地开始，并确保动作质量始终高于训练强度。"
          }
        }
      }
    },
    "coach.scenario.performanceBefore.hard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare for a hard session"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовьтесь к тяжелой тренировке"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为高强度训练做好准备"
          }
        }
      }
    },
    "coach.scenario.performanceBefore.loaded.messageFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ For %@, make this quality work rather than extra volume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ Для %@ сделайте это качественной работой, а не дополнительным объемом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@对于%@ ，让这种质量发挥作用，而不是额外的音量。"
          }
        }
      }
    },
    "coach.scenario.performanceBefore.loadedDay.titleFormat": {
      "extractionState": "manual",
      "localizations": {
