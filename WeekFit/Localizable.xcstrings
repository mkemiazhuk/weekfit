          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché il recupero cambia durante il giorno?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復が日中に変わるのはなぜ？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복이 하루 중 바뀌는 이유는?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dlaczego regeneracja zmienia się w ciągu dnia?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почему Восстановление меняется в течение дня?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么恢复过程在一天之中会发生变化？"
          }
        }
      }
    },
    "support.faq.item42.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfen Sie Mitteilungsberechtigungen in den iPhone-Einstellungen und stellen Sie sicher, dass Erinnerungen in WeekFit aktiviert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check notification permissions in iPhone Settings and make sure reminders are turned on inside WeekFit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise permisos de notificaciones en Ajustes del iPhone y que los recordatorios estén activados en WeekFit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les autorisations de notification dans Réglages iPhone et que les rappels sont activés dans WeekFit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla i permessi notifiche in Impostazioni iPhone e assicurati che i promemoria siano attivi in WeekFit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneの設定で通知の権限を確認し、WeekFit内でリマインダーがオンになっていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 설정에서 알림 권한을 확인하고 WeekFit에서 알림이 켜져 있는지 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź uprawnienia powiadomień w Ustawieniach iPhone i czy przypomnienia są włączone w WeekFit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте разрешения уведомлений в настройках iPhone и убедитесь, что напоминания включены внутри WeekFit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 的“设置”中检查通知权限，并确保在 WeekFit 应用中已开启提醒功能。"
          }
        }
      }
    },
