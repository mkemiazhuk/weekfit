    "coach.insight.activityLoadIsHighAndEnergyIntake.864" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aktivitätsbelastung ist hoch und die Energieaufnahme hinkt hinterher. Fügen Sie jetzt Protein und leicht verdauliche Kohlenhydrate hinzu, dann halten Sie die Intensität unter Kontrolle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activity load is high and energy intake is behind. Add protein and easy carbs now, then keep intensity controlled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de actividad es alta y la ingesta de energía va retrasada. Añada proteína y carbohidratos fáciles ahora y mantenga la intensidad controlada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge d'activité est élevée et l'apport énergétique est en retard. Ajoutez protéines et glucides faciles maintenant, puis gardez l'intensité maîtrisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico di attività è elevato e l'apporto energetico è insufficiente. Aggiunga proteine e carboidrati facili ora, poi mantieni l'intensità sotto controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活動量が多く、エネルギー摂取が追いついていません。今すぐタンパク質と消化の良い炭水化物を追加し、その後は強度を抑えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활동량이 많고 에너지 섭취가 부족합니다. 지금 단백질과 소화가 쉬운 탄수화물을 추가하고, 이후에는 강도를 조절하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie aktywnością jest wysokie, a spożycie energii z tyłu. Dodaj białko i łatwe węgle teraz, potem trzymaj intensywność pod kontrolą."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагрузка высокая, а энергии не хватает. Добавьте белок и легкие углеводы, затем держите интенсивность под контролем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动负荷较高，但能量摄入不足。建议立即增加蛋白质及易吸收碳水化合物的摄入，同时保持运动强度恒定。"
          }
        }
      }
    },
