    "coach.youAlreadyHaveLoadInTheDayKeepThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben heute schon Last im Tag. Halten Sie die Fahrt ruhig und machen Sie aus Volumen keine Intensität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
