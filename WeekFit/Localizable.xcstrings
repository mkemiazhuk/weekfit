    "coach.section.recovery.why.general" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholungsarbeit hilft dem Körper, sich nach Belastung zu beruhigen. Ziel ist es, Spannungen zu reduzieren, den Schlaf zu unterstützen und zusätzlichen Stress zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery work helps the body settle after load. The goal is to reduce tension, support sleep and avoid adding more stress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo de recuperación ayuda al cuerpo a asentarse tras la carga. El objetivo es reducir tensión, apoyar el sueño y evitar más estrés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail de récupération aide le corps à se calmer après la charge. L’objectif est de réduire les tensions, soutenir le sommeil et éviter d’ajouter du stress."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro di recupero aiuta il corpo a stabilizzarsi dopo il carico. L'obiettivo è ridurre la tensione, favorire il sonno ed evitare di aggiungere ulteriore stress."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復作業は、負荷の後に体を落ち着かせるのに役立ちます。目標は、緊張を減らし、睡眠をサポートし、さらなるストレスを加えないようにすることです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복 작업은 몸이 부하 후에 안정되도록 돕습니다. 목표는 긴장을 줄이고, 수면을 지원하며, 추가적인 스트레스를 피하는 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca regeneracyjna pomaga ciału uspokoić się po obciążeniu. Celem jest zmniejszenie napięcia, wsparcie snu i unikanie dodatkowego stresu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановительная работа помогает телу успокоиться после нагрузки. Цель — снизить напряжение, поддержать сон и не добавлять стресс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复性活动有助于身体在负荷后恢复平静，其目的在于减轻肌肉紧张、保障睡眠质量，并避免增加压力。"
          }
        }
      }
    },
    "coach.section.recovery.why.stretching" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilitätsübungen können Steifheit reduzieren und die Bewegungsqualität zwischen den Trainingseinheiten erhalten. Bewege Sie langsam und vermeide es, schmerzhafte Positionen zu erzwingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobility work can reduce stiffness and maintain movement quality between training sessions. Move slowly and avoid forcing painful positions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo de movilidad puede reducir rigidez y mantener calidad de movimiento entre sesiones. Muévase despacio y evite posturas dolorosas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail de mobilité peut réduire la raideur et maintenir la qualité de mouvement entre les séances. Bougez lentement et évitez les positions douloureuses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro di mobilità può ridurre la rigidità e mantenere la qualità del movimento tra le sessioni di allenamento. Muoviti lentamente ed evita di forzare posizioni dolorose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モビリティワークは、トレーニングセッションの間のこわばりを減らし、動きの質を維持することができます。ゆっくり動かし、痛みを伴う姿勢を無理にとらないようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모빌리티 운동은 훈련 사이에 뻣뻣함을 줄이고 움직임의 질을 유지할 수 있습니다. 천천히 움직이고 통증이 있는 자세를 억지로 취하지 마세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca nad mobilnością może zmniejszyć sztywność i utrzymać jakość ruchu między sesjami. Poruszaj się powoli i unikaj bolesnych pozycji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мобилити может снизить скованность и сохранить качество движения между тренировками. Двигайтесь медленно и не продавливайте болезненные положения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活动训练有助于减轻关节僵硬，并在两次训练间隔期间维持活动能力。动作应缓慢进行，避免强行进入引发疼痛的姿势。"
          }
        }
      }
    },
    "coach.section.recovery.why.walk" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leichtes Gehen unterstützt die Durchblutung und Erholung, ohne bedeutende Ermüdung hinzuzufügen. Das Ziel ist es, sich danach besser zu fühlen, nicht müder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy walking supports circulation and recovery without adding meaningful fatigue. The goal is to feel better afterwards, not more tired."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminar suave apoya circulación y recuperación sin fatiga significativa. El objetivo es sentirse mejor después, no más cansado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une marche facile soutient la circulation et la récupération sans fatigue significative. L’objectif est de se sentir mieux ensuite, pas plus fatigué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camminare facilmente supporta la circolazione e il recupero senza aggiungere una fatica significativa. L'obiettivo è sentirsi meglio dopo, non più stanchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽いウォーキングは、重要な疲労を増やすことなく、循環と回復をサポートします。目標は、より疲れることではなく、歩いた後に気分が良くなることです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가벼운 걷기는 의미 있는 피로를 더하지 않고 순환과 회복을 돕습니다. 목표는 더 피곤해지는 것이 아니라 이후에 기분이 좋아지는 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spokojny spacer wspiera krążenie i regenerację bez istotnego zmęczenia. Celem jest poczuć się lepiej potem, a nie bardziej zmęczonym."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легкая ходьба поддерживает кровообращение и восстановление без заметной усталости. Цель — почувствовать себя лучше, а не уставшим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简易步行有助于促进血液循环与恢复，且不会引发明显疲劳。其目的在于事后感觉更好，而非更加疲惫。"
          }
        }
      }
    },
    "coach.section.recovery.why.yoga" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanftes Yoga kann Spannungen lösen, die Beweglichkeit verbessern und dem Körper helfen, herunterzufahren. Halte die Sitzung ruhig genug, um die Erholung zu unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle yoga can release tension, improve mobility and help the body downshift. Keep the session calm enough to support recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yoga suave puede soltar tensión, mejorar movilidad y ayudar al cuerpo a bajar el ritmo. Mantenga la sesión lo bastante calmada para apoyar la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un yoga doux peut relâcher les tensions, améliorer la mobilité et aider le corps à ralentir. Gardez la séance assez calme pour soutenir la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo yoga dolce può liberare tensioni, migliorare la mobilità e aiutare il corpo a rallentare. Mantieni la sessione abbastanza calma da supportare il recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やさしいヨガは緊張をほぐし、可動性を改善し、体をリラックスさせるのに役立ちます。回復をサポートするために、セッションは落ち着いた雰囲気を保ちましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 요가는 긴장을 풀고, 유연성을 향상시키며 몸이 휴식 모드로 전환되도록 도울 수 있습니다. 회복을 지원할 수 있도록 세션을 충분히 차분하게 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łagodna joga może puścić napięcie, poprawić mobilność i pomóc ciału zwolnić. Utrzymuj sesję na tyle spokojną, by wspierała regenerację."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягкая йога может снять напряжение, улучшить подвижность и помочь телу замедлиться. Держите тренировку достаточно спокойной, чтобы она помогала восстановлению."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温和瑜伽有助于缓解肌肉紧张、提升身体灵活性，并促进身体进入放松状态。请保持练习环境足够安静，以利于身体恢复。"
          }
        }
      }
    },
    "coach.section.recovery.yoga.finishCalmer" : {
