    "onboarding.v7.intro.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit vereint Erholung, Aktivität, Ernährung und Pläne, damit Sie heute verstehen und entscheiden können, was als Nächstes kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit brings together your recovery, activity, nutrition and plans to help you understand today and decide what comes next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit reúne recuperación, actividad, nutrición y planes para ayudarle a entender hoy y decidir qué sigue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit réunit récupération, activité, nutrition et plans pour vous aider à comprendre aujourd'hui et décider la suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit unisce recupero, attività, nutrizione e piani per aiutarti a capire oggi e decidere cosa viene dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitは回復、活動、栄養、予定をまとめ、今日を理解し次を決めるのを助けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 회복, 활동, 영양, 계획을 모아 오늘을 이해하고 다음을 결정하도록 돕습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit łączy regenerację, aktywność, odżywianie i plany, by pomóc zrozumieć dziś i zdecydować, co dalej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit собирает восстановление, активность, питание и планы — чтобы понять сегодня и решить, что дальше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 整合恢复数据、活动量、营养信息及计划——旨在洞察当下状况，并制定后续行动方案。"
          }
        }
      }
    },
