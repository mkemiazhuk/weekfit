        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если дать еде улечься, старт пройдет легче и без лишнего стресса для пищеварения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让食物静置可保护消化起始阶段，且不会增加消化负担。"
          }
        }
      }
    },
