    "coach.humanDecision.giveTheMealTimeToSettleBring.3295" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib der Mahlzeit Zeit, sich zu setzen. Bring eine Flasche mit und fang locker an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the meal time to settle. Bring a bottle and start easy."
