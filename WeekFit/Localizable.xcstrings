    "support.faq.item03.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute konzentriert sich auf Ihren aktuellen Tag, Metriken und Live-Aktivität. Plan ist der Ort, an dem Sie Workouts, Mahlzeiten, Erholung, Schlaf und Routinen im Voraus organisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today focuses on your current day, metrics, and live activity. Plan is where you organize workouts, meals, recovery, sleep, and routines ahead of time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy se centra en su día actual, métricas y actividad en vivo. Plan es donde organiza entrenamientos, comidas, recuperación, sueño y rutinas con antelación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui se concentre sur votre journée en cours, vos métriques et l'activité en direct. Plan sert à organiser entraînements, repas, récupération, sommeil et routines à l'avance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi si concentra sulla giornata attuale, metriche e attività live. Piano è dove organizzi allenamenti, pasti, recupero, sonno e routine in anticipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は今日、指標、ライブのアクティビティに焦点を当てます。プランでは、ワークアウト、食事、回復、睡眠、ルーティンを事前に整理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 오늘, 지표, 실시간 활동에 초점을 맞춥니다. 계획에서는 운동, 식사, 회복, 수면, 루틴을 미리 정리합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś skupia się na bieżącym dniu, metrykach i aktywności na żywo. Plan służy do organizacji treningów, posiłków, regeneracji, snu i rutyn z wyprzedzeniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня показывает текущий день, метрики и живую активность. План нужен, чтобы заранее организовать тренировки, питание, восстановление, сон и рутины."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本页面显示当前日期、相关指标及实时活动数据。制定计划有助于提前规划训练、营养、恢复、睡眠及日常作息。"
          }
        }
      }
    },
    "support.faq.item03.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist der Unterschied zwischen Heute und Plan?"
          }
        },
        "en" : {
