          }
        }
      }
    },
    "coach.scenario.recoveryAfter.default.loaded.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dies war genau die richtige Art von Arbeit nach einem anstrengenden Tag. Halte den nächsten Teil einfach und lasse die Erholung weitergehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ This was the right kind of work after a loaded day. Keep the next part easy and let recovery continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Fue el tipo correcto de trabajo tras un día cargado. Mantenga lo siguiente suave y deje seguir la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ C’était le bon type de travail après une journée chargée. Gardez la suite facile et laissez la récupération continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Questo era il tipo giusto di lavoro dopo una giornata intensa. Mantieni la parte successiva facile e lascia che il recupero continui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ これは、充実した一日の後に適した仕事でした。次の部分は簡単にして、回復を続けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이것은 힘든 하루 후에 알맞은 종류의 일이었다. 다음 부분은 쉽게 진행하고 회복이 계속되도록 하라."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ To była właściwa praca po obciążonym dniu. Utrzymaj następną część na luzie i pozwól regeneracji trwać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Это был правильный тип работы после нагруженного дня. Держите следующую часть легкой и дайте восстановлению продолжиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@在忙碌了一天之后，这是正确的工作方式。让下一部分变得简单，让恢复继续进行。"
          }
        }
      }
    },
