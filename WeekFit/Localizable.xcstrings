    "onboarding.v4.way.adaptive.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach liest Erholung, Aktivität, Ernährung, Pläne und Ziele — und empfiehlt den besten nächsten Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach reads recovery, activity, nutrition, plans and goals — then recommends your best next step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach lee recuperación, actividad, nutrición, planes y objetivos — y recomienda su mejor siguiente paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach lit récupération, activité, nutrition, plans et objectifs — puis recommande votre meilleure prochaine étape."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach legge recupero, attività, nutrizione, piani e obiettivi — poi consiglia il miglior passo successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coachは回復、活動、栄養、予定、目標を読み取り—最適な次の一歩を提案します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach는 회복, 활동, 영양, 계획, 목표를 읽고 — 가장 유용한 다음 단계를 추천합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach czyta regenerację, aktywność, odżywianie, plany i cele — potem poleca najlepszy następny krok."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренер учитывает восстановление, активность, питание, планы и цели — и предлагает лучший следующий шаг."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练会评估您的恢复情况、活动量、营养状况、计划及目标——进而为您推荐最佳的下一步行动方案。"
          }
        }
      }
    },
