    "coach.eveningRecap.feeling.reaction.energized.quiet" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schön, heute Licht zu fühlen. Tragen Sie diese Leichtigkeit in die Nacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nice to feel light today. Carry that ease into night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agradable sentirse ligero hoy. Lleva esa calma a la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agréable de se sentir léger aujourd’hui. Gardez cette légèreté ce soir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E' bello sentire la luce oggi. Portate via la notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は光を感じるのが好きです。 夜を楽しませてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 빛을 느끼기 좋은. 밤에 쉽게 이동."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miło czuć się lekko dziś. Zabierz to spokojnie w noc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приятно чувствовать лёгкость сегодня. Сохраните её до ночи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天感觉轻盈很好。把这份轻松带到夜里。"
          }
        }
      }
    },
