    "coach.humanDecision.theRideStartsInValueBreakfastIs.3160" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fahrt beginnt um %@ . Das Frühstück ist im Magen, also ist das Ziel jetzt, frisch anzukommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ride starts in %@. Breakfast is in, so now the goal is arriving fresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salida empieza en %@ . Desayuno hecho; el objetivo es llegar fresco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sortie commence dans %@ . Le petit-déjeuner est pris ; l’objectif est d’arriver frais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il giro inizia a %@ . La colazione è compresa, quindi ora l'obiettivo è arrivare freschi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライドは %@ で始まります。朝食は済んだので、今の目標は元気な状態で到着することです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이드는 %@ 에서 시작합니다. 아침식사는 끝났으니, 이제 목표는 신선한 상태로 도착하는 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyjazd za %@ . Śniadanie zjedzone — celem jest świeże przyjście."
