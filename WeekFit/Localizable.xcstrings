    "onboarding.v8.coach.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wägt Erholung, Aktivität, Ernährung, Ziele und Pläne ab — und schlägt den nächsten nützlichen Schritt vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It weighs recovery, activity, nutrition, goals and plans — then suggests the next useful step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopesa recuperación, actividad, nutrición, objetivos y planes — y sugiere el siguiente paso útil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pondère récupération, activité, nutrition, objectifs et plans — puis suggère la prochaine étape utile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valuta recupero, attività, nutrizione, obiettivi e piani — poi suggerisce il passo utile successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復、活動、栄養、目標、予定を踏まえ—次の有用な一歩を提案します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복, 활동, 영양, 목표, 계획을 고려해 — 유용한 다음 단계를 제안합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waży regenerację, aktywność, odżywianie, cele i plany — potem sugeruje następny użyteczny krok."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитывает восстановление, активность, питание, цели и планы — и предлагает полезный следующий шаг."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它综合考量康复情况、活动水平、营养状况、目标及计划——进而提出下一步可行的建议。"
          }
        }
      }
    },
