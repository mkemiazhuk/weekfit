    "recovery.details.score.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery vergleicht letzte nacht mit ihrer letzten baseline. Dies ist eine Schätzung, keine medizinische Diagnose."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery compares last night to your recent baseline. This is an estimate, not a medical diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación compara anoche con su referencia reciente. Es una estimación, no un diagnóstico médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération compare la nuit dernière à votre référence récente. Il s'agit d'une estimation, pas d'un diagnostic médical."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero si confronta ieri sera con la vostra linea di base recente. Questa è una stima, non una diagnosi medica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復は、あなたの最近のベースラインに最後の夜を比較します。 医療診断ではなく、見積もりです。"
