            "value" : "サポートされているコンテキストはまだ形成されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원 컨텍스트는 여전히 형성"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontekst wsparcia wciąż się formuje"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживающий контекст ещё формируется"
