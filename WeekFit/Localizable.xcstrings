    "coach.priority.recoveryMovementIsPlannedButThereIs.4450" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholungsbewegung ist geplant, aber es gibt keine dringende Coaching-Maßnahme."
          }
        },
        "en" : {
