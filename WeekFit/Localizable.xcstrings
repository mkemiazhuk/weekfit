    "login.appleReplaceLocal.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung bei Apple startet einen separaten Kontoarbeitsbereich. Lokale WeekFit-Daten auf diesem Gerät werden entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing in with Apple starts a separate account workspace. Local WeekFit data on this device will be removed. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sesión con Apple crea un espacio de cuenta separado. Se eliminarán los datos locales de WeekFit en este dispositivo. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecter avec Apple crée un espace de compte distinct. Les données WeekFit locales sur cet appareil seront supprimées. Action irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con Apple inizia uno spazio di lavoro separato dell'account. I dati locali WeekFit su questo dispositivo verranno rimossi. Questo non può essere annullato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleでサインインすると、別のアカウントのワークスペースが始まります。 このデバイス上のローカルWeekFitデータを削除します。 これは元に戻すことができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple과 로그인하면 별도의 계정 작업 공간을 시작합니다. 이 장치에 국부적으로 WeekFit 자료는 제거될 것입니다. 이것은 undone일 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logowanie przez Apple tworzy osobny obszar konta. Lokalne dane WeekFit na tym urządzeniu zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход с Apple откроет отдельное пространство аккаунта. Локальные данные WeekFit на этом устройстве будут удалены. Это нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Apple 登录将启用独立的账户空间。该设备上 WeekFit 的本地数据将被清除，且此操作不可撤销。"
          }
        }
