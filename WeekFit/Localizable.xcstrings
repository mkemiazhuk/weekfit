    "insights.vm.learnings.shortSleep.textFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tage nach 7h + Schlaf durchschnittlich etwa +%lldErholungspunkte im Vergleich zu Kurzschlafnächten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Days after 7h+ sleep average about +%lld recovery points compared with short-sleep nights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días tras 7 h+ de sueño promedian unos +%lld puntos de recuperación frente a noches cortas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours après 7 h+ de sommeil valent en moyenne +%lld points de récupération par rapport aux nuits courtes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giorni dopo 7h+ media di sonno circa +%lldpunti di recupero rispetto alle notti di breve durata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7h+の睡眠の平均の後の日 +%lld短い眠りの夜と比較される回復ポイント。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7h + 수면 평균 후 일 +%lld짧은 수면 밤에 비해 회복 포인트."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dni po 7 h+ snu dają średnio +%lld punktów regeneracji w porównaniu z krótkimi nocami."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дни после 7+ ч сна в среднем дают около +%lld баллов восстановления по сравнению с ночами короткого сна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与短睡眠夜相比，睡眠时长≥7小时者在数日后平均可获得约%lld个恢复点。"
          }
        }
      }
    },
