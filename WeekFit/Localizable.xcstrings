          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일을 지켜라세요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chroń jutro"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните силы на завтра"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为明天保留体力"
          }
        }
      }
    },
    "coach.rationale.restorativeDay.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ soll die Erholung unterstützen. Halte dieses %2$@ einfach, damit der Tag erholsam und nicht anstrengend bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is meant to support recovery. Keep this %2$@ easy so the day stays restorative, not draining."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está pensado para apoyar la recuperación. Mantenga este %2$@ suave para que el día siga siendo reparador, no agotador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est prévu pour soutenir la récupération. Gardez ce %2$@ facile pour que la journée reste réparatrice, pas épuisante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è pensato per supportare il recupero. Mantieni questo %2$@ facile in modo che la giornata rimanga rigenerante, non faticosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は回復をサポートすることを目的としています。この %2$@ は簡単にしておきましょう。そうすることで、一日が消耗ではなく、回復的なものになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은 회복을 지원하기 위한 것입니다. 하루가 소모적이지 않고 회복이 되도록 %2$@을/를 쉽고 간단하게 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ma wspierać regenerację. Utrzymuj ten %2$@ na łatwym poziomie, by dzień był regeneracyjny, a nie wyczerpujący."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ должна поддерживать восстановление. Держите эту %2$@ легкой, чтобы день оставался восстановительным, а не истощающим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@旨在支持恢复。保持这款%2$@轻松，让白天保持恢复，而不是消耗。"
          }
        }
      }
    },
