          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구는 더 많은 예측 가능"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja stała się bardziej przewidywalna"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление стало предсказуемее"
          }
        },
        "zh-Hans" : {
