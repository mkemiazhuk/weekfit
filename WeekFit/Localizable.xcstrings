    "insights.story.driver.sleepDuration.belowTargetFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf ist %.1fh unter dem Ziel, was die Marge reduziert, bevor die Last steigt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sleep is %.1fh below target, which reduces margin before load increases"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "el sueño está %.1fh por debajo del objetivo, lo que reduce el margen antes de subir la carga"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le sommeil est %.1fh sous l'objectif, ce qui réduit la marge avant d'augmenter la charge"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "il sonno è %.1fh sotto il bersaglio, che riduce il margine prima che aumenta il carico"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は%.1fhの下のターゲット、負荷増加の前に余白を減らすです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠은 목표의 밑에 %.1fh, 짐 증가의 앞에 한계를 감소시킵니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sen jest %.1fh poniżej celu, co zmniejsza zapas przed wzrostem obciążenia"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "сон на %.1f ч ниже цели, что сокращает запас перед увеличением нагрузки"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠时间比目标值低 %.1f，从而在增加负荷时减少储备量。"
          }
        }
      }
    },
