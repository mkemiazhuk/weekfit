    "termsPrivacy.legal.userData.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Aktivitäten, Mahlzeiten, Hydration, Erholungsroutinen, Schlaf-Routinen und andere geplante Elemente in WeekFit hinzufügen, bearbeiten, abschließen, überspringen oder löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You may add, edit, complete, skip, or delete activities, meals, hydration, recovery routines, sleep routines, and other planned items inside WeekFit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede añadir, editar, completar, omitir o eliminar actividades, comidas, hidratación, rutinas de recuperación, rutinas de sueño y otros elementos planificados en WeekFit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ajouter, modifier, terminer, ignorer ou supprimer activités, repas, hydratation, routines de récupération, routines de sommeil et autres éléments planifiés dans WeekFit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aggiungere, modificare, completare, saltare o eliminare attività, pasti, idratazione, routine recupero, sonno e altri elementi pianificati in WeekFit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit内でアクティビティ、食事、水分、回復ルーティン、睡眠ルーティンなど計画項目の追加、編集、完了、スキップ、削除ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit에서 활동, 식사, 수분, 회복·수면 루틴 등 계획 항목을 추가·편집·완료·건너뛰기·삭제할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W WeekFit można dodawać, edytować, kończyć, pomijać lub usuwać aktywności, posiłki, nawodnienie, rutyny regeneracji, sen i inne zaplanowane elementy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете добавлять, редактировать, завершать, пропускать или удалять активности, приемы пищи, гидратацию, восстановительные рутины, рутины сна и другие запланированные пункты внутри WeekFit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以在 WeekFit 中添加、编辑、完成、跳过或删除活动、进餐、补水、恢复性例行事项、睡眠例行事项及其他已规划的项目。"
          }
        }
      }
    },
    "termsPrivacy.legal.userData.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Nutzer eingegebene Daten aktualisieren Plan, Metriken, Coach-Kontext und Tagesführung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "User-entered data is used to update your plan, metrics, Coach context, and daily guidance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos introducidos se usan para actualizar su plan, métricas, contexto de Coach y orientación diaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données saisies servent à mettre à jour votre plan, vos métriques, le contexte Coach et les conseils quotidiens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati inseriti aggiornano piano, metriche, contesto Coach e guida giornaliera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー入力データはプラン、指標、Coachコンテキスト、一日のガイダンスを更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 입력 데이터는 플랜, 지표, Coach 맥락, 하루 안내를 업데이트합니다."
