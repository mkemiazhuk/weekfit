    "coach.priority.aHardPushAfterVeryLowSleep.4565" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein harter Einsatz nach sehr wenig Schlaf bringt Ihnen normalerweise Kosten, ohne die Qualität, die das Training lohnenswert macht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hard push after very low sleep usually gives you cost without the quality that makes training worthwhile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un empuje fuerte tras sueño muy bajo suele costar sin la calidad que hace valer el entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gros effort après un sommeil très faible coûte souvent sans la qualité qui rend l'entraînement utile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una forte spinta dopo un sonno molto scarso di solito ti dà costo senza la qualità che rende l'allenamento utile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常に少ない睡眠の後での無理なトレーニングは、トレーニングを価値あるものにする質を伴わないコストをもたらすことが多いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면이 매우 부족한 상태에서 무리하게 운동을 하면 훈련을 가치 있게 만드는 질 없이 대가만 치르게 된다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mocny wysiłek po bardzo małym śnie zwykle daje koszt bez jakości, która czyni trening wartościowym."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяжелый рывок после очень короткого сна обычно дает больше цены, чем качества."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在睡眠严重不足的情况下强行训练，往往只能获得数量而非质量，而缺乏这种质量，训练便失去了意义。"
          }
        }
      }
    },
    "coach.priority.aHardSessionAfterVeryLowSleep.3016" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
