    "support.faq.item20.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left zeigt eine grobe Schätzung verbleibender Kalorien basierend auf aktueller Aktivität, Workouts und protokollierten Mahlzeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left shows a rough estimate of remaining calories based on your current activity, workouts, and logged meals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left muestra una estimación aproximada de calorías restantes según actividad, entrenamientos y comidas registradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left montre une estimation approximative des calories restantes selon activité, entraînements et repas enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left mostra una stima approssimativa delle calorie rimanenti in base ad attività, allenamenti e pasti registrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftは、現在のアクティビティ、ワークアウト、記録した食事に基づく残りカロリーのおおよその推定を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left는 현재 활동, 운동, 기록된 식사를 바탕으로 남은 칼로리의 대략적 추정을 보여줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left pokazuje przybliżoną estymację pozostałych kalorii na podstawie aktywności, treningów i zalogowanych posiłków."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаток показывает примерную оценку оставшихся калорий с учетом текущей активности, тренировок и записанных приемов пищи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左侧图表根据您当前的活动量、锻炼情况及已记录的饮食记录，对剩余热量进行了粗略估算。"
          }
        }
      }
    },
