          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон достаточно стабилен, чтобы поддерживать восстановление, а не объяснять текущие проблемы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
