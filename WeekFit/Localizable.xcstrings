        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "七面鳥と緑の豆で甘いジャガイモをプレートし、味付けする季節。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "turkey와 녹색 콩을 가진 달콤한 감자를 도금하고, 그 후에 맛에 시즌."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ułóż batata z indykiem i fasolką, a następnie dopraw do smaku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выложите батат с индейкой и фасолью, приправьте по вкусу."
