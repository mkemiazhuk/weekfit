    "coach.priority.theGoalIsToArriveAtTomorrow.4866" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel ist es, morgen mit genügend Erholungskapazität anzukommen, um sich anzupassen, nicht nur den Plan zu erfüllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goal is to arrive at tomorrow with enough recovery capacity to adapt, not just complete the plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El objetivo es llegar mañana con capacidad de recuperación suficiente para adaptarse, no solo cumplir el plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’objectif est d’arriver demain avec assez de capacité de récupération pour vous adapter, pas seulement pour suivre le plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'obiettivo è arrivare a domani con sufficiente capacità di recupero per adattarsi, non solo completare il piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標は、計画を完了するだけでなく、適応できる十分な回復力を持って明日を迎えることです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표는 단순히 계획을 완료하는 것이 아니라 적응할 수 있는 충분한 회복 능력을 가지고 내일에 도달하는 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celem jest dotrzeć jutro z wystarczającą zdolnością regeneracji, by się adaptować, a nie tylko wykonać plan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель — подойти к завтрашнему дню с запасом на восстановление, а не просто выполнить план."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标是在迎接明日挑战时，为恢复工作预留充足余地，而非仅仅完成既定计划。"
          }
        }
      }
    },
    "coach.priority.theGoalIsToFeelBetterAfterward.3888" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel ist es, sich danach besser zu fühlen, nicht zwangsweise fitter. Halten Sie die Bewegung leicht und lass sie ihre Arbeit tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goal is to feel better afterward, not fitter by force. Keep the movement easy and let it do its job."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El objetivo es sentirse mejor después, no más en forma a la fuerza. Mantenga el movimiento suave y déjelo hacer su trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’objectif est de vous sentir mieux ensuite, pas plus en forme par la force. Gardez le mouvement facile et laissez-le faire son effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'obiettivo è sentirsi meglio dopo, non più in forma con la forza. Mantenga il movimento facile e lascia che faccia il suo lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標は無理に体を鍛えることではなく、その後に気分が良くなることです。動きを無理のないものにして、その効果に任せましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표는 억지로 더 건강해지는 것이 아니라, 나중에 기분이 좋아지는 것입니다. 동작을 쉽게 유지하고 그것이 제 역할을 하도록 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celem jest poczuć się lepiej potem, a nie być silniejszym na siłę. Utrzymuj ruch łatwy i pozwól mu działać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель — почувствовать себя лучше после, а не силой стать «в форме». Держите движение легким и дайте ему сделать свое дело."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标是在运动后感觉更好，而非强行让自己变得“有型”。保持动作轻盈，让身体自然完成动作。"
          }
        }
      }
    },
    "coach.priority.theGoalIsToRecoverFromThe.1786" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel ist es, sich von der Sitzung zu erholen, ohne den Schlaf zu stören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goal is to recover from the session without disrupting sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El objetivo es recuperarse de la sesión sin alterar el sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’objectif est de récupérer de la séance sans perturber le sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'obiettivo è riprendersi dalla sessione senza disturbare il sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標は、睡眠を妨げることなくセッションから回復することです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표는 수면을 방해하지 않고 세션에서 회복하는 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celem jest regeneracja po sesji bez zakłócania snu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель — восстановиться после тренировки и не испортить сон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标是训练后恢复体力，且不影响睡眠。"
          }
        }
      }
    },
    "coach.priority.theHardPartIsAlreadyDoneA.1780" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der schwierige Teil ist bereits erledigt. Eine leichte, proteinorientierte Mahlzeit ist jetzt sinnvoll, aber vermeiden Sie, daraus ein schweres spätes Abendessen zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hard part is already done. A light protein-focused meal makes sense now, but avoid turning it into a heavy late dinner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte difícil ya está hecha. Una comida ligera con proteínas encaja ahora, pero evite convertirla en una cena tardía pesada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La partie difficile est déjà faite. Un repas léger riche en protéines a du sens maintenant, mais évitez d’en faire un dîner tardif copieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte difficile è già fatta. Ora ha senso un pasto leggero a base di proteine, ma evita di trasformarlo in una cena abbondante e tardiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大変な部分はもう終わっています。今は軽めでタンパク質中心の食事が理にかなっていますが、遅い時間に重い夕食に変えるのは避けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어려운 부분은 이미 끝났습니다. 이제는 가벼운 단백질 중심 식사가 적절하지만, 늦은 시간에 무거운 저녁으로 바꾸는 것은 피하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trudna część jest już za Tobą. Lekki posiłek z naciskiem na białko ma teraz sens, ale unikaj ciężkiej kolacji późno wieczorem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяжелая часть уже сделана. Легкая еда с фокусом на белок сейчас уместна, но не превращайте ее в плотный поздний ужин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重餐部分已经完成。目前以蛋白质为主的清淡饮食是合适的选择，但切勿将其变成丰盛的深夜晚餐。"
          }
        }
      }
    },
    "coach.priority.theMorningIsInAGoodRecovery.2774" : {
