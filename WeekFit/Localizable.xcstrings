    "support.faq.item29.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live bedeutet, die Aktivität läuft gerade basierend auf geplanter Zeit oder synchronisiertem Workout-Timing."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live means the activity is currently happening based on the planned time or synced workout timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vivo significa que la actividad ocurre ahora según la hora planificada o el timing del entrenamiento sincronizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En direct signifie que l'activité a lieu maintenant selon l'heure planifiée ou le timing du entraînement synchronisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live significa che l’attività è in corso in base all’orario pianificato o al timing dell’allenamento sincronizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liveは、予定時刻または同期されたワークアウトのタイミングに基づき、アクティビティが現在進行中であることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live는 예정 시간 또는 동기화된 운동 타이밍에 따라 활동이 현재 진행 중임을 의미합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na żywo oznacza, że aktywność trwa teraz według planowanej godziny lub czasu zsynchronizowanego treningu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас означает, что активность идет по запланированному времени или времени синхронизированной тренировки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“实时”表示该活动正根据预设时间或同步训练时间正在进行。"
          }
        }
      }
    },
