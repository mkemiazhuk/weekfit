    "coach.activityContext.noCoachingMoveIsUrgentRightNow.373" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Coaching-Move ist derzeit dringend. Lassen Sie den Plan im Hintergrund bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No coaching move is urgent right now. Let the plan stay in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna acción de Coach es urgente ahora. Deje el plan en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune action Coach n'est urgente pour l'instant. Laissez le plan rester en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'e' nessuna mossa di coaching in questo momento. Lascia che il piano rimanga sullo sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーチング・ムーブは今は急務です。 プランはバックグラウンドで滞在しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코칭 이동은 지금 긴급합니다. 계획은 배경에 체재하자."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden ruch Coach nie jest teraz pilny. Pozostawić plan w tle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас не нужно срочно что-то исправлять. Пусть план остается на фоне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前并无紧急的教练调整需求。让计划继续处于次要地位。"
          }
        }
      }
    },
