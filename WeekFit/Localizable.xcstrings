    "coach.priority.theSessionIsCloseTheUsefulMove.4409" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sitzung ist nah. Der nützliche Schritt ist die Einsatzbereitschaft, nicht die Änderung des Plans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session is close. The useful move is execution readiness, not changing the plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión está cerca. Lo útil es prepararse para ejecutar, no cambiar el plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La séance est proche. Le geste utile est la préparation à l’exécution, pas le changement de plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione è vicina. La mossa utile è la prontezza all'esecuzione, non cambiare il piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションは間近です。有効な動きは計画を変えることではなく、実行準備です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 가까워지고 있습니다. 유용한 움직임은 계획을 변경하는 것이 아니라 실행 준비입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesja jest blisko. Użyteczny krok to gotowość do wykonania, a nie zmiana planu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировка близко. Полезный шаг — готовность к выполнению, а не изменение плана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练已近在咫尺。关键的一步是做好执行准备，而非改变计划。"
          }
        }
      }
    },
    "coach.priority.theUsefulCoachingMoveIsProtectingThe.2419" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der nützliche Coaching-Schritt besteht darin, die spätere Arbeit vor den Dingen zu schützen, die sie zuerst erschöpfen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The useful coaching move is protecting the later work from the things that can drain it first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paso útil de Coach es proteger el trabajo posterior de lo que puede agotarlo primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le geste d’accompagnement utile est de protéger le travail ultérieur de ce qui peut l’épuiser en premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mossa di coaching utile è proteggere il lavoro successivo dalle cose che possono prosciugarlo prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有用なコーチングの一手は、後の作業を先にそれを消耗させるものから守ることです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유용한 코칭 방법은 나중의 작업을 먼저 그것을 소모시킬 수 있는 것들로부터 보호하는 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyteczny krok Coach to ochrona późniejszej pracy przed tym, co może ją najpierw osłabić."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полезный тренерский ход — сохранить силы на позднюю работу от того, что может забрать их раньше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个有益的教练策略是：通过避免过早耗尽体力，从而为后期的工作保留精力。"
          }
        }
      }
    },
    "coach.priority.theUsefulMoveInALongGap.4531" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der nützliche Schritt bei einer langen Pause ist Konsistenz, nicht auf die Uhr zu schauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The useful move in a long gap is consistency, not watching the clock."
          }
