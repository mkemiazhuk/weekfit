    "support.faq.item17.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit nutzt adaptive Ziele, die auf Workouts, Bewegung, Erholung, Mahlzeiten und neu verfügbare Apple Health-Daten tagsüber reagieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit uses adaptive targets that react to workouts, movement, recovery, meals, and newly available Apple Health data throughout the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa objetivos adaptativos que reaccionan a entrenamientos, movimiento, recuperación, comidas y nuevos datos de Apple Health durante el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit utilise des objectifs adaptatifs qui réagissent aux entraînements, au mouvement, à la récupération, aux repas et aux nouvelles données Apple Health dans la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit usa obiettivi adattivi che reagiscono ad allenamenti, movimento, recupero, pasti e nuovi dati Apple Health durante la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitはワークアウト、移動、回復、食事、新たに利用可能になったApple Healthデータに反応する適応型目標を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 운동, 이동, 회복, 식사, 새로 사용 가능한 Apple Health 데이터에 반응하는 적응형 목표를 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit używa adaptacyjnych celów reagujących na treningi, ruch, regenerację, posiłki i nowe dane Apple Health w ciągu dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit использует адаптивные цели, которые реагируют на тренировки, движение, восстановление, питание и новые данные Apple Health в течение дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 采用自适应目标，这些目标会根据训练、活动、恢复、营养以及 Apple Health 在一天内提供的最新数据动态调整。"
          }
        }
      }
    },
