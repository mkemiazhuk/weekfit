    "coach.scenario.performanceBefore.closeToStart.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sitzung beginnt bald. Beginnen Sie unterhalb der Zielanstrengung und steigern Sie erst, nachdem der erste Block sich leicht anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session starts soon. Start below target effort and build only after the first block feels easy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión empieza pronto. Empiece por debajo del esfuerzo objetivo y suba solo cuando el primer bloque se sienta fácil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
