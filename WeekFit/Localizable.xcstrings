    "coach.copy.startLightThisMorningKeepHydrationSteady.208" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start Licht heute Morgen. Halten Sie die Hydratation stabil und vermeiden Sie es, die Intensität vor der ersten Mahlzeit zu drücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start light this morning. Keep hydration steady and avoid pushing intensity before your first meal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empiece ligero esta mañana. Mantenga hidratación estable y evite apretar intensidad antes de la primera comida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez léger ce matin. Gardez l'hydratation stable et évitez de pousser l'intensité avant votre premier repas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accendi la luce stamattina. Tenere l'idratazione costante ed evitare di spingere l'intensità prima del primo pasto."
