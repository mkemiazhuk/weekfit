    "meals.starter.avocadoToast.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toast das Brot goldbraun und knusprig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toast the bread until golden and crisp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tueste el pan hasta que quede dorado y crujiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites dorer le pain jusqu'à ce qu'il soit croustillant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tosta il pane fino a doratura e croccantezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パンをこんがりカリッとトーストする。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빵을 황금빛으로 바삭하게 토스트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opiecz chleb do złotego, chrupiącego tosta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поджарьте хлеб до золотистой корочки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将面包烤至表面呈金黄色。"
          }
        }
      }
    },
    "meals.starter.avocadoToast.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Avocado mit einer Prise Salz zerdrücken und dick auf den Toast streichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mash the avocado with a pinch of salt and spread it thickly on the toast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machaca el aguacate con una pizca de sal y úntalo generosamente en el toast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrasez l'avocat avec une pincée de sel et étalez-le généreusement sur le toast."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schiaccia l’avocado con un pizzico di sale e spalmalo generosamente sul toast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アボカドを塩ひとつまみでつぶし、トーストに厚く塗る。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아보카도를 소금 한 꼬집으로 으깨어 토스트에 두툼하게 바르세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozgnieć awokado z szczyptą soli i grubo posmaruj tost."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разомните авокадо с щепоткой соли и густо намажьте на тост."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将牛油果与一小撮盐一起捣碎，然后均匀地涂在烤面包片上。"
          }
        }
      }
    },
    "meals.starter.avocadoToast.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eier weich Rührei oder Spiegelei zubereiten und auf die Avocado legen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook the eggs soft-scrambled or sunny-side up, then place them on the avocado."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocine los huevos revueltos suaves o fritos y colóquelos sobre el aguacate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisez les œufs brouillés moelleux ou au plat, puis posez-les sur l'avocat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuoci le uova strapazzate morbide o al tegamino, poi adagiale sull’avocado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卵をソフトスクランブルか目玉焼きにし、アボカドの上にのせる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계란을 부드러운 스크램블이나 프라이로 익혀 아보카도 위에 올리세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usmaż jajka na miękko lub sadzone i połóż na awokado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приготовьте яйца всмятку или глазуньей и выложите поверх авокадо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将鸡蛋炒至嫩炒蛋或单面煎熟，然后将其摆放在牛油果上。"
          }
        }
      }
    },
    "meals.starter.avocadoToast.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Tomatenscheiben toppen und sofort servieren."
          }
