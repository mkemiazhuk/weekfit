    "insights.story.weekendRecovery.action.action" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die Wochenendwachzeit innerhalb von 60 Minuten an Wochentagen für die nächsten 2 Wochenenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep weekend wake time within 60 minutes of weekdays for the next 2 weekends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga la hora de despertar de fin de semana dentro de 60 minutos de los días laborables durante los próximos 2 fines de semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez l'heure de réveil du week-end à 60 minutes des jours ouvrés pendant les 2 prochains week-ends."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenere il fine settimana sveglia entro 60 minuti di giorni feriali per i prossimi 2 fine settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週末は、次の2週末の平日の60分以内にタイムウェイクを保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평일 60 분 이내에 주말 모닝타임을 유지하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj godzinę pobudki w weekendy w granicy 60 minut od dni roboczych przez 2 kolejne weekendy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите время пробуждения в выходные в пределах 60 минут от будней следующие 2 выходных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在接下来的两个周末，将周末起床时间与工作日保持不超过 60 分钟的差异。"
          }
        }
      }
    },
