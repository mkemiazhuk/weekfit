    "coach.humanDecision.keepTheFirstMinutesEasyAndLet.4197" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie die ersten Minuten leicht und lasse Atmung, Tempo und Körperfeedback die Obergrenze bestimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the first minutes easy and let breathing, pacing, and body feedback set the ceiling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén los primeros minutos suaves; respiración, ritmo y señales del cuerpo marcan el techo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez les premières minutes faciles ; respiration, rythme et retour corporel fixent le plafond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga i primi minuti facili e lascia che la respirazione, il ritmo e i segnali del corpo stabiliscano il limite massimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の数分は楽にして、呼吸、歩調、体のフィードバックに天井を任せる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 몇 분은 무리하지 않고 호흡, 페이스, 몸의 피드백이 한계를 설정하게 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwsze minuty łatwo — oddech, tempo i sygnały ciała wyznaczają sufit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первые минуты держите легкими — пусть дыхание, темп и самочувствие подскажут, сколько сегодня давать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前几分钟保持轻松状态，让呼吸、节奏把控及身体反馈来设定强度上限。"
          }
        }
      }
    },
