    "coach.priority.theNextDecisionIsBetterMadeAfter.5140": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next decision is better made after recovery, not in the middle of the night."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее решение лучше принять после восстановления, а не среди ночи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来的决定最好在恢复之后做出，而非在深夜时分。"
          }
