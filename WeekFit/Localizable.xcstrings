    "support.guides.item12.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokollieren ist für echte Dinge, die tagsüber passiert sind — Kaffee, Wasser, Mahlzeiten, Workouts, Erholung, Sauna, Atmung, Dehnen oder Schlaf-Routinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logging is for real things that happened during the day — coffee, water, meals, workouts, recovery, sauna, breathing, stretching, or sleep routines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar es para lo que realmente ocurrió durante el día: café, agua, comidas, entrenamientos, recuperación, sauna, respiración, estiramientos o rutinas de sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement concerne ce qui s'est réellement passé dans la journée — café, eau, repas, entraînements, récupération, sauna, respiration, étirements ou routines de sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il logging è per ciò che è realmente accaduto — caffè, acqua, pasti, allenamenti, recupero, sauna, respirazione, stretching o routine sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録はその日に実際に起きたこと — コーヒー、水、食事、ワークアウト、回復、サウナ、呼吸、ストレッチ、睡眠ルーティンなど — のためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록은 하루에 실제로 일어난 일 — 커피, 물, 식사, 운동, 회복, 사우나, 호흡, 스트레칭, 수면 루틴 등 — 을 위한 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logowanie dotyczy tego, co naprawdę wydarzyło się w ciągu dnia — kawa, woda, posiłki, treningi, regeneracja, sauna, oddychanie, rozciąganie lub rutyny snu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логирование — для реальных событий дня: кофе, воды, еды, тренировок, восстановления, сауны, дыхания, растяжки или рутин сна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日志记录用于记录白天发生的实际事项——咖啡、饮水、用餐、锻炼、恢复、桑拿、呼吸、拉伸或睡眠习惯。"
          }
        }
      }
    },
