          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水质数据"
          }
        }
      }
    },
    "insights.vm.learnings.absorbingWorkload.textFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Recovery stayed stable, suggesting your body is absorbing the workload well."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Восстановление оставалось стабильным — организм хорошо поглощает нагрузку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@Recovery保持稳定，表明您的身体正在很好地吸收工作量。"
          }
        }
      }
    },
    "insights.vm.learnings.absorbingWorkload.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is absorbing your workload"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление поглощает вашу нагрузку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复过程会消耗您的体能储备。"
          }
        }
      }
    },
    "insights.vm.learnings.adjacent.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main story is clear enough to act on, but adjacent sleep, recovery, training or nutrition patterns need more overlap before they become separate discoveries."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Главная история достаточно ясна для действий, но смежным паттернам сна, восстановления, тренировок или питания нужно больше пересечения, прежде чем они станут отдельными открытиями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心故事对于行动而言已足够清晰，但若要使与睡眠、恢复、训练或营养相关的辅助模式产生更多交集，这些模式方能成为独立的突破点。"
          }
        }
      }
    },
    "insights.vm.learnings.adjacent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The supporting context is still forming"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживающий контекст ещё формируется"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持性语境仍在逐步形成。"
          }
        }
      }
    },
    "insights.vm.learnings.loadPressing.textFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Recovery is not keeping pace, so the issue looks like load management rather than motivation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Восстановление не успевает — проблема скорее в управлении нагрузкой, чем в мотивации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@Recovery没有跟上步伐，因此问题看起来是负载管理而不是动机。"
          }
        }
      }
    },
    "insights.vm.learnings.loadPressing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training load is pressing recovery"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировочная нагрузка давит на восстановление"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练负荷会阻碍身体恢复。"
          }
        }
      }
    },
    "insights.vm.learnings.nutritionUnclear.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutrition has too few logged days to explain recovery changes. It should stay supporting context until logging is steadier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком мало записанных дней питания, чтобы объяснить изменения восстановления. Пока записи не станут стабильнее, это лишь контекст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "营养记录天数过少，尚不足以解释恢复情况的变化；在记录数据趋于稳定之前，营养分析仍应仅作为背景支持。"
          }
        }
      }
    },
    "insights.vm.learnings.nutritionUnclear.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutrition patterns are not clear yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Паттерны питания пока неясны"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "营养模式尚不明确。"
          }
        }
      }
    },
    "insights.vm.learnings.patternForming.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough overlapping sleep, recovery, training and nutrition data yet to make a personal discovery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока недостаточно пересекающихся данных о сне, восстановлении, тренировках и питании для личного открытия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前，关于睡眠、恢复、训练及营养方面的交叉数据仍不足，难以用于个人突破。"
          }
        }
      }
    },
    "insights.vm.learnings.patternForming.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pattern is still forming"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Паттерн ещё формируется"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模式仍在形成中。"
          }
        }
      }
    },
    "insights.vm.learnings.recoveryStable.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery has enough history and is holding steady, so changes in sleep or training can be interpreted more clearly."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно истории восстановления, и оно держится стабильно — изменения сна или тренировок можно интерпретировать яснее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复期已具备足够的历史基础且保持稳定，因此对睡眠或训练变化的解读将更为清晰。"
          }
        }
      }
    },
    "insights.vm.learnings.recoveryStable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is your most stable signal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление — ваш самый стабильный сигнал"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复——是您最可靠的信号"
          }
        }
      }
    },
    "insights.vm.learnings.recoveryWatch.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery has enough history to be useful, but it is not yet stable enough to ignore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истории восстановления достаточно для пользы, но оно ещё недостаточно стабильно, чтобы его игнорировать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该恢复机制已具备足够的历史基础以发挥效用，但其稳定性尚不足以被忽略。"
          }
        }
      }
    },
    "insights.vm.learnings.recoveryWatch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is the signal to watch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление — сигнал, за которым стоит следить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复是一个值得关注的信号"
          }
        }
      }
    },
    "insights.vm.learnings.shortSleep.textFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days after 7h+ sleep average about +%lld recovery points compared with short-sleep nights."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни после 7+ ч сна в среднем дают около +%lld баллов восстановления по сравнению с ночами короткого сна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与短睡眠夜相比，睡眠时长≥7小时者在数日后平均可获得约%lld个恢复点。"
          }
        }
      }
    },
    "insights.vm.learnings.shortSleep.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery drops most after short sleep"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление сильнее всего падает после короткого сна"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短期睡眠后，恢复程度下降最为明显。"
          }
        }
      }
    },
    "insights.vm.learnings.sleepBase.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep is becoming a stable base"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон становится стабильной базой"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠已成为稳定的基础。"
          }
        }
      }
    },
    "insights.vm.learnings.sleepBelowTarget.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep remains below target often enough that it is the clearest bottleneck to test next."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон часто ниже цели — это самое явное узкое место для проверки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预期结果往往低于目标值——这是验证过程中最明显的薄弱环节。"
          }
        }
      }
    },
    "insights.vm.learnings.sleepConsistent.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep is consistent enough to support recovery rather than explain current problems."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон достаточно стабилен, чтобы поддерживать восстановление, а не объяснять текущие проблемы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这种状态相当稳定，足以支撑恢复进程，而非解释当前出现的问题。"
          }
        }
      }
    },
    "insights.vm.learnings.sleepImproved.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep has improved recently, which may give recovery more room to stay strong."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон недавно улучшился — это может дать восстановлению больше запаса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠质量近期有所改善——这或可为身体恢复提供更多储备。"
          }
        }
      }
    },
    "insights.vm.learnings.sleepLever.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep is the clearest recovery lever"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон — самый явный рычаг восстановления"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠是恢复最显著的途径。"
          }
        }
      }
    },
    "insights.vm.opportunity.keepRhythm.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is already strong enough that the next useful lesson is which habit keeps it stable when training changes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление уже достаточно сильное — следующий полезный урок: какая привычка держит его стабильным при изменении тренировок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复情况已经相当显著——接下来值得关注的要点是：在训练计划调整期间，哪种习惯能帮助他保持稳定状态。"
          }
        }
      }
    },
    "insights.vm.opportunity.keepRhythm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the rhythm steady"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите ритм стабильным"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持节奏稳定"
          }
        }
      }
    },
    "insights.vm.opportunity.nutritionVisible.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More complete meal logging would show whether food is actually influencing recovery or just adding noise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более полная запись блюд покажет, влияет ли еда на восстановление или только добавляет шум."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更详尽的膳食记录将有助于判断食物是否真正促进了恢复，抑或仅引入了干扰因素。"
          }
        }
      }
    },
    "insights.vm.opportunity.nutritionVisible.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make nutrition visible enough to learn from"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте питание достаточно видимым для анализа"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让营养信息足够直观，以便从中汲取经验。"
          }
        }
      }
    },
    "insights.vm.opportunity.proveLoad.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next improvement is likely to come from absorbing the current training load, not adding more volume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее улучшение скорее придёт от усвоения текущей нагрузки, а не от добавления объёма."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来的提升更多源于对当前负荷的掌握，而非增加负荷量。"
          }
        }
      }
    },
    "insights.vm.opportunity.proveLoad.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let recovery prove the load is working"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте восстановлению подтвердить, что нагрузка работает"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过恢复过程验证负载是否正常运行。"
          }
        }
      }
    },
    "insights.vm.opportunity.sleepBottleneck.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding 30-45 minutes of sleep is more likely to improve recovery than adding another workout right now."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить 30–45 минут сна сейчас вероятнее улучшит восстановление, чем ещё одна тренировка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比现在增加一次训练，增加 30-45 分钟的睡眠更有可能促进恢复。"
          }
        }
      }
    },
    "insights.vm.opportunity.sleepBottleneck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep is the next bottleneck to test"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон — следующее узкое место для проверки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠是下一个需要检查的关键环节。"
          }
        }
      }
    },
    "insights.vm.progression.betterDistribution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next level is better distribution: keep volume similar and spread hard efforts across the week."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий уровень — лучшее распределение: сохраните объём и распределите тяжёлые усилия по неделе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个阶段是优化分配：保持工作量不变，将高强度任务合理分配到一周内。"
          }
        }
      }
    },
    "insights.vm.progression.buildThreeHours": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next level is building toward three hours of weekly activity before chasing intensity."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий уровень — выйти на три часа еженедельной активности, прежде чем гнаться за интенсивностью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个阶段是先实现每周三小时的活动量，然后再逐步提升活动强度。"
          }
        }
      }
    },
    "insights.vm.progression.controlledSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next level is one more controlled session or a small intensity bump, only if recovery stays stable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий уровень — ещё одна контролируемая сессия или небольшой рост интенсивности, только если восстановление стабильно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
