    "coach.priority.valueStartsValueKeepTheDayPointed.4502": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starts %@. Keep the day pointed at the work, not the clock."
          }
        },
        "ru": {
          "stringUnit": {
