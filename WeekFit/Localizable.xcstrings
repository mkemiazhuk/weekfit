    "coach.priority.noSingleBlockerIsLoudKeepFood.4434" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein einzelner Blocker ist laut. Halten Sie Essen, Getränke und Intensität ruhig, damit der Tag sauber endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No single blocker is loud. Keep food, fluids, and intensity calm so the day finishes cleanly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún bloqueador único destaca. Mantenga comida, líquidos e intensidad calmados para cerrar el día limpio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun frein unique ne domine. Gardez nourriture, fluides et intensité calmes pour finir la journée proprement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun blocco singolo è rumoroso. Mantenga cibo, liquidi e intensità calmi in modo che la giornata finisca pulita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのブロッカーも大きな音を立てません。食べ物や飲み物、活動の強度は穏やかに保ち、一日を清らかに終えましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 막는 것도 시끄럽지 않습니다. 음식과 음료, 활동 강도를 차분하게 유지하여 하루를 깔끔하게 마무리하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden pojedynczy bloker nie krzyczy. Trzymaj jedzenie, płyny i intensywność spokojnie, by dzień zakończył się czysto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет одного громкого блокера. Держите еду, воду и интенсивность спокойными, чтобы день завершился чисто."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有任何一种阻断剂会产生剧烈反应。请保持饮食、液体摄入及运动强度稳定，以确保当天结束得顺利。"
          }
        }
      }
    },
