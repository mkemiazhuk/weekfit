    "challenge.recovery7.day5.partialNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach weiter, wenn du kannst. Der nächste Tag ist eine neue Aufgabe - keine Notwendigkeit, verbleibende Pausen zusammenzupacken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep going when you can. The next day is a fresh task — no need to cram remaining breaks together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga cuando pueda. El día siguiente es una tarea nueva; no hace falta acumular pausas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez quand vous le pouvez. Le jour suivant est une nouvelle tâche — inutile de rattraper toutes les pauses d'un coup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua a camminare quando puoi. Il giorno successivo è un compito fresco — non c'è bisogno di ammassare le pause rimanenti insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたができるとき、行ってください。 翌日は新鮮なタスクです。残りの休憩を一緒に残す必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신이 할 때 계속. 다음 날은 신선한 작업입니다 - cram 나머지는 함께 휴식 할 필요가 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontynuuj, gdy możesz. Kolejny dzień to nowe zadanie — nie trzeba nadganiać przerw naraz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжай, когда получится. Завтра — новая задача; не нужно сжимать оставшиеся паузы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
