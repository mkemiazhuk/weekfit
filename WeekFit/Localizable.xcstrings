    "coach.humanDecision.becauseTheActiveSessionIsUnclearFinish.490" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weil die aktive Einheit unklar ist, mit Reserve beenden statt den ursprünglichen Plan zu beweisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because the active session is unclear, finish with reserve instead of proving the original plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como la sesión activa no está clara, termina con reserva en lugar de demostrar el plan original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme la séance active est floue, terminez avec de la marge au lieu de prouver le plan initial."
