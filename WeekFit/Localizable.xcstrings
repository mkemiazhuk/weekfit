    "coach.priority.givenValueValueMayExceedWhatYou.4860": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Given %@, %@ may exceed what you can recover from. I would protect tonight and be ready to swap tomorrow's %@ work for recovery if readiness is still low."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С учетом %@, %@ может быть выше того, от чего вы успеете восстановиться. Сегодня я бы сохранил вечер спокойным и был готов заменить завтрашнюю %@ работу на восстановление, если готовность останется низкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鉴于%@的情况，%@可能超出您可恢复的范围。我今晚会采取防护措施，若准备度仍较低，则可将明日的%@工作替换为恢复操作。"
          }
        }
      }
    },
    "coach.priority.giveTheBodyMaterialToRepairThe.2134": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the body material to repair the work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте телу материал, чтобы восстановить сделанную работу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供修复所需的材料。"
          }
        }
      }
    },
    "coach.priority.goodExecutionIsCoachingTooKeepThe.3597": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good execution is coaching too: keep the session useful without turning it into extra stress."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошее выполнение — тоже работа тренера: держите тренировку полезной, без лишнего стресса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "良好的执行同样属于教练技巧：在确保课程有效性的同时，避免将其变成额外的压力源。"
          }
        }
      }
    },
    "coach.priority.goodPreparationStartsBeforeTheOfficialPrep.4506": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good preparation starts before the official prep window: avoid spending energy you want available later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошая подготовка начинается до официального окна: не тратьте энергию, которая понадобится позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充分的准备应从正式准备期之前就开始：避免消耗那些你希望留待之后使用的精力。"
          }
        }
      }
    },
    "coach.priority.goodReadinessIsUsefulButTheBest.3558": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good readiness is useful, but the best sessions still begin with a calm opening."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошая готовность полезна, но лучшие тренировки все равно начинаются спокойно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "良好的准备固然有益，但最理想的会谈仍应从平静的开场开始。"
          }
        }
      }
    },
    "coach.priority.goodWindowToday.4263": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good window today"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня хорошее окно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天天气不错"
          }
        }
