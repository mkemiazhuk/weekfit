    "planner.confirm.activityMessageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haben Sie abgeschlossen %@ Oder sollten wir es als übersprungen markieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you complete %@, or should we mark it as skipped?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Completó %@ o debemos marcarlo como omitido?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avez-vous terminé %@ , ou devons-nous le marquer comme ignoré ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai completato %@ o dovremmo segnarlo come saltato?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お問い合わせ %@ 、または、スキップしてマークする必要がありますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 완료 %@ , 또는 우리는 Skipped로 표시해야 합니까?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy ukończyłeś %@ , czy oznaczyć jako pominięte?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выполнили %@ или отметить как пропущенное?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已完成%@，还是我们应该将其标记为跳过？"
          }
        }
      }
    },
