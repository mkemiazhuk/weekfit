        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление показывает, устойчив ли текущий ритм тренировок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复期可评估当前训练节奏是否稳定。"
          }
        }
      }
    },
