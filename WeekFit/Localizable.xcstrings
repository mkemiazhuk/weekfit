    "coach.humanDecision.heatIsStillAheadTodaySoHydration.3506" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute bleibt es noch heiß, daher ist Hydration wichtig, weil sie beeinflusst, wie stressig dieser Saunagang sich anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heat is still ahead today, so hydration matters because it changes how stressful that sauna block feels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calor sigue por delante hoy; la hidratación importa porque cambia el estrés de ese bloque de sauna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaleur est encore à venir aujourd’hui ; l’hydratation compte car elle change le stress de ce bloc sauna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il caldo è ancora davanti a noi oggi, quindi l'idratazione è importante perché cambia quanto stressante sembra quel blocco di sauna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はまだ暑さが続くので、水分補給が重要です。なぜなら、それがサウナの時間のストレスの感じ方を変えるからです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘도 더위가 예상되므로, 수분 섭취가 중요합니다. 수분 상태에 따라 사우나 구간이 얼마나 힘들게 느껴지는지가 달라지기 때문입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciepło wciąż przed tobą dziś — nawodnienie ma znaczenie, bo zmienia stres tego bloku sauny."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тепло еще впереди, поэтому вода важна: она меняет, насколько тяжелым будет блок сауны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天仍将持续高温，因此补水至关重要，因为它会影响您在桑拿时段内的不适感。"
          }
        }
      }
    },
