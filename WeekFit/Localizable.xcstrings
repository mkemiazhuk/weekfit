    "coach.humanDecision.lettingFoodSettleProtectsTheStartWithout.3331" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Setzenlassen von Nahrung schützt den Start, ohne die Verdauung zu belasten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letting food settle protects the start without adding digestive stress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejar asentar la comida protege el inicio sin estrés digestivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisser le repas se stabiliser protège le départ sans stress digestif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasciare che il cibo si assesti protegge l'inizio senza aggiungere stress digestivo."
