    "coach.humanDecision.readinessSupportsTheValueTheUsefulMove.3157" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereitschaft unterstützt das %@ . Der nützliche Schritt besteht darin, angekommen und gefestigt zu sein, nicht den Plan frühzeitig zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Readiness supports the %@. The useful move is arriving settled, not changing the plan early."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposición apoya el %@ . Lo útil es llegar asentado, no cambiar el plan pronto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposition soutient le %@ . Le mouvement utile est d’arriver posé, pas de changer le plan tôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La preparazione supporta il %@ . La mossa utile è arrivare preparati, non cambiare il piano presto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備は %@ を支援します。役に立つ動きは、計画を早く変えるのではなく、落ち着いて到着することです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비 상태는 %@ 를 지원합니다. 유용한 조치는 계획을 일찍 바꾸는 것이 아니라, 계획대로 도착하는 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotowość wspiera %@ . Użyteczny ruch to spokojne przyjście, nie wczesna zmiana planu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовность поддерживает %@. Сейчас полезнее подойти спокойно, а не менять план заранее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备状态支持%@。正确的做法是稳步推进，而非过早改变计划。"
          }
        }
      }
    },
