    "recovery.stressIndex.calculation.bodyFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stress Index kombiniert verfügbare Signale wie %@. Jedes Signal wird mit Ihrer eigenen letzten Baseline verglichen und nicht mit Bevölkerungsdurchschnitten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index combines available signals such as %@. Each signal is compared with your own recent baseline rather than population averages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index combina señales disponibles como %@ . Cada señal se compara con su propia referencia reciente en lugar de promedios poblacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Stress Index combine les signaux disponibles tels que %@ . Chaque signal est comparé à votre propre référence récente plutôt qu'aux moyennes populationnelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo Stress Index combina segnali disponibili come %@. Ogni segnale è confrontato con la vostra linea di base recente piuttosto che con la media della popolazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Indexは、%@などの利用可能な信号を組み合わせます。各シグナルは、母集団の平均ではなく、あなたの最近のベースラインと比較されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index는 %@와 같은 사용 가능한 신호를 결합합니다. 각 신호는 인구 평균이 아닌 최근 기준과 비교됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index łączy dostępne sygnały, takie jak %@ . Każdy sygnał jest porównywany z własną ostatnią linią bazową, a nie ze średnimi populacyjnymi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индекс нагрузки объединяет доступные сигналы, такие как %@. Каждый сигнал сравнивается с вашим собственным недавним базовым уровнем, а не со средними по популяции."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负荷指数整合了可用的信号，例如 %@。每个信号均与您自身的近期基准值进行比较，而非与群体平均值进行比较。"
          }
        }
      }
    },
