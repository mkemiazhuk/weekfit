    "coach.priority.itIsEveningAndNoActivitiesRemain.4153" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist Abend und heute bleiben keine Aktivitäten mehr übrig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is evening and no activities remain today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es tarde-noche y no quedan actividades hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est le soir et il ne reste plus d'activités aujourd'hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È sera e oggi non rimangono attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕方で、今日の活動は残っていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저녁이고 오늘은 남은 활동이 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wieczór i nie ma już aktywności na dziś."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас вечер, и активностей на сегодня больше нет."
          }
        },
        "zh-Hans" : {
