    "support.faq.item05.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit zeigt Daten, die bereits in Apple Health vorhanden sind. Prüfen Sie Health-Berechtigungen und stellen Sie sicher, dass Apple Health Daten für den gewählten Tag hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit shows data that already exists in Apple Health. Check Health permissions and make sure Apple Health has data for the selected day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit muestra datos que ya existen en Apple Health. Revise permisos de Health y que Apple Health tenga datos del día seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit affiche les données déjà présentes dans Apple Health. Vérifiez les autorisations Health et que Apple Health contient des données pour le jour sélectionné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit mostra dati già presenti in Apple Health. Controlla i permessi Salute e assicurati che Apple Health abbia dati per il giorno selezionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitはApple Healthにすでにあるデータを表示します。Healthの権限を確認し、選択した日のデータがApple Healthにあることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 Apple Health에 이미 있는 데이터를 표시합니다. Health 권한을 확인하고 선택한 날짜의 데이터가 Apple Health에 있는지 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit pokazuje dane już obecne w Apple Health. Sprawdź uprawnienia Health i czy Apple Health ma dane dla wybranego dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit показывает данные, которые уже есть в Apple Health. Проверьте разрешения Health и убедитесь, что в Apple Health есть данные за выбранный день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 显示的是 Apple Health 中已存在的数据。请检查 Health 应用的权限，并确保 Apple Health 中已包含所选日期的相关数据。"
          }
        }
      }
    },
