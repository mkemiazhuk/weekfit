    "support.faq.item06.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nein. Sie können WeekFit ohne Apple Watch nutzen. Schlaf, Workouts, Erholung und Aktivitätsdaten können jedoch fehlen oder ungenauer sein, was Coach-Einblicke und Empfehlungen beeinflussen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. You can use WeekFit without Apple Watch. But sleep, workouts, recovery, and activity data may be missing or less accurate, which can affect coaching insights and recommendations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Puede usar WeekFit sin Apple Watch. Pero sueño, entrenamientos, recuperación y actividad pueden faltar o ser menos precisos, lo que afecta perspectivas y recomendaciones de Entrenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non. Vous pouvez utiliser WeekFit sans Apple Watch. Mais sommeil, entraînements, récupération et activité peuvent manquer ou être moins précis, ce qui peut affecter les aperçus et recommandations du Coach."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Puoi usare WeekFit senza Apple Watch. Ma sonno, allenamenti, recupero e attività possono mancare o essere meno accurati, influenzando insight e raccomandazioni del Coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いいえ。Apple WatchなしでもWeekFitは使えます。ただし睡眠、ワークアウト、回復、アクティビティデータが不足したり精度が下がったりし、コーチの洞察やおすすめに影響することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아니요. Apple Watch 없이도 WeekFit을 사용할 수 있습니다. 다만 수면, 운동, 회복, 활동 데이터가 없거나 덜 정확해 코치 인사이트와 추천에 영향을 줄 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie. Możesz używać WeekFit bez Apple Watch. Sen, treningi, regeneracja i aktywność mogą jednak być niepełne lub mniej dokładne, co wpływa na wglądy i rekomendacje Trener."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет. WeekFit можно использовать без Apple Watch. Но данные сна, тренировок, восстановления и активности могут отсутствовать или быть менее точными, что влияет на инсайты Тренера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不。您无需 Apple Watch 也可使用 WeekFit。但睡眠、训练、恢复及活动相关数据可能会缺失或准确性降低，进而影响训练指导中的洞察与建议。"
          }
        }
      }
    },
