    "coach.eveningRecap.feeling.reaction.good.quiet" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut, dass sich der Tag in Ordnung anfühlte. Ein ruhiges Finish genügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glad the day felt okay. A quiet finish is enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me alegra que el día haya ido bien. Un cierre tranquilo basta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content que la journée ait été correcte. Une fin calme suffit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felice che la giornata si sia sentita bene. Basta un finale tranquillo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日が沈むと大丈夫。 静かな仕上がりは十分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날이 잘 느낀다. 조용한 마무리는 충분합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień był w porządku — spokojne zakończenie wystarczy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хорошо, что день прошёл спокойно. Тихого завершения достаточно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很高兴今天感觉还好。安静收尾就够了。"
          }
        }
      }
    },
