    "support.faq.item28.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming ist später heute. Live passiert jetzt. Pending heißt, die geplante Zeit ist vorbei. Done heißt, in WeekFit abgeschlossen. Synced heißt, aus Apple Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming is later today. Live is happening now. Pending means the planned time already passed. Done means you completed it in WeekFit. Synced means it came from Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximo: más tarde hoy. En vivo: ocurre ahora. Pendiente: la hora planificada pasó. Hecho: completado en WeekFit. Sincronizado: de Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À venir : plus tard aujourd'hui. En direct : en cours. En attente : l'heure planifiée est passée. Terminé : complété dans WeekFit. Synchronisé : venu d'Apple Health."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming è più tardi oggi. Live è in corso. Pending significa che l’orario pianificato è passato. Done completato in WeekFit. Synced da Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcomingは今日の後半。Liveは今進行中。Pendingは予定時刻を過ぎた状態。DoneはWeekFitで完了。SyncedはApple Health由来。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming은 오늘 이후. Live는 지금 진행 중. Pending은 예정 시간이 지남. Done은 WeekFit에서 완료. Synced는 Apple Health에서."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadchodzące: później dziś. Na żywo: trwa teraz. Oczekujące: planowana godzina minęła. Gotowe: ukończone w WeekFit. Zsynchronizowane: z Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предстоит — позже сегодня. Сейчас — происходит сейчас. Ожидает — запланированное время уже прошло. Выполнено — завершено в WeekFit. Синхронизировано — импортировано из Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即将到来 —— 今日稍后。正在发生 —— 当前正在进行的动作。已预期 —— 预定时间已过去。已完成 —— 已在 WeekFit 中完成。已同步 —— 已从 Apple Health 导入。"
          }
        }
      }
    },
