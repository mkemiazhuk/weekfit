    "coach.insight.waterIsAlreadyCoveredMineralSupportIs.420" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasser ist bereits abgedeckt. Mineralische Unterstützung ist ein besserer nächster Schritt als mehr einfaches Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water is already covered. Mineral support is a better next step than more plain water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agua ya está cubierta. El apoyo mineral es mejor siguiente paso que más agua simple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eau est déjà couverte. Le soutien minéral est une meilleure prochaine étape que plus d'eau pure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acqua è già coperta. Il supporto minerale è un passo successivo migliore rispetto a più acqua naturale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水はすでに確保されています。ミネラル補給は、さらに水を飲むよりも次の良いステップです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물은 이미 충분히 섭취했습니다. 추가로 물을 마시는 것보다 미네랄 보충이 더 나은 다음 단계입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woda jest już ogarnięta. Wsparcie mineralne to lepszy następny krok niż więcej czystej wody."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воды уже достаточно. Лучше добавить минералы, чем пить еще больше обычной воды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水分已经足够，与其多喝普通水，不如补充矿物质。"
          }
        }
      }
    },
