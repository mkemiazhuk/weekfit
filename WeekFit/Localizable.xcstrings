          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come funziona Coach?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーチはどう動きますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코치는 어떻게 동작하나요?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak działa Trener?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как работает Тренер?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练是如何工作的？"
          }
        }
      }
    },
    "support.faq.item36.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach betrachtet Aktivität, Hydration, Erholung, Timing und Routinen. Nach leichter Bewegung oder Erholung kann es einfache Aktionen wie Hydration oder Ruhe vorschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach looks at your activity, hydration, recovery, timing, and routines. After light movement or recovery activities, it may suggest simple actions like hydration or rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenador revisa actividad, hidratación, recuperación, horarios y rutinas. Tras movimiento ligero o recuperación puede sugerir hidratación o descanso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach examine activité, hydratation, récupération, timing et routines. Après un mouvement léger ou une activité de récupération, il peut suggérer hydratation ou repos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach analizza attività, idratazione, recupero, tempistiche e routine. Dopo movimento leggero o recupero può suggerire azioni semplici come idratazione o riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーチはアクティビティ、水分、回復、タイミング、ルーティンを見ます。軽い運動や回復の後、水分や休息などシンプルな提案をすることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코치는 활동, 수분, 회복, 타이밍, 루틴을 봅니다. 가벼운 움직임이나 회복 후 수분이나 휴식 같은 간단한 행동을 제안할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trener patrzy na aktywność, nawodnienie, regenerację, timing i rutyny. Po lekkim ruchu lub regeneracji może zasugerować wodę lub odpoczynek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренер смотрит на активность, воду, восстановление, время и рутины. После легкого движения или восстановления он может предложить простые действия вроде воды или отдыха."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练会评估您的活动情况、水分补充状况、恢复情况、时机选择及日常习惯。在完成轻度活动或恢复性活动后，教练可能会建议采取简单的措施，例如补充水分或休息。"
          }
        }
      }
    },
    "support.faq.item36.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum schlägt Coach Wasser oder Tee vor?"
          }
