    "support.faq.item22.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahlzeiten ermöglicht eigene Gerichte, Zutatenkombinationen und Ernährungsplanung rund um Workouts, Erholung und Routinen — mit Schätzungen für Kalorien, Protein, Kohlenhydrate und Fette."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meals lets you create your own dishes, combine ingredients, and plan nutrition around workouts, recovery, and daily routines. WeekFit gives estimates for calories, protein, carbs, and fats to help you stay aware of your nutrition without making tracking feel overwhelming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comidas le permite crear platos, combinar ingredientes y planificar nutrición alrededor de entrenamientos, recuperación y rutinas. WeekFit estima calorías, proteína, carbohidratos y grasas para conciencia sin agobio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repas permet de créer vos plats, combiner ingrédients et planifier la nutrition autour entraînements, récupération et routines. WeekFit estime calories, protéines, glucides et lipides pour une prise de conscience sans surcharge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasti ti permette di creare piatti, combinare ingredienti e pianificare nutrizione intorno ad allenamenti, recupero e routine, con stime di calorie, proteine, carboidrati e grassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事では自分の料理を作り、材料を組み合わせ、ワークアウト、回復、ルーティンに合わせて栄養を計画できます — カロリー、タンパク質、炭水化物、脂質の推定付き。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사에서 직접 요리를 만들고 재료를 조합하며 운동, 회복, 루틴에 맞춰 영양을 계획할 수 있습니다 — 칼로리, 단백질, 탄수화물, 지방 추정 포함."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiłki pozwala tworzyć własne dania, łączyć składniki i planować odżywianie wokół treningu, regeneracji i rutyn. WeekFit szacuje kalorie, białko, węglowodany i tłuszcze, by śledzenie nie było przytłaczające."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блюда позволяет создавать собственные блюда, комбинировать ингредиенты и планировать питание вокруг тренировок, восстановления и рутины. WeekFit дает оценки калорий и макроэлементов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "膳食功能让您能够自制菜肴、组合食材，并围绕训练、恢复与日常作息规划营养。WeekFit 会给出卡路里、蛋白质、碳水化合物和脂肪的估算，帮您了解营养状况，又不会让记录变得负担过重。"
          }
        }
      }
    },
