    "settings.account.appleReplaceLocal.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in with Apple starts a separate account workspace on this device. Your current local plan, meals, and preferences will be removed. This cannot be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход с Apple откроет отдельное пространство аккаунта на этом устройстве. Текущий локальный план, приёмы пищи и настройки будут удалены. Это нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple 登录将在该设备上启用独立的账户空间。当前的本地设置、饮食选项及配置功能将被移除。此变更不可撤销。"
          }
        }
      }
    },
    "settings.account.appleReplaceLocal.primary": {
