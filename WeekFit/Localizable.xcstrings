    "coach.priority.useTimeAwareProgressNotTheFull.2038": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use time-aware progress, not the full-day target."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ориентируйтесь на прогресс по времени, а не на цель за весь день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以时间进度为导向，而非以全天目标为导向。"
          }
        }
      }
    },
    "coach.priority.valueIsNotTheProblemTheCeiling.3010": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not the problem; the ceiling is. Poor sleep makes intensity expensive today, so start easier and be willing to turn this into easier work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — не проблема; проблема в потолке. Плохой сон делает интенсивность дорогой сегодня, поэтому начните легче и будьте готовы превратить это в более легкую работу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@不是问题；天花板是。如今，睡眠不足会使强度变得昂贵，因此，从轻松开始，并愿意将其转化为更轻松的工作。"
          }
        }
      }
    },
    "coach.priority.valueStartsValue.1906": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starts %@"
