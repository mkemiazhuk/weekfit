    "support.faq.item07.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status gibt einen einfachen Überblick über Aktivität, Ernährung, Erholung, Schlaf, Hydration und Apple Health-Daten tagsüber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status gives a simple overview of your activity, nutrition, recovery, sleep, hydration, and Apple Health data throughout the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status ofrece una vista simple de actividad, nutrición, recuperación, sueño, hidratación y datos de Apple Health durante el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status donne un aperçu simple de votre activité, nutrition, récupération, sommeil, hydratation et données Apple Health dans la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status offre una panoramica semplice di attività, nutrizione, recupero, sonno, idratazione e dati Apple Health durante la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Statusは、一日を通じたアクティビティ、栄養、回復、睡眠、水分、Apple Healthデータの概要をシンプルに示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status는 하루 동안 활동, 영양, 회복, 수면, 수분, Apple Health 데이터를 간단히 보여줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status daje prosty przegląd aktywności, odżywiania, regeneracji, snu, nawodnienia i danych Apple Health w ciągu dnia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статус дня дает простой обзор активности, питания, восстановления, сна, гидратации и данных Apple Health в течение дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「每日状态」功能可为您全天内的活动、营养摄入、恢复情况、睡眠、水分补充以及 Apple Health 数据提供简明概览。"
          }
        }
      }
    },
