    "insights.vm.learnings.patternForming.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt noch nicht genug überlappende Schlaf-, Erholungs-, Trainings- und Ernährungsdaten, um eine persönliche Entdeckung zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is not enough overlapping sleep, recovery, training and nutrition data yet to make a personal discovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay solapamiento suficiente de sueño, recuperación, entrenamiento y nutrición para un descubrimiento personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas encore assez de recoupement entre sommeil, récupération, entraînement et nutrition pour une découverte personnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'è abbastanza sovrapposizione di sonno, recupero, formazione e dati nutrizionali ancora per fare una scoperta personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠、回復、トレーニング、栄養データを個人的な発見をするために十分に重ねることができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠, 회복, 훈련 및 영양 자료가 아직 개인적인 발견을 만들기 위해 충분하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma jeszcze wystarczającego nakładania snu, regeneracji, treningu i odżywiania, by wyciągnąć osobiste odkrycie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока недостаточно пересекающихся данных о сне, восстановлении, тренировках и питании для личного открытия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前，关于睡眠、恢复、训练及营养方面的交叉数据仍不足，难以用于个人突破。"
          }
        }
      }
    },
