    "recovery.stressIndex.confidence.low.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Early signals suggest a category, but there is not enough recent data for a precise Stress Index yet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранние сигналы позволяют оценить категорию, но для точного индекса нагрузки пока недостаточно данных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
