          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights necesita más solapamiento de sueño, recuperación, entrenamiento y nutrición antes de clasificar historias."
          }
        },
        "fr" : {
          "stringUnit" : {
