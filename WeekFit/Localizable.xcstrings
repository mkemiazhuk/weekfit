    "support.faq.item15.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein basiert hauptsächlich auf Körpergewicht und Ihrem Ziel. Fette nutzen einen Prozentsatz Ihres Kalorienziels. Kohlenhydrate werden aus den verbleibenden Kalorien nach Protein und Fetten berechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein is mainly based on body weight and your selected goal. Fats use a percentage of your calorie target. Carbs are calculated from the remaining calories after protein and fats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La proteína se basa sobre todo en peso corporal y su objetivo. Las grasas usan un porcentaje del objetivo calórico. Los carbohidratos salen de las calorías restantes tras proteína y grasas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les protéines reposent surtout sur le poids corporel et votre objectif. Les lipides utilisent un pourcentage de l'objectif calorique. Les glucides viennent des calories restantes après protéines et lipides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le proteine dipendono principalmente da peso e obiettivo. I grassi usano una percentuale del target calorico. I carboidrati dal resto dopo proteine e grassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タンパク質は主に体重と選択した目標に基づきます。脂質はカロリー目標の一定割合です。炭水化物はタンパク質と脂質の後の残りカロリーから計算されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단백질은 주로 체중과 목표에 기반합니다. 지방은 칼로리 목표의 비율을 사용합니다. 탄수화물은 단백질·지방 이후 남은 칼로리에서 계산됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Białko opiera się głównie na masie ciała i celu. Tłuszcze to procent celu kalorycznego. Węglowodany liczone są z kalorii pozostałych po białku i tłuszczach."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Белок в основном зависит от веса тела и выбранной цели. Жиры берутся как доля от цели калорий. Углеводы рассчитываются из оставшихся калорий после белков и жиров."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蛋白质摄入量主要根据您的体重及设定的目标来确定；脂肪摄入量则基于您设定的热量目标百分比计算；碳水化合物摄入量则根据蛋白质与脂肪摄入后剩余的热量来推算。"
          }
        }
      }
    },
