    "settings.account.deleteConfirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht Ihr WeekFit-Konto und WeekFit-Daten dauerhaft. Dies kann nicht rückgängig gemacht werden. Apple Health-Daten bleiben in Apple Health. Systemberechtigungen (Apple Health, Standort, Mitteilungen) bleiben bestehen, bis Sie sie in iOS-Einstellungen → WeekFit (und Quellen in der Health-App) deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes your WeekFit account and WeekFit data. This cannot be undone.\n\nApple Health data stays in Apple Health.\n\nSystem permissions (Apple Health, Location, Notifications) stay until you turn them off in iOS Settings → WeekFit (and Sources in the Health app)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente su cuenta de WeekFit y los datos de WeekFit. Esta acción no se puede deshacer.\n\nLos datos de Apple Health permanecen en Apple Health.\n\nLos permisos del sistema (Apple Health, Ubicación, Notificaciones) se mantienen hasta que los desactive en Ajustes de iOS → WeekFit (y Fuentes en la app Salud)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime définitivement votre compte WeekFit et vos données WeekFit. Cette action est irréversible. Les données Apple Health restent dans Apple Health. Les autorisations système (Apple Health, Localisation, Notifications) restent actives jusqu'à ce que vous les désactiviez dans Réglages iOS → WeekFit (et Sources dans l'app Santé)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente il tuo account WeekFit e i dati WeekFit. Non è reversibile. I dati Apple Health restano in Apple Health. I permessi di sistema (Apple Health, Posizione, Notifiche) restano finché non li disattivi in Impostazioni iOS → WeekFit (e Sorgenti nell’app Salute)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitアカウントとWeekFitデータを完全に削除します。元に戻せません。 Apple HealthのデータはApple Healthに残ります。 システムの権限（Apple Health、位置情報、通知）は、iOSの設定 → WeekFit（およびヘルスアプリのソース）でオフにするまで有効のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 계정과 WeekFit 데이터가 영구적으로 삭제됩니다. 되돌릴 수 없습니다. Apple Health 데이터는 Apple Health에 남습니다. 시스템 권한(Apple Health, 위치, 알림)은 iOS 설정 → WeekFit(및 건강 앱의 소스)에서 끌 때까지 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To trwale usuwa konto WeekFit i dane WeekFit. Tej operacji nie można cofnąć.\n\nDane Apple Health pozostają w Apple Health.\n\nUprawnienia systemowe (Apple Health, Lokalizacja, Powiadomienia) pozostają aktywne, dopóki nie zostaną wyłączone w Ustawieniach iOS → WeekFit (oraz w Źródłach w app Zdrowie)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это навсегда удалит ваш аккаунт WeekFit и данные WeekFit. Действие нельзя отменить.\n\nДанные Apple Health останутся в Apple Health.\n\nСистемные разрешения (Apple Health, геолокация, уведомления) останутся, пока вы не отключите их в Настройки iOS → WeekFit (и в Источники в приложении Здоровье)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除你的 WeekFit 账户和 WeekFit 数据。此操作无法撤销。\n\nApple 健康中的数据仍保留在 Apple 健康中。\n\n系统权限（Apple 健康、定位、通知）会保留，直到你在 iOS 设置 → WeekFit（以及健康 App 的数据源）中关闭它们。"
          }
        }
      }
    },
