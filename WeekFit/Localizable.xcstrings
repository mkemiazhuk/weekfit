    "highlights.story.sleepRecoveryUp.bodyFormat" : {
      "comment" : "Monthly highlight body. The argument is the sleep consistency increase percentage.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Schlafrhythmus wurde durch %lld%% konsistenter, was dazu beitrug, dass sich Ihre Erholung stabilisierte und effizient wieder auf die Beine kam, während das Training konstant blieb."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sleep schedule became more consistent by %lld%%, helping your recovery stabilize and bounce back efficiently while training stayed steady."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su horario de sueño se volvió más consistente un %lld %%, ayudando a estabilizar la recuperación mientras el entrenamiento se mantuvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre horaire de sommeil est devenu plus régulier de %lld %%, aidant votre récupération à se stabiliser et rebondir efficacement tandis que l'entraînement est resté stable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo programma del sonno è diventato più coerente entro il %lld%%, aiutando il tuo recupero a stabilizzarsi e a riprendersi in modo efficiente mentre l'allenamento è rimasto stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% までに睡眠スケジュールがより安定し、トレーニングを安定させながら回復が安定し、効率的に回復するのに役立ちました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%%로 수면 일정이 더욱 일관되게 되어 훈련을 꾸준하게 유지하면서 회복이 안정되고 효율적으로 회복되는 데 도움이 되었습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harmonogram snu stał się bardziej regularny o %lld %%, co pomogło stabilizować regenerację, podczas gdy trening pozostał stały."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расписание сна стало стабильнее на %lld%%, помогая восстановлению стабилизироваться и эффективнее возвращаться к норме при ровной тренировочной нагрузке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠规律性提高了 %lld%%，有助于身体恢复稳定状态，并在保持恒定训练负荷时更有效地回归正常生理状态。"
          }
        }
      }
    },
    "highlights.story.sleepRecoveryUp.headline" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung wurde berechenbarer"
          }
        },
        "en" : {
