    "coach.rationale.protectMainEffort.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist die wichtigste Belastung heute. Halten Sie dieses %2$@ locker, damit Sie Beine und Energievorrat für die Haupteleistung schonen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is the key workload today. Keep this %2$@ relaxed so you preserve legs and fueling for the main effort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es la carga clave hoy. Mantenga este %2$@ relajado para preservar piernas y combustible para el esfuerzo principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est la charge clé aujourd’hui. Gardez ce %2$@ détendu pour préserver jambes et alimentation pour l’effort principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è il carico di lavoro chiave oggi. Mantieni questo %2$@ rilassato in modo da preservare le gambe e l'energia per lo sforzo principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の主要な負荷は%1$@です。この%2$@はリラックスした状態に保ち、脚や主要な努力に向けたエネルギーを温存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@는 오늘의 핵심 작업량입니다. 이 %2$@를 편안하게 유지하여 다리와 주요 노력에 필요한 에너지를 보존하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ to dziś kluczowe obciążenie. Utrzymuj ten %2$@ na luzie, by zachować nogi i paliwo na główny wysiłek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — главная нагрузка сегодня. Держите %2$@ спокойно, чтобы сохранить силы и качество движения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@是当今的关键工作负载。让这款%2$@保持放松，这样您就可以保留双腿，为主要工作加油。"
          }
        }
      }
    },
    "coach.rationale.protectMainEffort.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
