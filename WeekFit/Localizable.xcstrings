          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите тренировку легкой и не добавляйте лишний стресс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
