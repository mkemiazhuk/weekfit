    "highlights.story.rhythmNeedsAttention.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung, Aktivität und Schlaf sind in diesem Monat gesunken. WeekFit beobachtet, ob dies ein kurzer Dip oder ein Muster ist, das mehr Wiederherstellungsunterstützung benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery, activity, and sleep moved lower this month. WeekFit is watching whether this is a short dip or a pattern that needs more recovery support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación, actividad y sueño bajaron este mes. WeekFit observa si es un bache breve o un patrón que necesita más apoyo de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération, activité et sommeil ont baissé ce mois-ci. WeekFit observe si c'est une baisse courte ou un schéma nécessitant plus de soutien à la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero, l'attività e il sonno si sono spostati più in basso questo mese. WeekFit sta guardando se si tratta di un breve tuffo o di un modello che ha bisogno di più supporto di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復、活動、睡眠は今月下に移動しました。 WeekFitは、より回復サポートを必要とする短いすくいかパターンであるかどうかを見ています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복, 활동, 수면은 이번 달을 낮춥니다. WeekFit는 짧은 딥 또는 더 많은 복구 지원이 필요한 패턴인지 볼 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja, aktywność i sen spadły w tym miesiącu. WeekFit obserwuje, czy to krótki spadek, czy wzorzec wymagający wsparcia regeneracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление, активность и сон снизились в этом месяце. WeekFit отслеживает, это краткий спад или паттерн, которому нужна поддержка восстановления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本月，恢复能力、活动量及睡眠时长均有所下降。WeekFit 正在监测这一短暂下滑或特定模式，该模式可能需要恢复支持。"
          }
        }
      }
    },
