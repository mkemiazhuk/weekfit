        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartości to szacunki na podstawie zapisanych posiłków.\\nZapisuj wszystko, aby uzyskać lepszą dokładność."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значения являются оценками на основе записанных приемов пищи.\nДля лучшей точности записывайте все."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些数值是基于记录的膳食摄入情况得出的评估值。\n为确保准确性，请记录所有信息。"
          }
        }
      }
    },
