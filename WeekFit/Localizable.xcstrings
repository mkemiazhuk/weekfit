          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘와 계획의 차이는?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaka jest różnica między Dziś a Plan?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем отличаются Сегодня и План?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“今日”与“计划”有何不同？"
          }
        }
      }
    },
    "support.faq.item04.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan hilft, Dinge im Voraus zu organisieren. Protokollieren ist für Dinge, die tagsüber bereits passiert sind — wie Mahlzeiten, Kaffee, Wasser, Workouts, Erholung oder Schlaf-Routinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan helps you organize things ahead of time. Logging is for things that already happened during the day — like meals, coffee, water, workouts, recovery, or sleep routines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan ayuda a organizar con antelación. Registrar es para lo que ya ocurrió: comidas, café, agua, entrenamientos, recuperación o rutinas de sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan aide à organiser à l'avance. L'enregistrement concerne ce qui s'est déjà passé — repas, café, eau, entraînements, récupération ou routines de sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piano aiuta a organizzare in anticipo. Il logging è per ciò che è già accaduto durante la giornata — pasti, caffè, acqua, allenamenti, recupero o routine del sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランは事前の整理に役立ちます。記録は、その日にすでに起きたこと — 食事、コーヒー、水、ワークアウト、回復、睡眠ルーティンなど — のためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획은 미리 정리하는 데 도움이 됩니다. 기록은 하루 동안 이미 일어난 일 — 식사, 커피, 물, 운동, 회복, 수면 루틴 등 — 을 위한 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan pomaga organizować z wyprzedzeniem. Logowanie dotyczy tego, co już się stało — posiłków, kawy, wody, treningów, regeneracji lub rutyn snu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "План помогает заранее организовать дела. Логирование — для того, что уже произошло в течение дня: еды, кофе, воды, тренировок, восстановления или рутин сна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计划功能可帮助您提前整理各项事务；而日志记录功能则用于记录当天已发生的事项——例如用餐、饮用咖啡与饮水、锻炼、恢复活动或睡眠习惯等。"
          }
        }
      }
    },
