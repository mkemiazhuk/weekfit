    "coach.priority.todayHasAlreadyTakenALotIf.2749" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute hat schon viel gekostet. Wenn sich heute Nacht nichts ändert, wird %@ wahrscheinlich mehr kosten, als es einbringt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today has already taken a lot. If nothing changes tonight, %@ is likely to cost more than it gives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy ya ha exigido mucho. Si esta noche no cambia nada, %@ probablemente cueste más de lo que aporta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La journée a déjà demandé beaucoup. Si rien ne change ce soir, %@ risque de coûter plus qu’il n’apporte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi ha già preso molto. Se niente cambia stanotte, %@ probabilmente costerà più di quanto dia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はすでに多くを奪った。今夜何も変わらなければ、 %@ は与える以上のコストがかかる可能性が高い。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 이미 많은 것을 가져갔다. 오늘 밤 아무것도 바뀌지 않는다면, %@ 는 주는 것보다 더 많은 비용이 들 가능성이 있다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień już wiele wymagał. Jeśli dziś wieczorem nic się nie zmieni, %@ prawdopodobnie kosztuje więcej, niż daje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня уже многое забрало силы. Если вечером ничего не изменить, %@ скорее даст больше цены, чем пользы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天已经消耗很多。若今晚没有改变，%@可能代价大于收益。"
          }
        }
      }
    },
    "coach.priority.todayIsARecoveryDaySoMovement.3876" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist ein Erholungstag, daher sollte Bewegung die Erholung unterstützen und nicht die Leistung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today is a recovery day, so movement should support recovery instead of performance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy es día de recuperación: el movimiento debe apoyar la recuperación, no el rendimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui est une journée de récupération : le mouvement doit soutenir la récupération plutôt que la performance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi è un giorno di recupero, quindi il movimento dovrebbe supportare il recupero invece delle prestazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は回復の日なので、動きはパフォーマンスではなく回復をサポートするべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 회복하는 날이므로, 운동은 수행이 아니라 회복을 지원해야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś jest dzień regeneracji — ruch powinien wspierać regenerację, a nie wydajność."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня день восстановления, поэтому движение должно помогать восстановиться, а не работать на результат."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天是恢复日，因此运动应助力恢复，而非以追求特定效果为目标。"
          }
        }
      }
    },
    "coach.priority.todaySTrainingLoadIsAlreadyCovered.4580" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heutige Trainingsbelastung ist bereits abgedeckt. Der größte verbleibende Gewinn besteht darin, diese Arbeit regenerierbar zu machen. %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's training load is already covered. The biggest gain left is making that work recoverable.%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de entrenamiento de hoy ya está cubierta. La mayor ganancia restante es hacer ese trabajo recuperable. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge d’entraînement d’aujourd’hui est déjà couverte. Le plus grand gain restant est de rendre ce travail récupérable. %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico di allenamento di oggi è già coperto. Il più grande vantaggio rimasto è rendere quel lavoro recuperabile. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のトレーニング負荷はすでにカバーされています。残された最大の利点は、その作業を回復可能にすることです。 %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 훈련량은 이미 충분히 소화되었습니다. 남은 가장 큰 이득은 그 운동을 회복 가능하게 만드는 것입니다. %@ 세요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiejsze obciążenie treningowe jest już pokryte. Największy zysk to uczynić tę pracę możliwą do regeneracji. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главная тренировочная нагрузка сегодня уже закрыта. Самый большой выигрыш теперь — сделать эту работу восстановимой.%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的主要训练负荷已告一段落。如今最大的收获在于使这项训练具备可恢复性。%@"
          }
        }
      }
    },
    "coach.priority.tomorrowHasAHighLoadSessionRecovery.1642" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgen steht eine intensive Sitzung an. Erholungsentscheidungen heute Abend sind wichtiger als zusätzliche Arbeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomorrow has a high-load session. Recovery decisions tonight matter more than extra work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mañana hay una sesión de alta carga. Las decisiones de recuperación esta noche importan más que trabajo extra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demain comporte une séance à forte charge. Les décisions de récupération ce soir comptent plus que du travail supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domani c'è una sessione ad alta intensità. Le decisioni sul recupero di stasera contano più del lavoro extra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明日は負荷の高いセッションがあります。今夜の回復の判断は、追加の作業よりも重要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일은 고강도 세션이 있습니다. 오늘 밤 회복 결정이 추가 운동보다 더 중요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutro jest sesja o dużym obciążeniu. Decyzje regeneracyjne dziś wieczorem są ważniejsze niż dodatkowa praca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завтра тренировка с высокой нагрузкой. Сегодня вечером решения для восстановления важнее дополнительной работы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明天将进行高强度训练。今晚，恢复方案比额外训练更为重要。"
          }
        }
      }
    },
