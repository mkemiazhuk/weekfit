    },
    "coach.priority.aFoodMealIsCurrentlyActive.3767": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A food meal is currently active."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас идет прием пищи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前有一项餐食活动正在进行中。"
          }
        }
      }
    },
    "coach.priority.aHardPlanOnlyWorksWhenThe.1690": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard plan only works when the body can absorb it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжелый план работает только когда тело способно его усвоить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有当身体能够吸收时，严苛的计划才能奏效。"
          }
        }
      }
    },
    "coach.priority.aHardPushAfterVeryLowSleep.4565": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard push after very low sleep usually gives you cost without the quality that makes training worthwhile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжелый рывок после очень короткого сна обычно дает больше цены, чем качества."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在睡眠严重不足的情况下强行训练，往往只能获得数量而非质量，而缺乏这种质量，训练便失去了意义。"
          }
        }
      }
    },
    "coach.priority.aHardSessionAfterVeryLowSleep.3016": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard session after very low sleep can cost recovery without producing the quality you wanted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжелая тренировка после очень короткого сна может стоить восстановления и не дать нужного качества."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在睡眠严重不足的情况下进行高强度训练，可能会阻碍恢复进程，且无法达到预期的训练效果。"
          }
        }
      }
    },
    "coach.priority.aHardSessionIsEasierToExecute.5084": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard session is easier to execute when energy is available before it starts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжелую тренировку легче выполнить, когда энергия есть до старта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果在开始之前已储备充足能量，那么高强度训练 session 将更容易完成。"
          }
        }
      }
    },
    "coach.priority.aHardSessionJustEndedSoLight.1768": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard session just ended, so light recovery support is still useful."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжелая тренировка только закончилась, поэтому легкая помощь восстановлению все еще полезна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚结束一次高强度训练，因此轻量化的恢复支持仍然很有帮助。"
          }
        }
      }
    },
    "coach.priority.aMealIsActiveSoTheUseful.3752": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meal is active, so the useful coaching move is to anchor the next block around it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас идет прием пищи, поэтому следующий блок лучше строить вокруг него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个动作是活跃的，因此有效的引导技巧是将下一个动作模块围绕该动作进行锚定。"
          }
        }
      }
    },
    "coach.priority.aMeaningfulActivityJustFinished.3623": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meaningful activity just finished."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Важная активность только что завершилась."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一项有意义的活动刚刚结束。"
          }
        }
      }
    },
    "coach.priority.aMeaningfulTrainingSessionIsPlannedLater.4507": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meaningful training session is planned later today."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позже сегодня запланирована важная тренировка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们今天晚些时候计划进行一次有意义的训练会议。"
          }
        }
      }
    },
    "coach.priority.aMissedActivityIsContextNotThe.3802": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A missed activity is context, not the whole day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропущенная активность — это контекст, а не весь день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被错过的活动是指特定情境，而非整一天。"
          }
        }
      }
    },
    "coach.priority.anActivityIsLiveAndNoStronger.3579": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An activity is live and no stronger blocker needs to interrupt it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активность уже идет, и нет более сильного сигнала, который требует вмешательства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某活动处于实时运行状态，且无需更强的阻断器来中断该活动。"
          }
        }
      }
    },
    "coach.priority.aPlannedRecoveryDayIsUsefulSpace.4626": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A planned recovery day is useful space, not a gap to fill with more training."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запланированный день восстановления — это полезное пространство, а не пробел для новой тренировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划中的恢复日应被视为宝贵的缓冲期，而非需要用更多训练来填补的空白。"
          }
        }
      }
    },
    "coach.priority.aRecentSessionMakesRecoveryFuelAnd.3635": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
