        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구가 로드를 증명하자"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól regeneracji udowodnić, że obciążenie działa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте восстановлению подтвердить, что нагрузка работает"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过恢复过程验证负载是否正常运行。"
          }
        }
      }
    },
    "insights.vm.opportunity.sleepBottleneck.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinzufügen von 30-45 Minuten Schlaf ist wahrscheinlicher, die Erholung zu verbessern, als ein weiteres Training jetzt hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding 30-45 minutes of sleep is more likely to improve recovery than adding another workout right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir 30–45 minutos de sueño tiene más probabilidad de mejorar la recuperación que otro entrenamiento ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter 30 à 45 minutes de sommeil est plus susceptible d'améliorer la récupération qu'ajouter un autre entraînement maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere 30-45 minuti di sonno è più probabile per migliorare il recupero che aggiungere un altro allenamento in questo momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30-45分の眠りを追加することは、今別のトレーニングを追加するよりも回復を改善する可能性が高いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면의 30-45 분을 추가하면 이제 다른 운동을 추가하는 것보다 회복을 향상시킬 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodanie 30–45 minut snu ma większą szansę poprawić regenerację niż kolejny trening teraz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить 30–45 минут сна сейчас вероятнее улучшит восстановление, чем ещё одна тренировка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比现在增加一次训练，增加 30-45 分钟的睡眠更有可能促进恢复。"
          }
        }
      }
    },
