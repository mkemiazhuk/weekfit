          "stringUnit" : {
            "state" : "translated",
            "value" : "주요 작업은 끝났습니다. 단백질과 수분을 보충하고 심박을 가라앉히세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Główna praca za Tobą. Zjedz białko, pij wodę i pozwól tętnu opaść."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
