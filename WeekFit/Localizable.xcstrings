        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Энергии не хватает под сегодняшнюю нагрузку. Добавьте простой перекус для восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能量摄入不足是导致您感到疲劳的原因。请补充一份均衡的恢复性零食。"
          }
        }
      }
    },
