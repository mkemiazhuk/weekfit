    "coach.insight.sleepWasShorterThanNeededKeepMeals.440" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf war kürzer als nötig. Halten Sie die Mahlzeiten regelmäßig und vermeide es, das Training heute zu intensiv zu gestalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep was shorter than needed. Keep meals steady and avoid pushing workout intensity today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño fue más corto de lo necesario. Mantenga comidas estables y evite subir la intensidad del entrenamiento hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil était plus court que nécessaire. Gardez des repas stables et évitez de pousser l'intensité d'entraînement aujourd'hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno è stato più breve del necessario. Mantenga costanti i pasti ed evita di aumentare l'intensità dell'allenamento oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は必要より短かった。食事は規則正しく、今日は運動の強度を無理に上げないようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면이 필요보다 짧았습니다. 식사는 일정하게 유지하고 오늘은 운동 강도를 무리하게 높이지 마세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen był krótszy niż potrzeba. Trzymaj posiłki stabilnie i unikaj podbijania intensywności treningu dziś."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сна было меньше, чем нужно. Ешьте ровно и не давите интенсивность сегодня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠不足。今天请规律饮食，不要过度劳累。"
          }
        }
      }
    },
