    "onboarding.v4.ways.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, um heute zu verstehen, zu entscheiden, was als Nächstes kommt, und sich auf morgen vorzubereiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything you need to understand today, decide what's next, and prepare for tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo necesario para entender hoy, decidir qué sigue y preparar mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qu'il faut pour comprendre aujourd'hui, décider la suite et préparer demain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che serve per capire oggi, decidere cosa viene dopo e prepararsi a domani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日を理解し、次を決め、明日に備えるために必要なすべて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘을 이해하고, 다음을 결정하고, 내일을 준비하는 데 필요한 모든 것."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko, by zrozumieć dziś, zdecydować, co dalej, i przygotować jutro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, чтобы понять сегодняшний день, решить, что дальше, и подготовить завтра."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "助您把握今日所需，规划未来方向，并为明日做好准备。"
          }
        }
      }
    },
