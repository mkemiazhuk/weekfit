    "support.faq.item39.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV steht für Herzfrequenzvariabilität. WeekFit nutzt sie als eines mehrerer Erholungssignale aus Apple Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV stands for heart rate variability. WeekFit uses it as one of several recovery signals from Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV significa variabilidad de la frecuencia cardíaca. WeekFit lo usa como una señal de recuperación desde Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV signifie variabilité de la fréquence cardiaque. WeekFit l'utilise comme l'un des signaux de récupération depuis Apple Health."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV indica variabilità della frequenza cardiaca. WeekFit la usa come uno dei segnali di recupero da Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRVは心拍変動（Heart Rate Variability）です。WeekFitはApple Healthからの回復シグナルの一つとして使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV는 심박 변이도입니다. WeekFit은 Apple Health의 여러 회복 신호 중 하나로 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV to zmienność rytmu serca. WeekFit używa tego jako jednego z sygnałów regeneracji z Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV — вариабельность сердечного ритма. WeekFit использует ее как один из сигналов восстановления из Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV 代表心率变异性。WeekFit 将其作为来自 Apple Health 的多个恢复信号之一使用。"
          }
        }
      }
    },
