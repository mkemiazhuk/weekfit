    "coach.priority.recoveryLooksStrongThisMorningBuildThe.2786" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erholung sieht heute Morgen stark aus. Baue die Grundlagen ruhig auf, damit der erste Bewegungsblock angenehm bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery looks strong this morning. Build the basics calmly so the first movement block stays comfortable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación se ve fuerte esta mañana. Construya las bases con calma para que el primer bloque de movimiento siga cómodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération semble solide ce matin. Construisez les bases calmement pour que le premier bloc de mouvement reste confortable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero sembra buono stamattina. Costruisca le basi con calma in modo che il primo blocco di movimento rimanga confortevole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今朝は回復が順調に見えます。最初の動きのブロックが快適でいられるように、基本を落ち着いて構築してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 아침 회복 상태가 좋아 보입니다. 첫 번째 동작 블록이 편안하게 유지되도록 기본을 차분히 구축하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja wygląda dziś rano na mocną. Buduj podstawy spokojnie, by pierwszy blok ruchu pozostał komfortowy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утром восстановление выглядит сильным. Соберите базу спокойно, чтобы первый блок движения остался комфортным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早晨恢复情况良好。请从容地整理基础状态，以确保首个运动环节依然舒适。"
          }
        }
      }
    },
    "coach.priority.recoveryMovementIsCloseButTheCoaching.4369" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erholungsbewegung ist nah, aber der Coaching-Bedarf ist eingeschränkt."
          }
        },
        "en" : {
