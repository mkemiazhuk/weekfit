        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パターンの構築 トレンドのロックを解除するために、数日間眠り、食事、ドリンク、アクティビティをログに記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 본을 건설하십시오. 수면, 식사, 음료 및 활동을 기록하여 트렌드를 잠금 해제하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budowanie wzorców. Loguj sen, posiłki, napoje i aktywności jeszcze kilka dni, by odblokować trendy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формируем ваши паттерны. Записывайте сон, еду, напитки и активность ещё несколько дней, чтобы открыть тренды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立您的模式：继续记录数日的睡眠、饮食、饮水及活动情况，以挖掘趋势规律。"
          }
        }
      }
    },
