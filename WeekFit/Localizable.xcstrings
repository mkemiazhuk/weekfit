    "coach.priority.missingOneBlockDoesNotDefineThe.3814" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fehlen eines Blocks definiert den Tag nicht. Verwenden Sie die nächste nützliche Wahl, um wieder in den Rhythmus zu kommen, ohne zu versuchen, es zurückzuzahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Missing one block does not define the day. Use the next useful choice to get back into rhythm without trying to repay it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perder un bloque no define el día. Use la siguiente elección útil para volver al ritmo sin intentar compensarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manquer un bloc ne définit pas la journée. Utilisez le prochain choix utile pour retrouver le rythme sans essayer de le rembourser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdere un blocco non definisce la giornata. Usi la prossima scelta utile per tornare in ritmo senza cercare di compensarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一つのブロックを逃したからといって、その日が台無しになるわけではありません。取り戻そうとせずに、次の役立つ選択を使ってリズムに戻りましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나의 블록을 놓쳤다고 해서 하루가 좌우되는 것은 아닙니다. 그것을 보상하려고 하지 말고 다음 유용한 선택을 사용하여 리듬을 되찾으세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden pominięty blok nie definiuje dnia. Użyj następnego sensownego wyboru, by wrócić w rytm bez próby spłaty."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один пропущенный блок не определяет весь день. Вернитесь в ритм следующим полезным шагом, без попытки расплатиться за пропуск."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺失一个板块并不意味着当日节奏已失效。请选用下一个合适的选项，以重新找回节奏，而无需刻意弥补缺失。"
          }
        }
      }
    },
