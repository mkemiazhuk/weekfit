        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구는 최근 기본으로 마지막 밤을 비교합니다. 이것은 의료 진단이 아닌 견적입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja porównuje ostatnią noc z ostatnią linią bazową. To szacunek, nie diagnoza medyczna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка восстановления учитывает сон, ВСР и пульс в покое."
