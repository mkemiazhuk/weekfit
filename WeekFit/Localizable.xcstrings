    "coach.copy.energyIntakeAndActivityStrainAreElevated.73" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energieaufnahme und Aktivitätsbelastung sind erhöht. Halten Sie die Nahrung leicht, hydratisieren Sie stetig und schützen Sie die Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energy intake and activity strain are elevated. Keep food light, hydrate steadily, and protect recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ingesta de energía y la carga de actividad están elevadas. Mantenga comida ligera, hidratación constante y proteja la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'apport énergétique et la charge d'activité sont élevés. Gardez les repas légers, hydratez-vous régulièrement et protégez la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'apporto energetico e l'attività sono elevati. Tenere il cibo leggero, idratare costantemente e proteggere il recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギー摂取量と活動負担が上昇します。 食糧ライトを保ち、着実に水和し、回復を保護して下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에너지 섭취 및 활동 변형이 높다. 음식 빛, hydrate 꾸준히 유지하고, 회복을 보호합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobór energii i obciążenie aktywnością są wysokie. Utrzymać lekkie jedzenie, stałe nawodnienie i chronić regenerację."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энергии уже достаточно, а нагрузка повышена. Держите еду легкой, пейте спокойно и не добавляйте лишний стресс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量摄入与活动强度均有所增加。请保持饮食清淡，规律补充水分，并保障身体恢复。"
          }
        }
      }
    },
