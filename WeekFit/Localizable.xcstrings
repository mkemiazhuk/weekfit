    "coach.priority.sleepWasVeryLowSoThisRecovery.4914" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf war sehr gering, daher sollte dieser Erholungsblock einfach bleiben und Ihnen helfen, Sie für heute Abend herunterzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep was very low, so this recovery block should stay easy and help you downshift for tonight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño fue muy bajo; este bloque de recuperación debería mantenerse fácil y ayudarle a bajar revoluciones para esta noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil était très faible ; ce bloc de récupération devrait rester facile et vous aider à redescendre pour ce soir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno è stato molto scarso, quindi questo blocco di recupero dovrebbe rimanere facile e aiutarti a rallentare per stasera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠が非常に少なかったので、この回復ブロックは軽くしておくべきで、今夜に向けてギアを落とすのに役立つはずです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면이 매우 부족했기 때문에 이번 회복 블록은 쉬운 상태로 유지되어 오늘 밤을 위해 속도를 낮추는 데 도움이 되어야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen był bardzo krótki — ten blok regeneracji powinien pozostać lekki i pomóc ci wyciszyć się przed nocą."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сна было очень мало, поэтому этот восстановительный блок должен остаться легким и помочь вам замедлиться к вечеру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠时间非常有限，因此这款恢复型产品应保持轻便，助您在傍晚时分逐渐进入休息状态。"
          }
        }
      }
    },
    "coach.priority.smallActionsShouldBeAcknowledgedWithoutPretending.3709" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine Handlungen sollten anerkannt werden, ohne so zu tun, als hätten sie einen großen Erholungsbedarf verursacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small actions should be acknowledged without pretending they created a major recovery need."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las acciones pequeñas merecen reconocerse sin fingir que generaron una necesidad importante de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les petits gestes méritent d’être reconnus sans prétendre qu’ils créent un besoin majeur de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I piccoli gesti dovrebbero essere riconosciuti senza fingere che abbiano creato un grande bisogno di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さな行動は、重大な回復の必要性を生み出したかのように装わずに認められるべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 행동은 큰 회복 필요를 만들어낸 것처럼 가장하지 않고 인정되어야 한다세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drobne działania warto docenić, nie udając, że stworzyły duże zapotrzebowanie na regenerację."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленькие действия стоит учитывать, но не делать вид, что они создали большую потребность в восстановлении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细微之举值得留意，但切勿假装这些举动已引发了亟需修复的迫切需求。"
          }
        }
