    "coach.scenario.performanceAfter.racketLoad.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Halte den Rest des Tages ruhig, damit die Sitzung keine unnötige Müdigkeit anhäuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Keep the rest of the day easy so the session does not stack unnecessary fatigue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Mantenga el resto del día suave para que la sesión no apile fatiga innecesaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Gardez le reste de la journée facile pour que la séance n’empile pas de fatigue inutile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Tieni il resto della giornata leggero in modo che la sessione non accumuli fatica inutile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ セッションで不必要な疲労が重ならないように、残りの一日は無理せず過ごしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ 세션이 불필요한 피로를 쌓지 않도록 나머지 하루는 가볍게 보내세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Utrzymuj resztę dnia na luzie, by sesja nie dokładała zbędnego zmęczenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ Проведите остаток дня легко, чтобы тренировка не добавила лишнюю усталость."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@保持一天的其余时间轻松，这样会话就不会累积不必要的疲劳。"
          }
        }
      }
    },
