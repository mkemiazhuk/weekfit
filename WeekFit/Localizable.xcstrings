        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last updated: May 2026"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновлено: май 2026"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后更新日期：2026年5月"
          }
        }
      }
    },
    "termsPrivacy.legal.about.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit is a personal training, recovery, nutrition, hydration, sleep, and routine planning app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit — приложение для личного планирования тренировок, восстановления, питания, гидратации, сна и повседневных рутин."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit —— 一款用于个人训练规划、恢复、营养管理、水分补充、睡眠管理及日常生活习惯管理的应用程序。"
          }
        }
      }
    },
    "termsPrivacy.legal.about.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app helps you organize your day, review health-related metrics, and receive coaching-style suggestions before, during, and after workouts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение помогает организовать день, просматривать связанные со здоровьем метрики и получать рекомендации в стиле коучинга до, во время и после тренировок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用程序可帮助您规划每日生活、查看与健康相关的指标，并在训练前、训练期间及训练后获得教练式建议。"
          }
        }
      }
    },
    "termsPrivacy.legal.about.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit is intended for personal wellness, fitness planning, habit tracking, and lifestyle support. It is not intended for emergency use or clinical decision-making."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit предназначен для личного благополучия, фитнес-планирования, отслеживания привычек и поддержки образа жизни. Он не предназначен для экстренных ситуаций или клинических решений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 旨在促进个人健康、制定健身计划、追踪生活习惯以及支持健康生活方式。本产品不适用于紧急状况或临床决策。"
          }
        }
      }
    },
    "termsPrivacy.legal.about.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About WeekFit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О WeekFit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 WeekFit"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthData.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit may use data from Apple Health, Apple Watch, iPhone sensors, and information you enter manually inside the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit может использовать данные из Apple Health, Apple Watch, датчиков iPhone и информацию, которую вы вручную вводите в приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 可利用来自 Apple Health、Apple Watch、iPhone 传感器的数据，以及您手动在应用中输入的信息。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthData.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This may include activity, workouts, sleep, energy, hydration, nutrition, body metrics, recovery-related signals, and other wellness data depending on the permissions you grant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это может включать активность, тренировки, сон, энергию, гидратацию, питание, параметры тела, сигналы восстановления и другие данные о здоровье в зависимости от выданных разрешений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可根据已授予的权限，包括活动量、训练、睡眠、能量水平、水分摄入、营养状况、身体指标、恢复信号以及其他健康相关数据。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthData.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some features may be limited, unavailable, or less accurate if Apple Health access is not granted, if Apple Watch is not used, or if the underlying data is missing, delayed, incomplete, or inaccurate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые функции могут быть ограничены, недоступны или менее точны, если доступ к Apple Health не предоставлен, Apple Watch не используется или исходные данные отсутствуют, задерживаются, неполные или неточные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若未启用 Apple Health、未使用 Apple Watch，或原始数据缺失、延迟、不完整或不准确，则某些功能可能受限、无法使用或精度降低。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthData.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health & Device Data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные Apple Health и устройств"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 健康与设备数据"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthPermissions.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit only accesses Apple Health categories that you explicitly allow through Apple Health permissions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit получает доступ только к тем категориям Apple Health, которые вы явно разрешили в настройках Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 仅可访问您在 Apple Health 设置中明确授权的 Apple Health 分类。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthPermissions.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can review, modify, or revoke Apple Health permissions at any time in the Apple Health app or iOS Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете просмотреть, изменить или отозвать разрешения Apple Health в любое время в приложении Apple Health или настройках iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可随时在 Apple Health 应用中或 iOS 设置中查看、修改或撤销 Apple Health 的授权。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthPermissions.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If permissions are removed, WeekFit may no longer be able to update related metrics, sync completed workouts, personalize Coach suggestions, or show certain insights."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если разрешения удалены, WeekFit может больше не обновлять связанные метрики, синхронизировать завершенные тренировки, персонализировать советы Тренера или показывать отдельные инсайты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若权限被撤销，WeekFit 可能将无法再更新相关指标、同步已完成训练记录、个性化教练建议或显示特定洞察信息。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthPermissions.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health Permissions"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешения Apple Health"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 权限"
          }
        }
      }
    },
    "termsPrivacy.legal.dataUse.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit uses available activity, workout, nutrition, hydration, sleep, recovery, body, and planner data to provide app functionality and personalize your experience."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit использует доступные данные активности, тренировок, питания, гидратации, сна, восстановления, тела и планирования, чтобы обеспечивать функции приложения и персонализировать опыт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 利用现有的活动、训练、营养、水分补充、睡眠、恢复、身体及计划等相关数据，以提供应用程序功能并打造个性化使用体验。"
          }
        }
      }
    },
    "termsPrivacy.legal.dataUse.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data may be used to show metrics, update Plan statuses, import completed workouts, calculate daily context, generate Coach suggestions, support reminders, and help you understand your routine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти данные могут использоваться для отображения метрик, обновления статусов плана, импорта завершенных тренировок, расчета дневного контекста, генерации подсказок Тренера, поддержки напоминаний и помощи в понимании вашей рутины."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些数据可用于展示关键指标、更新计划状态、导入已完成的训练记录、计算每日训练情境、生成教练提示、支持提醒功能，以及帮助您更好地理解日常训练流程。"
          }
        }
      }
    },
    "termsPrivacy.legal.dataUse.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accuracy of insights depends on the accuracy, completeness, and timing of the data available to WeekFit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точность инсайтов зависит от точности, полноты и своевременности данных, доступных WeekFit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内幕消息的准确性取决于 WeekFit 可获取数据的准确性、完整性和及时性。"
          }
        }
      }
    },
    "termsPrivacy.legal.dataUse.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How WeekFit Uses Data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как WeekFit использует данные"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 如何利用数据"
          }
        }
      }
    },
    "termsPrivacy.legal.disclaimer.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit provides general wellness, fitness, recovery, hydration, sleep, and nutrition information for educational and informational purposes only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit предоставляет общую информацию о благополучии, фитнесе, восстановлении, гидратации, сне и питании только в образовательных и информационных целях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 提供的关于身心健康、健身、恢复、水分补充、睡眠及营养的一般性信息，仅用于教育和信息传播目的。"
          }
        }
      }
    },
    "termsPrivacy.legal.disclaimer.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit does not provide medical advice, diagnosis, treatment, prescription, therapy, or professional healthcare services."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit не предоставляет медицинские советы, диагнозы, лечение, рецепты, терапию или профессиональные медицинские услуги."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 不提供医疗建议、诊断、治疗方案、处方、治疗措施或专业医疗服务。"
          }
        }
      }
    },
    "termsPrivacy.legal.disclaimer.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coaching insights, nutrition suggestions, recovery guidance, reminders, activity status, and metric summaries are not a substitute for advice from a doctor, dietitian, physiotherapist, or other qualified professional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коучинговые инсайты, рекомендации по питанию, советы по восстановлению, напоминания, статусы активности и сводки метрик не заменяют консультацию врача, диетолога, физиотерапевта или другого квалифицированного специалиста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练指导、营养建议、恢复指导、提醒信息、活动状态及指标摘要均不能替代医生、营养师、物理治疗师或其他合格专业人士提供的专业建议。"
          }
        }
      }
    },
    "termsPrivacy.legal.disclaimer.p4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always consult a qualified healthcare professional before making health-related decisions, starting a new training program, changing your diet, or relying on app-based guidance if you have any medical condition, injury, pregnancy, medication use, or other health concern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда консультируйтесь с квалифицированным медицинским специалистом перед решениями, связанными со здоровьем, началом новой программы тренировок, изменением питания или использованием рекомендаций приложения, если у вас есть заболевание, травма, беременность, прием лекарств или другие вопросы по здоровью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若您患有任何疾病、受过外伤、处于妊娠期、正在服用药物或存在其他健康顾虑，在做出与健康相关的决定、开始新的训练计划、调整饮食方案或依赖应用程序提供的指导前，请务必咨询具备资质的医疗保健专业人员。"
          }
        }
      }
    },
    "termsPrivacy.legal.disclaimer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health, Fitness & Nutrition Disclaimer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказ от ответственности по здоровью, фитнесу и питанию"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康、健身与营养免责声明"
          }
        }
      }
    },
    "termsPrivacy.legal.notifications.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit may send reminders for planned activities, meals, hydration, recovery routines, completion check-ins, or other app-related actions if you enable notifications."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit может отправлять напоминания о запланированных активностях, приемах пищи, гидратации, восстановительных рутинах, проверках завершения или других действиях в приложении, если вы включите уведомления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若您已开启通知功能，WeekFit 可向您发送关于已安排的活动、进餐、补水、恢复性训练计划、训练完成度检查或其他应用内操作的提醒。"
          }
        }
      }
    },
    "termsPrivacy.legal.notifications.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are optional and can be changed in WeekFit settings or iOS Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления необязательны, их можно изменить в настройках WeekFit или iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知功能为可选功能，可在 WeekFit 设置或 iOS 设置中进行更改。"
          }
        }
      }
    },
    "termsPrivacy.legal.notifications.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder timing may be affected by device settings, Focus modes, notification permissions, and system limitations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время напоминаний может зависеть от настроек устройства, режимов Фокусирования, разрешений уведомлений и системных ограничений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒时间可能取决于设备设置、聚焦模式、通知权限及系统限制。"
          }
        }
      }
    },
    "termsPrivacy.legal.notifications.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications & Reminders"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления и напоминания"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知与提醒"
          }
        }
      }
    },
    "termsPrivacy.legal.privacy.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your health and wellness information remains under your control."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информация о вашем здоровье и благополучии остается под вашим контролем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的健康与福祉相关信息仍由您自主掌控。"
          }
        }
      }
    },
    "termsPrivacy.legal.privacy.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit does not sell personal health information and does not share Apple Health data with advertisers or data brokers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit не продает персональную медицинскую информацию и не передает данные Apple Health рекламодателям или брокерам данных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 不出售个人医疗信息，也不将 Apple Health 相关数据传递给广告主或数据经纪商。"
          }
        }
      }
    },
    "termsPrivacy.legal.privacy.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where possible, data processing is performed on device to reduce unnecessary data transfer and collection."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По возможности обработка данных выполняется на устройстве, чтобы уменьшить ненужную передачу и сбор данных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在可能的情况下，数据处理均在本地设备上进行，以减少不必要的数据传输与数据收集。"
          }
        }
      }
    },
    "termsPrivacy.legal.privacy.p4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If future features require external processing, account services, cloud sync, analytics, or support diagnostics, those features should be disclosed separately and handled according to the app privacy policy and applicable App Store requirements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если будущие функции потребуют внешней обработки, учетных сервисов, облачной синхронизации, аналитики или диагностик поддержки, такие функции должны быть раскрыты отдельно и обрабатываться согласно политике конфиденциальности приложения и требованиям App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若未来功能需要外部处理、账户服务、云同步、分析或支持性诊断，则此类功能应单独披露，并依据应用隐私政策及适用的 App Store 要求进行处理。"
          }
        }
      }
    },
    "termsPrivacy.legal.privacy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & Data Protection"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфиденциальность и защита данных"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私与数据保护"
          }
        }
      }
    },
    "termsPrivacy.legal.retention.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit retains app data only as needed to provide functionality, maintain your plan, show metrics, and personalize the experience."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit хранит данные приложения только в объеме, необходимом для работы функций, поддержания плана, отображения метрик и персонализации опыта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 仅存储应用程序运行所需的功能、计划维护、指标展示及个性化体验所必需的数据量。"
          }
        }
      }
    },
    "termsPrivacy.legal.retention.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting activities, removing permissions, or deleting app data may reduce or remove related features, insights, and historical context."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление активностей, отключение разрешений или удаление данных приложения может уменьшить или убрать связанные функции, инсайты и исторический контекст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除操作、撤销权限或删除应用数据，均可能导致相关功能、洞察及历史上下文减少或消失。"
          }
        }
      }
    },
    "termsPrivacy.legal.retention.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can manage Apple Health permissions at any time through Apple Health or iOS Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете управлять разрешениями Apple Health в любое время через Apple Health или настройки iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可随时通过“Apple Health”或“iOS 设置”管理“Apple Health”的权限。"
          }
        }
      }
    },
    "termsPrivacy.legal.retention.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Retention & Deletion"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранение и удаление данных"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据保留与删除"
          }
        }
      }
    },
    "termsPrivacy.legal.termsOfUse.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By using WeekFit, you agree to use the app only for lawful, personal, non-commercial wellness and fitness purposes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используя WeekFit, вы соглашаетесь применять приложение только для законных, личных, некоммерческих целей благополучия и фитнеса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 WeekFit 即表示您同意仅将该应用程序用于合法、个人且非商业性的健康与健身用途。"
          }
        }
      }
    },
    "termsPrivacy.legal.termsOfUse.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are responsible for your own activity choices, workout intensity, nutrition decisions, hydration habits, recovery approach, and use of any information shown in the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отвечаете за собственный выбор активности, интенсивность тренировок, решения по питанию, привычки гидратации, подход к восстановлению и использование любой информации, показанной в приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您负责自行选择运动项目、设定训练强度、制定饮食方案、养成补水习惯、规划恢复方案，并充分利用应用程序中提供的所有信息。"
          }
        }
      }
    },
    "termsPrivacy.legal.termsOfUse.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit may provide suggestions based on the data available to the app, but those suggestions are not a guarantee of performance, recovery, health, fitness, or wellness results."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit может давать рекомендации на основе доступных приложению данных, но эти рекомендации не гарантируют результаты в производительности, восстановлении, здоровье, фитнесе или благополучии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 可根据应用程序中的可用数据提供建议，但这些建议并不能保证在运动表现、恢复、健康、健身或整体福祉方面取得预期效果。"
          }
        }
      }
    },
    "termsPrivacy.legal.termsOfUse.p4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You should stop any activity and seek appropriate professional help if you feel pain, dizziness, shortness of breath, unusual discomfort, or any other concerning symptoms."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекратите любую активность и обратитесь за профессиональной помощью, если почувствуете боль, головокружение, одышку, необычный дискомфорт или другие тревожные симптомы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如出现疼痛、头晕、呼吸困难、异常不适感或其他警示症状，请立即停止一切活动，并寻求专业医疗帮助。"
          }
        }
      }
    },
    "termsPrivacy.legal.termsOfUse.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms of Use"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Условия использования"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用条款"
          }
        }
      }
    },
    "termsPrivacy.legal.userData.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may add, edit, complete, skip, or delete activities, meals, hydration, recovery routines, sleep routines, and other planned items inside WeekFit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете добавлять, редактировать, завершать, пропускать или удалять активности, приемы пищи, гидратацию, восстановительные рутины, рутины сна и другие запланированные пункты внутри WeekFit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在 WeekFit 中添加、编辑、完成、跳过或删除活动、进餐、补水、恢复性例行事项、睡眠例行事项及其他已规划的项目。"
          }
        }
      }
    },
    "termsPrivacy.legal.userData.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-entered data is used to update your plan, metrics, Coach context, and daily guidance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные, введенные пользователем, используются для обновления плана, метрик, контекста Тренера и ежедневных рекомендаций."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户输入的数据用于更新计划、指标、教练上下文及每日推荐。"
          }
        }
      }
    },
    "termsPrivacy.legal.userData.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are responsible for the accuracy of information you enter manually."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отвечаете за точность информации, которую вводите вручную."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您需对手动输入信息的准确性负责。"
          }
        }
      }
    },
    "termsPrivacy.legal.userData.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-Entered Data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные, введенные пользователем"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户输入的数据"
          }
        }
      }
    },
    "termsPrivacy.legal.warranty.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit is provided as is and as available, without guarantees that the app will always be uninterrupted, error-free, fully accurate, or suitable for every individual situation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit предоставляется как есть и по мере доступности, без гарантий, что приложение всегда будет работать без перебоев, ошибок, с полной точностью или подходить для каждой индивидуальной ситуации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 按现有状态及可获取范围提供，且不保证该应用程序始终能够无故障、无错误地运行，亦不保证其具备完全精度或适用于每种个性化场景。"
          }
        }
      }
    },
    "termsPrivacy.legal.warranty.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health, activity, sleep, nutrition, hydration, and recovery data may be delayed, incomplete, estimated, or unavailable depending on your device, permissions, third-party sources, and Apple Health data availability."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные здоровья, активности, сна, питания, гидратации и восстановления могут задерживаться, быть неполными, оценочными или недоступными в зависимости от устройства, разрешений, сторонних источников и доступности данных Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康、活动、睡眠、营养、水分补充及恢复相关数据可能因所用设备、权限设置、第三方数据源以及 Apple Health 数据可用性而存在延迟、不完整、采用估算值或无法获取的情况。"
          }
        }
      }
    },
    "termsPrivacy.legal.warranty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Warranty"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без гарантий"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不提供保修服务"
          }
        }
      }
    },
