    "coach.narrative.rideAheadFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine %@ Fahrt liegt vor uns. Halten Sie den ersten Teil einfach und finde einen gleichmäßigen Rhythmus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ ride is ahead. Keep the first part easy and settle into a steady rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un paseo en bici %@ por delante. Mantenga la primera parte fácil y entre en un ritmo estable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sortie %@ est devant. Gardez la première partie facile et installez un rythme stable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è una corsa %@ davanti. Mantenga facile la prima parte e stabilisciti in un ritmo costante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これから %@ のライドがあります。最初の部分は楽にして、安定したリズムに乗りましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로 %@ 라이딩이 있습니다. 처음 부분은 쉽게 하고 꾸준한 리듬을 유지하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed tobą jazda %@ . Trzymaj pierwszą część lekko i wejdź w stabilny rytm."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Впереди заезд %@. Начните спокойно и войдите в ровный ритм."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来是%@骑行阶段。前半段保持轻松节奏，逐步进入稳定的骑行节奏。"
          }
        }
      }
    },
    "coach.narrative.runAheadFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein %@ Lauf steht bevor. Starten Sie langsamer, als Sie willst, und steigere nur, wenn sich der Körper gut anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ run is ahead. Start slower than you want to and build only if the body feels good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una carrera %@ por delante. Empiece más lento de lo que quiere y suba solo si el cuerpo se siente bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une course %@ est devant. Partez plus lentement que vous ne le voulez et accélérez seulement si le corps va bien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un %@ corsa è davanti. Inizia più lentamente di quanto desideri e accelera solo se il corpo si sente bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前に %@ のランがあります。思ったより遅めにスタートし、体の調子が良ければペースを上げていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로 %@ 달리기가 있습니다. 원하는 것보다 천천히 시작하고 몸이 좋다고 느껴질 때만 속도를 올리세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed tobą bieg %@ . Startuj wolniej niż chcesz i buduj tempo tylko, gdy ciało czuje się dobrze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Впереди пробежка %@. Начните медленнее, чем хочется, и ускоряйтесь только если тело отвечает хорошо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即将进行%@训练。初始强度应低于你的预期目标，且仅在身体感觉良好时逐步增加强度。"
          }
        }
      }
    },
