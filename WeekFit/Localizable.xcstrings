        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loguj też proste rzeczy"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте простые вещи тоже"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也记录一些简单的事情"
          }
        }
      }
    },
    "support.guides.item18.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Apple Watch oder eine App nutzen, die Workouts in Apple Health schreibt, kann WeekFit abgeschlossene Workouts Ihrem Plan hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you use Apple Watch or another app that writes workouts to Apple Health, WeekFit can add completed workouts to your plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si usa Apple Watch u otra app que escriba entrenamientos en Apple Health, WeekFit puede añadirlos a su plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous utilisez Apple Watch ou une autre app qui écrit les entraînements dans Apple Health, WeekFit peut les ajouter à votre plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usi Apple Watch o un’app che scrive allenamenti in Apple Health, WeekFit può aggiungerli al piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple WatchやApple Healthにワークアウトを書き込むアプリを使うと、WeekFitが完了ワークアウトをプランに追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch나 Apple Health에 운동을 기록하는 앱을 쓰면 WeekFit이 완료 운동을 계획에 추가할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli używasz Apple Watch lub innej aplikacji zapisującej treningi w Apple Health, WeekFit może dodać je do planu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы используете Apple Watch или другое приложение, которое записывает тренировки в Apple Health, WeekFit может добавить завершенные тренировки в ваш план."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您使用 Apple Watch 或其他可将训练记录写入 Apple Health 的应用程序，WeekFit 可将已完成的训练记录添加到您的训练计划中。"
          }
        }
      }
    },
    "support.guides.item18.title" : {
      "extractionState" : "manual",
