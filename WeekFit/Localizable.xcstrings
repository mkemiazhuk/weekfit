    "coach.theMainWorkIsDoneEatProteinDrinkWater" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hauptarbeit ist erledigt. Essen Sie Protein, trinken Sie Wasser und lassen Sie die Herzfrequenz sinken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The main work is done. Eat protein, drink water and let your heart rate settle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo principal está hecho. Coma proteína, beba agua y deje bajar la frecuencia cardíaca."
          }
        },
        "fr" : {
          "stringUnit" : {
