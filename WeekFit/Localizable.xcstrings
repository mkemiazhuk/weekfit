          }
        }
      }
    },
    "coach.humanDecision.theFirst10MinutesMatterMoreThan.473": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first 10 minutes matter more than targets. Let breathing, pacing, and body feedback set the ceiling."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые 10 минут важнее целей: пусть дыхание, темп и самочувствие подскажут, как двигаться дальше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最初的10分钟比目标更重要：让呼吸、节奏和身体感觉来指引你接下来的行进方向。"
          }
        }
      }
    },
    "coach.humanDecision.theGoalIsAUsefulSessionNot.3464": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The goal is a useful session, not proving you can complete the plan unchanged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель — полезная тренировка, а не доказать, что план можно выполнить без изменений."
          }
