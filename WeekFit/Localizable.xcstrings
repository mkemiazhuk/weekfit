    "termsPrivacy.legal.appleHealthData.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit kann Daten aus Apple Health, Apple Watch, iPhone-Sensoren und manuell eingegebenen Informationen nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit may use data from Apple Health, Apple Watch, iPhone sensors, and information you enter manually inside the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit puede usar datos de Apple Health, Apple Watch, sensores del iPhone e información introducida manualmente en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit peut utiliser des données d'Apple Health, d'Apple Watch, des capteurs iPhone et les informations saisies manuellement dans l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit può usare dati da Apple Health, Apple Watch, sensori iPhone e informazioni inserite manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFitはApple Health、Apple Watch、iPhoneセンサー、手入力情報のデータを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit은 Apple Health, Apple Watch, iPhone 센서, 수동 입력 정보 데이터를 사용할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit może korzystać z danych Apple Health, Apple Watch, czujników iPhone oraz informacji wprowadzonych ręcznie w aplikacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit может использовать данные из Apple Health, Apple Watch, датчиков iPhone и информацию, которую вы вручную вводите в приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 可利用来自 Apple Health、Apple Watch、iPhone 传感器的数据，以及您手动在应用中输入的信息。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthData.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dazu können Aktivität, Workouts, Schlaf, Energie, Hydration, Ernährung, Körpermetriken, Erholungssignale und andere Wellness-Daten gehören — je nach erteilten Berechtigungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This may include activity, workouts, sleep, energy, hydration, nutrition, body metrics, recovery-related signals, and other wellness data depending on the permissions you grant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede incluir actividad, entrenamientos, sueño, energía, hidratación, nutrición, métricas corporales, señales de recuperación y otros datos de bienestar según los permisos concedidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut inclure activité, entraînements, sommeil, énergie, hydratation, nutrition, métriques corporelles, signaux de récupération et autres données bien-être selon les autorisations accordées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possono includere attività, allenamenti, sonno, energia, idratazione, nutrizione, metriche corporee, segnali recupero e altri dati wellness, secondo i permessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティ、ワークアウト、睡眠、エネルギー、水分、栄養、体の指標、回復シグナルなど、許可した範囲のウェルネスデータが含まれる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활동, 운동, 수면, 에너지, 수분, 영양, 신체 지표, 회복 신호 등 허용한 웰니스 데이터가 포함될 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może to obejmować aktywność, treningi, sen, energię, nawodnienie, odżywianie, metryki ciała, sygnały regeneracji i inne dane wellness — zależnie od udzielonych uprawnień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это может включать активность, тренировки, сон, энергию, гидратацию, питание, параметры тела, сигналы восстановления и другие данные о здоровье в зависимости от выданных разрешений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这可根据已授予的权限，包括活动量、训练、睡眠、能量水平、水分摄入、营养状况、身体指标、恢复信号以及其他健康相关数据。"
          }
        }
      }
    },
    "termsPrivacy.legal.appleHealthData.p3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Funktionen können eingeschränkt, nicht verfügbar oder ungenauer sein, wenn kein Apple Health-Zugriff besteht, keine Apple Watch genutzt wird oder zugrunde liegende Daten fehlen, verzögert, unvollständig oder ungenau sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some features may be limited, unavailable, or less accurate if Apple Health access is not granted, if Apple Watch is not used, or if the underlying data is missing, delayed, incomplete, or inaccurate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas funciones pueden ser limitadas, no estar disponibles o ser menos precisas si no se concede acceso a Apple Health, no se usa Apple Watch o los datos subyacentes faltan, se retrasan, están incompletos o son inexactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines fonctionnalités peuvent être limitées, indisponibles ou moins précises si l'accès à Apple Health n'est pas accordé, si Apple Watch n'est pas utilisée, ou si les données sous-jacentes manquent, sont retardées, incomplètes ou inexactes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune funzioni possono essere limitate o meno accurate senza Apple Health, senza Apple Watch o se i dati mancano, sono ritardati, incompleti o imprecisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Healthへのアクセスがない、Apple Watchを使わない、基礎データが欠落・遅延・不完全・不正確な場合、一部機能が制限・利用不可・精度低下することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health 접근 없음, Apple Watch 미사용, 기초 데이터 누락·지연·불완전·부정확 시 일부 기능이 제한·미제공·부정확할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre funkcje mogą być ograniczone, niedostępne lub mniej dokładne, jeśli nie udzielono dostępu do Apple Health, nie używa się Apple Watch lub dane są niekompletne, opóźnione albo niedokładne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые функции могут быть ограничены, недоступны или менее точны, если доступ к Apple Health не предоставлен, Apple Watch не используется или исходные данные отсутствуют, задерживаются, неполные или неточные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若未启用 Apple Health、未使用 Apple Watch，或原始数据缺失、延迟、不完整或不准确，则某些功能可能受限、无法使用或精度降低。"
          }
        }
      }
    },
