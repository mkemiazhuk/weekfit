    "insights.vm.learnings.recoveryWatch.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery hat genug Geschichte, um nützlich zu sein, aber es ist noch nicht stabil genug, um zu ignorieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery has enough history to be useful, but it is not yet stable enough to ignore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación tiene historial suficiente para ser útil, pero aún no es lo bastante estable para ignorarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération a assez d'historique pour être utile, mais n'est pas encore assez stable pour l'ignorer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero ha abbastanza storia per essere utile, ma non è ancora abbastanza stabile da ignorare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復には十分な歴史がありますが、無視するのに十分な安定していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복은 유용하기에 충분한 역사를 가지고 있지만 무시하기에 충분히 안정적이지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja ma wystarczającą historię, by być użyteczna, ale nie jest jeszcze na tyle stabilna, by ją ignorować."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истории восстановления достаточно для пользы, но оно ещё недостаточно стабильно, чтобы его игнорировать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该恢复机制已具备足够的历史基础以发挥效用，但其稳定性尚不足以被忽略。"
          }
        }
      }
    },
