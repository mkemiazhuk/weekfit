    "termsPrivacy.legal.notifications.p1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit kann Erinnerungen für geplante Aktivitäten, Mahlzeiten, Hydration, Erholungsroutinen, Abschluss-Check-ins oder andere App-Aktionen senden, wenn Sie Mitteilungen aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit may send reminders for planned activities, meals, hydration, recovery routines, completion check-ins, or other app-related actions if you enable notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit puede enviar recordatorios de actividades planificadas, comidas, hidratación, rutinas de recuperación, comprobaciones de finalización u otras acciones si activa las notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit peut envoyer des rappels pour activités planifiées, repas, hydratation, routines de récupération, contrôles de complétion ou autres actions si vous activez les notifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit può inviare promemoria per attività pianificate, pasti, idratazione, routine recupero, check-in completamento o altre azioni se abiliti le notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知を有効にすると、予定アクティビティ、食事、水分、回復ルーティン、完了チェックインなどのリマインダーを送る場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림을 켜면 예정 활동, 식사, 수분, 회복 루틴, 완료 체크인 등 알림을 보낼 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit może wysyłać przypomnienia o planowanych aktywnościach, posiłkach, nawodnieniu, regeneracji, kontrolach ukończenia i innych działaniach — po włączeniu powiadomień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit может отправлять напоминания о запланированных активностях, приемах пищи, гидратации, восстановительных рутинах, проверках завершения или других действиях в приложении, если вы включите уведомления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若您已开启通知功能，WeekFit 可向您发送关于已安排的活动、进餐、补水、恢复性训练计划、训练完成度检查或其他应用内操作的提醒。"
          }
        }
      }
    },
    "termsPrivacy.legal.notifications.p2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind optional und können in WeekFit-Einstellungen oder iOS-Einstellungen geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are optional and can be changed in WeekFit settings or iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones son opcionales y pueden cambiarse en ajustes de WeekFit o de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont facultatives et peuvent être modifiées dans les réglages WeekFit ou Réglages iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sono opzionali e modificabili in WeekFit o Impostazioni iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知は任意で、WeekFit設定またはiOS設定で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림은 선택 사항이며 WeekFit 설정 또는 iOS 설정에서 변경할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia są opcjonalne i można je zmienić w ustawieniach WeekFit lub iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления необязательны, их можно изменить в настройках WeekFit или iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知功能为可选功能，可在 WeekFit 设置或 iOS 设置中进行更改。"
          }
        }
      }
    },
    "termsPrivacy.legal.notifications.p3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungszeitpunkt kann durch Geräteeinstellungen, Fokusmodi, Mitteilungsberechtigungen und Systemgrenzen beeinflusst werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminder timing may be affected by device settings, Focus modes, notification permissions, and system limitations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El momento de los recordatorios puede verse afectado por ajustes del dispositivo, modos Enfoque, permisos de notificación y limitaciones del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le timing des rappels peut être affecté par les réglages de l'appareil, les modes Concentration, les autorisations de notification et les limites du système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il timing dei promemoria può dipendere da impostazioni dispositivo, Focus, permessi notifiche e limiti di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーのタイミングは、デバイス設定、フォーカス、通知権限、システム制限の影響を受ける場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림 시점은 기기 설정, 집중 모드, 알림 권한, 시스템 제한의 영향을 받을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas przypomnień może zależeć od ustawień urządzenia, trybów Skupienia, uprawnień powiadomień i ograniczeń systemu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время напоминаний может зависеть от настроек устройства, режимов Фокусирования, разрешений уведомлений и системных ограничений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒时间可能取决于设备设置、聚焦模式、通知权限及系统限制。"
          }
        }
      }
    },
