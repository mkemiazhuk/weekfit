    "coach.humanDecision.theDayJustChangedSaunaCanSupport.2008": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day just changed. Sauna can support recovery, but it still adds heat stress before %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День изменился. Сауна может помочь восстановиться, но перед %@ она все равно добавит тепловой стресс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天已经变了。桑拿或许有助于恢复，但在发生 %@ 之前，它仍会引发热应激。"
          }
        }
      }
    },
    "coach.humanDecision.theDecisionThatMattersNowIsArriving.3479": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The decision that matters now is arriving ready, not changing the workout early."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Главное решение сейчас — подойти готовым, а не заранее менять тренировку."
          }
        },
        "zh-Hans": {
