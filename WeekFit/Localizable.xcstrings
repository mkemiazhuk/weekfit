        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将红薯与火鸡及四季豆一同铺在盘中，然后按个人口味调味。"
          }
        }
      }
    },
    "meals.starter.yogurtBerries.step1" : {
