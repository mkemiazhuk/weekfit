    "highlights.story.activityUpRecoveryDown.bodyFormat": {
      "comment": "Monthly highlight body. The argument is the activity increase percentage.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your training volume increased by %lld%%, but your recovery metrics didn't match the output. Your body is running on a temporary deficit, causing your overall readiness to trend downward."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объем тренировок вырос на %lld%%, но метрики восстановления не успели за нагрузкой. Тело временно работает в дефиците, поэтому общая готовность снижается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练量增加了 %lld%%，但恢复指标未能跟上训练强度的提升。身体暂时处于能量不足状态，因此整体恢复能力有所下降。"
          }
        }
      }
    },
    "highlights.story.activityUpRecoveryDown.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity is up, but efficiency is dropping"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активность выросла, но эффективность падает"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "业务量在增加，但效率却在下降。"
          }
        }
      }
    },
    "highlights.story.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit needs at least 20 days of recovery, activity, nutrition, and sleep data before it can synthesize your first monthly story."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit нужно минимум 20 дней данных о восстановлении, активности, питании и сне, чтобы собрать первую месячную историю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekFit 需要至少 20 天的恢复、活动、饮食及睡眠数据，才能生成首月记录。"
          }
        }
      }
    },
