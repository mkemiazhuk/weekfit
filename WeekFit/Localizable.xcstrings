    "onboarding.v2.meaning.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statt zwischen Apps zu wechseln, gibt WeekFit eine klare Antwort für heute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instead of switching between apps, WeekFit gives you one clear answer for today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lugar de cambiar entre apps, WeekFit le da una respuesta clara para hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au lieu de jongler entre les apps, WeekFit vous donne une réponse claire pour aujourd'hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invece di passare tra app, WeekFit ti dà una risposta chiara per oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを行き来する代わりに、WeekFitが今日の明確な答えを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 오가는 대신 WeekFit이 오늘을 위한 명확한 답을 제공합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamiast przełączać aplikacje, WeekFit daje jedną jasną odpowiedź na dziś."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо переключения между приложениями WeekFit даёт один ясный ответ на сегодня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeekFit 不再让您在多个应用之间切换，而是为您提供关于今日的一站式清晰解答。"
          }
        }
      }
    },
