          "stringUnit": {
            "state": "translated",
            "value": "Wear Apple Watch consistently for a few more days to establish your personal baseline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Носите Apple Watch регулярно ещё несколько дней, чтобы сформировать личный базовый уровень."
          }
        },
        "zh-Hans": {
