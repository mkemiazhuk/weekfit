    "coach.rationale.protectTomorrow.messageFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow carries real demand. Keep this %@ easy so today supports recovery instead of borrowing from the next training day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завтра есть реальная нагрузка. Держите эту %@ легкой, чтобы сегодняшний день поддержал восстановление, а не забрал ресурс у следующей тренировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天会有实际训练量。保持这种适度的强度，让今天助力恢复，而不是消耗你下次训练所需的体能。"
          }
        }
      }
    },
    "coach.rationale.protectTomorrow.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect tomorrow"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните силы на завтра"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为明天保留体力"
          }
        }
      }
    },
    "coach.rationale.restorativeDay.messageFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is meant to support recovery. Keep this %2$@ easy so the day stays restorative, not draining."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ должна поддерживать восстановление. Держите эту %2$@ легкой, чтобы день оставался восстановительным, а не истощающим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@旨在支持恢复。保持这款%2$@轻松，让白天保持恢复，而不是消耗。"
          }
        }
      }
    },
