        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让%@变得简单"
          }
        }
      }
    },
    "coach.scenario.performanceBefore.smooth.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short warm-up and easy start should be enough for this session."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткой разминки и легкого старта должно хватить для этой тренировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次训练仅需简短的热身和轻松的起步即可。"
          }
        }
      }
    },
    "coach.scenario.performanceBefore.smooth.title": {
