        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练应将良好的备战状态视为一个契机，而不仅仅是针对缺水或缺粮的情况做出反应。"
          }
        }
      }
    },
    "coach.priority.aCoachShouldUseTheCurrentReal.3766": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
