    "coach.scenario.heatDuring.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitze sollte sich angenehm anfühlen. Beenden Sie die Sitzung frühzeitig, wenn sie sich erschöpfend anfühlt."
          }
        },
        "en" : {
