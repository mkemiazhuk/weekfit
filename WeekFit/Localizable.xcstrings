    "coach.insight.nutritionIsBehindForThisPointOf.869" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ernährung hinkt zu diesem Zeitpunkt des Tages hinterher. Fügen Sie Protein und einfache Energiequellen hinzu, um die Erholung und stabile Energie zu unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutrition is behind for this point of the day. Add protein and simple fuel to support recovery and stable energy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nutrición va retrasada en este punto del día. Añada proteína y combustible simple para recuperación y energía estable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nutrition est en retard à ce stade de la journée. Ajoutez protéines et carburant simple pour la récupération et une énergie stable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nutrizione è indietro a questo punto della giornata. Aggiunga proteine e carburante semplice per supportare il recupero e mantenere energia stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この時間帯の栄養が不足しています。回復と安定したエネルギーをサポートするために、タンパク質と簡単に消化できるエネルギー源を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영양 섭취가 오늘 이 시점까지 부족합니다. 회복과 안정적인 에너지를 위해 단백질과 간단한 연료를 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odżywianie jest w tyle na tym etapie dnia. Dodaj białko i proste paliwo, by wspierać regenerację i stabilną energię."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого времени дня питания маловато. Добавьте белок и простую еду, чтобы телу было легче восстановиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此时，营养摄入至关重要。补充蛋白质及简单能量营养素，以助力身体恢复并维持稳定能量水平。"
          }
        }
      }
    },
    "coach.insight.plainWaterIsAlreadyCoveredFocusOn.182" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reines Wasser ist bereits abgedeckt. Konzentrieren Sie sich stattdessen auf Mineralien, Protein und eine gleichmäßige Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plain water is already covered. Focus on minerals, protein and steady recovery instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agua simple ya está cubierta. Enfóquese en minerales, proteína y recuperación constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eau pure est déjà couverte. Concentrez-vous sur les minéraux, les protéines et une récupération régulière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acqua semplice è già coperta. Concentrati invece su minerali, proteine e recupero costante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水はすでにカバーされています。代わりに、ミネラル、タンパク質、そして安定した回復に注目してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 물은 이미 충분합니다. 대신 미네랄, 단백질, 그리고 꾸준한 회복에 집중하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czysta woda jest już ogarnięta. Skup się na minerałach, białku i spokojnej regeneracji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычная вода уже закрыта. Лучше подумать о минералах, белке и спокойном восстановлении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通饮水已足够，接下来应重点关注矿物质、蛋白质摄入以及稳步恢复。"
          }
        }
      }
    },
