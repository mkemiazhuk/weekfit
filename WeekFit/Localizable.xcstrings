    "support.guides.item03.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status zeigt schnell, wie Ihr Tag läuft. Schauen Sie auf Aktivität, Ernährung und Erholung, um Balance, Leichtigkeit oder hohe Belastung zu erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status gives a quick view of how your day is going. Look at Activity, Nutrition, and Recovery to understand whether the day is balanced, light, or already demanding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status ofrece una vista rápida de su día. Mire Actividad, Nutrición y Recuperación para ver si el día está equilibrado, ligero o ya exigente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status donne une vue rapide de votre journée. Regardez Activité, Nutrition et Récupération pour voir si la journée est équilibrée, légère ou déjà exigeante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status offre una vista rapida della giornata. Guarda Attività, Nutrizione e Recupero per capire equilibrio, leggerezza o carico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Statusで一日の調子を素早く把握。アクティビティ、栄養、回復を見て、バランス、軽め、負荷が高いかを理解します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status로 하루 흐름을 빠르게 봅니다. 활동, 영양, 회복로 균형·가벼움·부담을 파악하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Status daje szybki obraz dnia. Spójrz na Aktywność, Odżywianie i Regeneracja, by zrozumieć, czy dzień jest zrównoważony, lekki czy już wymagający."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статус дня быстро показывает, как идет день. Посмотрите Активность, Питание и Восстановление, чтобы понять, день сбалансированный, легкий или уже требовательный."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“每日状态”功能可让您快速掌握当日状态：通过查看“活动”、“营养”与“恢复”三项指标，即可判断当日生活状态是均衡、轻松，还是已较为繁忙。"
          }
        }
      }
    },
    "support.guides.item03.title" : {
      "extractionState" : "manual",
      "localizations" : {
