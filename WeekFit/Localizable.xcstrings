    "support.faq.item35.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach passt sich tagsüber an Ihre Aktivität, Erholung, Schlaf, Hydration, Mahlzeiten und Routinen an. Vorschläge können sich mit Ihrem Tag ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach adapts throughout the day based on your activity, recovery, sleep, hydration, meals, and routines. Suggestions may change as your day changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenador se adapta durante el día según actividad, recuperación, sueño, hidratación, comidas y rutinas. Las sugerencias pueden cambiar a medida avanza el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach s'adapte dans la journée selon activité, récupération, sommeil, hydratation, repas et routines. Les suggestions peuvent changer au fil de la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach si adatta durante la giornata in base ad attività, recupero, sonno, idratazione, pasti e routine. I suggerimenti possono cambiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーチはアクティビティ、回復、睡眠、水分、食事、ルーティンに基づいて一日を通じて適応します。提案は一日の変化に合わせて変わることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코치는 활동, 회복, 수면, 수분, 식사, 루틴에 따라 하루 종일 적응합니다. 제안은 하루 변화에 따라 바뀔 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trener dostosowuje się w ciągu dnia do aktywności, regeneracji, snu, nawodnienia, posiłków i rutyn. Sugestie mogą się zmieniać wraz z dniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренер адаптируется в течение дня на основе активности, восстановления, сна, гидратации, питания и рутин. Советы могут меняться по мере изменения дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练会根据您的活动情况、恢复状况、睡眠情况、水分补充、饮食及日常作息，在一天之中动态调整指导方案。随着您一天中状态的变化，相关建议也可能相应调整。"
          }
        }
      }
    },
    "support.faq.item35.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie funktioniert Coach?"
          }
        },
        "en" : {
