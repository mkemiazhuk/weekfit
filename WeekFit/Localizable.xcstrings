    "support.faq.item41.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung reagiert auf Schlaf, Workouts, Stress, Hydration, Erholungsaktivitäten und die tägliche Gesamtbelastung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery reacts to sleep, workouts, stress, hydration, recovery activities, and overall daily load."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación reacciona a sueño, entrenamientos, estrés, hidratación, actividades de recuperación y carga diaria global."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération réagit au sommeil, entraînements, stress, hydratation, activités de récupération et charge quotidienne globale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero reagisce a sonno, allenamenti, stress, idratazione, attività di recupero e carico giornaliero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復は睡眠、ワークアウト、ストレス、水分、回復アクティビティ、一日の総負荷に反応します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복은 수면, 운동, 스트레스, 수분, 회복 활동, 하루 전체 부하에 반응합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja reaguje na sen, treningi, stres, nawodnienie, aktywności regeneracyjne i ogólną dzienną obciążenie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление реагирует на сон, тренировки, стресс, гидратацию, восстановительные активности и общую дневную нагрузку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复过程受睡眠、训练、压力、水分补充、恢复性活动及日间总体运动负荷的影响。"
          }
        }
      }
    },
