    "onboarding.v6.begin.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Heute, erfassen Sie Essen und Trinken oder starten Sie eine Aktivität. Coach hält den Tag auf Kurs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Today, log what you eat and drink, or start an activity. Coach will keep the day on track."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Hoy, registre lo que come y bebe o inicie una actividad. Coach mantendrá el día en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Aujourd’hui, consignez ce que vous mangez et buvez ou démarrez une activité. Coach gardera la journée sur les rails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Oggi, registra cosa mangi e bevi o avvia un’attività. Coach terrà la giornata in carreggiata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日を開き、食事と飲み物を記録するかアクティビティを開始。Coachが一日を軌道に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘를 열어 음식과 음료를 기록하거나 활동을 시작하세요. Coach가 하루를 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Dziś, loguj jedzenie i napoje albo rozpocznij aktywność. Coach utrzyma dzień na właściwym torze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Сегодня, залогируйте еду и напитки или запустите активность. Тренер будет держать день в фокусе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启当日记录：记录您的饮食内容，或开始一项活动。教练将协助您确保当日计划顺利推进。"
          }
        }
      }
    },
