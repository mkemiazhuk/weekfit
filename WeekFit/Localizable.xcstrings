    "coach.scenario.performanceDuring.racket.smooth.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege Sie geschmeidig, halte die Atmung gleichmäßig und vermeide es, das Tempo zu früh zu steigern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move smoothly, keep breathing steady and avoid rushing the pace early."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muévase con fluidez, mantenga la respiración estable y evite apresurar el ritmo al inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bougez en fluidité, gardez la respiration stable et évitez de précipiter le rythme tôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muoviti con fluidità, mantieni una respirazione costante ed evita di accelerare il ritmo troppo presto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スムーズに動き、呼吸を安定させ、序盤でペースを急がないようにする。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드럽게 움직이고, 호흡을 안정적으로 유지하며 초반에 속도를 서두르지 마세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poruszaj się płynnie, utrzymuj stabilny oddech i unikaj wczesnego pośpiechu tempa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двигайтесь плавно, держите дыхание ровным и не ускоряйте темп слишком рано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动作流畅，保持呼吸均匀，避免过早加快节奏。"
          }
        }
      }
    },
