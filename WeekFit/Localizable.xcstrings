    "insights.snapshot.fallback.supportCard.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine zuverlässige Baseline ermöglicht es Insights, Durchschnittswerte, Richtung und Änderung zu vergleichen, anstatt Rohprotokollzählungen zu melden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reliable baseline will let Insights compare averages, direction and change instead of reporting raw logging counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una base fiable permitirá a Insights comparar promedios, dirección y cambio en lugar de contar registros brutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une base fiable permettra à Insights de comparer moyennes, direction et changement au lieu de compter les journaux bruts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una linea di base affidabile permetterà a Insights di confrontare le medie, la direzione e il cambiamento invece di segnalare i conti di registrazione raw."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できるベースラインは、Insights は、生のロギングカウントを報告するのではなく、平均、方向、変化を比較します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수있는 기본은 Insights가 평균, 방향 및 변경을 비교 할 수 있도록합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiarygodna baza pozwoli Insights porównywać średnie, kierunek i zmianę zamiast raportować surowe liczby logów."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надёжный базовый уровень позволит Инсайтам сравнивать средние значения, направление и изменения вместо сырых счётчиков записей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
