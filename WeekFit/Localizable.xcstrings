    "insights.view.fallbackSupport.recoveryResponse.activity.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung ist die Überprüfung, ob der aktuelle Trainingsrhythmus nachhaltig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery is the check on whether the current training rhythm is sustainable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación comprueba si el ritmo de entrenamiento actual es sostenible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
