    "recovery.stressIndex.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index schätzt physiologische Belastung aus verfügbaren Gesundheits- und Aktivitätssignalen. Es ist keine medizinische Diagnose."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index estimates physiological strain from available health and activity signals. It is not a medical diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index estima la tensión fisiológica a partir de señales de salud y actividad disponibles. No es un diagnóstico médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Stress Index estime la tension physiologique à partir des signaux de santé et d'activité disponibles. Ce n'est pas un diagnostic médical."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index stima lo strain fisiologico dai segnali salute e attività disponibili. Non è una diagnosi medica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Indexは利用可能な健康・活動シグナルから生理的負荷を推定します。医学的診断ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index는 사용 가능한 건강·활동 신호로 생리적 부담을 추정합니다. 의학적 진단이 아닙니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress Index szacuje obciążenie fizjologiczne na podstawie dostępnych sygnałów zdrowia i aktywności. To nie diagnoza medyczna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индекс нагрузки оценивает физиологическую нагрузку по доступным сигналам здоровья и активности. Это не медицинский диагноз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负荷指数根据可用的健康与活动信号估算生理负荷，并非医学诊断。"
          }
        }
      }
    },
