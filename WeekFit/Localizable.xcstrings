    "nutrition.details.quality.subtitle.pastDay" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Punktzahl basiert auf protokolliertem Protein, Kohlenhydraten, Fetten, Ballaststoffen und der allgemeinen Ernährungsbilanz für diesen Tag."
