          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrivare sistemato per il caldo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱に落ち着くために到着する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도착해서 열에 정착하다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyjdź spokojny na upał"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подойдите к теплу спокойно"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抵达后已安顿好，准备应对高温。"
          }
        }
      }
    },
    "coach.rationale.digestionEasy.messageFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist der nächste nützliche Reset. Halte dieses %2$@ einfach, damit Appetit und Verdauung stabil bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is the next useful reset. Keep this %2$@ easy so appetite and digestion stay steady."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es el siguiente reinicio útil. Mantenga este %2$@ suave para que apetito y digestión sigan estables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est la prochaine pause utile. Gardez ce %2$@ facile pour stabiliser l’appétit et la digestion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è il prossimo reset utile. Mantieni questo %2$@ leggero in modo che appetito e digestione rimangano stabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は次に有用なリセットです。この %2$@ を簡単に保ち、食欲と消化を安定させましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@는 다음 유용한 리셋입니다. %2$@을 쉽게 유지하여 식욕과 소화가 안정되도록 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ to następny użyteczny reset. Utrzymuj ten %2$@ na łatwym poziomie, by apetyt i trawienie były stabilne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — сейчас полезный вариант. Держите %2$@ легкой, чтобы аппетит и пищеварение оставались стабильными."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@是下一个有用的重置。保持这款%2$@轻松，让食欲和消化保持稳定。"
          }
        }
      }
    },
