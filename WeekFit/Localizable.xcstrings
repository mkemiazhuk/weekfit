        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "急な問題は注意を払っていません。 食糧、水および動きを安定した保って下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴급한 문제점은 주의를 요구하지 않습니다. 음식, 물 및 운동을 지키십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden pilny problem nie wymaga uwagi. Utrzymać jedzenie, wodę i ruch na stałym poziomie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас нет срочного сигнала. Держите еду, воду и движение ровными."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前没有需要紧急处理的问题。请保持饮食、饮水及活动量稳定。"
          }
        }
      }
    },
