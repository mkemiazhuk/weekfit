    "support.guides.item11.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming ist später heute. Live passiert jetzt. Pending heißt, die geplante Zeit ist vorbei. Done heißt in WeekFit abgeschlossen. Synced heißt aus Apple Health importiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming means later today. Live means happening now. Pending means the planned time passed. Done means completed in WeekFit. Synced means imported from Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximo es más tarde hoy. En vivo es ahora. Pendiente significa que la hora planificada pasó. Hecho es completado en WeekFit. Sincronizado es importado desde Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À venir signifie plus tard aujourd'hui. En direct signifie en cours. En attente signifie que l'heure planifiée est passée. Terminé signifie complété dans WeekFit. Synchronisé signifie importé depuis Apple Health."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming più tardi oggi. Live in corso. Pending orario passato. Done completato in WeekFit. Synced importato da Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcomingは今日の後半。Liveは今。Pendingは予定時刻経過。DoneはWeekFitで完了。SyncedはApple Healthからインポート。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming은 오늘 이후. Live는 지금. Pending은 예정 시간 경과. Done은 WeekFit 완료. Synced는 Apple Health에서 가져옴."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadchodzące to później dziś. Na żywo to trwa teraz. Oczekujące oznacza, że planowana godzina minęła. Gotowe to ukończone w WeekFit. Zsynchronizowane to import z Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предстоит — позже сегодня. Сейчас — происходит сейчас. Ожидает — время прошло. Выполнено — завершено в WeekFit. Синхронизировано — импортировано из Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即将发生——今日稍后。正在发生——此刻正在发生。预期——时间已流逝。已完成——已在 WeekFit 中完成。已同步——已从 Apple Health 导入。"
          }
        }
      }
    },
