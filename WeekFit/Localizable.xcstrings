    "coach.section.breathing.before.insight" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist kein Leistungshindernis. Das Ziel ist es, einen ruhigeren Zustand zu schaffen und den Körper herunterzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not a performance block. The goal is to create a calmer state and let the body downshift."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es un bloque de rendimiento. El objetivo es un estado más calmado y dejar que el cuerpo baje el ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas un bloc de performance. L’objectif est de créer un état plus calme et de laisser le corps ralentir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo non è un blocco di prestazione. L'obiettivo è creare uno stato più calmo e permettere al corpo di rallentare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはパフォーマンスのブロックではありません。目的は、より落ち着いた状態を作り、体をダウンシフトさせることです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 공연 준비 블록이 아닙니다. 목표는 더 차분한 상태를 만들고 몸을 낮추는 것입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nie jest blok wydajnościowy. Celem jest spokojniejszy stan i pozwolenie ciału zwolnić."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не блок для результата. Цель — создать более спокойное состояние и дать телу замедлиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这并非对结果的限制，其目的在于营造一种更为平静的状态，并让身体逐渐放缓节奏。"
          }
        }
      }
    },
