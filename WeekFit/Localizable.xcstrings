    "coach.scenario.heatAfter.late.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie den Körper sich nach der Hitze beruhigen und halten Sie den Abend ruhig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the body settle after heat and keep the evening calm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deje que el cuerpo se asiente tras el calor y mantenga la noche tranquila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le corps se calmer après la chaleur et gardez la soirée tranquille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che il corpo si assesti dopo il calore e mantieni tranquilla la sera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱の後で体を落ち着かせ、夜を穏やかに保とう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열이 난 후에는 몸을 가라앉히고 저녁 시간을 차분하게 보내세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól ciału się uspokoić po cieple i utrzymaj spokojny wieczór."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте телу успокоиться после тепла и сохраните вечер спокойным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沐浴后让身体静置片刻，让夜晚保持宁静。"
          }
        }
      }
    },
    "coach.scenario.heatAfter.normal.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Hitze vermeiden Sie es, sofort harte Anstrengung zu unternehmen. Lassen Sie Ihren Körper zum Normalzustand zurückkehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After heat, avoid rushing into hard effort. Let your body return to baseline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras el calor, evite lanzarse a esfuerzo duro. Deje que el cuerpo vuelva a la línea base."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la chaleur, évitez de vous précipiter vers un effort dur. Laissez le corps revenir à la baseline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo il calore, evita di precipitarti in sforzi intensi. Lascia che il tuo corpo ritorni alla normalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱後は、すぐに激しい運動をしないでください。体を元の状態に戻すようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열을 받으면 바로 무리한 운동을 하지 마세요. 몸이 정상 상태로 돌아오도록 하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po cieple unikaj pędu w twardy wysiłek. Pozwól ciału wrócić do linii bazowej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После тепла не спешите переходить к тяжелому усилию. Дайте телу вернуться к базовому состоянию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动后，切勿急于进行高强度训练，让身体先恢复到基础状态。"
          }
        }
      }
    },
