    "ai.usage.terms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional purchases do not expire. An active Premium subscription is required to use them. Monthly allowance is used first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Докупленный объём не сгорает. Для использования нужна активная подписка Premium. Сначала расходуется месячный лимит."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokupione środki nie wygasają. Korzystanie z nich wymaga aktywnej subskrypcji Premium. Najpierw zużywany jest limit miesięczny."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加购用量不会过期，使用时需有有效的Premium订阅。优先使用每月包含的额度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crédits supplémentaires n’expirent pas. Un abonnement Premium actif est nécessaire pour les utiliser. Le quota mensuel est utilisé en premier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo adicional no caduca. Se necesita una suscripción Premium activa para utilizarlo. Primero se consume el cupo mensual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzlich gekauftes Guthaben verfällt nicht. Zur Nutzung ist ein aktives Premium-Abo erforderlich. Zuerst wird das Monatskontingent verwendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加購入した残高に有効期限はありません。利用には有効なPremiumサブスクリプションが必要です。毎月の利用枠から先に使用されます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo aggiuntivo non scade. Per utilizzarlo serve un abbonamento Premium attivo. Si utilizza prima la quota mensile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 구매한 사용량은 만료되지 않습니다. 사용하려면 활성 Premium 구독이 필요합니다. 월 기본 제공량이 먼저 차감됩니다."
          }
        }
      }
    },
