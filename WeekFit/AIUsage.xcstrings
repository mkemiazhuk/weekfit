    "ai.usage.terms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything you buy stays in your account. Premium is needed to use it. Your monthly amount is used first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Докупленное остаётся у вас. Чтобы пользоваться им, нужна подписка Premium. Сначала тратится то, что входит в месяц."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokupione zostaje na koncie. Do korzystania potrzebna jest subskrypcja Premium. Najpierw zużywane jest to, co jest w miesiącu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加购的部分会留在账户里。使用时需要有效的 Premium 订阅。会先用每月包含的额度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous achetez reste sur votre compte. Premium est nécessaire pour l’utiliser. Le montant du mois est utilisé en premier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que compras se queda en tu cuenta. Hace falta Premium para usarlo. Primero se usa lo del mes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekauftes bleibt auf deinem Konto. Zum Nutzen brauchst du Premium. Zuerst wird verbraucht, was im Monat enthalten ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入した分はアカウントに残ります。使うにはPremiumが必要です。毎月の分から先に使われます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che acquisti resta sul tuo account. Per usarlo serve Premium. Si usa prima ciò che è incluso nel mese."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매한 양은 계정에 남습니다. 쓰려면 Premium이 필요합니다. 이번 달에 포함된 양이 먼저 사용됩니다."
          }
        }
      }
    },
