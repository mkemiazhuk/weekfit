    "ai.usage.exhausted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your included allowance and purchased balance have been used. Add more or wait for the next allowance update."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месячный лимит и докупленный остаток закончились. Докупите объём или дождитесь обновления лимита."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystano limit miesięczny i dokupione środki. Dokup więcej lub poczekaj na odnowienie limitu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月额度和加购余额已用完。您可以加购用量，或等待下次额度更新。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre quota mensuel et votre solde acheté sont épuisés. Achetez du crédit ou attendez le prochain renouvellement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has agotado el cupo mensual y el saldo comprado. Compra más o espera a la próxima renovación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Monatskontingent und gekauftes Guthaben sind aufgebraucht. Kaufe mehr oder warte auf die nächste Erneuerung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月の利用枠と追加購入した残高を使い切りました。追加購入するか、次回の更新をお待ちください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai esaurito la quota mensile e il saldo acquistato. Acquista altro o attendi il prossimo rinnovo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 기본 제공량과 추가 구매 잔액을 모두 사용했습니다. 추가 구매하거나 다음 갱신을 기다려 주세요."
          }
        }
      }
    },
