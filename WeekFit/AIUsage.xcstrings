    "ai.usage.sandboxMisconfigured": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Diese Testversion ist für die AI-Sandbox gedacht, kann sie aber nicht verwenden. Produktion wird nicht kontaktiert. Bitte erneut aus der Scheme WeekFit Sandbox QA starten." } },
        "en": { "stringUnit": { "state": "translated", "value": "This test build is set to the AI Sandbox but cannot use it. Production was not contacted. Run again from the WeekFit Sandbox QA scheme." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esta compilación de prueba está en el Sandbox de IA, pero no puede usarlo. No se contactó con Producción. Vuelve a ejecutarla desde el esquema WeekFit Sandbox QA." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cette version de test vise le bac à sable IA, mais ne peut pas l’utiliser. La production n’a pas été contactée. Relancez depuis le schéma WeekFit Sandbox QA." } },
        "it": { "stringUnit": { "state": "translated", "value": "Questa build di prova è impostata sulla sandbox IA, ma non può usarla. La produzione non è stata contattata. Riavvia dallo scheme WeekFit Sandbox QA." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このテストビルドはAIサンドボックス向けですが、接続できません。本番環境には接続していません。スキーム WeekFit Sandbox QA から再実行してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 테스트 빌드는 AI 샌드박스용이지만 사용할 수 없습니다. 프로덕션에는 연결하지 않았습니다. WeekFit Sandbox QA 스킴으로 다시 실행하세요." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Ta kompilacja testowa jest ustawiona na piaskownicę AI, ale nie może z niej skorzystać. Produkcja nie została użyta. Uruchom ponownie ze schematu WeekFit Sandbox QA." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Эта тестовая сборка настроена на AI Sandbox, но не может его использовать. Production не вызывался. Запустите снова из схемы WeekFit Sandbox QA." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此测试版本设置为 AI 沙盒，但无法使用。未连接正式环境。请从 WeekFit Sandbox QA 方案重新运行。" } }
      }
    },
