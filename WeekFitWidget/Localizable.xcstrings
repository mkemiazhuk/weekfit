    "See how your day is going and what to do next.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie der Tag läuft und was als Nächstes ansteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how your day is going and what to do next."
          }
        },
        "es": {
